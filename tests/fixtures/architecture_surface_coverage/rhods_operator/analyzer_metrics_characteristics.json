{
  "component": "rhods-operator",
  "entrypoints": [
    {
      "name": "cmd",
      "type": "Go controller-runtime operator",
      "source": "cmd/main.go:301"
    }
  ],
  "services": [
    {
      "name": "opendatahub-operator-controller-manager-metrics-service",
      "target_deployment": "opendatahub-operator-controller-manager",
      "source": "config/default/metrics_service_patch.yaml:3"
    },
    {
      "name": "gateway-auth-proxy",
      "ports": [{"name": "metrics"}],
      "source": "internal/controller/services/gateway/resources/kube-auth-proxy-svc.tmpl.yaml:1"
    }
  ],
  "deployments": [
    {
      "name": "opendatahub-operator-controller-manager",
      "args": ["--metrics-bind-address=:8443", "--metrics-secure=true"],
      "source": "config/default/manager_webhook_patch.yaml:1"
    },
    {
      "name": "gateway-oidc-proxy",
      "args": ["--metrics-address=0.0.0.0:9090"],
      "source": "internal/controller/services/gateway/resources/kube-auth-proxy-oidc-deployment.tmpl.yaml:1"
    }
  ]
}
