graph TD
    subgraph "Service Accounts"
        SA_Manager["opendatahub-operator-<br/>controller-manager"]
        SA_Controller["controller-manager"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Manager["opendatahub-operator-controller-<br/>manager-rolebinding"]
        CRB_Controller["controller-manager-<br/>rolebinding"]
    end

    subgraph "Controller Manager Role"
        CR_Manager["controller-manager-role<br/>(ClusterRole)"]
    end

    SA_Manager -->|"bound via"| CRB_Manager
    SA_Controller -->|"bound via"| CRB_Controller
    CRB_Manager -->|"grants"| CR_Manager
    CRB_Controller -->|"grants"| CR_Manager

    subgraph "Component Editor/Viewer Roles"
        direction TB
        DSP_Editor["datasciencepipelines-editor-role"]
        DSP_Viewer["datasciencepipelines-viewer-role"]
        Kueue_Editor["kueue-editor-role"]
        Kueue_Viewer["kueue-viewer-role"]
        Ray_Editor["ray-editor-role"]
        Ray_Viewer["ray-viewer-role"]
        TrustyAI_Editor["trustyai-editor-role"]
        TrustyAI_Viewer["trustyai-viewer-role"]
        Dashboard_Editor["dashboard-editor-role"]
        Dashboard_Viewer["dashboard-viewer-role"]
        KServe_Editor["kserve-editor-role"]
        KServe_Viewer["kserve-viewer-role"]
        ModelReg_Editor["modelregistry-editor-role"]
        ModelReg_Viewer["modelregistry-viewer-role"]
        Workbench_Editor["workbenches-editor-role"]
        Workbench_Viewer["workbenches-viewer-role"]
        Auth_Editor["auth-editor-role"]
        Auth_Viewer["auth-viewer-role"]
    end

    subgraph "Data Science Group Roles"
        direction TB
        AdminCluster["data-science-admingroupcluster-role"]
        AllowedCluster["data-science-allowedgroupcluster-role"]
        AdminGroup["data-science-admingroup-role"]
        AdminKuadrant["data-science-admingroup-kuadrant-role"]
        AdminMaaS["data-science-admingroup-maas-role"]
    end

    subgraph "Component API Resources"
        DSP_Res["components.platform.opendatahub.io<br/>datasciencepipelines"]
        Kueue_Res["components.platform.opendatahub.io<br/>kueues"]
        Ray_Res["components.platform.opendatahub.io<br/>rays"]
        TrustyAI_Res["components.platform.opendatahub.io<br/>trustyais"]
        Dashboard_Res["components.platform.opendatahub.io<br/>dashboards"]
        KServe_Res["components.platform.opendatahub.io<br/>kserves"]
        ModelReg_Res["components.platform.opendatahub.io<br/>modelregistries"]
        Workbench_Res["components.platform.opendatahub.io<br/>workbenches"]
    end

    subgraph "Platform API Resources"
        Auth_Res["services.platform.opendatahub.io<br/>auths"]
        DSC_Res["datasciencecluster.opendatahub.io<br/>datascienceclusters"]
        HW_Res["infrastructure.opendatahub.io<br/>hardwareprofiles"]
        Feast_Res["feast.dev<br/>featurestores"]
        MR_Res["modelregistry.opendatahub.io<br/>modelregistries"]
        MaaS_Res["maas.opendatahub.io<br/>maasmodelrefs, maasauthpolicies,<br/>maassubscriptions"]
        NIM_Res["nim.opendatahub.io<br/>accounts"]
        Serving_Res["serving.kserve.io<br/>servingruntimes,<br/>llminferenceserviceconfigs"]
    end

    %% Editor roles -> resources (full CRUD)
    DSP_Editor -->|"full CRUD"| DSP_Res
    Kueue_Editor -->|"full CRUD"| Kueue_Res
    Ray_Editor -->|"full CRUD"| Ray_Res
    TrustyAI_Editor -->|"full CRUD"| TrustyAI_Res
    Dashboard_Editor -->|"full CRUD"| Dashboard_Res
    KServe_Editor -->|"full CRUD"| KServe_Res
    ModelReg_Editor -->|"full CRUD"| ModelReg_Res
    Workbench_Editor -->|"full CRUD"| Workbench_Res

    %% Viewer roles -> resources (read-only)
    DSP_Viewer -.->|"get,list,watch"| DSP_Res
    Kueue_Viewer -.->|"get,list,watch"| Kueue_Res
    Ray_Viewer -.->|"get,list,watch"| Ray_Res
    TrustyAI_Viewer -.->|"get,list,watch"| TrustyAI_Res
    Dashboard_Viewer -.->|"get,list,watch"| Dashboard_Res
    KServe_Viewer -.->|"get,list,watch"| KServe_Res
    ModelReg_Viewer -.->|"get,list,watch"| ModelReg_Res
    Workbench_Viewer -.->|"get,list,watch"| Workbench_Res

    %% Admin cluster role -> platform resources
    AdminCluster -->|"get,list,patch,watch"| Auth_Res
    AdminCluster -->|"get,list,patch,<br/>update,watch"| DSC_Res
    AdminCluster -->|"full CRUD"| MR_Res
    AdminCluster -->|"full CRUD"| Feast_Res
    AdminCluster -->|"get,list,watch"| MaaS_Res

    %% Admin group role -> additional resources
    AdminGroup -->|"full CRUD"| HW_Res
    AdminGroup -->|"create"| Serving_Res
    AdminGroup -->|"full CRUD"| NIM_Res

    %% Admin MaaS role
    AdminMaaS -->|"full CRUD"| MaaS_Res

    %% Allowed cluster role (read-only)
    AllowedCluster -.->|"get,list,watch"| Auth_Res

