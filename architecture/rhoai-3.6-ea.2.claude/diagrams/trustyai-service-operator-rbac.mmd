graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Module["trustyai-operator-module-<br/>controller-manager"]
        SA_Manager["controller-manager"]
        SA_Eval["{name}-service<br/>(per evaluation)"]
        SA_Proxy["{name}-proxy<br/>(per TrustyAI instance)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Module["trustyai-operator-module-<br/>manager-rolebinding"]
        CRB_Manager["manager-rolebinding"]
        CRB_EvalAuth["{name}-{namespace}-<br/>auth-reviewer-crb"]
        CRB_Proxy["{name}-{namespace}-<br/>proxy-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Module["trustyai-operator-module-<br/>manager-role"]
        CR_Manager["manager-role"]
        CR_EvalAuth["trustyai-service-operator-<br/>evalhub-auth-reviewer-role"]
        CR_Proxy["trustyai-service-operator-<br/>proxy-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core/v1<br/>ConfigMaps<br/>create,delete,get,list,<br/>patch,update,watch"]
        Events["core/v1<br/>Events<br/>create,patch,update"]
        Services["core/v1<br/>Services<br/>get,list,patch"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps/v1<br/>Deployments<br/>get,list,patch"]
    end

    subgraph TrustyAIResources["TrustyAI API Resources"]
        TrustyAIs["components.platform.opendatahub.io<br/>TrustyAIs<br/>create,delete,get,list,<br/>patch,update,watch"]
        TrustyAIFinalizers["components.platform.opendatahub.io<br/>TrustyAIs/finalizers<br/>update"]
        TrustyAIStatus["components.platform.opendatahub.io<br/>TrustyAIs/status<br/>get,patch,update"]
    end

    subgraph CoordinationResources["Coordination Resources"]
        Leases["coordination.k8s.io<br/>Leases<br/>create,delete,get,list,<br/>patch,update,watch"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        Prometheuses["monitoring.coreos.com<br/>Prometheuses<br/>get,list"]
    end

    subgraph RBACResources["RBAC Resources"]
        RoleBindings["rbac.authorization.k8s.io<br/>RoleBindings<br/>get,list,patch"]
    end

    subgraph KServeResources["KServe Resources"]
        InferenceServices["serving.kserve.io<br/>InferenceServices<br/>get,list"]
    end

    %% Module SA bindings
    SA_Module -->|bound via| CRB_Module
    CRB_Module -->|grants| CR_Module

    %% Manager SA bindings
    SA_Manager -->|bound via| CRB_Manager
    CRB_Manager -->|grants| CR_Manager

    %% Dynamic eval SA bindings
    SA_Eval -->|bound via| CRB_EvalAuth
    CRB_EvalAuth -->|grants| CR_EvalAuth

    %% Dynamic proxy SA bindings
    SA_Proxy -->|bound via| CRB_Proxy
    CRB_Proxy -->|grants| CR_Proxy

    %% Module/Manager role permissions (same for both)
    CR_Module -->|access| ConfigMaps
    CR_Module -->|access| Events
    CR_Module -->|access| Services
    CR_Module -->|access| Deployments
    CR_Module -->|access| TrustyAIs
    CR_Module -->|access| TrustyAIFinalizers
    CR_Module -->|access| TrustyAIStatus
    CR_Module -->|access| Leases
    CR_Module -->|access| Prometheuses
    CR_Module -->|access| RoleBindings
    CR_Module -->|access| InferenceServices

    CR_Manager -->|access| ConfigMaps
    CR_Manager -->|access| Events
    CR_Manager -->|access| Services
    CR_Manager -->|access| Deployments
    CR_Manager -->|access| TrustyAIs
    CR_Manager -->|access| TrustyAIFinalizers
    CR_Manager -->|access| TrustyAIStatus
    CR_Manager -->|access| Leases
    CR_Manager -->|access| Prometheuses
    CR_Manager -->|access| RoleBindings
    CR_Manager -->|access| InferenceServices

    style SA_Module fill:#4a90e2,stroke:#333,color:#fff
    style SA_Manager fill:#4a90e2,stroke:#333,color:#fff
    style SA_Eval fill:#4a90e2,stroke:#333,color:#fff
    style SA_Proxy fill:#4a90e2,stroke:#333,color:#fff
    style CR_Module fill:#f5a623,stroke:#333
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_EvalAuth fill:#f5a623,stroke:#333
    style CR_Proxy fill:#f5a623,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333,color:#fff
    style Events fill:#7ed321,stroke:#333,color:#fff
    style Services fill:#7ed321,stroke:#333,color:#fff
    style Deployments fill:#7ed321,stroke:#333,color:#fff
    style TrustyAIs fill:#7ed321,stroke:#333,color:#fff
    style TrustyAIFinalizers fill:#7ed321,stroke:#333,color:#fff
    style TrustyAIStatus fill:#7ed321,stroke:#333,color:#fff
    style Leases fill:#7ed321,stroke:#333,color:#fff
    style Prometheuses fill:#7ed321,stroke:#333,color:#fff
    style RoleBindings fill:#7ed321,stroke:#333,color:#fff
    style InferenceServices fill:#7ed321,stroke:#333,color:#fff
