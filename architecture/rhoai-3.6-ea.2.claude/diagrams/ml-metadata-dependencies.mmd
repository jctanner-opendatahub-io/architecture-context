graph LR
    MLMD["ML Metadata<br/>(metadata_store_server)"]

    %% Internal Platform Dependencies
    MLMD -->|"database client<br/>3306/TCP MySQL protocol<br/>Optional SSL"| MySQL["MySQL / MariaDB"]
    MLMD -->|"database client<br/>5432/TCP PostgreSQL protocol<br/>Optional SSL"| PostgreSQL["PostgreSQL"]
    MLMD -.->|"embedded storage<br/>(dev/test only)"| SQLite["SQLite"]

    %% Build Dependencies
    MLMD -.->|"crypto library<br/>(linked at build time)"| OpenSSL["System OpenSSL"]
    MLMD -.->|"database connector<br/>(bundled third-party)"| MariaDBClient["libmysqlclient<br/>(MariaDB connector)"]

    %% Integration Points - Consumers
    DSP["Data Science Pipelines"] -->|"gRPC/8080<br/>metadata CRUD"| MLMD
    PythonSDK["ml_metadata<br/>Python SDK"] -->|"gRPC/8080<br/>client library"| MLMD

    %% Container / Platform
    MLMD -.->|"base image"| UBI9["UBI9/ubi-minimal-pqc"]
    MLMD -.->|"build system"| Bazel["Bazel"]

    %% Repo Lineage
    subgraph "Repo Lineage"
        direction TB
        Google["google/ml-metadata<br/>(upstream)"]
        ODH["opendatahub-io/ml-metadata<br/>(midstream)"]
        RHDS["red-hat-data-services/ml-metadata<br/>(downstream)"]
        Google -->|auto_merge| ODH
        ODH -->|auto_merge| RHDS
    end

    style MLMD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style MySQL fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style SQLite fill:#e8e8e8,stroke:#333
    style DSP fill:#7ed321,stroke:#333,color:#fff
    style PythonSDK fill:#7ed321,stroke:#333,color:#fff
    style OpenSSL fill:#f5a623,stroke:#333,color:#fff
    style MariaDBClient fill:#f5a623,stroke:#333,color:#fff
    style UBI9 fill:#999,stroke:#333,color:#fff
    style Bazel fill:#999,stroke:#333,color:#fff
    style Google fill:#fff2cc,stroke:#d6b656
    style ODH fill:#fff2cc,stroke:#d6b656
    style RHDS fill:#fff2cc,stroke:#d6b656
