graph LR
    OGX["ogx-k8s-operator<br/>(OGXServer Controller +<br/>ogx-module)"]

    %% Runtime Framework
    OGX -->|operator framework| ControllerRuntime["controller-runtime<br/>0.23.3"]
    OGX -->|Go runtime| Go["Go 1.25.8"]

    %% Internal ODH Dependencies
    OGX -->|manifest rendering,<br/>platform detection| ODHPlatformUtils["odh-platform-utilities"]
    OGX -->|TLS profiles| OSControllerCommon["openshift/<br/>controller-runtime-common"]

    %% Kubernetes API Dependencies
    OGX -->|resource operations| K8sAPI["Kubernetes API<br/>(k8s.io/api v0.35.2)"]
    OGX -->|CRD operations| K8sApiExt["apiextensions-apiserver<br/>(k8s.io v0.35.2)"]
    OGX -->|client| K8sClient["client-go<br/>(k8s.io v0.35.2)"]

    %% External Dependencies
    OGX -->|monitoring CRDs| PromOperator["prometheus-operator<br/>v0.82.0"]
    OGX -->|OpenShift APIs| OpenShiftAPI["openshift/api"]
    OGX -->|manifest rendering| Kustomize["kustomize<br/>(api + kyaml v0.21.0)"]

    %% Observability
    OGX -->|logging| Zap["go.uber.org/zap<br/>v1.28.0"]
    OGX -->|structured logging| Logr["go-logr/logr<br/>v1.4.4"]

    %% Configuration
    OGX -->|runtime config| Viper["spf13/viper<br/>v1.21.0"]

    %% Container Registry
    OGX -->|image refs| GoContainerReg["go-containerregistry<br/>v0.21.9"]

    %% Integration Points
    Prometheus["Prometheus"] -->|scrapes metrics| OGX
    PlatformOp["Platform Operator<br/>(RHOAI/ODH)"] -->|creates OGX CR| OGX

