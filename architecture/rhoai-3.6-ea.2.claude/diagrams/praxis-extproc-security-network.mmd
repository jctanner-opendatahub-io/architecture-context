graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Gateway["INGRESS (openshift-ingress namespace)"]
        direction TB
        EnvoyGW["Istio/Envoy Gateway<br/>(maas-default-gateway)<br/>EnvoyFilter Priority 10"]

        subgraph FilterChain["Envoy Filter Chain"]
            direction LR
            PreFilter["ipp-pre ext_proc<br/>failure_mode_allow: true<br/>(before auth)"]
            KuadrantAuth["Kuadrant WasmPlugin<br/>(Authorization)"]
            PostFilter["ipp ext_proc<br/>failure_mode_allow: false<br/>(after auth)"]
            PreFilter --> KuadrantAuth --> PostFilter
        end
    end

    subgraph ServiceZone["SERVICE ZONE (openshift-ingress namespace)"]
        direction TB
        SVC["payload-processing Service<br/>ClusterIP 9004/TCP<br/>Internal Only"]

        subgraph PodBoundary["payload-processing Pod"]
            direction TB
            ExtProc["praxis-extproc<br/>Rust Binary"]

            subgraph Listeners["Listeners"]
                direction LR
                GRPC["ExtProc gRPC<br/>9004/TCP HTTP/2<br/>Configurable TLS<br/>(None/TLS/mTLS)"]
                Health["Health gRPC<br/>50052/TCP HTTP/2<br/>No Encryption"]
                Metrics["Prometheus HTTP<br/>9090/TCP HTTP/1.1<br/>No Encryption"]
            end
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>443/TCP, 6443/TCP<br/>HTTPS TLS<br/>ServiceAccount Token RBAC"]
        Prom["Prometheus<br/>Monitoring"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS"| EnvoyGW
    EnvoyGW -->|"gRPC/9004<br/>TLS SIMPLE<br/>(DestinationRule + SNI)<br/>Bidirectional Stream"| SVC
    SVC --> GRPC

    ExtProc -->|"HTTPS/443,6443<br/>TLS<br/>SA Token Auth<br/>get/list/watch ConfigMaps<br/>get Secrets<br/>get/list/watch ExternalProviders<br/>get/list/watch ExternalModels"| K8sAPI

    Prom -->|"HTTP/9090<br/>No Auth<br/>GET /metrics"| Metrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef filterchain fill:#fff2cc,stroke:#d6b656,stroke-width:1px
    classDef servicezone fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef pod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class EnvoyGW gateway
    class PreFilter,KuadrantAuth,PostFilter filterchain
    class SVC,ExtProc,GRPC,Health,Metrics servicezone
    class K8sAPI,Prom platform
