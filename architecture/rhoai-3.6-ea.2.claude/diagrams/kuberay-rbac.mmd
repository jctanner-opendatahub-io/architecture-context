graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["kuberay-operator<br/>(ServiceAccount)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Operator["kuberay-operator<br/>(ClusterRoleBinding)"]
        CRB_ConfigMap["kuberay-operator-configmap<br/>(RoleBinding, redhat-ods-applications)"]
        CRB_GatewayAPI["kuberay-operator-gateway-api<br/>(RoleBinding, redhat-ods-applications)"]
        CRB_LeaderElection["kuberay-operator-leader-election<br/>(RoleBinding)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Operator["kuberay-operator<br/>(ClusterRole)"]
        CR_Edit["kuberay-edit-role<br/>(ClusterRole)"]
        CR_View["kuberay-view-role<br/>(ClusterRole)"]
        CR_ConfigMap["kuberay-operator-configmap<br/>(ClusterRole)"]
        CR_GatewayAPI["kuberay-operator-gateway-api<br/>(ClusterRole)"]
        CR_LeaderElection["kuberay-operator-leader-election<br/>(Role)"]
    end

    subgraph RayCRDs["Ray CRDs (ray.io)"]
        RayClusters["RayCluster<br/>rayclusters, finalizers, status"]
        RayJobs["RayJob<br/>rayjobs, finalizers, status"]
        RayServices["RayService<br/>rayservices, finalizers, status"]
        RayCronJobs["RayCronJob<br/>raycronjobs, finalizers, status"]
    end

    subgraph CoreResources["Core API Resources"]
        Pods["Pods<br/>pods, pods/status, pods/proxy, pods/resize"]
        CoreServices["Services<br/>services, services/status, services/proxy"]
        Secrets["Secrets"]
        ConfigMaps["ConfigMaps"]
        ServiceAccts["ServiceAccounts"]
        Events["Events"]
    end

    subgraph ExtResources["Extended API Resources"]
        Deployments["apps/Deployments"]
        Jobs["batch/Jobs"]
        Certs["cert-manager.io<br/>Certificates, Issuers"]
        HTTPRoutes["gateway.networking.k8s.io<br/>HTTPRoutes, ReferenceGrants, Gateways"]
        NetPolicies["networking.k8s.io<br/>NetworkPolicies, Ingresses"]
        Routes["route.openshift.io<br/>Routes"]
        RBAC_Res["rbac.authorization.k8s.io<br/>Roles, RoleBindings,<br/>ClusterRoles, ClusterRoleBindings"]
        Leases["coordination.k8s.io<br/>Leases"]
        TokenReviews["authentication.k8s.io<br/>TokenReviews"]
        SAR["authorization.k8s.io<br/>SubjectAccessReviews"]
    end

    %% SA to Bindings
    SA_Operator -->|bound via| CRB_Operator
    SA_Operator -->|bound via| CRB_ConfigMap
    SA_Operator -->|bound via| CRB_GatewayAPI
    SA_Operator -->|bound via| CRB_LeaderElection

    %% Bindings to Roles
    CRB_Operator -->|grants| CR_Operator
    CRB_ConfigMap -->|grants| CR_ConfigMap
    CRB_GatewayAPI -->|grants| CR_GatewayAPI
    CRB_LeaderElection -->|grants| CR_LeaderElection

    %% Operator role to resources
    CR_Operator -->|"CRUD + watch"| RayClusters
    CR_Operator -->|"CRUD + watch"| RayJobs
    CR_Operator -->|"CRUD + watch"| RayServices
    CR_Operator -->|"CRUD + watch"| RayCronJobs
    CR_Operator -->|"CRUD + watch"| Pods
    CR_Operator -->|"CRUD + watch"| CoreServices
    CR_Operator -->|"CRUD + watch"| Secrets
    CR_Operator -->|"CRUD + watch"| ConfigMaps
    CR_Operator -->|"CRUD + watch"| ServiceAccts
    CR_Operator -->|"CRUD + watch"| Deployments
    CR_Operator -->|"CRUD + watch"| Jobs
    CR_Operator -->|"CRUD + watch"| Certs
    CR_Operator -->|"CRUD + watch"| HTTPRoutes
    CR_Operator -->|"CRUD + watch"| NetPolicies
    CR_Operator -->|"CRUD + watch"| Routes
    CR_Operator -->|"CRUD + watch"| RBAC_Res
    CR_Operator -->|"create"| TokenReviews
    CR_Operator -->|"create"| SAR

    %% Edit role
    CR_Edit -->|"CRUD"| RayClusters
    CR_Edit -->|"CRUD"| RayJobs
    CR_Edit -->|"CRUD"| RayServices

    %% View role
    CR_View -->|"get, list, watch"| RayClusters
    CR_View -->|"get, list, watch"| RayJobs
    CR_View -->|"get, list, watch"| RayServices

    %% ConfigMap role
    CR_ConfigMap -->|"CRUD + watch"| ConfigMaps

    %% Gateway API role
    CR_GatewayAPI -->|"get, list, watch"| HTTPRoutes

    %% Leader election
    CR_LeaderElection -->|"CRUD"| Leases
    CR_LeaderElection -->|"CRUD"| ConfigMaps
    CR_LeaderElection -->|"create"| Events

    %% Styling
    style SA_Operator fill:#4a90e2,color:#fff
    style CR_Operator fill:#f5a623,color:#000
    style CR_Edit fill:#f5a623,color:#000
    style CR_View fill:#f5a623,color:#000
    style CR_ConfigMap fill:#f5a623,color:#000
    style CR_GatewayAPI fill:#f5a623,color:#000
    style CR_LeaderElection fill:#f5a623,color:#000
    style RayClusters fill:#7ed321,color:#000
    style RayJobs fill:#7ed321,color:#000
    style RayServices fill:#7ed321,color:#000
    style RayCronJobs fill:#7ed321,color:#000
    style CRB_Operator fill:#ddd,color:#000
    style CRB_ConfigMap fill:#ddd,color:#000
    style CRB_GatewayAPI fill:#ddd,color:#000
    style CRB_LeaderElection fill:#ddd,color:#000
