graph TD
    subgraph ServiceAccounts["Service Accounts"]
        GatewaySA["{release} Gateway SA"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB1["{release}-node-reader<br/>ClusterRoleBinding"]
    end

    subgraph RoleBindings["Namespace Role Bindings"]
        RB1["{release}-sandbox<br/>RoleBinding<br/>(Sandbox Namespace)"]
        RB2["{release}-credential-secrets<br/>RoleBinding<br/>(Credential Namespace)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR1["{release}-node-reader<br/>ClusterRole"]
    end

    subgraph NamespaceRoles["Namespace Roles"]
        R1["{release}-sandbox<br/>Role"]
        R2["{release}-credential-secrets<br/>Role"]
    end

    subgraph ClusterResources["Cluster-Scoped Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        Nodes["core<br/>nodes"]
        Namespaces["core<br/>namespaces"]
        SandboxCRD["agents.x-k8s.io<br/>sandboxes"]
    end

    subgraph NamespaceResources["Namespace-Scoped Resources"]
        SandboxSecrets["core<br/>secrets<br/>(Sandbox NS)"]
        CredentialSecrets["core<br/>secrets<br/>(Credential NS)"]
        Pods["core<br/>pods"]
        Services["core<br/>services"]
    end

    %% SA to Bindings
    GatewaySA -->|"bound via"| CRB1
    GatewaySA -->|"bound via"| RB1
    GatewaySA -->|"bound via"| RB2

    %% Bindings to Roles
    CRB1 -->|"grants"| CR1
    RB1 -->|"grants"| R1
    RB2 -->|"grants"| R2

    %% ClusterRole to Resources
    CR1 -->|"create"| TokenReviews
    CR1 -->|"get, list, watch"| Nodes
    CR1 -->|"get (+list, watch,<br/>create, delete<br/>in managed mode)"| Namespaces
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| SandboxCRD

    %% Namespace Roles to Resources
    R1 -->|"get, patch, create<br/>(resourceName restrictions)"| SandboxSecrets
    R1 -->|"get, list, watch,<br/>create, delete"| Pods
    R1 -->|"get, list, watch,<br/>create, delete"| Services
    R2 -->|"get, patch, create<br/>(resourceName restrictions)"| CredentialSecrets

    subgraph AuthorizationModel["Application-Level Authorization"]
        direction TB
        OIDCAuth["OIDC Roles"]
        WorkspaceUser["workspace:user<br/>Create/manage own sandboxes"]
        WorkspaceAdmin["workspace:admin<br/>Manage all workspace resources"]
        PlatformAdmin["platform_admin (global)<br/>Cross-workspace access"]

        OIDCAuth --> WorkspaceUser
        OIDCAuth --> WorkspaceAdmin
        OIDCAuth --> PlatformAdmin
    end

    %% Styles
    style GatewaySA fill:#4a90e2,color:#fff
    style CR1 fill:#f5a623,color:#fff
    style R1 fill:#f5a623,color:#fff
    style R2 fill:#f5a623,color:#fff
    style CRB1 fill:#e8e8e8
    style RB1 fill:#e8e8e8
    style RB2 fill:#e8e8e8
    style TokenReviews fill:#7ed321,color:#fff
    style Nodes fill:#7ed321,color:#fff
    style Namespaces fill:#7ed321,color:#fff
    style SandboxCRD fill:#7ed321,color:#fff
    style SandboxSecrets fill:#7ed321,color:#fff
    style CredentialSecrets fill:#7ed321,color:#fff
    style Pods fill:#7ed321,color:#fff
    style Services fill:#7ed321,color:#fff
    style OIDCAuth fill:#9b59b6,color:#fff
    style WorkspaceUser fill:#e1d5e7
    style WorkspaceAdmin fill:#e1d5e7
    style PlatformAdmin fill:#e74c3c,color:#fff
