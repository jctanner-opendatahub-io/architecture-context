graph TD
    subgraph "Authentication Source"
        Kubeconfig["kubeconfig file<br/>(bearer token / client cert / OIDC)"]
    end

    subgraph "CLI Runtime"
        ConfigFlags["k8s.io/cli-runtime ConfigFlags<br/>--kubeconfig, --context,<br/>--token, --server"]
    end

    subgraph "Pre-flight Authorization"
        SSAR["SelfSubjectAccessReview<br/>authorization/v1"]
    end

    subgraph "Kubernetes API Server"
        RBAC["kube-apiserver RBAC<br/>Enforcement Point"]
    end

    subgraph "Read-Only Operations (Reader Interface)"
        direction LR
        StatusOp["status<br/>get, list, watch"]
        DiagnoseOp["diagnose<br/>get, list"]
        LintOp["lint<br/>get, list"]
        GetOp["get<br/>get, list"]
        DepsOp["deps<br/>get, list"]
        ApiOp["api<br/>get, list (discovery)"]
        LogsOp["logs<br/>get, list"]
        EventsOp["events<br/>get, list, watch"]
    end

    subgraph "Write Operations (Writer Interface)"
        direction LR
        MigrateOp["migrate<br/>create, update, patch"]
        NamespaceCreate["Namespace create<br/>(privileged)"]
    end

    subgraph "API Resources Accessed"
        direction LR
        Pods["core/v1<br/>Pods"]
        Deployments["apps/v1<br/>Deployments"]
        Services["core/v1<br/>Services"]
        Namespaces["core/v1<br/>Namespaces"]
        CRDs["apiextensions<br/>CRDs"]
        Subscriptions["operators.coreos.com<br/>Subscriptions"]
        CSVs["operators.coreos.com<br/>CSVs"]
        Routes["route.openshift.io<br/>Routes"]
    end

    Kubeconfig -->|"credentials"| ConfigFlags
    ConfigFlags -->|"propagated to<br/>all subcommands"| SSAR
    SSAR -->|"pre-flight check<br/>before privileged ops"| RBAC

    RBAC -->|"authorizes"| StatusOp
    RBAC -->|"authorizes"| DiagnoseOp
    RBAC -->|"authorizes"| LintOp
    RBAC -->|"authorizes"| GetOp
    RBAC -->|"authorizes"| DepsOp
    RBAC -->|"authorizes"| ApiOp
    RBAC -->|"authorizes"| LogsOp
    RBAC -->|"authorizes"| EventsOp
    RBAC -->|"authorizes"| MigrateOp
    RBAC -->|"authorizes"| NamespaceCreate

    StatusOp --> Pods
    StatusOp --> Deployments
    DiagnoseOp --> Pods
    DiagnoseOp --> Subscriptions
    DepsOp --> Subscriptions
    DepsOp --> CSVs
    MigrateOp --> Routes
    MigrateOp --> Namespaces
    NamespaceCreate --> Namespaces

    style Kubeconfig fill:#4a90e2,stroke:#333,color:#fff
    style ConfigFlags fill:#d5e8d4,stroke:#82b366
    style SSAR fill:#f5a623,stroke:#333
    style RBAC fill:#e8e8e8,stroke:#333
    style MigrateOp fill:#f5a623,stroke:#333
    style NamespaceCreate fill:#f5a623,stroke:#333

    style Pods fill:#7ed321,stroke:#333
    style Deployments fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style Namespaces fill:#7ed321,stroke:#333
    style CRDs fill:#7ed321,stroke:#333
    style Subscriptions fill:#7ed321,stroke:#333
    style CSVs fill:#7ed321,stroke:#333
    style Routes fill:#7ed321,stroke:#333
