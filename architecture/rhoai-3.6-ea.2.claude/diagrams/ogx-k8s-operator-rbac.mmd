graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["ogx-k8s-operator-<br/>controller-manager"]
        SA_Op["operator"]
        SA_CtrlMgr["controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Mgr["ogx-k8s-operator-<br/>manager-rolebinding"]
        CRB_Proxy["ogx-k8s-operator-<br/>proxy-rolebinding"]
        CRB_MgrCluster["manager-cluster-<br/>rolebinding"]
        CRB_Metrics["metrics-auth-<br/>rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["ogx-k8s-operator-<br/>leader-election-rolebinding<br/>(ns: ogx-k8s-operator-system)"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Mgr["ogx-k8s-operator-<br/>manager-role"]
        CR_Proxy["ogx-k8s-operator-<br/>proxy-role"]
        CR_MgrCluster["manager-cluster-role<br/>(ogx-module)"]
        CR_Viewer["ogxserver-viewer-role"]
        CR_Editor["ogxserver-editor-role"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Leader["ogx-k8s-operator-<br/>leader-election-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["ConfigMaps"]
        PVCs["PersistentVolumeClaims"]
        Pods["Pods"]
        Secrets["Secrets"]
        Services["Services"]
        ServiceAccts["ServiceAccounts"]
        Events["Events"]
    end

    subgraph OGXResources["ogx.io API Resources"]
        OGXServers["OGXServers"]
        OGXServersFin["OGXServers/finalizers"]
        OGXServersStatus["OGXServers/status"]
    end

    subgraph PlatformResources["Platform API Resources"]
        OGXs["OGXs<br/>(components.platform.opendatahub.io)"]
        OGXsFin["OGXs/finalizers"]
        OGXsStatus["OGXs/status"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["Deployments"]
        ReplicaSets["ReplicaSets"]
    end

    subgraph NetworkResources["Networking API Resources"]
        Ingresses["Ingresses"]
        NetworkPolicies["NetworkPolicies"]
    end

    subgraph ScalingResources["Autoscaling & Policy"]
        HPAs["HorizontalPodAutoscalers"]
        PDBs["PodDisruptionBudgets"]
    end

    subgraph MonitoringResources["Monitoring API Resources"]
        ServiceMonitors["ServiceMonitors"]
        PrometheusRules["PrometheusRules"]
    end

    subgraph AuthResources["Auth API Resources"]
        TokenReviews["TokenReviews"]
        SAReviews["SubjectAccessReviews"]
    end

    subgraph AdminResources["Admin API Resources"]
        CRDs["CustomResourceDefinitions"]
        VWHCs["ValidatingWebhookConfigurations"]
        CRoles["ClusterRoles"]
        CRBindings["ClusterRoleBindings"]
        RBindings["RoleBindings"]
        Roles2["Roles"]
        SCCs["SecurityContextConstraints"]
    end

    %% SA to CRB bindings
    SA_CM -->|bound via| CRB_Mgr
    SA_CM -->|bound via| CRB_Proxy
    SA_Op -->|bound via| CRB_MgrCluster
    SA_Op -->|bound via| CRB_Metrics
    SA_CM -->|bound via| RB_Leader

    %% CRB to CR grants
    CRB_Mgr -->|grants| CR_Mgr
    CRB_Proxy -->|grants| CR_Proxy
    CRB_MgrCluster -->|grants| CR_MgrCluster
    CRB_Metrics -->|grants| CR_Proxy

    %% RB to Role grants
    RB_Leader -->|grants| R_Leader

    %% CR_Mgr permissions (OGXServer controller)
    CR_Mgr -->|"CRUD"| ConfigMaps
    CR_Mgr -->|"CRUD"| PVCs
    CR_Mgr -->|"list"| Pods
    CR_Mgr -->|"read"| Secrets
    CR_Mgr -->|"CRUD"| Services
    CR_Mgr -->|"CRUD"| ServiceAccts
    CR_Mgr -->|"CRUD"| OGXServers
    CR_Mgr -->|"update"| OGXServersFin
    CR_Mgr -->|"read+patch"| OGXServersStatus
    CR_Mgr -->|"CRUD"| Deployments
    CR_Mgr -->|"read"| ReplicaSets
    CR_Mgr -->|"CRUD"| HPAs
    CR_Mgr -->|"CRUD"| PDBs
    CR_Mgr -->|"CRUD"| Ingresses
    CR_Mgr -->|"CRUD"| NetworkPolicies
    CR_Mgr -->|"CRUD"| ServiceMonitors
    CR_Mgr -->|"CRUD"| PrometheusRules
    CR_Mgr -->|"use"| SCCs

    %% CR_Proxy permissions
    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SAReviews

    %% CR_MgrCluster permissions (ogx-module)
    CR_MgrCluster -->|"CRUD"| OGXs
    CR_MgrCluster -->|"update"| OGXsFin
    CR_MgrCluster -->|"read+patch"| OGXsStatus
    CR_MgrCluster -->|"CRUD"| CRDs
    CR_MgrCluster -->|"CRUD"| VWHCs
    CR_MgrCluster -->|"CRUD"| CRoles
    CR_MgrCluster -->|"CRUD"| CRBindings
    CR_MgrCluster -->|"CRUD"| RBindings
    CR_MgrCluster -->|"CRUD"| Roles2
    CR_MgrCluster -->|"create,patch"| Events

    %% Leader election role
    R_Leader -->|"CRUD"| ConfigMaps
    R_Leader -->|"create,patch"| Events

    %% Styling
    style SA_CM fill:#4a90e2,color:#fff
    style SA_Op fill:#4a90e2,color:#fff
    style SA_CtrlMgr fill:#4a90e2,color:#fff
    style CR_Mgr fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_MgrCluster fill:#f5a623,color:#fff
    style CR_Viewer fill:#f5a623,color:#fff
    style CR_Editor fill:#f5a623,color:#fff
    style R_Leader fill:#f5a623,color:#fff
    style OGXServers fill:#7ed321,color:#fff
    style OGXServersFin fill:#7ed321,color:#fff
    style OGXServersStatus fill:#7ed321,color:#fff
    style OGXs fill:#7ed321,color:#fff
    style OGXsFin fill:#7ed321,color:#fff
    style OGXsStatus fill:#7ed321,color:#fff
