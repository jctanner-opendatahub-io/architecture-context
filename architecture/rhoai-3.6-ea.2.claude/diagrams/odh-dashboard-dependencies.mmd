graph LR
    ODHDashboard["ODH Dashboard<br/>(Web Console)"]

    %% Internal RHOAI Platform Dependencies (CRD Watch/CRUD)
    ODHDashboard -->|"CRD Watch<br/>InferenceService"| KServe["KServe"]
    ODHDashboard -->|"CRD Watch<br/>TrustyAI CRs"| TrustyAI["TrustyAI"]
    ODHDashboard -->|"CRD CRUD<br/>ModelRegistry"| ModelRegistry["Model Registry"]
    ODHDashboard -->|"CRD Watch<br/>FeatureStore"| Feast["Feast"]
    ODHDashboard -->|"CRD Watch<br/>MLflow CRs"| MLflow["MLflow"]
    ODHDashboard -->|"CRD CRUD<br/>Notebooks"| Notebooks["Kubeflow Notebooks"]
    ODHDashboard -->|"CRD Watch<br/>DSCluster, DSCInit"| RHOAIOperator["RHOAI Operator"]
    ODHDashboard -->|"REST Proxy<br/>8443"| DSPipelines["DataScience Pipelines"]
    ODHDashboard -->|"CRD CRUD<br/>prometheus-operator"| PromOperator["prometheus-operator"]
    ODHDashboard -->|"CRD Watch<br/>EvalHub"| EvalHub["TrustyAI EvalHub"]

    %% External Infrastructure Dependencies
    ODHDashboard -->|"API client<br/>6443"| K8sAPI["Kubernetes API<br/>v0.36.2"]
    ODHDashboard -->|"HTTPRoute CRUD"| GatewayAPI["Gateway API<br/>v1.4.1"]
    ODHDashboard -->|"TLS certs"| CertManager["cert-manager"]
    ODHDashboard -->|"VirtualService"| Istio["Istio<br/>v1.22.8"]
    ODHDashboard -->|"HTTPS/9092"| Prometheus["Prometheus/Thanos"]

    %% External AI Service Dependencies
    ODHDashboard -->|"gRPC-web<br/>8443"| MLMD["ML Metadata"]
    ODHDashboard -->|"HTTPS REST"| LlamaStack["Llama Stack"]
    ODHDashboard -->|"HTTPS REST"| NeMo["NeMo Guardrails"]
    ODHDashboard -->|"HTTPS REST"| MaaS["MaaS Provider"]
    ODHDashboard -->|"HTTPS REST"| MLflowTracking["MLflow Tracking Server"]

    %% Runtime Framework Dependencies
    ODHDashboard -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    ODHDashboard -->|"HTTP framework"| Fastify["Fastify<br/>v4.29.1"]
    ODHDashboard -->|"UI library"| PatternFly["PatternFly<br/>v6.5.x"]
    ODHDashboard -->|"micro-frontend"| WebpackMF["Webpack Module<br/>Federation 5.x"]
    ODHDashboard -->|"monorepo build"| Turborepo["Turborepo<br/>v2.9.16"]

    %% Go Library Dependencies
    ODHDashboard -->|"Go library"| ODHPlatformUtils["odh-platform-utilities"]
    ODHDashboard -->|"Go library"| MLflowGo["mlflow-go"]
    ODHDashboard -->|"Go dependency"| KServeLib["kserve<br/>v0.16.1"]

    %% Components that depend ON the dashboard
    RHOAIOperator -->|"creates Dashboard CR"| ODHDashboard

