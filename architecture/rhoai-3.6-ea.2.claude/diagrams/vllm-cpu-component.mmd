graph TB
    subgraph "vllm-cpu Application Service"
        direction TB

        subgraph "HTTP Server (FastAPI)"
            APIServer["OpenAI API Server<br/>vllm.entrypoints.openai.api_server"]
            AuthMW["AuthenticationMiddleware<br/>Bearer Token (conditional)<br/>SHA-256 constant-time comparison"]

            subgraph "API Routers"
                ChatRouter["/v1/chat/completions<br/>Chat Completions"]
                CompletionsRouter["/v1/completions<br/>Text Completions"]
                EmbeddingsRouter["/v1/embeddings<br/>Embeddings"]
                RerankRouter["/v1/rerank, /v2/rerank<br/>Reranking"]
                AudioRouter["/v1/audio/transcriptions<br/>Audio Transcription"]
                AnthropicRouter["/v1/messages<br/>Anthropic Messages"]
                ResponsesRouter["/v1/responses<br/>Responses API"]
                SageMakerRouter["/invocations, /ping<br/>SageMaker Compat"]
                PoolingRouter["/pooling, /score, /classify<br/>Pooling & Scoring"]
            end

            subgraph "Operational Endpoints"
                HealthEndpoint["/health, /ready, /readyz<br/>Health & Readiness<br/>(No Auth)"]
                LoadEndpoint["/load<br/>Load Status<br/>(No Auth)"]
                DocsEndpoint["/docs<br/>API Documentation<br/>(No Auth)"]
                VersionEndpoint["/version<br/>Version Info"]
            end
        end

        subgraph "gRPC Server (Optional)"
            GRPCServer["gRPC Server<br/>vllm.entrypoints.grpc_server<br/>Port 50051"]
            VllmEngine["VllmEngine Service<br/>smg-grpc-servicer"]
            HealthService["grpc.health.v1.Health<br/>K8s Probes"]
            GRPCServer --> VllmEngine
            GRPCServer --> HealthService
        end

        subgraph "Core Engine"
            AsyncLLM["AsyncLLM Engine<br/>Model Inference"]
        end

        APIServer --> AuthMW
        AuthMW -->|"/v1, /v2, /inference paths"| ChatRouter
        AuthMW -->|"/v1, /v2, /inference paths"| CompletionsRouter
        AuthMW -->|"/v1, /v2, /inference paths"| EmbeddingsRouter
        AuthMW -->|"/v1, /v2, /inference paths"| RerankRouter
        AuthMW -->|"/v1, /v2, /inference paths"| AudioRouter
        AuthMW -->|"/v1, /v2, /inference paths"| AnthropicRouter
        AuthMW -->|"/v1, /v2, /inference paths"| ResponsesRouter
        APIServer -->|"bypass auth"| HealthEndpoint
        APIServer -->|"bypass auth"| LoadEndpoint
        APIServer -->|"bypass auth"| DocsEndpoint

        ChatRouter --> AsyncLLM
        CompletionsRouter --> AsyncLLM
        EmbeddingsRouter --> AsyncLLM
        RerankRouter --> AsyncLLM
        AudioRouter --> AsyncLLM
        AnthropicRouter --> AsyncLLM
        ResponsesRouter --> AsyncLLM
        PoolingRouter --> AsyncLLM
        SageMakerRouter --> AsyncLLM
        VllmEngine --> AsyncLLM
    end

    Client[External Client] -->|"HTTP/HTTPS"| APIServer
    Client -->|"gRPC/50051"| GRPCServer
    K8s[Kubernetes] -->|"Health Probes"| HealthEndpoint
    K8s -->|"gRPC Health Check"| HealthService

    style APIServer fill:#4a90e2,stroke:#333
    style AuthMW fill:#e74c3c,stroke:#333,color:#fff
    style AsyncLLM fill:#9b59b6,stroke:#333,color:#fff
    style GRPCServer fill:#4a90e2,stroke:#333
    style VllmEngine fill:#4a90e2,stroke:#333
    style HealthService fill:#2ecc71,stroke:#333
    style HealthEndpoint fill:#2ecc71,stroke:#333
    style Client fill:#f5a623,stroke:#333
    style K8s fill:#e8e8e8,stroke:#333
