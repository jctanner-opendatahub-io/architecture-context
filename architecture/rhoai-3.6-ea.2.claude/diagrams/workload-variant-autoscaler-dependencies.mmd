graph LR
    WVA["Workload Variant<br/>Autoscaler"]

    %% External Dependencies (infrastructure)
    WVA -->|"metrics queries<br/>TLS 1.2+ / Bearer"| Prometheus["Prometheus<br/>(metrics source)"]
    WVA -->|"resource CRUD<br/>6443/HTTPS"| K8sAPI["Kubernetes API<br/>v1.34+"]
    WVA -->|"operator framework"| ControllerRuntime["controller-runtime<br/>v0.22.5"]
    WVA -->|"predictive scaling"| KalmanFilter["llm-inferno/kalman-filter<br/>v0.1.2"]
    WVA -->|"mathematical ops"| Gonum["gonum<br/>v0.17.0"]

    %% Internal RHOAI Dependencies
    WVA -->|"InferencePool CRs<br/>watch"| GatewayAPIInference["Gateway API<br/>Inference Extension<br/>v1.2.1"]
    WVA -->|"ServiceMonitor CRDs"| PromOperator["prometheus-operator<br/>v0.89.0"]
    WVA -->|"ScaledObject CRs<br/>conditional watch"| KEDA["KEDA<br/>v2.18.3"]
    WVA -->|"LeaderWorkerSet<br/>scale"| LWS["sigs.k8s.io/lws<br/>v0.8.0"]

    %% Observability Dependencies
    WVA -->|"metrics export"| PromClient["prometheus/client_golang<br/>v1.23.2"]
    WVA -->|"structured logging"| Zap["go.uber.org/zap<br/>v1.27.1"]

    %% Configuration
    WVA -->|"runtime config"| Viper["spf13/viper<br/>v1.21.0"]

    %% Scaling Targets (downstream)
    Deployments["Deployments<br/>(apps/v1)"] -.->|"scaled by"| WVA
    LeaderWorkerSets["LeaderWorkerSets"] -.->|"scaled by"| WVA
    HPAs["HPAs<br/>(autoscaling/v2)"] -.->|"watched by"| WVA

    %% Build Dependencies
    WVA -->|"Go 1.26<br/>FIPS: strictfipsruntime"| GoRuntime["Go Runtime<br/>+ CGO + OpenSSL"]
    WVA -->|"base image"| UBI["ubi9/ubi-minimal-pqc<br/>(post-quantum crypto)"]

