graph TB
    subgraph TrainingHub["Training Hub Library"]
        direction TB

        subgraph Registry["AlgorithmRegistry"]
            AR[AlgorithmRegistry<br/>Factory-based construction]
        end

        subgraph Algorithms["Algorithms"]
            SFT[SFT Algorithm]
            OSFT[OSFT Algorithm]
            LoRA[LoRA SFT Algorithm]
            GRPO[LoRA GRPO Algorithm]
            GEPA[GEPA Algorithm]
        end

        subgraph Backends["Backends"]
            SFTBackend[InstructLab Training Backend<br/>torchrun distributed training]
            OSFTBackend[Mini-Trainer Backend<br/>optimized SFT]
            LoRABackend[Unsloth Backend<br/>parameter-efficient LoRA]
            GRPOBackend[ART/OpenPipe Backend<br/>co-located vLLM + Unsloth]
            VeRLBackend[VeRL Backend<br/>distributed GRPO]
            GEPAStandalone[GEPA Standalone Backend<br/>evolutionary prompt optimization]
            GEPAMLflow[GEPA MLflow Backend<br/>MLflow-integrated optimization]
        end

        subgraph Utilities["Utilities"]
            Callback[TrainingHubCallback<br/>Unified callback abstraction]
            MemEst[Memory Estimator<br/>GPU memory estimation]
            ITSInteg[ITS Hub Integration<br/>Inference-time scaling]
        end

        AR -->|creates| SFT
        AR -->|creates| OSFT
        AR -->|creates| LoRA
        AR -->|creates| GRPO
        AR -->|creates| GEPA

        SFT -->|delegates to| SFTBackend
        OSFT -->|delegates to| OSFTBackend
        LoRA -->|delegates to| LoRABackend
        GRPO -->|delegates to| GRPOBackend
        GRPO -->|delegates to| VeRLBackend
        GEPA -->|delegates to| GEPAStandalone
        GEPA -->|delegates to| GEPAMLflow

        Callback -.->|receives state from| SFTBackend
        Callback -.->|receives state from| OSFTBackend
        Callback -.->|receives state from| LoRABackend
        Callback -.->|receives state from| GRPOBackend
    end

    User[User / Notebook] -->|invokes algorithm| AR

    GRPOBackend -->|co-located inference| vLLM[vLLM Engine<br/>GPU time-sharing]
    GEPAStandalone -->|inference via LiteLLM| OpenAIAPI[OpenAI-compatible API]
    GEPAMLflow -->|inference via LiteLLM| OpenAIAPI
    GEPAMLflow -->|prompt registry & tracking| MLflow[MLflow Tracking Server]
    ITSInteg -->|scaling algorithms| ITSHub[ITS Hub Library]

