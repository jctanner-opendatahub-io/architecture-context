graph TB
    subgraph Operator["LMES Operator (trustyai-service-operator)"]
        OpController[LMES Controller]
    end

    subgraph Job["lm-evaluation-harness Job Pod"]
        direction TB
        Entrypoint["/opt/app-root/bin/python<br/>Container Entrypoint"]
        CLI["lm-eval CLI<br/>lm_eval.__main__:cli_evaluate"]
        Entrypoint --> CLI

        subgraph ModelBackends["Model Backends"]
            direction LR
            HFLocal["HuggingFace Local<br/>(Transformers)"]
            OpenAIBackend["OpenAI-Compatible<br/>API Client"]
            AnthropicBackend["Anthropic<br/>API Client"]
            WatsonXBackend["IBM WatsonX<br/>API Client"]
            VLLMBackend["vLLM<br/>API Client"]
        end

        subgraph TaskFramework["Task Framework"]
            direction LR
            Unitxt["Unitxt Framework<br/>Task Definitions"]
            Datasets["HuggingFace Datasets<br/>Benchmark Data"]
            EvalHub["eval-hub-sdk ~1.0.0<br/>RHOAI Eval Hub"]
        end

        subgraph Output["Output"]
            Results["Evaluation Results<br/>Scores & Metrics"]
        end

        CLI --> ModelBackends
        CLI --> TaskFramework
        CLI --> Output
    end

    OpController -->|"creates K8s Job<br/>injects env vars & volumes"| Entrypoint

    %% External services
    OpenAIBackend -->|HTTPS| OpenAIAPI["OpenAI-Compatible API"]
    AnthropicBackend -->|HTTPS| AnthropicAPI["Anthropic API"]
    WatsonXBackend -->|HTTPS| WatsonXAPI["IBM WatsonX API"]
    VLLMBackend -->|HTTPS| VLLMService["vLLM Serving Endpoint"]
    Datasets -->|HTTPS/443| HFHub["HuggingFace Hub<br/>datasets-server.huggingface.co"]
    HFLocal -->|"loads model weights"| ModelStorage["Model Storage<br/>(PVC / S3)"]
    Results -->|"writes to"| OutputPath["Output Path<br/>(PVC / Local Volume)"]

    %% S3 integration
    CLI -->|"boto3 HTTPS"| S3["S3-Compatible Storage<br/>(AWS / IBM COS)"]

    %% Styling
    style OpController fill:#4a90e2,stroke:#333
    style CLI fill:#4a90e2,stroke:#333
    style Entrypoint fill:#4a90e2,stroke:#333
    style HFLocal fill:#7ed321,stroke:#333
    style OpenAIBackend fill:#7ed321,stroke:#333
    style AnthropicBackend fill:#7ed321,stroke:#333
    style WatsonXBackend fill:#7ed321,stroke:#333
    style VLLMBackend fill:#7ed321,stroke:#333
    style Unitxt fill:#9b59b6,stroke:#333
    style Datasets fill:#9b59b6,stroke:#333
    style EvalHub fill:#9b59b6,stroke:#333
    style Results fill:#f5a623,stroke:#333
    style OpenAIAPI fill:#e8e8e8,stroke:#333
    style AnthropicAPI fill:#e8e8e8,stroke:#333
    style WatsonXAPI fill:#e8e8e8,stroke:#333
    style VLLMService fill:#e8e8e8,stroke:#333
    style HFHub fill:#e8e8e8,stroke:#333
    style S3 fill:#e8e8e8,stroke:#333
    style ModelStorage fill:#e8e8e8,stroke:#333
    style OutputPath fill:#e8e8e8,stroke:#333
