sequenceDiagram
    participant User as User / Notebook
    participant Registry as AlgorithmRegistry
    participant Algo as Algorithm
    participant Backend as Backend
    participant Callback as TrainingHubCallback

    rect rgb(230, 245, 255)
        Note over User,Callback: SFT / OSFT Training Flow
        User->>Registry: sft(config) or osft(config)
        Registry->>Algo: Create SFT/OSFT Algorithm
        Algo->>Backend: Dispatch to InstructLab/Mini-Trainer
        Backend->>Backend: Launch torchrun subprocess<br/>(distributed training)
        loop Training Steps
            Backend->>Callback: on_step(step, epoch, loss, metrics)
        end
        Backend-->>Algo: Training complete
        Algo-->>User: Trained model artifacts
    end

    rect rgb(255, 243, 224)
        Note over User,Callback: LoRA GRPO Training Flow
        User->>Registry: lora_grpo(config)
        Registry->>Algo: Create LoRA GRPO Algorithm
        Algo->>Backend: Dispatch to ART/OpenPipe Backend

        participant vLLM as vLLM Engine<br/>(co-located GPU)
        participant ITS as ITS Hub

        Backend->>vLLM: Start AsyncLLM engine<br/>(GPU time-sharing)
        loop Training Iterations
            Backend->>vLLM: Generate rollouts<br/>(in-process)
            vLLM-->>Backend: Rollout completions
            opt Multi-turn agentic rollouts
                Backend->>ITS: Inference-time scaling<br/>(BestOfN, SelfConsistency)
                ITS->>vLLM: Concurrent LLM calls<br/>(1000s per iteration)
                vLLM-->>ITS: Scaled responses
                ITS-->>Backend: Aggregated results
            end
            Backend->>Backend: Unsloth LoRA update<br/>(GRPO reward optimization)
            Backend->>Callback: on_step(step, epoch, loss, metrics)
        end
        Backend->>vLLM: Shutdown AsyncLLM +<br/>EngineCore subprocess
        Backend-->>Algo: Training complete
        Algo-->>User: LoRA adapter weights
    end

    rect rgb(232, 245, 233)
        Note over User,Callback: GEPA Prompt Optimization Flow
        User->>Registry: gepa(config)
        Registry->>Algo: Create GEPA Algorithm

        participant LiteLLM as LiteLLM →<br/>OpenAI-compatible API
        participant MLflowSvr as MLflow Server

        alt Standalone Backend
            Algo->>Backend: Dispatch to GEPA Standalone
            Backend->>Backend: Set OPENAI_API_BASE,<br/>OPENAI_API_KEY env vars
            loop Evolutionary Search Iterations
                Backend->>LiteLLM: Inference requests<br/>(prompt candidates)
                LiteLLM-->>Backend: Completions
                Backend->>Backend: Pareto-based selection<br/>(no weight updates)
            end
            Backend->>Backend: Restore env vars
        else MLflow Backend
            Algo->>Backend: Dispatch to GEPA MLflow
            Backend->>MLflowSvr: Read prompt templates<br/>from prompt registry
            MLflowSvr-->>Backend: Prompt templates
            Backend->>Backend: Set OPENAI_API_BASE,<br/>OPENAI_API_KEY env vars
            loop Evolutionary Search Iterations
                Backend->>LiteLLM: Inference requests<br/>(prompt candidates)
                LiteLLM-->>Backend: Completions
                Backend->>Backend: Pareto-based selection
                Backend->>MLflowSvr: Log metrics &<br/>optimization results
            end
            Backend->>Backend: Restore env vars
        end
        Backend-->>Algo: Optimized prompt
        Algo-->>User: Optimized prompt text
    end
