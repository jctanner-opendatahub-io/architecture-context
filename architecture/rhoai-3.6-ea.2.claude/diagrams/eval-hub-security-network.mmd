graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Application["APPLICATION LAYER"]
        direction TB

        subgraph APIServer["eval-hub API Server"]
            API["REST API :8080<br/>TLS 1.2-1.3 (when enabled)<br/>FIPS: strictfipsruntime"]
            IdentityGate["Identity Middleware<br/>X-User + X-Tenant<br/>(conditional enforcement)"]
        end

        Metrics["Metrics Server<br/>/metrics<br/>Prometheus scrape"]
        MCP["evalhub-mcp<br/>MCP endpoint + /health"]
    end

    subgraph K8sCluster["KUBERNETES CLUSTER"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>:6443 HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount auth"]

        subgraph EvalPod["Evaluation Job Pod (batch/v1)"]
            InitContainer["eval-runtime-init<br/>S3 data download"]
            SidecarContainer["eval-runtime-sidecar<br/>Evaluation lifecycle"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        direction TB
        PostgreSQL["PostgreSQL<br/>TCP (pgx)<br/>OTel instrumented"]
        SQLite["SQLite<br/>Local file<br/>(alternative backend)"]
        S3["S3-compatible Storage<br/>HTTP/HTTPS<br/>AWS SDK v2 auth"]
        MLflow["MLflow Tracking Server<br/>HTTP/HTTPS<br/>Optional TLS + token"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC"]
    end

    %% Client to API
    Client -->|"HTTP/HTTPS :8080<br/>TLS 1.2-1.3<br/>X-User + X-Tenant"| API
    API --> IdentityGate

    %% API to Kubernetes
    API -->|"HTTPS/WSS :6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    K8sAPI -->|"Creates Jobs,<br/>ConfigMaps, Secrets"| EvalPod

    %% Init container to S3
    InitContainer -->|"HTTP/HTTPS<br/>AWS SDK v2<br/>credentials"| S3

    %% Sidecar to MLflow
    SidecarContainer -->|"HTTP/HTTPS<br/>TLS + token auth"| MLflow

    %% API to storage
    API -->|"TCP (pgx)<br/>Connection credentials"| PostgreSQL
    API -->|"Local file"| SQLite

    %% Observability
    API -->|"OTLP/gRPC<br/>Traces, metrics, logs"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef fips fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class API,IdentityGate,Metrics,MCP application
    class K8sAPI,InitContainer,SidecarContainer k8s
    class PostgreSQL,SQLite,S3,MLflow,OTel externalservice
