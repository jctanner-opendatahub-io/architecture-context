graph TB
    subgraph Manager["mlflow-operator Manager Process"]
        direction TB

        subgraph Controllers["Controllers"]
            MLflowCtrl["MLflowReconciler<br/>(Primary Controller)"]
            MLflowOpCtrl["MLflowOperatorReconciler<br/>(Platform Component Controller)"]
            NSRBACCtrl["NamespaceRBACReconciler<br/>(RBAC Propagation Controller)"]
        end

        subgraph HelmEngine["Helm Chart Rendering"]
            Charts["Embedded charts/mlflow"]
        end

        subgraph Probes["Health & Metrics"]
            Health[":8081/healthz"]
            Ready[":8081/readyz"]
            Metrics[":8443/metrics<br/>TLS + TokenReview/SAR"]
        end
    end

    %% CRDs watched
    MLflowCR["MLflow CR<br/>(mlflow.opendatahub.io/v1)<br/>Cluster-scoped"]
    MLflowOpCR["MLflowOperator CR<br/>(components.platform.opendatahub.io/v1alpha1)<br/>Cluster-scoped"]
    MLflowConfigCR["MLflowConfig CR<br/>(mlflow.kubeflow.org/v1)<br/>Namespaced"]
    AuthCR["Auth CR<br/>(services.platform.opendatahub.io/v1alpha1)"]

    %% Owned resources
    subgraph OwnedResources["Owned Resources (via Helm)"]
        Deploy["Deployments"]
        Svc["Services"]
        SA["ServiceAccounts"]
        PVC["PersistentVolumeClaims"]
        Secrets["Secrets"]
        CronJob["CronJobs / Jobs"]
        NetPol["NetworkPolicies"]
    end

    %% Conditional integrations
    subgraph ConditionalAPIs["Conditional Integrations (Discovery-Gated)"]
        HTTPRoute["HTTPRoute<br/>(Gateway API)"]
        ConsoleLink["ConsoleLink<br/>(OpenShift Console)"]
        ServiceMonitor["ServiceMonitor<br/>(prometheus-operator)"]
    end

    %% RBAC propagation
    subgraph RBACPropagation["Workspace RBAC"]
        ViewRB["mlflow-view<br/>RoleBinding"]
        EditRB["mlflow-edit<br/>RoleBinding"]
    end

    Namespaces["Workspace Namespaces<br/>(labeled)"]

    %% Controller → CR watches
    MLflowCR -->|watched by| MLflowCtrl
    MLflowOpCR -->|watched by| MLflowOpCtrl
    MLflowConfigCR -->|watched by| MLflowCtrl
    MLflowCR -->|cross-watched| MLflowOpCtrl
    MLflowOpCR -->|cross-watched| MLflowCtrl
    MLflowCR -->|watched by| NSRBACCtrl
    AuthCR -->|watched by| NSRBACCtrl
    Namespaces -->|watched by| NSRBACCtrl

    %% Controller → owned resources
    MLflowCtrl -->|renders via| Charts
    Charts -->|creates| OwnedResources

    %% Conditional integrations
    MLflowCtrl -->|creates if available| HTTPRoute
    MLflowCtrl -->|creates if available| ConsoleLink
    MLflowCtrl -->|creates if available| ServiceMonitor

    %% Platform lifecycle bridge
    MLflowOpCtrl -->|bridges lifecycle to| MLflowCtrl

    %% RBAC propagation
    NSRBACCtrl -->|propagates| ViewRB
    NSRBACCtrl -->|propagates| EditRB
    ViewRB -->|in| Namespaces
    EditRB -->|in| Namespaces

    %% Styling
    style MLflowCtrl fill:#4a90e2,stroke:#333,color:#fff
    style MLflowOpCtrl fill:#4a90e2,stroke:#333,color:#fff
    style NSRBACCtrl fill:#4a90e2,stroke:#333,color:#fff
    style Charts fill:#f5a623,stroke:#333,color:#fff
    style MLflowCR fill:#f5a623,stroke:#333
    style MLflowOpCR fill:#f5a623,stroke:#333
    style MLflowConfigCR fill:#f5a623,stroke:#333
    style AuthCR fill:#f5a623,stroke:#333
    style HTTPRoute fill:#7ed321,stroke:#333
    style ConsoleLink fill:#7ed321,stroke:#333
    style ServiceMonitor fill:#7ed321,stroke:#333
    style Health fill:#50e3c2,stroke:#333
    style Ready fill:#50e3c2,stroke:#333
    style Metrics fill:#50e3c2,stroke:#333
