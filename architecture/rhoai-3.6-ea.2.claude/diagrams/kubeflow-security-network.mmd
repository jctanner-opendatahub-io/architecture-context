graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / kubectl"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount / x509"]
    end

    subgraph ControllerNS["CONTROLLER NAMESPACE (Trusted)"]
        direction TB

        subgraph UpstreamCtrl["Notebook Controller"]
            NbCtrl["Notebook Controller<br/>SA: notebook-controller-service-account<br/>Image: notebook-controller<br/>FIPS: strictfipsruntime"]
            HealthProbe[":8081/healthz :8081/readyz<br/>HTTP, unauthenticated"]
        end

        subgraph DownstreamCtrl["ODH Notebook Controller"]
            ODHCtrl["ODH Notebook Controller<br/>SA: manager<br/>FIPS: strictfipsruntime"]
            Webhooks["Webhook Server<br/>8443/TCP TLS<br/>OpenShift APIServer TLS profile<br/>Certs: /tmp/k8s-webhook-server/serving-certs"]
        end

        SVC["notebook-controller-service<br/>ClusterIP 443/TCP<br/>Internal only"]
    end

    subgraph UserNS["USER NAMESPACE (Tenant-scoped)"]
        direction TB
        NotebookPod["Notebook StatefulSet Pod"]
        KRBACProxy["kube-rbac-proxy sidecar<br/>TokenReview + SubjectAccessReview"]
        NetPol["NetworkPolicy<br/>Per-notebook isolation"]
        PipelineSecret["ds-pipeline-config Secret<br/>/opt/app-root/runtimes"]
    end

    subgraph IngressNS["OPENSHIFT INGRESS (openshift-ingress)"]
        Gateway["data-science-gateway<br/>Gateway<br/>HTTPS TLS 1.2+"]
        HTTPRoutes["HTTPRoutes + ReferenceGrants"]
    end

    subgraph PlatformSvc["INTERNAL PLATFORM SERVICES"]
        DSPA["DataSciencePipelinesApplication<br/>read-only"]
        APIServer["OpenShift APIServer<br/>TLS profile config"]
        Proxy["OpenShift Proxy<br/>Corporate proxy env vars"]
        ImageStreams["OpenShift Image Streams<br/>read-only"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI
    K8sAPI -->|"Admission webhooks<br/>HTTPS/8443<br/>TLS (platform profile)<br/>K8s admission auth"| Webhooks
    K8sAPI -->|"Watch events<br/>HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| NbCtrl
    K8sAPI -->|"Watch events<br/>HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| ODHCtrl

    ODHCtrl -->|"Creates"| NetPol
    ODHCtrl -->|"Creates"| HTTPRoutes
    ODHCtrl -->|"Creates"| PipelineSecret
    Webhooks -->|"Injects"| KRBACProxy

    NbCtrl -->|"Creates/Updates"| NotebookPod

    ODHCtrl -->|"Reads<br/>get, list, watch"| DSPA
    ODHCtrl -->|"Reads<br/>get, list, watch"| APIServer
    ODHCtrl -->|"Reads<br/>list"| Proxy
    ODHCtrl -->|"Reads<br/>get, list"| ImageStreams

    HTTPRoutes -->|"Routes to"| Gateway

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8sapi fill:#dce8f5,stroke:#4a7ab5,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef webhook fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef userspace fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef ingress fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class K8sAPI k8sapi
    class NbCtrl,ODHCtrl,HealthProbe,SVC controller
    class Webhooks webhook
    class NotebookPod,KRBACProxy,NetPol,PipelineSecret userspace
    class Gateway,HTTPRoutes ingress
    class DSPA,APIServer,Proxy,ImageStreams platform
