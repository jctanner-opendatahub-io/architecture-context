graph TD
    subgraph "OGX Application-Level Access Control"
        direction TB

        subgraph "Authentication Layer"
            OAuth2["OAuth2 JWT Validator<br/>(enabled when AUTH_ISSUER set)"]
            JWKS["JWKS Endpoint<br/>(fetched from AUTH_ISSUER)"]
            OAuth2 -->|"fetches keys"| JWKS
        end

        subgraph "Access Policy (3 Rules)"
            Rule1["Rule 1: Public Read<br/>Unauthenticated access<br/>to system resources"]
            Rule2["Rule 2: Authenticated Create<br/>Valid JWT required<br/>to create resources"]
            Rule3["Rule 3: Owner-Scoped CRUD<br/>User must own resource<br/>for update/delete"]
        end

        subgraph "Protected API Endpoints"
            Health["/v1/health<br/>No auth required"]
            Models["/v1/models<br/>OAuth2 (when configured)"]
            Chat["/v1/chat/completions<br/>OAuth2 (when configured)"]
            Responses["/v1/responses<br/>OAuth2 (when configured)"]
            Messages["/v1/messages<br/>OAuth2 (when configured)"]
            Metrics["/metrics<br/>No auth required"]
        end

        OAuth2 -->|"evaluates"| Rule1
        OAuth2 -->|"evaluates"| Rule2
        OAuth2 -->|"evaluates"| Rule3

        Rule1 -->|"allows unauthenticated"| Health
        Rule1 -->|"allows unauthenticated"| Metrics
        Rule2 -->|"requires JWT"| Models
        Rule2 -->|"requires JWT"| Chat
        Rule2 -->|"requires JWT"| Responses
        Rule2 -->|"requires JWT"| Messages
        Rule3 -->|"owner check"| Chat
        Rule3 -->|"owner check"| Responses
        Rule3 -->|"owner check"| Messages
    end

    subgraph "Kubernetes-Level RBAC"
        Note["No ClusterRoles or RoleBindings<br/>defined in this component.<br/>RBAC managed by ogx-operator."]
    end

    subgraph "Secret Management"
        SecretPattern["_FILE Secret Resolution Pattern<br/>(entrypoint.sh)"]
        PGSecret["POSTGRES_PASSWORD_FILE<br/>&rarr; POSTGRES_PASSWORD"]
        MilvusSecret["MILVUS_TOKEN_FILE<br/>&rarr; MILVUS_TOKEN"]
        AuthSecret["AUTH_ISSUER<br/>AUTH_TLS_CAFILE"]

        SecretPattern -->|"reads K8s mount"| PGSecret
        SecretPattern -->|"reads K8s mount"| MilvusSecret
        SecretPattern -->|"env var"| AuthSecret
    end

    style OAuth2 fill:#f5a623,stroke:#333
    style JWKS fill:#f5a623,stroke:#333
    style Rule1 fill:#7ed321,stroke:#333
    style Rule2 fill:#4a90e2,stroke:#333,color:#fff
    style Rule3 fill:#e74c3c,stroke:#333,color:#fff
    style Health fill:#d5e8d4,stroke:#333
    style Metrics fill:#d5e8d4,stroke:#333
    style Models fill:#dae8fc,stroke:#333
    style Chat fill:#dae8fc,stroke:#333
    style Responses fill:#dae8fc,stroke:#333
    style Messages fill:#dae8fc,stroke:#333
    style Note fill:#f9f9f9,stroke:#999
    style SecretPattern fill:#fff2cc,stroke:#d6b656
    style PGSecret fill:#fff2cc,stroke:#d6b656
    style MilvusSecret fill:#fff2cc,stroke:#d6b656
    style AuthSecret fill:#fff2cc,stroke:#d6b656
