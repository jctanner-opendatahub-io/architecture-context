graph LR
    RhodsOp["rhods-operator<br/>RHOAI Lifecycle Operator"]

    %% External Infrastructure Dependencies
    RhodsOp -->|"resource CRUD<br/>6443/HTTPS"| K8sAPI["Kubernetes API<br/>v0.36.3"]
    RhodsOp -->|"EnvoyFilters<br/>DestinationRules"| Istio["Istio Service Mesh"]
    RhodsOp -->|"Gateway, HTTPRoute<br/>resources"| GatewayAPI["Gateway API<br/>v1.3.0"]
    RhodsOp -->|"webhook + metrics<br/>TLS certs"| ServiceCA["OpenShift service-ca"]
    RhodsOp -->|"TLS security<br/>profile"| OSAPIServer["OpenShift APIServer"]
    RhodsOp -->|"PodMonitors<br/>PrometheusRules"| PromOp["prometheus-operator<br/>v0.74.0"]

    %% Framework Dependencies
    RhodsOp -->|"operator framework"| CtrlRuntime["controller-runtime<br/>v0.24.1"]
    RhodsOp -->|"manager framework"| ODHPlatform["odh-platform-utilities<br/>framework"]
    RhodsOp -->|"MaaS types"| MaaSCtrl["models-as-a-service<br/>maas-controller"]

    %% Internal RHOAI Component Dependencies (managed by operator)
    RhodsOp -->|"component lifecycle"| DSP["DataSciencePipelines"]
    RhodsOp -->|"component lifecycle"| KueueComp["Kueue"]
    RhodsOp -->|"component lifecycle"| RayComp["Ray"]
    RhodsOp -->|"component lifecycle"| TrustyAI["TrustyAI"]

    %% Internal RHOAI Integration Dependencies (watched/CRUD)
    RhodsOp -->|"CRD watch"| KServe["KServe<br/>InferenceService"]
    RhodsOp -->|"CRD CRUD"| ModelReg["Model Registry"]
    RhodsOp -->|"CRD watch"| Feast["Feast<br/>FeatureStore"]
    RhodsOp -->|"CRD CRUD"| HWProfile["HardwareProfile"]
    RhodsOp -->|"CRD CRUD"| NIMAccount["NIM Account"]

    %% Namespace watch dependencies
    RhodsOp -.->|"namespace watch<br/>(RBAC)"| MaaS["models-as-a-service"]
    RhodsOp -.->|"namespace watch<br/>(RBAC)"| Kuadrant["Kuadrant"]

    %% Integration points (other components that integrate with operator)
    Dashboard["ODH Dashboard"] -.->|"Console links<br/>Route status"| RhodsOp
    OSConsole["OpenShift Console"] -.->|"ConsoleLink CRDs"| RhodsOp

    %% Cloud providers (cloudmanager)
    RhodsOp -->|"cloud provisioning"| AWS["AWS<br/>KubernetesEngine"]
    RhodsOp -->|"cloud provisioning"| Azure["Azure<br/>KubernetesEngine"]
    RhodsOp -->|"cloud provisioning"| CoreWeave["CoreWeave<br/>KubernetesEngine"]

