graph TB
    subgraph BuildTime["CI/CD BUILD ENVIRONMENT (Build-Time Only)"]
        direction TB

        subgraph CLITools["Go CLI Tools (not shipped in production)"]
            Extractor["model-extractor<br/>Go 1.24, CGO_ENABLED=0"]
            Report["metadata-report<br/>Go 1.24, CGO_ENABLED=0"]
        end

        subgraph LocalFS["Local Filesystem"]
            DataFiles["data/<br/>YAML Catalogs & Index Files"]
        end

        Extractor -->|"write YAML"| DataFiles
        DataFiles -->|"read"| Report
    end

    subgraph ExternalAPIs["EXTERNAL SERVICES (CI/CD Only)"]
        HF["HuggingFace API<br/>huggingface.co/api<br/>443/TCP, TLS<br/>Bearer Token (optional)"]
        GH["GitHub API<br/>api.github.com<br/>443/TCP, TLS<br/>Bearer Token (optional)"]
        OCI["OCI Registries<br/>443/TCP, TLS<br/>Credential Chain"]
    end

    subgraph Runtime["PRODUCTION RUNTIME"]
        direction TB

        subgraph SidecarContainer["Data Sidecar Container"]
            Sidecar["ubi-minimal-pqc<br/>UID 1001 (non-root)<br/>CMD: sleep infinity<br/>No binaries, no listeners"]
            Volume["/app/data<br/>Static YAML Data<br/>(read-only)"]
            Sidecar --- Volume
        end
    end

    subgraph Consumers["PLATFORM CONSUMERS"]
        Platform["Other RHOAI Components<br/>Volume mount consumers"]
    end

    %% CI/CD network flows
    Extractor -->|"HTTPS/443<br/>TLS<br/>Bearer HF_TOKEN"| HF
    Extractor -->|"HTTPS/443<br/>TLS<br/>Bearer GITHUB_TOKEN"| GH
    Extractor -->|"HTTPS/443<br/>TLS<br/>Registry Creds"| OCI

    %% Build to runtime
    DataFiles -.->|"Container image build<br/>COPY into /app/data"| Volume

    %% Runtime consumption
    Platform -->|"Volume Mount<br/>Filesystem access<br/>No network"| Volume

    %% Styling
    classDef buildtime fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef runtime fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef consumer fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Extractor,Report buildtime
    class HF,GH,OCI external
    class Sidecar,Volume runtime
    class Platform consumer
