graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Engineer / User<br/>kubectl / oc"]
    end

    subgraph K8sAPI["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC Enforcement"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (RBAC Enforced)"]
        direction TB

        ModuleCtrl["spark-operator-module<br/>controller-manager<br/>SA: spark-operator-module-controller-manager<br/>CR: spark-operator-module-manager-role"]

        subgraph ControllerBox["Controller Deployment"]
            Controller["spark-operator-controller<br/>SA: spark-operator-controller<br/>CR: spark-operator-controller<br/>Health: :8081 (unauth)"]
        end

        subgraph WebhookBox["Webhook Deployment"]
            WebhookSvc["spark-operator-webhook-svc<br/>ClusterIP 443/TCP"]
            Webhook["spark-operator-webhook<br/>SA: spark-operator-webhook<br/>CR: spark-operator-webhook<br/>TLS: cert-manager certs<br/>Ciphers: AEAD only<br/>Mount: /etc/k8s-webhook-server/serving-certs"]
            WebhookSvc --> Webhook
        end
    end

    subgraph UserNS["USER NAMESPACE (Workload)"]
        DriverPod["Driver Pod"]
        ExecPods["Executor Pod(s)<br/>(mutated by SparkPodDefaulter)"]
        WorkloadSvc["Service<br/>(headless)"]
        WorkloadCM["ConfigMap<br/>(monitoring)"]
    end

    subgraph PlatformSvcs["PLATFORM SERVICES"]
        CertManager["cert-manager<br/>Certificate/Issuer CRDs<br/>Provisions: spark-operator-webhook-certs"]
        PrometheusOp["prometheus-operator<br/>PodMonitor CRDs"]
        ODHOp["ODH Operator<br/>Creates SparkOperator CR"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token / x509"| APIServer

    %% API Server to Webhook (admission)
    APIServer -->|"HTTPS/443<br/>TLS (cert-manager)<br/>Admission Review<br/>failurePolicy: Fail"| WebhookSvc

    %% Controller to API
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer
    Webhook -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer
    ModuleCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| APIServer

    %% Module manages operator
    ModuleCtrl -.->|manages lifecycle| Controller
    ModuleCtrl -.->|manages lifecycle| Webhook

    %% Controller creates workloads
    Controller -.->|creates via API| DriverPod
    Controller -.->|creates via API| WorkloadSvc
    Controller -.->|creates via API| WorkloadCM

    %% Platform services
    CertManager -.->|provisions TLS certs| Webhook
    PrometheusOp -.->|scrapes metrics| Controller
    ODHOp -.->|creates SparkOperator CR| ModuleCtrl

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#e6f3ff,stroke:#4a90e2,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e8e8e8,stroke:#666,stroke-width:2px

    class User external
    class APIServer apiserver
    class ModuleCtrl,Controller,Webhook,WebhookSvc operator
    class DriverPod,ExecPods,WorkloadSvc,WorkloadCM workload
    class CertManager,PrometheusOp,ODHOp platform
