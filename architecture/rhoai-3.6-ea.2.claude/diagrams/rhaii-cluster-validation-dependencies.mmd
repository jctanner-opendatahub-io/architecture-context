graph LR
    RhaiiValidator["rhaii-cluster-validation<br/>CLI Tool"]

    %% Runtime Dependencies
    RhaiiValidator -->|"resource CRUD<br/>6443/TCP HTTPS"| KubeAPI["Kubernetes API<br/>(k8s.io/client-go v0.35.3)"]
    RhaiiValidator -->|"batch/v1 Jobs"| K8sAPI_Batch["k8s.io/api<br/>v0.35.3"]
    RhaiiValidator -->|"resource types"| K8sApimachinery["k8s.io/apimachinery<br/>v0.35.3"]

    %% Build Dependencies
    RhaiiValidator -->|"CLI framework"| Cobra["spf13/cobra<br/>v1.10.2"]
    RhaiiValidator -->|"YAML parsing"| YamlV3["gopkg.in/yaml.v3<br/>v3.0.1"]
    RhaiiValidator -->|"YAML marshaling"| SigsYaml["sigs.k8s.io/yaml<br/>v1.6.0"]

    %% Runtime
    RhaiiValidator -->|"FIPS runtime<br/>strictfipsruntime"| GoRuntime["Go 1.26<br/>CGO_ENABLED=1"]
    GoRuntime -->|"FIPS crypto"| OpenSSL["OpenSSL<br/>(UBI9 base)"]

    %% Kubernetes Resources Created
    subgraph "Kubernetes Resources Managed"
        Namespace["Namespace<br/>rhaii-validation"]
        ServiceAccount["ServiceAccount<br/>rhaii-validator"]
        ClusterRole["ClusterRole<br/>(empty rules)"]
        ClusterRoleBinding["ClusterRoleBinding<br/>(SCC: privileged)"]
        Jobs["Jobs<br/>(probe workloads)"]
        ConfigMaps["ConfigMaps<br/>(results)"]
    end

    KubeAPI -->|creates| Namespace
    KubeAPI -->|creates| ServiceAccount
    KubeAPI -->|creates| ClusterRole
    KubeAPI -->|creates| ClusterRoleBinding
    KubeAPI -->|creates| Jobs
    KubeAPI -->|creates| ConfigMaps

    %% Host Access (via Jobs)
    Jobs -->|"privileged SCC"| HostDevices["Host Devices<br/>/sys/class/*"]

    %% No internal platform dependencies
    %% Note: This is a standalone CLI tool with no ODH/RHOAI component dependencies

    style RhaiiValidator fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KubeAPI fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI_Batch fill:#999,stroke:#333,color:#fff
    style K8sApimachinery fill:#999,stroke:#333,color:#fff
    style Cobra fill:#999,stroke:#333,color:#fff
    style YamlV3 fill:#999,stroke:#333,color:#fff
    style SigsYaml fill:#999,stroke:#333,color:#fff
    style GoRuntime fill:#999,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333,color:#fff
    style HostDevices fill:#e8e8e8,stroke:#333
    style Namespace fill:#7ed321,stroke:#333
    style ServiceAccount fill:#7ed321,stroke:#333
