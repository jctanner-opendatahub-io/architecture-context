graph LR
    Notebooks["Notebooks<br/>Image Factory"]

    %% Internal RHOAI Dependencies (Required)
    Notebooks -->|"pod lifecycle,<br/>OAuth sidecar injection"| Controller["odh-notebook-controller"]
    Notebooks -->|"workbench creation UI"| Dashboard["RHOAI Dashboard"]

    %% Build System
    Notebooks -->|"image builds"| Konflux["Konflux Pipelines"]

    %% Key Runtime Libraries (bundled in images)
    subgraph BundledLibraries["Key Bundled Libraries"]
        PyTorch["PyTorch 2.11.0"]
        TensorFlow["TensorFlow 2.21.0+redhat"]
        ScikitLearn["scikit-learn 1.9.0"]
        Pandas["pandas 2.3.3"]
        NumPy["numpy 2.5.2"]
        Transformers["transformers 5.14.1"]
        MLflow["MLflow 3.15.1"]
        Boto3["boto3 1.43.72"]
        KFP["kfp 2.17.0"]
        CodeFlare["codeflare-sdk 0.38.2"]
        TrustyAI["trustyai 0.6.4"]
        LLMCompressor["llmcompressor 0.13.0"]
    end

    Notebooks -.->|"includes"| BundledLibraries

    %% External Services (accessed by user workloads)
    Notebooks -.->|"user workloads<br/>HTTPS/443"| K8sAPI["Kubernetes API"]
    Notebooks -.->|"user workloads<br/>HTTPS/443"| S3["S3-Compatible Storage"]

    %% Platform Dependencies
    Notebooks -->|"OAuth authentication"| OAuthProxy["OAuth Proxy<br/>(sidecar)"]
    Notebooks -->|"TLS ingress"| Route["OpenShift Route"]

    %% Go Build Dependencies
    subgraph GoBuildDeps["Go Build Dependencies"]
        BuildKit["moby/buildkit v0.32.0"]
        Platforms["containerd/platforms"]
        ImageSpec["opencontainers/image-spec"]
    end

    Notebooks -.->|"build-time only"| GoBuildDeps

    %% Base Image
    Notebooks -->|"base image"| UBI9["UBI9<br/>+ Python 3.12<br/>+ OpenSSL (FIPS)"]

    style Notebooks fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Controller fill:#7ed321,stroke:#333
    style Dashboard fill:#7ed321,stroke:#333
    style OAuthProxy fill:#7ed321,stroke:#333
    style Route fill:#ee0000,stroke:#333,color:#fff
    style Konflux fill:#999,stroke:#333
    style K8sAPI fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style UBI9 fill:#ee0000,stroke:#333,color:#fff
    style PyTorch fill:#ee4c2c,stroke:#333,color:#fff
    style TensorFlow fill:#ff6f00,stroke:#333,color:#fff
    style ScikitLearn fill:#f89939,stroke:#333
    style Pandas fill:#150458,stroke:#333,color:#fff
    style NumPy fill:#4dabcf,stroke:#333
    style Transformers fill:#ffd21e,stroke:#333
    style MLflow fill:#0194e2,stroke:#333,color:#fff
    style Boto3 fill:#ff9900,stroke:#333
    style KFP fill:#4285f4,stroke:#333,color:#fff
    style CodeFlare fill:#7ed321,stroke:#333
    style TrustyAI fill:#7ed321,stroke:#333
    style LLMCompressor fill:#7ed321,stroke:#333
    style BuildKit fill:#999,stroke:#333
    style Platforms fill:#999,stroke:#333
    style ImageSpec fill:#999,stroke:#333
