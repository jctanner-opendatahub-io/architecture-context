graph TB
    subgraph "eval-hub Service"
        direction TB
        APIServer["eval-hub API Server<br/>:8080 HTTP/HTTPS"]
        MetricsServer["Metrics Server<br/>Prometheus /metrics"]
        Middleware["Middleware Stack<br/>Identity | CORS | OTel"]
        APIServer --> Middleware
        APIServer --> MetricsServer
    end

    subgraph "Runtime Binaries"
        InitContainer["eval-runtime-init<br/>S3 data download"]
        Sidecar["eval-runtime-sidecar<br/>Evaluation lifecycle proxy"]
        MCPServer["evalhub-mcp<br/>MCP endpoint"]
    end

    subgraph "Storage Layer"
        StorageAbstraction["sqlStorage abstraction"]
        PostgreSQL["PostgreSQL<br/>(pgx driver)"]
        SQLite["SQLite<br/>(modernc.org/sqlite)"]
        StorageAbstraction --> PostgreSQL
        StorageAbstraction --> SQLite
    end

    subgraph "Kubernetes Integration"
        K8sHelper["KubernetesHelper"]
        TypedClient["Typed Clientset<br/>ConfigMaps, Secrets, Jobs"]
        DynamicClient["Dynamic Client<br/>HardwareProfile CRs"]
        EventRecorder["Event Recorder<br/>evalhub-server"]
        K8sHelper --> TypedClient
        K8sHelper --> DynamicClient
        K8sHelper --> EventRecorder
    end

    Client[Client] -->|"HTTP/HTTPS :8080<br/>X-User, X-Tenant"| APIServer
    APIServer --> StorageAbstraction
    APIServer --> K8sHelper

    K8sHelper -->|"creates"| EvalJob["Kubernetes Job<br/>batch/v1"]
    K8sHelper -->|"reads"| HWProfile["HardwareProfile CR<br/>infrastructure.opendatahub.io/v1"]
    InitContainer -->|"downloads"| S3["S3-compatible Storage"]
    EvalJob --> InitContainer
    EvalJob --> Sidecar

    APIServer -->|"HTTP/HTTPS"| MLflow["MLflow Tracking Server"]
    APIServer -->|"OTLP/gRPC"| OTelCollector["OpenTelemetry Collector"]

    style APIServer fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style Middleware fill:#4a90e2,color:#fff
    style InitContainer fill:#5b9bd5,color:#fff
    style Sidecar fill:#5b9bd5,color:#fff
    style MCPServer fill:#5b9bd5,color:#fff
    style StorageAbstraction fill:#7ed321,color:#fff
    style PostgreSQL fill:#336791,color:#fff
    style SQLite fill:#003b57,color:#fff
    style K8sHelper fill:#326ce5,color:#fff
    style TypedClient fill:#326ce5,color:#fff
    style DynamicClient fill:#326ce5,color:#fff
    style EventRecorder fill:#326ce5,color:#fff
    style EvalJob fill:#f5a623
    style HWProfile fill:#f5a623
    style S3 fill:#e8e8e8
    style MLflow fill:#e8e8e8
    style OTelCollector fill:#e8e8e8
    style Client fill:#f9f9f9,stroke:#999
