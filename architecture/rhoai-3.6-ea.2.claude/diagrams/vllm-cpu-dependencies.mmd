graph LR
    VllmCPU["vllm-cpu<br/>LLM Inference Engine"]

    %% Runtime Dependencies
    VllmCPU -->|"runtime"| Python["Python >=3.10,<3.15"]

    %% Optional Dependencies
    VllmCPU -.->|"optional gRPC"| SmgGrpc["smg-grpc-servicer<br/>gRPC service impl"]

    %% Build Dependencies
    VllmCPU -->|"base image"| UBI9["registry.redhat.io<br/>ubi9/ubi-minimal-pqc<br/>UBI9 + PQC"]

    %% Crypto / Security
    VllmCPU -->|"crypto (system)"| OpenSSL["System OpenSSL<br/>via UBI9 base"]
    VllmCPU -->|"GRPC_PYTHON_BUILD_<br/>SYSTEM_OPENSSL=1"| OpenSSL

    %% Framework Dependencies
    VllmCPU -->|"HTTP server"| FastAPI["FastAPI<br/>ASGI Framework"]
    VllmCPU -->|"ASGI server"| Uvicorn["Uvicorn<br/>ASGI Server"]

    %% Integration Points
    SmgGrpc -->|"provides"| GRPCProto["VllmEngine gRPC Service<br/>Port 50051"]

    %% Platform Integration
    K8s["Kubernetes"] -->|"health probes"| VllmCPU
    ServiceMesh["Service Mesh /<br/>Sidecar Proxy"] -.->|"mTLS for gRPC"| VllmCPU
    RHOAI["OpenShift AI<br/>(RHOAI)"] -->|"deploys as<br/>ServingRuntime"| VllmCPU

    %% External Services
    VllmCPU -.->|"model loading"| ModelStorage["Model Storage<br/>(S3 / Local)"]

    style VllmCPU fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Python fill:#999,stroke:#333
    style SmgGrpc fill:#d4a017,stroke:#333
    style UBI9 fill:#cc0000,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333
    style FastAPI fill:#009688,stroke:#333,color:#fff
    style Uvicorn fill:#009688,stroke:#333,color:#fff
    style GRPCProto fill:#d4a017,stroke:#333
    style K8s fill:#326ce5,stroke:#333,color:#fff
    style ServiceMesh fill:#e8e8e8,stroke:#333
    style RHOAI fill:#7ed321,stroke:#333
    style ModelStorage fill:#f5a623,stroke:#333
