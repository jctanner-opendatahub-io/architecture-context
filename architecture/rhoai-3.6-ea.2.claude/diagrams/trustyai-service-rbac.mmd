graph TD
    subgraph "Authentication Architecture"
        direction TB

        subgraph "External Access Path"
            Client["External Client<br/>(Data Scientist / ML Engineer)"]
            KRBP["kube-rbac-proxy Sidecar"]
            K8sAPI["Kubernetes API Server<br/>(TokenReview / SubjectAccessReview)"]
        end

        subgraph "TrustyAI Service Pod"
            MainAPI["Main FastAPI App<br/>127.0.0.1:8081<br/>(loopback only)"]
            HealthAPI["Health/Consumer FastAPI App<br/>0.0.0.0:8080<br/>(no auth required)"]
        end

        subgraph "Internal Consumers (Unauthenticated)"
            Kubelet["Kubelet<br/>GET /health"]
            KServe["KServe Inference Logger<br/>POST / (CloudEvent)"]
            ModelMesh["ModelMesh Agent<br/>POST /consumer/kserve/v2"]
            Prometheus["Prometheus<br/>GET /q/metrics"]
        end

        subgraph "Secrets"
            DBPass["DATABASE_PASSWORD<br/>(env var)<br/>MariaDB credentials"]
            QuarkusPass["QUARKUS_DATASOURCE_PASSWORD<br/>(env var)<br/>Legacy Quarkus-compat"]
            TLSCert["TLS Certificate<br/>/etc/tls/internal/tls.crt<br/>/etc/tls/internal/tls.key"]
            DBCACert["MariaDB CA Cert<br/>/etc/tls/db/ca.crt"]
        end
    end

    %% Authentication flow
    Client -->|"HTTPS/8443<br/>Bearer Token"| KRBP
    KRBP -->|"TokenReview<br/>SubjectAccessReview"| K8sAPI
    K8sAPI -->|"auth decision"| KRBP
    KRBP -->|"HTTP/8081<br/>pre-authenticated<br/>(loopback)"| MainAPI

    %% Unauthenticated internal access
    Kubelet -->|"HTTP/8080"| HealthAPI
    KServe -->|"HTTP/8080"| HealthAPI
    ModelMesh -->|"HTTP/8080"| HealthAPI
    Prometheus -->|"HTTP/8080"| HealthAPI

    %% Secret usage
    DBPass -.->|"runtime config"| MainAPI
    QuarkusPass -.->|"runtime config"| MainAPI
    TLSCert -.->|"HTTPS on 4443"| MainAPI
    DBCACert -.->|"MariaDB TLS"| MainAPI

    %% Styling
    style Client fill:#f9f9f9,stroke:#999
    style KRBP fill:#f5a623,stroke:#333
    style K8sAPI fill:#e74c3c,stroke:#333,color:#fff
    style MainAPI fill:#4a90e2,stroke:#333,color:#fff
    style HealthAPI fill:#4a90e2,stroke:#333,color:#fff
    style Kubelet fill:#dae8fc,stroke:#6c8ebf
    style KServe fill:#dae8fc,stroke:#6c8ebf
    style ModelMesh fill:#dae8fc,stroke:#6c8ebf
    style Prometheus fill:#dae8fc,stroke:#6c8ebf
    style DBPass fill:#f8cecc,stroke:#b85450
    style QuarkusPass fill:#f8cecc,stroke:#b85450
    style TLSCert fill:#f8cecc,stroke:#b85450
    style DBCACert fill:#f8cecc,stroke:#b85450
