graph TB
    subgraph "rhods-operator"
        direction TB
        Manager["/manager Binary<br/>Go Controller-Runtime Operator"]
        CloudManager["cloudmanager Binary<br/>Multi-Cloud K8s Engine Provisioning"]
        WebhookServer["Webhook Server<br/>Port 9443/TLS"]
        MetricsServer["Metrics Server<br/>Port 8443/TLS"]
        HealthProbes["Health Probes<br/>Port 8081"]

        Manager -->|"hosts"| WebhookServer
        Manager -->|"hosts"| MetricsServer
        Manager -->|"hosts"| HealthProbes
    end

    subgraph "Controller Categories"
        direction TB
        subgraph "Component Controllers"
            DSPCtrl["DataSciencePipelines<br/>Controller"]
            KueueCtrl["Kueue Controller"]
            RayCtrl["Ray Controller"]
            TrustyAICtrl["TrustyAI Controller"]
        end

        subgraph "Service Controllers"
            AuthCtrl["Auth Service<br/>Controller"]
            GatewayCtrl["Gateway Service<br/>Controller"]
        end

        subgraph "Module Controllers"
            ModuleCtrl["Module Controllers<br/>(DAG-based registration)"]
        end
    end

    Manager -->|"manages via DAG"| DSPCtrl
    Manager -->|"manages via DAG"| KueueCtrl
    Manager -->|"manages via DAG"| RayCtrl
    Manager -->|"manages via DAG"| TrustyAICtrl
    Manager -->|"manages via DAG"| AuthCtrl
    Manager -->|"manages via DAG"| GatewayCtrl
    Manager -->|"manages via DAG"| ModuleCtrl

    %% CRDs
    DSCCR["DataScienceCluster CR<br/>v1, v2"]
    DSCICR["DSCInitialization CR<br/>v1, v2"]
    AuthCR["Auth CR"]
    GatewayCR["GatewayConfig CR"]
    HWProfile["HardwareProfile CR"]
    FeatureTracker["FeatureTracker CR"]
    PlatformCR["Platform CR"]

    %% Cloud CRDs
    AWSCR["AWSKubernetesEngine CR"]
    AzureCR["AzureKubernetesEngine CR"]
    CoreWeaveCR["CoreWeaveKubernetesEngine CR"]

    DSCCR -->|"watched by"| Manager
    DSCICR -->|"watched by"| Manager
    AuthCR -->|"watched by"| AuthCtrl
    GatewayCR -->|"watched by"| GatewayCtrl
    AWSCR -->|"watched by"| CloudManager
    AzureCR -->|"watched by"| CloudManager
    CoreWeaveCR -->|"watched by"| CloudManager

    %% Gateway creates
    GatewayCtrl -->|"creates"| GatewayAPI["Gateway API Resources"]
    GatewayCtrl -->|"creates"| KubeAuthProxy["kube-auth-proxy<br/>Deployments"]
    GatewayCtrl -->|"creates"| HTTPRoutes["HTTPRoutes"]
    GatewayCtrl -->|"creates"| OSRoutes["OpenShift Routes"]
    GatewayCtrl -->|"creates"| EnvoyFilters["EnvoyFilters"]
    GatewayCtrl -->|"creates"| DestRules["DestinationRules"]
    GatewayCtrl -->|"creates"| NetPolicies["NetworkPolicies"]

    %% Auth creates
    AuthCtrl -->|"creates"| RBAC["ClusterRoles &<br/>RoleBindings"]

    %% Webhooks
    K8sAPI["Kubernetes API Server"] -->|"admission requests"| WebhookServer
    WebhookServer -->|"validates"| DSCCR
    WebhookServer -->|"validates"| DSCICR
    WebhookServer -->|"mutates"| DSCCR
    WebhookServer -->|"converts"| DSCCR

    %% External dependencies
    Manager -->|"depends on"| Istio["Istio Service Mesh"]
    Manager -->|"depends on"| K8sAPI
    Manager -->|"watches"| OSConfig["OpenShift APIServer<br/>TLS Profile"]

    %% Styling
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style CloudManager fill:#4a90e2,stroke:#333,color:#fff
    style WebhookServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbes fill:#4a90e2,stroke:#333,color:#fff
    style DSPCtrl fill:#7ed321,stroke:#333
    style KueueCtrl fill:#7ed321,stroke:#333
    style RayCtrl fill:#7ed321,stroke:#333
    style TrustyAICtrl fill:#7ed321,stroke:#333
    style AuthCtrl fill:#7ed321,stroke:#333
    style GatewayCtrl fill:#7ed321,stroke:#333
    style ModuleCtrl fill:#7ed321,stroke:#333
    style DSCCR fill:#f5a623,stroke:#333
    style DSCICR fill:#f5a623,stroke:#333
    style AuthCR fill:#f5a623,stroke:#333
    style GatewayCR fill:#f5a623,stroke:#333
    style HWProfile fill:#f5a623,stroke:#333
    style FeatureTracker fill:#f5a623,stroke:#333
    style PlatformCR fill:#f5a623,stroke:#333
    style AWSCR fill:#f5a623,stroke:#333
    style AzureCR fill:#f5a623,stroke:#333
    style CoreWeaveCR fill:#f5a623,stroke:#333
    style Istio fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OSConfig fill:#e8e8e8,stroke:#333
