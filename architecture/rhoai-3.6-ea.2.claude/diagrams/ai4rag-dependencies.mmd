graph LR
    ai4rag["ai4rag<br/>Python Library"]

    %% Runtime Integration Dependencies
    ai4rag -->|"document retrieval"| boto3["boto3 >=1.28<br/>(S3 client)"]
    ai4rag -->|"embeddings & chat"| openai["openai ~2.53.0<br/>(MaaS client)"]

    %% Vector Store Dependencies
    ai4rag -->|"vector storage"| pymilvus["pymilvus ~3.0.1<br/>(Milvus client)"]
    ai4rag -->|"vector storage"| pgvector["pgvector ~0.5.0"]
    ai4rag -->|"vector storage"| psycopg["psycopg >=3.1<br/>(PostgreSQL driver)"]
    ai4rag -->|"vector storage"| chromadb["chromadb >=1.5,<2"]

    %% Document Processing Dependencies
    ai4rag -->|"text extraction"| docling["docling-slim ~2.107.0"]
    ai4rag -->|"text splitting"| langchain_ts["langchain-text-splitters ~1.1.0"]
    ai4rag -->|"HTML parsing"| bs4["beautifulsoup4"]

    %% Data & ML Dependencies
    ai4rag -->|"data processing"| pandas["pandas ==2.2.*"]
    ai4rag -->|"ML utilities"| sklearn["scikit-learn ==1.8.*"]
    ai4rag -->|"data validation"| pydantic["pydantic ==2.11.*"]

    %% Evaluation Dependencies
    ai4rag -->|"RAG evaluation"| ragas["ragas >=0.3,<0.5"]
    ai4rag -->|"evaluation framework"| unitxt["unitxt ~1.26.1"]
    ai4rag -->|"optimization"| pygam["pygam ~0.12.0"]

    %% LangChain
    ai4rag -->|"community integrations"| langchain_comm["langchain-community <0.4.2"]

    %% External Services (runtime)
    boto3 -->|"HTTPS/443"| S3["S3-Compatible Storage"]
    openai -->|"HTTPS/443"| MaaS["OpenAI-Compatible<br/>MaaS Endpoint"]
    pymilvus -->|"gRPC/19530"| MilvusServer["Milvus Server"]
    psycopg -->|"TCP/5432"| PGServer["PostgreSQL Server"]
    chromadb -->|"HTTP/8000"| ChromaServer["ChromaDB Server"]

    %% Runtime
    ai4rag -->|"requires"| Python["Python >=3.12,<3.14"]

