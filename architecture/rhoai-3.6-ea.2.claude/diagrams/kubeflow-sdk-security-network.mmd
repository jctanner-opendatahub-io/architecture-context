graph TB
    subgraph ClientEnv["CLIENT ENVIRONMENT (User Workstation / Notebook Pod)"]
        App["Python Application<br/>Jupyter Notebook<br/>kubeflow-sdk"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE (Trusted)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS (platform-managed)<br/>AuthN: x509 / Bearer / OIDC<br/>AuthZ: RBAC"]
    end

    subgraph OperatorNS["KUBEFLOW OPERATOR NAMESPACE (Trusted)"]
        direction TB
        TrainerCtrl["Kubeflow Trainer Controller<br/>Watches: TrainJob CRs<br/>Creates: Training pods"]
        KatibCtrl["Katib Controller<br/>Watches: Experiment CRs<br/>Creates: Tuning pods"]
    end

    subgraph UserNS["USER NAMESPACE (Workload Execution)"]
        direction TB
        TrainingPods["Training Pods<br/>Created by Trainer Controller<br/>Env: HF_TOKEN"]
        SparkConnect["SparkConnect Resources<br/>sparkoperator.k8s.io/v1alpha1"]
    end

    %% Flows
    App -->|"HTTPS/6443<br/>TLS (platform-delegated)<br/>kube-config / SA token<br/>kubernetes Python client"| K8sAPI

    K8sAPI -->|"Watch events<br/>TrainJob CRs"| TrainerCtrl
    K8sAPI -->|"Watch events<br/>Experiment CRs"| KatibCtrl

    TrainerCtrl -->|"Creates pods<br/>in user namespace"| TrainingPods
    App -->|"Creates CR via API<br/>SparkConnect"| SparkConnect

    %% Styling
    classDef client fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class App client
    class K8sAPI controlplane
    class TrainerCtrl,KatibCtrl operator
    class TrainingPods,SparkConnect workload
