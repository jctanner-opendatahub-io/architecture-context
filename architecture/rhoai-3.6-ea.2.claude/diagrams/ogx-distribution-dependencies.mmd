graph LR
    OGX["OGX Distribution<br/>AI Agent Server"]

    %% Required Internal Dependencies
    OGX -->|"inference proxy<br/>HTTP/HTTPS"| vLLM["vLLM<br/>(Required)"]
    OGX -->|"state storage<br/>5432/TCP"| PostgreSQL["PostgreSQL<br/>(Required)"]
    OGX -.->|"lifecycle mgmt"| OGXOperator["ogx-operator<br/>(Required)"]

    %% Optional: Vector Databases
    OGX -->|"vector search<br/>HTTP/gRPC, mTLS"| Milvus["Milvus<br/>(Optional)"]
    OGX -->|"vector search<br/>5432/TCP"| PGVector["PGVector<br/>(Optional)"]
    OGX -->|"vector search<br/>6333/TCP, 6334/TCP"| Qdrant["Qdrant<br/>(Optional)"]

    %% Optional: Embedding
    OGX -->|"embeddings<br/>HTTP/HTTPS"| vLLMEmbed["vLLM Embedding<br/>(Optional)"]

    %% External Services
    OGX -->|"JWKS validation<br/>443/TCP HTTPS"| IdP["OAuth2 IdP<br/>(Optional)"]
    OGX -->|"OTLP export"| OTEL["OpenTelemetry<br/>Collector<br/>(Optional)"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrapes /metrics"| OGX

    %% Upstream / Downstream
    Upstream["opendatahub-io/<br/>ogx-distribution"] -.->|"auto_merge<br/>(upstream)"| OGX
    OGX -.->|"packaged in"| BaseImage["AIPCC Base Image<br/>+ Modelcar Artifacts"]

    style OGX fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style vLLM fill:#7ed321,stroke:#333
    style PostgreSQL fill:#7ed321,stroke:#333
    style OGXOperator fill:#7ed321,stroke:#333
    style Milvus fill:#e1d5e7,stroke:#333
    style PGVector fill:#e1d5e7,stroke:#333
    style Qdrant fill:#e1d5e7,stroke:#333
    style vLLMEmbed fill:#e1d5e7,stroke:#333
    style IdP fill:#f5a623,stroke:#333
    style OTEL fill:#f5a623,stroke:#333
    style Prometheus fill:#f8cecc,stroke:#333
    style Upstream fill:#e8e8e8,stroke:#333
    style BaseImage fill:#e8e8e8,stroke:#333
