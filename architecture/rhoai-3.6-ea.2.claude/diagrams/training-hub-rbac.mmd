graph TD
    subgraph LibraryContext["Training Hub — Library (No Own RBAC)"]
        direction TB
        Note["Training Hub is a Python library.<br/>It defines NO Kubernetes RBAC resources:<br/>• No ClusterRoles<br/>• No Roles<br/>• No RoleBindings<br/>• No ServiceAccounts<br/><br/>All RBAC is inherited from the consuming component<br/>(notebook, training job, pipeline task, etc.)"]
    end

    subgraph InheritedContext["Inherited Security Context (from consumer)"]
        direction TB

        Consumer["Consuming Component<br/>(e.g., Notebook Pod, Training Job)"]
        SA["ServiceAccount<br/>(consumer-defined)"]
        NS["Namespace<br/>(consumer-defined)"]

        Consumer -->|runs as| SA
        Consumer -->|deployed in| NS
    end

    subgraph SecretsAccess["Runtime Secrets"]
        direction TB

        OPENAI_KEY["OPENAI_API_KEY<br/>Type: Environment Variable<br/>Purpose: LLM inference auth<br/>Used by: GEPA backends<br/>Lifecycle: Set → Use → Restore"]
        MLFLOW_URI["MLflow Tracking URI<br/>Type: Environment Variable<br/>Purpose: MLflow server address<br/>Used by: GEPA MLflow backend"]
    end

    Consumer -->|provides env vars to| OPENAI_KEY
    Consumer -->|provides env vars to| MLFLOW_URI

    style Note fill:#fff3cd,stroke:#856404,stroke-width:2px,color:#856404
    style Consumer fill:#4a90e2,stroke:#333,color:#fff
    style SA fill:#7ed321,stroke:#333,color:#fff
    style NS fill:#7ed321,stroke:#333,color:#fff
    style OPENAI_KEY fill:#f8cecc,stroke:#b85450
    style MLFLOW_URI fill:#f8cecc,stroke:#b85450
