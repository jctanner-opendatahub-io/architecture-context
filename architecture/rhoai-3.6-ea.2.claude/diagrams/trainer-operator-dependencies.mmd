graph LR
    TrainerOp["Trainer Operator"]

    %% Runtime Framework Dependencies
    TrainerOp -->|"operator framework"| ControllerRuntime["controller-runtime 0.23.3"]
    TrainerOp -->|"manifest rendering,<br/>platform detection,<br/>deployment helpers"| ODHPlatformUtils["odh-platform-utilities 0.3.0"]
    TrainerOp -->|"TLS profile resolution"| OSControllerCommon["openshift/controller-runtime-common"]

    %% Kubeflow Dependency
    TrainerOp -->|"CRDs & types<br/>(TrainJob, TrainingRuntime)"| KubeflowTrainer["kubeflow/trainer v2.2.0"]

    %% Kubernetes Client Dependencies
    TrainerOp -->|"API client"| K8sClientGo["k8s.io/client-go 0.35.4"]
    TrainerOp -->|"API types"| K8sAPI["k8s.io/api 0.35.4"]
    TrainerOp -->|"CRD extensions"| K8sApiext["k8s.io/apiextensions 0.35.4"]

    %% OpenShift Dependencies
    TrainerOp -->|"OpenShift types"| OSApi["openshift/api"]
    TrainerOp -->|"OLM types"| OFApi["operator-framework/api 0.42.0"]

    %% Internal Platform Dependencies
    TrainerOp -->|"CRD CRUD"| PrometheusOp["prometheus-operator"]

    %% Runtime Prerequisites
    TrainerOp -->|"prerequisite check<br/>(gates deployment)"| JobSetOp["JobSet Operator"]

    %% Cluster Dependencies
    TrainerOp -->|"resource operations<br/>6443/TCP HTTPS"| K8sAPIServer["Kubernetes API Server"]
    TrainerOp -->|"TLS profile<br/>watch + resolve"| OSAPIServer["OpenShift APIServer"]
    TrainerOp -->|"subscription status"| OLM["OLM"]
    TrainerOp -.->|"TLS cert provisioning"| ServiceCA["OpenShift Service-CA"]

