graph TB
    subgraph "ai4rag Python Library"
        direction TB

        subgraph "Document Processing"
            S3Client["S3 Client<br/>(boto3)"]
            Docling["Text Extraction<br/>(docling-slim)"]
            Chunker["Chunking Engine<br/>(AI4RAGChunk)"]
            ChunkID["Chunk ID Generator<br/>(SHA-256)"]
        end

        subgraph "Embedding Layer"
            MaaSClient["MaaS Client<br/>(OpenAI SDK)"]
            EmbeddingModel["OpenAI Embedding Model<br/>(batch up to 1024)"]
        end

        subgraph "Vector Store Backends"
            VSConfig["BaseVectorStoreConfig<br/>(from_env() contract)"]
            MilvusBackend["Milvus Backend<br/>(pymilvus ~3.0.1)"]
            PGVectorBackend["PGVector Backend<br/>(pgvector ~0.5.0)"]
            ChromaBackend["ChromaDB Backend<br/>(chromadb >=1.5)"]
        end

        subgraph "Evaluation & Optimization"
            RagasEval["ragas Evaluation<br/>(>=0.3,<0.5)"]
            UnitxtEval["unitxt Evaluation<br/>(~1.26.1)"]
            PygamOpt["pygam Optimization<br/>(~0.12.0)"]
        end
    end

    %% Document flow
    S3Storage["S3-Compatible Storage"] -->|"boto3 / HTTPS"| S3Client
    S3Client -->|"raw documents"| Docling
    Docling -->|"extracted text"| Chunker
    Chunker -->|"generates"| ChunkID

    %% Embedding flow
    Chunker -->|"chunk text"| EmbeddingModel
    EmbeddingModel -->|"OpenAI SDK"| MaaSClient
    MaaSClient -->|"HTTPS"| MaaSEndpoint["OpenAI-Compatible<br/>MaaS Endpoint"]

    %% Vector store flow
    VSConfig --> MilvusBackend
    VSConfig --> PGVectorBackend
    VSConfig --> ChromaBackend
    EmbeddingModel -->|"embeddings"| VSConfig

    MilvusBackend -->|"gRPC/HTTPS"| MilvusDB["Milvus Server"]
    PGVectorBackend -->|"PostgreSQL"| PGDatabase["PostgreSQL + pgvector"]
    ChromaBackend -->|"HTTP/ephemeral"| ChromaServer["ChromaDB"]

    %% Evaluation
    Chunker -.->|"evaluation input"| RagasEval
    Chunker -.->|"evaluation input"| UnitxtEval
    RagasEval -.->|"metrics"| PygamOpt
    UnitxtEval -.->|"metrics"| PygamOpt

    %% Styling
    style S3Storage fill:#f5a623,stroke:#333
    style MaaSEndpoint fill:#f5a623,stroke:#333
    style MilvusDB fill:#f5a623,stroke:#333
    style PGDatabase fill:#f5a623,stroke:#333
    style ChromaServer fill:#f5a623,stroke:#333
    style S3Client fill:#4a90e2,stroke:#333
    style Docling fill:#4a90e2,stroke:#333
    style Chunker fill:#4a90e2,stroke:#333
    style ChunkID fill:#4a90e2,stroke:#333
    style MaaSClient fill:#4a90e2,stroke:#333
    style EmbeddingModel fill:#4a90e2,stroke:#333
    style VSConfig fill:#7ed321,stroke:#333
    style MilvusBackend fill:#7ed321,stroke:#333
    style PGVectorBackend fill:#7ed321,stroke:#333
    style ChromaBackend fill:#7ed321,stroke:#333
    style RagasEval fill:#b8a9c9,stroke:#333
    style UnitxtEval fill:#b8a9c9,stroke:#333
    style PygamOpt fill:#b8a9c9,stroke:#333
