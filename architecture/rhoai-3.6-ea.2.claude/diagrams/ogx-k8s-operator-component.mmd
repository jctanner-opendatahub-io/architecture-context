graph TB
    subgraph OGXModule["ogx-module (ODH Platform Component Controller)"]
        ModuleReconciler["OGX Reconciler<br/>(Reconciler)"]
        KustomizeRenderer["Kustomize Manifest<br/>Renderer"]
        ModuleReconciler -->|renders| KustomizeRenderer
    end

    subgraph OGXOperator["ogx-k8s-operator (OGXServer Controller)"]
        OGXServerReconciler["OGXServer Reconciler<br/>(OGXServerReconciler)"]
        WebhookServer["Validating Webhook<br/>/validate-ogx-io-v1beta1-ogxserver<br/>Port 9443"]
        MetricsServer["Metrics Server<br/>Port 8443<br/>TokenReview + SAR Auth"]
        ConfigGen["configgen<br/>(Config Generator)"]
    end

    %% CRDs
    OGXCR["OGX CR<br/>components.platform.opendatahub.io/v1alpha1<br/>(Cluster-scoped)"]
    OGXServerCR["OGXServer CR<br/>ogx.io/v1beta1<br/>(Namespaced)"]
    LlamaStackCR["LlamaStackDistribution CR<br/>llamastack.io/v1alpha1<br/>(Namespaced)"]

    %% Managed Resources
    subgraph ManagedResources["Managed Resources (per OGXServer)"]
        Deployment["Deployment"]
        Service["Service"]
        HPA["HorizontalPodAutoscaler"]
        PDB["PodDisruptionBudget"]
        NetworkPolicy["NetworkPolicy"]
        Ingress["Ingress"]
        ConfigMap["ConfigMap"]
        PVC["PersistentVolumeClaim"]
        SA["ServiceAccount"]
        RoleBinding["RoleBinding"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitor["ServiceMonitor"]
        PrometheusRule["PrometheusRule"]
    end

    %% Platform operator creates OGX CR
    PlatformOperator["Platform Operator<br/>(RHOAI/ODH)"] -->|creates| OGXCR
    OGXCR -->|watched by| ModuleReconciler

    %% ogx-module deploys ogx-k8s-operator
    KustomizeRenderer -->|deploys| OGXOperator
    KustomizeRenderer -->|manages| CRDs["CRDs"]
    KustomizeRenderer -->|manages| RBAC["RBAC Resources"]
    KustomizeRenderer -->|manages| WebhookConfig["ValidatingWebhookConfiguration"]

    %% User creates OGXServer
    User["User / Data Scientist"] -->|creates| OGXServerCR
    OGXServerCR -->|validated by| WebhookServer
    OGXServerCR -->|watched by| OGXServerReconciler

    %% OGXServerReconciler creates managed resources
    OGXServerReconciler -->|creates/manages| Deployment
    OGXServerReconciler -->|creates/manages| Service
    OGXServerReconciler -->|creates/manages| HPA
    OGXServerReconciler -->|creates/manages| PDB
    OGXServerReconciler -->|creates/manages| NetworkPolicy
    OGXServerReconciler -->|creates/manages| Ingress
    OGXServerReconciler -->|creates/manages| ConfigMap
    OGXServerReconciler -->|creates/manages| PVC
    OGXServerReconciler -->|creates/manages| SA
    OGXServerReconciler -->|creates/manages| RoleBinding
    OGXServerReconciler -->|creates/manages| ServiceMonitor
    OGXServerReconciler -->|creates/manages| PrometheusRule

    %% Monitoring
    Prometheus["Prometheus"] -->|scrapes| MetricsServer

    %% Styling
    style ModuleReconciler fill:#4a90e2,color:#fff
    style KustomizeRenderer fill:#4a90e2,color:#fff
    style OGXServerReconciler fill:#4a90e2,color:#fff
    style WebhookServer fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style ConfigGen fill:#4a90e2,color:#fff
    style OGXCR fill:#f5a623,color:#fff
    style OGXServerCR fill:#f5a623,color:#fff
    style LlamaStackCR fill:#f5a623,color:#fff
    style PlatformOperator fill:#e8e8e8
    style User fill:#e8e8e8
    style Prometheus fill:#e8e8e8
