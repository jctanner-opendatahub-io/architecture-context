graph TB
    subgraph Prometheus["Prometheus Scrape Targets (redhat-ods-monitoring)"]
        direction TB
        P_Desc["ServiceMonitor-based discovery<br/>All operators expose metrics on<br/>dedicated ports via kube-rbac-proxy"]
        P1["rhods-operator<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P2["kserve controllers<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P3["odh-model-controller<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P4["odh-dashboard<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P5["kubeflow notebook-controller<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P6["data-science-pipelines<br/>Port 8888/TCP<br/>Application auth"]
        P7["models-as-a-service<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P8["model-registry-operator<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P9["kueue-operator<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P10["kuberay<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
        P11["46+ operator metrics endpoints<br/>Port 8443/TCP<br/>kube-rbac-proxy"]
