    style MPIPlugin fill:#6bb5e0,color:#fff
    style CoSchedPlugin fill:#6bb5e0,color:#fff
    style VolcanoPlugin fill:#6bb5e0,color:#fff
    style NetPolReconciler fill:#e07b6b,color:#fff
    style ProgressionTracker fill:#e07b6b,color:#fff
    style TLSProfileResolver fill:#e07b6b,color:#fff
    style DatasetInit fill:#9b59b6,color:#fff
    style ModelInit fill:#9b59b6,color:#fff
    style TrainJobCR fill:#f5a623
    style TrainingRuntimeCR fill:#f5a623
    style ClusterTrainingRuntimeCR fill:#f5a623
