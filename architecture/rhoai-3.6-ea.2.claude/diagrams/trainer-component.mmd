graph TB
    subgraph TrainerOperator["Trainer Operator (kubeflow-trainer-controller-manager)"]
        Controller["Trainer Controller Manager<br/>Go controller-runtime"]
        MutatingWebhook["Mutating Webhook<br/>Port 443/TCP TLS"]
        ValidatingWebhook["Validating Webhooks<br/>Port 443/TCP TLS"]
        MetricsServer["Metrics Server<br/>Port 8443/TCP TLS"]
        StatusServer["Status Server<br/>Port 10443/TCP"]
        HealthProbes["Health/Readiness Probes<br/>Port 8081/TCP"]

        subgraph FrameworkPlugins["Runtime Framework Plugins"]
            FluxPlugin["Flux Plugin"]
            MPIPlugin["MPI Plugin"]
            CoSchedPlugin["CoScheduling Plugin"]
            VolcanoPlugin["Volcano Plugin"]
        end

        subgraph RHOAIAddons["RHOAI Extensions"]
            NetPolReconciler["NetworkPolicy Reconciler"]
            ProgressionTracker["Progression Tracker"]
            TLSProfileResolver["TLS Profile Resolver"]
        end

        Controller --> FrameworkPlugins
        Controller --> RHOAIAddons
        Controller -->|serves| MutatingWebhook
        Controller -->|serves| ValidatingWebhook
        Controller -->|serves| MetricsServer
        Controller -->|serves| StatusServer
    end

    subgraph Initializers["Python Initializer Containers"]
        DatasetInit["Dataset Initializer<br/>pkg.initializers.dataset"]
        ModelInit["Model Initializer<br/>pkg.initializers.model"]
    end

    %% CRDs
    User[Data Scientist / User] -->|creates| TrainJobCR["TrainJob CR<br/>trainer.kubeflow.org/v1alpha1"]
    Admin[Admin] -->|creates| TrainingRuntimeCR["TrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1"]
    Admin -->|creates| ClusterTrainingRuntimeCR["ClusterTrainingRuntime CR<br/>trainer.kubeflow.org/v1alpha1"]

    TrainJobCR -->|mutated by| MutatingWebhook
    TrainJobCR -->|validated by| ValidatingWebhook
    TrainingRuntimeCR -->|validated by| ValidatingWebhook
    ClusterTrainingRuntimeCR -->|validated by| ValidatingWebhook

    TrainJobCR -->|watched by| Controller
    TrainingRuntimeCR -->|referenced by| Controller
    ClusterTrainingRuntimeCR -->|referenced by| Controller

    %% Downstream resources
    Controller -->|creates| JobSetCR["JobSet CR<br/>jobset.x-k8s.io/v1alpha2"]
    Controller -->|creates| NetworkPolicy["NetworkPolicy<br/>networking.k8s.io/v1"]

    %% Plugin-specific resources
    FluxPlugin -->|watches| ConfigMaps["ConfigMaps"]
    FluxPlugin -->|watches| Secrets["Secrets"]
    MPIPlugin -->|watches| ConfigMaps
    MPIPlugin -->|watches| Secrets
    CoSchedPlugin -->|creates/watches| SchedPodGroup["PodGroup<br/>scheduling.x-k8s.io"]
    VolcanoPlugin -->|creates/watches| VolcanoPodGroup["PodGroup<br/>scheduling.volcano.sh"]

    %% External
    TLSProfileResolver -->|reads| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1"]
    CertController["OPA cert-controller"] -->|rotates certs for| MutatingWebhook

