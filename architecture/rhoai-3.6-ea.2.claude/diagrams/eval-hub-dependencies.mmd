graph LR
    EvalHub["eval-hub<br/>Evaluation Orchestration"]

    %% Kubernetes / Cluster Dependencies
    EvalHub -->|"HTTPS/WSS :6443<br/>ServiceAccount"| K8sAPI["Kubernetes API<br/>v0.37.0"]
    EvalHub -->|"creates Jobs"| BatchJobs["batch/v1 Jobs"]
    EvalHub -->|"creates"| ConfigMaps["ConfigMaps"]
    EvalHub -->|"creates"| Secrets["Secrets"]
    EvalHub -->|"get, delete"| HWProfile["HardwareProfile CR<br/>infrastructure.opendatahub.io/v1"]

    %% Storage Dependencies
    EvalHub -->|"TCP (pgx v5.10)"| PostgreSQL["PostgreSQL"]
    EvalHub -.->|"local file<br/>(alternative)"| SQLite["SQLite<br/>modernc v1.57"]

    %% External Service Dependencies
    EvalHub -->|"HTTP/HTTPS<br/>TLS + token"| MLflow["MLflow Tracking Server"]
    EvalHub -->|"HTTP/HTTPS<br/>AWS SDK v2"| S3["S3-compatible Storage"]
    EvalHub -->|"OTLP/gRPC"| OTelCollector["OpenTelemetry Collector"]

    %% Observability Libraries
    EvalHub -->|"metrics"| Prometheus["Prometheus<br/>client_golang v1.24"]
    EvalHub -->|"tracing"| OTel["OpenTelemetry SDK<br/>v1.46.0"]
    EvalHub -->|"logging"| Zap["Zap Logger<br/>v1.28.0"]

    %% Build Dependencies
    EvalHub -->|"runtime"| GoRuntime["Go 1.26.7<br/>FIPS: strictfipsruntime"]
    EvalHub -->|"base image"| UBI9["UBI9 PQC Minimal"]

    %% Integration Points
    Dashboard["RHOAI Dashboard"] -.->|"UI integration"| EvalHub
    Operator["RHOAI Operator"] -.->|"deploys"| EvalHub

    %% MCP
    EvalHub -->|"MCP protocol"| MCPClients["MCP Clients<br/>go-sdk v1.7.0"]

