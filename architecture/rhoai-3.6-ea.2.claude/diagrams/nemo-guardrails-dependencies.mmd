graph LR
    NemoGuardrails["NeMo-Guardrails<br/>Guardrails Server"]

    %% Runtime Framework
    NemoGuardrails -->|"web framework"| FastAPI["FastAPI<br/>>=0.103.0"]
    NemoGuardrails -->|"ASGI server"| Uvicorn["uvicorn<br/>>=0.23"]
    NemoGuardrails -->|"framework layer"| Starlette["Starlette<br/>>=0.49.1"]

    %% LLM Provider SDKs
    NemoGuardrails -->|"LLM inference"| OpenAI["OpenAI SDK<br/>>=1.0.0,<3.0.0"]
    NemoGuardrails -->|"LLM inference"| LangChainOAI["langchain-openai<br/>>=0.1.0"]

    %% HTTP Clients
    NemoGuardrails -->|"async HTTP"| HTTPX["httpx<br/>>=0.24.1"]
    NemoGuardrails -->|"async HTTP"| AioHTTP["aiohttp<br/>>=3.10.11"]
    NemoGuardrails -->|"sync HTTP"| Requests["requests<br/>==2.34.2"]

    %% ML / NLP Libraries
    NemoGuardrails -->|"ML runtime"| PyTorch["torch<br/>>=2.0.0"]
    NemoGuardrails -->|"model inference"| Transformers["transformers<br/>>=4.35.0"]
    NemoGuardrails -->|"embeddings"| SentenceTransformers["sentence-transformers<br/>>=2.2.0"]
    NemoGuardrails -->|"fast embeddings"| FastEmbed["fastembed<br/>>=0.2.2"]
    NemoGuardrails -->|"NLP pipeline"| SpaCy["spaCy<br/>>=3.4.4,<4.0.0"]
    NemoGuardrails -->|"tokenization"| NLTK["NLTK<br/>>=3.8"]
    NemoGuardrails -->|"ONNX inference"| ONNX["onnxruntime<br/>>=1.17.0,<1.24"]
    NemoGuardrails -->|"numerical"| NumPy["numpy<br/>>=1.21"]

    %% PII Detection
    NemoGuardrails -->|"PII analysis"| PresidioAnalyzer["presidio-analyzer<br/>>=2.2"]
    NemoGuardrails -->|"PII anonymization"| PresidioAnonymizer["presidio-anonymizer<br/>>=2.2"]

    %% Observability
    NemoGuardrails -.->|"tracing (optional)"| OTelAPI["opentelemetry-api<br/>>=1.27.0"]
    NemoGuardrails -.->|"tracing (optional)"| OTelSDK["opentelemetry-sdk<br/>==1.43.0"]
    NemoGuardrails -.->|"trace export"| OTelOTLP["opentelemetry-exporter-otlp<br/>>=1.27.0"]
    NemoGuardrails -.->|"FastAPI instrumentation"| OTelFastAPI["otel-instrumentation-fastapi<br/>>=0.48b0"]

    %% Security
    NemoGuardrails -->|"TLS/crypto"| Cryptography["cryptography<br/>==46.0.7"]
    NemoGuardrails -->|"malware detection"| YARA["yara-python<br/>>=4.5.1,<5.0.0"]

    %% Guardrails DSL
    NemoGuardrails -->|"Colang parsing"| Lark["lark<br/>>=1.1.7"]

    %% Data Processing
    NemoGuardrails -->|"data analysis"| Pandas["pandas<br/>>=1.4.0,<3.0.0"]
    NemoGuardrails -->|"serialization"| Pydantic["pydantic<br/>>=2.5,<3.0"]

    %% Transport
    NemoGuardrails -->|"gRPC transport"| gRPC["grpcio<br/>==1.82.1"]
    NemoGuardrails -->|"protobuf"| Protobuf["protobuf<br/>>=5.29.5"]

    %% External LLM Services
    OpenAI -->|"API calls"| OpenAIService["OpenAI API<br/>api.openai.com"]
    LangChainOAI -->|"API calls"| AzureOAIService["Azure OpenAI<br/>{endpoint}.openai.azure.com"]

    %% Auxiliary Services
    NemoGuardrails -.->|"fact-checking"| AlignScore["AlignScore Service<br/>Port 5000"]
    NemoGuardrails -.->|"jailbreak detection"| JailbreakSvc["Jailbreak Detection<br/>Port 1337"]

