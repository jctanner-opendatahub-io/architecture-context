graph TB
    subgraph MCPOperator["MCP Lifecycle Operator"]
        direction TB
        Controller["MCPServerReconciler<br/>(controller-runtime)"]
        HealthProbe["Health/Readiness Probes<br/>:8081/TCP HTTP"]
        MetricsServer["Metrics Server<br/>:8443/TCP HTTPS<br/>TokenReview + SAR Auth"]
        LeaderElection["Leader Election<br/>(Lease-based)"]
        TLSConfig["TLS Configuration<br/>TLS_MIN_VERSION<br/>TLS_CIPHER_SUITES"]
    end

    User["Platform User / Admin"] -->|"kubectl apply"| MCPServerCR["MCPServer CR<br/>(mcp.x-k8s.io/v1alpha1)<br/>Namespaced"]

    MCPServerCR -->|"watched by (For)"| Controller

    Controller -->|"creates/owns"| Deployment["Deployment<br/>(apps/v1)"]
    Controller -->|"creates/owns"| Service["Service<br/>(v1)"]
    Controller -->|"creates/owns"| NetworkPolicy["NetworkPolicy<br/>(networking.k8s.io/v1)"]

    ConfigMap["ConfigMap<br/>(referenced)"] -->|"triggers re-reconcile<br/>(field-indexed watch)"| Controller
    Secret["Secret<br/>(referenced)"] -->|"triggers re-reconcile<br/>(field-indexed watch)"| Controller

    Controller -->|"reads pods for<br/>status conditions"| Pods["Pods<br/>(managed)"]

    Controller -->|"REST/WSS :6443<br/>TLS 1.2+"| K8sAPI["Kubernetes API Server"]

    TLSConfig -.->|"PROPAGATE_TLS_ENV_VARS"| Deployment

    style Controller fill:#4a90e2,color:#fff
    style HealthProbe fill:#4a90e2,color:#fff
    style MetricsServer fill:#4a90e2,color:#fff
    style LeaderElection fill:#4a90e2,color:#fff
    style TLSConfig fill:#4a90e2,color:#fff
    style MCPServerCR fill:#f5a623,color:#fff
    style Deployment fill:#7ed321,color:#fff
    style Service fill:#7ed321,color:#fff
    style NetworkPolicy fill:#7ed321,color:#fff
    style ConfigMap fill:#f5a623,color:#fff
    style Secret fill:#f5a623,color:#fff
    style Pods fill:#7ed321,color:#fff
    style K8sAPI fill:#e8e8e8,color:#333
