graph TD
    subgraph "NeMo-Guardrails RBAC"
        direction TB
        Note["⚠️ No Kubernetes RBAC defined<br/>NeMo-Guardrails is a standalone<br/>application service, not a K8s operator"]
    end

    subgraph "Authentication Model"
        direction TB
        AuthNote["Authentication: NONE (platform-delegated)<br/>No built-in auth middleware<br/>No API key validation<br/>No token verification"]
    end

    subgraph "Platform-Delegated Security"
        direction TB

        subgraph "Expected Platform Controls"
            ServiceMesh["Service Mesh (Istio/OSSM)<br/>- mTLS enforcement<br/>- PeerAuthentication<br/>- AuthorizationPolicy"]
            Gateway["API Gateway / Ingress<br/>- TLS termination<br/>- Authentication<br/>- Rate limiting"]
            NetworkPolicy["Kubernetes NetworkPolicy<br/>- Pod-to-pod restrictions<br/>- Namespace isolation<br/>- Egress controls"]
        end
    end

    subgraph "Environment Variable Secrets"
        direction TB

        subgraph "LLM Provider Credentials"
            AzureKey["AZURE_OPENAI_API_KEY<br/>Azure OpenAI access"]
            OpenAIKey["OPENAI_API_KEY (implied)<br/>OpenAI API access"]
        end

        subgraph "Third-Party Guardrail Providers (Optional)"
            ActiveFence["ACTIVEFENCE_API_KEY"]
            AIDefense["AI_DEFENSE_API_KEY"]
            AutoAlign["AUTOALIGN_API_KEY"]
            Clavata["CLAVATA_API_KEY"]
            CleanLab["CLEANLAB_API_KEY"]
            CSAIDR["CS_AIDR_TOKEN"]
            F5["F5_GUARDRAILS_API_KEY"]
            Fiddler["FIDDLER_API_KEY"]
            Pangea["PANGEA_API_TOKEN"]
            Patronus["PATRONUS_API_KEY"]
            PolicyAI["POLICYAI_API_KEY"]
            Polygraf["POLYGRAF_API_KEY"]
            PAI["PAI_API_KEY"]
        end
    end

    ServiceMesh -->|"enforces mTLS<br/>on inbound traffic"| Note
    Gateway -->|"provides auth<br/>before requests reach app"| Note
    NetworkPolicy -->|"restricts<br/>network access"| Note

    AzureKey -->|"consumed by"| Note
    OpenAIKey -->|"consumed by"| Note

