    style CR_Leader fill:#f5a623,stroke:#333,color:#fff
    style CR_View fill:#7ed321,stroke:#333,color:#fff
    style CR_Edit fill:#7ed321,stroke:#333,color:#fff
    style CR_Integration fill:#7ed321,stroke:#333,color:#fff
