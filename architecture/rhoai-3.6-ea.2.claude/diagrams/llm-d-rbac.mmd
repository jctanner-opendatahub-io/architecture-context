graph TD
    subgraph "llm-d RBAC Model"
        direction TB

        Note["llm-d has NO built-in RBAC.<br/>Security is entirely platform-delegated."]
    end

    subgraph "Platform-Delegated Authentication"
        ModelServerAPI["Model Server API<br/>Port 8000/TCP<br/>/v1/completions<br/>/v1/chat/completions"]
        NoAuth["Auth: None<br/>Encryption: None<br/>Enforcement: None (vllm)"]
        ModelServerAPI --- NoAuth
    end

    subgraph "Optional: Istio mTLS (ModelExpress)"
        direction TB

        PeerAuth["PeerAuthentication<br/>Mode: STRICT<br/>Scope: Broker workload"]
        AuthzPolicy["AuthorizationPolicy<br/>Port: 8001/TCP gRPC"]

        DecodeAccount["ServiceAccount:<br/>decode"]
        BrokerWorkload["ModelExpress Broker<br/>gRPC Port 8001"]

        PeerAuth -->|"enforces mTLS"| BrokerWorkload
        AuthzPolicy -->|"restricts access to"| BrokerWorkload
        DecodeAccount -->|"allowed by<br/>AuthorizationPolicy"| BrokerWorkload
    end

    subgraph "Security Gaps"
        Gap1["RDMA port 5600/TCP<br/>Bypasses Istio mesh"]
        Gap2["--secure-proxy=false<br/>TLS disabled on<br/>sidecar-to-vllm path"]
        Gap3["ext_proc gRPC 9002<br/>No encryption (localhost)"]
        Gap4["OTLP export 4317<br/>No encryption"]
    end

    style Note fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    style ModelServerAPI fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    style NoAuth fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style PeerAuth fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style AuthzPolicy fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    style DecodeAccount fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style BrokerWorkload fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    style Gap1 fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Gap2 fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Gap3 fill:#f8cecc,stroke:#b85450,stroke-width:2px
    style Gap4 fill:#f8cecc,stroke:#b85450,stroke-width:2px
