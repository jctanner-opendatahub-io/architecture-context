graph TB
    subgraph ClientEnv["CLIENT ENVIRONMENT (User Workstation / Notebook / Workbench)"]
        SDK["CodeFlare SDK<br/>Python 3.11+<br/>cryptography (OpenSSL backend)<br/>Cert Gen: RSA 3072-bit x509"]
    end

    subgraph K8sCluster["KUBERNETES CLUSTER (Trusted)"]
        direction TB

        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>AuthN: Bearer / kubeconfig / SA<br/>AuthZ: RBAC"]

        subgraph Operators["Operator Namespace"]
            KubeRay["KubeRay Operator<br/>Watches: ray.io CRs<br/>(RayJob, RayCluster)"]
            KueueCtrl["Kueue Controller<br/>Watches: kueue.x-k8s.io CRs<br/>(ClusterQueues, LocalQueues)"]
        end

        subgraph UserNS["User Namespace"]
            RayCluster["Ray Cluster Pods<br/>Head + Workers<br/>Internal TLS: SDK-generated certs"]
            RayDash["Ray Dashboard<br/>HTTP/HTTPS<br/>Auth: Headers/Cookies"]
        end

        subgraph TestInfra["Test Infrastructure"]
            MinIO["MinIO<br/>9000/TCP API<br/>9090/TCP Console<br/>ClusterIP Internal<br/>Secret: minio-secret"]
        end

        K8sAPI --> KubeRay
        K8sAPI --> KueueCtrl
        KubeRay --> RayCluster
    end

    %% Flows
    SDK -->|"HTTPS/6443<br/>TLS<br/>Bearer token / kubeconfig /<br/>in-cluster SA<br/>(kube-authkit auto-detect)"| K8sAPI
    SDK -->|"HTTP(S)/configurable<br/>TLS verify: enabled<br/>Headers + Cookies<br/>(caller-configured)"| RayDash

    %% Styling
    classDef client fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8score fill:#e8e8e8,stroke:#666,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef testinfra fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class SDK client
    class K8sAPI k8score
    class KubeRay,KueueCtrl operator
    class RayCluster,RayDash workload
    class MinIO testinfra
