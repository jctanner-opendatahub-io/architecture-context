graph TD
    subgraph "pipelines-components RBAC Model"
        direction TB

        Note["NOTE: This component does not define its own<br/>ClusterRoles or RoleBindings.<br/>RBAC is inherited from the KFP runtime environment."]

        subgraph "Runtime Authentication"
            direction LR
            S3Auth["S3 Authentication<br/>AWS_ACCESS_KEY_ID +<br/>AWS_SECRET_ACCESS_KEY<br/>(environment variables)"]
            K8sAuth["Kubernetes API Auth<br/>In-cluster SA token<br/>(auto-mounted)"]
        end

        subgraph "Secrets / Credentials"
            direction TB
            AWSKey["AWS_SECRET_ACCESS_KEY<br/>Type: env var<br/>Purpose: S3 storage access"]
            TestAWSKey["TEST_DATA_AWS_SECRET_ACCESS_KEY<br/>Type: env var<br/>Purpose: Test S3 access"]
            InputAWSKey["INPUT_DATA_AWS_SECRET_ACCESS_KEY<br/>Type: env var<br/>Purpose: Input data S3"]
            HFToken["HF_TOKEN<br/>Type: env var<br/>Purpose: HuggingFace auth"]
            S3Key["S3_SECRET_KEY<br/>Type: env var<br/>Purpose: Alt S3 credential"]
            LLMKey["LLM_API_KEY<br/>Type: env var<br/>Purpose: LLM service auth"]
            OCISecret["OCI_PULL_SECRET_MODEL_DOWNLOAD<br/>Type: env var<br/>Purpose: OCI registry pull"]
            K8sToken["KUBERNETES_AUTH_TOKEN<br/>Type: env var<br/>Purpose: K8s API auth override"]
        end

        subgraph "Enforcement Points"
            Boto3["boto3 client<br/>Enforces AWS credentials<br/>for S3 operations"]
            K8sPython["kubernetes-python client<br/>Enforces SA token<br/>for K8s API calls"]
        end

        S3Auth -->|"provides credentials"| Boto3
        K8sAuth -->|"provides token"| K8sPython

        AWSKey -->|"consumed by"| S3Auth
        S3Key -->|"consumed by"| S3Auth
        HFToken -->|"consumed by"| S3Auth
        K8sToken -->|"consumed by"| K8sAuth

        subgraph "KFP-Managed RBAC (External)"
            KFPSA["Pipeline Runner ServiceAccount<br/>(assigned by KFP at runtime)"]
            KFPRole["KFP Pipeline Runner Role<br/>(defined by KFP operator)"]
            KFPSA -->|"bound to"| KFPRole
        end

        K8sPython -->|"uses permissions from"| KFPSA
    end

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style S3Auth fill:#4a90e2,stroke:#333,color:#fff
    style K8sAuth fill:#4a90e2,stroke:#333,color:#fff
    style AWSKey fill:#f5a623,stroke:#333
    style TestAWSKey fill:#f5a623,stroke:#333
    style InputAWSKey fill:#f5a623,stroke:#333
    style HFToken fill:#f5a623,stroke:#333
    style S3Key fill:#f5a623,stroke:#333
    style LLMKey fill:#f5a623,stroke:#333
    style OCISecret fill:#f5a623,stroke:#333
    style K8sToken fill:#f5a623,stroke:#333
    style Boto3 fill:#7ed321,stroke:#333
    style K8sPython fill:#7ed321,stroke:#333
    style KFPSA fill:#e8e8e8,stroke:#333
    style KFPRole fill:#e8e8e8,stroke:#333
