graph TD
    subgraph "Service Account"
        SA["user-one"]
    end

    subgraph "Role Binding"
        RB["user-one-view<br/>(RoleBinding)"]
    end

    subgraph "ClusterRole"
        CR["view<br/>(ClusterRole — built-in)"]
    end

    subgraph "Permissions (view ClusterRole)"
        Read["Standard read-only access<br/>get, list, watch"]
    end

    subgraph "Authentication & Authorization"
        NoAuth["⚠ No Auth Middleware<br/>FastAPI instances created<br/>with empty dependency lists"]
        TLS["TLS Configuration<br/>Configurable via ssl_ca_certs<br/>NOT enforced by default"]
    end

    subgraph "Secrets"
        Secret["aws-connection-minio-data-<br/>connection-guardrails-guardian<br/>(Opaque)<br/>Provisioned by: manifest"]
    end

    subgraph "KServe ServingRuntimes"
        RT1["guardrails-detector-runtime-guardian<br/>serving.kserve.io/v1alpha1<br/>Model: guardrails-detector-huggingface"]
        RT2["guardrails-detector-runtime-judge<br/>serving.kserve.io/v1alpha1<br/>Model: guardrails-detector-llm-judge"]
    end

    SA -->|"bound via"| RB
    RB -->|"grants"| CR
    CR -->|"provides"| Read

    Secret -.->|"used by"| RT1
    RT1 -.->|"deploys"| HF["HuggingFace Detector Pod"]
    RT2 -.->|"deploys"| Judge["LLM Judge Detector Pod"]

