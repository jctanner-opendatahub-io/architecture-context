graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Platform["PLATFORM BOUNDARY<br/>(Auth enforced externally)"]
        direction TB
        AuthNote["⚠️ No built-in auth<br/>Platform must provide:<br/>Service mesh / Gateway / NetworkPolicy"]
    end

    subgraph Application["APPLICATION LAYER"]
        direction TB

        subgraph MainServer["NeMo-Guardrails Server Container"]
            FastAPI["GuardrailsApp (FastAPI)<br/>Port: 8000/TCP<br/>Base: AIPCC CPU (UBI)<br/>Runtime: Python + uvicorn<br/>Middleware: Exception + CORS only<br/>Auth: NONE"]

            subgraph Endpoints["API Endpoints"]
                Chat["/v1/chat/completions<br/>POST"]
                Checks["/v1/checks<br/>POST"]
                GChecks["/v1/guardrail/checks<br/>POST"]
                Health["/healthz, /v1/health<br/>GET"]
            end

            subgraph CachedModels["Pre-cached Models<br/>(from Red Hat modelcar images)"]
                MiniLM["MiniLM"]
                Arctic["Snowflake Arctic"]
                SpaCy["spaCy"]
                NLTKData["NLTK"]
            end
        end

        subgraph AuxServices["Auxiliary Services (Optional, separate containers)"]
            AlignScore["AlignScore Server<br/>Port: 5000/TCP<br/>HTTP<br/>Fact-checking"]
            Jailbreak["Jailbreak Detection<br/>Port: 1337/TCP<br/>HTTP<br/>Heuristic analysis"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Egress)"]
        OpenAI["OpenAI API<br/>api.openai.com<br/>443/TCP HTTPS<br/>TLS<br/>Auth: API Key"]
        AzureOAI["Azure OpenAI<br/>{endpoint}.openai.azure.com<br/>443/TCP HTTPS<br/>TLS<br/>Auth: AZURE_OPENAI_API_KEY"]
    end

    subgraph Observability["OBSERVABILITY (Optional)"]
        OTLP["OTLP Endpoint<br/>OpenTelemetry Collector<br/>gRPC/HTTP"]
    end

    %% Flows
    Client -->|"HTTP(S)/8000<br/>Encryption: Platform-dependent<br/>Auth: NONE (platform-delegated)"| FastAPI
    FastAPI --> Endpoints
    FastAPI -->|"local inference"| CachedModels
    FastAPI -.->|"optional"| AlignScore
    FastAPI -.->|"optional"| Jailbreak
    Chat -->|"HTTPS/443<br/>TLS<br/>API Key (env var)"| OpenAI
    Chat -->|"HTTPS/443<br/>TLS<br/>AZURE_OPENAI_API_KEY"| AzureOAI
    FastAPI -.->|"OTLP traces<br/>(if OTEL_EXPORTER_OTLP_ENDPOINT set)"| OTLP

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef platform fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef application fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef observability fill:#e8e8e8,stroke:#999

    class Client external
    class AuthNote warning
    class FastAPI,Chat,Checks,GChecks,Health application
    class MiniLM,Arctic,SpaCy,NLTKData application
    class AlignScore,Jailbreak application
    class OpenAI,AzureOAI externalservice
    class OTLP observability
