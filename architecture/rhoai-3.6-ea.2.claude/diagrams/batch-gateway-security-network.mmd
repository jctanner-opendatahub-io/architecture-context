graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph PlatformGateway["INGRESS (Platform Gateway)"]
        Gateway["llm-d-inference-gateway<br/>HTTPRoute<br/>443/TCP → 8000/TCP<br/>TLS Termination<br/>External Auth Enforcement"]
    end

    subgraph Application["APPLICATION LAYER (batch-gateway)"]
        direction TB

        subgraph APIServerGroup["API Server Process"]
            APIServer["batch-gateway-apiserver<br/>FIPS: strictfipsruntime + CGO<br/>API: 8000/TCP (optional TLS, min 1.2)<br/>Obs: 8081/TCP (plain HTTP)<br/>Middleware: Recovery → Request → SecurityHeaders"]
        end

        subgraph ProcessorGroup["Processor Process"]
            Processor["batch-gateway-processor<br/>FIPS: strictfipsruntime + CGO<br/>Obs: 8081/TCP (plain HTTP)<br/>/ready, /health, /metrics"]
        end

        subgraph GCGroup["Garbage Collector Process"]
            GC["batch-gateway-gc<br/>FIPS: strictfipsruntime + CGO<br/>Obs: 8081/TCP (plain HTTP)<br/>/health, /metrics"]
        end
    end

    subgraph DataStores["DATA STORES"]
        PostgreSQL["PostgreSQL<br/>TCP<br/>TLS: Configurable<br/>OTel: otelpgx"]
        Redis["Redis/Valkey<br/>TCP<br/>TLS: Configurable<br/>OTel: redisotel"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>HTTP/HTTPS<br/>AWS SDK Auth<br/>Max file: 200MB<br/>Expiry: 90 days"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC"]
        LLMd["llm-d Inference Gateway<br/>HTTP/HTTPS<br/>Auth: Bearer passthrough"]
    end

    %% External → Gateway
    Client -->|"HTTPS/443<br/>Bearer Token (optional)"| Gateway

    %% Gateway → API Server
    Gateway -->|"HTTP(S)/8000<br/>TLS min 1.2<br/>X-MaaS-Username<br/>Authorization passthrough"| APIServer

    %% API Server → Data Stores
    APIServer -->|"TCP<br/>Configurable TLS<br/>Connection credentials"| PostgreSQL
    APIServer -->|"TCP<br/>Configurable TLS<br/>llm-d-async producer"| Redis
    APIServer -->|"HTTP/HTTPS<br/>AWS SDK credentials"| S3

    %% Processor → Data Stores & Services
    Processor -->|"TCP<br/>Configurable TLS"| PostgreSQL
    Processor -->|"TCP<br/>Configurable TLS<br/>Poll for jobs"| Redis
    Processor -->|"HTTP/HTTPS<br/>AWS SDK credentials"| S3
    Processor -->|"HTTP/HTTPS<br/>Authorization passthrough"| LLMd

    %% GC → Data Stores
    GC -->|"TCP<br/>Configurable TLS"| PostgreSQL
    GC -->|"HTTP/HTTPS<br/>Cleanup expired files"| S3

    %% Observability
    APIServer -->|"OTLP/gRPC<br/>Traces"| OTel
    Processor -->|"OTLP/gRPC<br/>Traces"| OTel
    GC -->|"OTLP/gRPC<br/>Traces"| OTel

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef application fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef datastore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalservice fill:#d5e8d4,stroke:#82b366,stroke-width:2px

    class Client external
    class Gateway ingress
    class APIServer,Processor,GC application
    class PostgreSQL,Redis datastore
    class S3,OTel,LLMd externalservice
