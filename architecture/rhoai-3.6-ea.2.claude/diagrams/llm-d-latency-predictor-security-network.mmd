graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        InferenceProxy["llm-d Inference Proxy<br/>/ Monitoring System"]
        PredClient["Prediction Client"]
    end

    subgraph ClusterNetwork["KUBERNETES CLUSTER (Internal Network)"]
        direction TB

        subgraph Services["Kubernetes Services"]
            TrainingSvc["training-service<br/>ClusterIP<br/>8000/TCP → 8000/TCP"]
            PredictionSvc["prediction-service<br/>ClusterIP<br/>80/TCP → 8001/TCP"]
        end

        subgraph TrainingNS["Training Server Pod"]
            TrainingServer["Training Server<br/>uvicorn :8000<br/>Base: aipcc/cpu:3.5.0<br/>No Auth Middleware"]
            TrainingEndpoints["Endpoints:<br/>POST /add_training_data_bulk<br/>GET /models/list<br/>GET /model/{name}/info<br/>GET /model/{name}/download<br/>GET /metrics<br/>GET /healthz, /readyz"]
        end

        subgraph PredictionNS["Prediction Server Pod"]
            PredictionServer["Prediction Server<br/>uvicorn :8001<br/>Base: aipcc/cpu:3.5.0<br/>No Auth Middleware"]
            ModelSyncer["ModelSyncer Thread<br/>Polls every 10s<br/>MD5 checksum verification"]
            PredictionEndpoints["Endpoints:<br/>POST /predict<br/>POST /predict/bulk<br/>POST /predict/bulk/strict<br/>GET /healthz, /readyz"]
        end

        subgraph Observability["OBSERVABILITY"]
            Prometheus["Prometheus"]
            Kubelet["Kubernetes kubelet"]
        end
    end

    %% External flows
    InferenceProxy -->|"HTTP/8000<br/>No Encryption<br/>No Auth"| TrainingSvc
    PredClient -->|"HTTP/80<br/>No Encryption<br/>No Auth"| PredictionSvc

    %% Service routing
    TrainingSvc -->|"HTTP/8000"| TrainingServer
    PredictionSvc -->|"HTTP/8001"| PredictionServer

    %% Internal model sync
    ModelSyncer -->|"HTTP/8000<br/>No Encryption<br/>No Auth<br/>Polling every 10s"| TrainingSvc

    %% Observability
    Prometheus -->|"HTTP/8000<br/>/metrics"| TrainingSvc
    Kubelet -->|"HTTP/8000<br/>/healthz, /readyz"| TrainingServer
    Kubelet -->|"HTTP/8001<br/>/healthz, /readyz"| PredictionServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef service fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef pod fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class InferenceProxy,PredClient external
    class TrainingSvc,PredictionSvc service
    class TrainingServer,PredictionServer,ModelSyncer pod
    class TrainingEndpoints,PredictionEndpoints warning
    class Prometheus,Kubelet observability
