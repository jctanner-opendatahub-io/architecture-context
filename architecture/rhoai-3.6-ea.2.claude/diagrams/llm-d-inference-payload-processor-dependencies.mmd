graph LR
    IPP["llm-d-inference-payload-processor<br/>ExtProc Service"]

    %% Internal llm-d Dependencies
    IPP -->|"shared plugin types<br/>(Go library)"| LLMDRouter["llm-d-router<br/>v0.10.0"]

    %% Runtime Framework Dependencies
    IPP -->|"lifecycle mgmt"| ControllerRuntime["controller-runtime<br/>v0.23.3"]
    IPP -->|"gRPC transport"| GRPC["google.golang.org/grpc<br/>v1.83.1"]
    IPP -->|"ExtProc API"| EnvoyControlPlane["go-control-plane<br/>v1.39.0"]
    IPP -->|"K8s client"| K8sClientGo["k8s.io/client-go<br/>v0.35.8"]

    %% Observability Dependencies
    IPP -->|"metrics"| PromClient["prometheus/client_golang<br/>v1.24.1"]
    IPP -->|"tracing"| OTel["OpenTelemetry<br/>v1.45.0"]
    IPP -->|"logging"| Zap["go.uber.org/zap<br/>v1.28.0"]

    %% Infrastructure Dependencies
    IPP -->|"inference API types"| OpenAI["openai/openai-go<br/>v1.12.0"]
    IPP -->|"gateway ext types"| GatewayAPI["gateway-api-inference-extension<br/>v1.5.0"]

    %% Platform Integration Points
    EnvoyProxy["Envoy Proxy"] -->|"gRPC ExtProc<br/>callouts"| IPP
    IPP -->|"ConfigMap watch<br/>resource ops"| K8sAPI["Kubernetes API<br/>6443/TCP"]

    %% Downstream Consumers
    EnvoyProxy -->|"forwards to"| VLLMDeepseek["vllm-deepseek-r1"]
    EnvoyProxy -->|"forwards to"| VLLMLlama["vllm-llama3-8b-instruct"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrapes /metrics"| IPP

