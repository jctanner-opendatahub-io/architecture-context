graph LR
    RhoaiMCP["rhoai-mcp<br/>MCP Server"]

    %% Core Runtime Dependencies
    RhoaiMCP -->|"MCP protocol"| MCP["mcp >=1.26.0"]
    RhoaiMCP -->|"plugin system"| Pluggy["pluggy >=1.6.0"]
    RhoaiMCP -->|"ASGI framework"| Starlette["starlette 1.6.0"]
    RhoaiMCP -->|"ASGI server"| Uvicorn["uvicorn 0.52.4"]
    RhoaiMCP -->|"data validation"| Pydantic["pydantic >=2.12.5"]

    %% Security Dependencies
    RhoaiMCP -->|"JWT auth"| PyJWT["PyJWT[crypto] >=2.12.1"]
    RhoaiMCP -->|"TLS/crypto"| Cryptography["cryptography 50.0.0"]

    %% Integration Dependencies
    RhoaiMCP -->|"K8s client"| Kubernetes["kubernetes >=35.0.0"]
    RhoaiMCP -->|"HTTP client"| HTTPX["httpx >=0.28.1"]
    RhoaiMCP -->|"SSE support"| SSEStarlette["sse-starlette 3.4.8"]

    %% Internal Platform Dependencies (Kubernetes CRDs)
    RhoaiMCP -->|"CRD CRUD"| KubeflowNotebooks["Kubeflow Notebooks<br/>(kubeflow.org)"]
    RhoaiMCP -->|"CRD Watch/CRUD"| KServe["KServe InferenceService<br/>(serving.kserve.io)"]
    RhoaiMCP -->|"CRD CRUD"| ServingRuntimes["ServingRuntimes<br/>(serving.kserve.io)"]
    RhoaiMCP -->|"CRD CRUD"| TrainJobs["Kubeflow TrainJobs<br/>(trainer.kubeflow.org)"]
    RhoaiMCP -->|"CRD Read"| TrainingRuntimes["TrainingRuntimes<br/>(trainer.kubeflow.org)"]
    RhoaiMCP -->|"CRD CRUD"| ClusterTrainingRuntimes["ClusterTrainingRuntimes<br/>(trainer.kubeflow.org)"]
    RhoaiMCP -->|"CRD CRUD"| DSPApps["DSP Applications<br/>(opendatahub.io)"]

    %% Platform Services
    RhoaiMCP -->|"HTTP/8080"| ModelRegistry["Model Registry<br/>model-registry.odh-model-registries.svc"]
    RhoaiMCP -->|"HTTP/8000"| PlannerBackend["Planner Backend<br/>backend.planner.svc"]

    %% Core Infrastructure
    RhoaiMCP -->|"HTTPS/6443"| K8sAPI["Kubernetes API Server"]

