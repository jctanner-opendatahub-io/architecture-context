graph LR
    DSP["Data Science Pipelines<br/>(ml-pipeline API Server)"]

    %% Core Execution Dependencies
    DSP -->|"workflow execution<br/>v3.7.14"| Argo["Argo Workflows<br/>argoproj.io"]
    DSP -->|"step execution<br/>pipeline-runner SA"| Driver["Driver + Launcher<br/>Go binaries"]

    %% Data Storage Dependencies
    DSP -->|"pipeline metadata<br/>3306/TCP"| MySQL["MySQL 8.4<br/>GORM driver"]
    DSP -->|"pipeline artifacts<br/>S3 API"| SeaweedFS["SeaweedFS<br/>S3-compatible"]
    DSP -->|"external artifacts<br/>AWS SDK v2"| ExtS3["External S3<br/>aws-sdk-go-v2"]
    DSP -.->|"alt DB backend<br/>pgx v5"| PostgreSQL["PostgreSQL<br/>(optional)"]

    %% Kubernetes Dependencies
    DSP -->|"TokenReview · SAR<br/>6443/HTTPS"| K8sAPI["Kubernetes API<br/>client-go v0.35.2"]
    DSP -->|"CRD management<br/>controller-runtime"| CRRuntime["controller-runtime<br/>v0.23.3"]

    %% ML Metadata Dependencies
    DSP -->|"ML Metadata<br/>gRPC/9090"| MLMD["ML Metadata Store<br/>ml_metadata 1.14.0"]
    MLMD -->|"gRPC proxy"| Envoy["Metadata Envoy<br/>Proxy"]

    %% API Framework Dependencies
    DSP -->|"gRPC services<br/>10 services"| gRPC["gRPC<br/>v1.82.1"]
    DSP -->|"REST gateway"| GRPCGateway["grpc-gateway<br/>v2.28.0"]
    DSP -->|"HTTP routing"| Mux["gorilla/mux<br/>v1.8.1"]

    %% Monitoring
    Prometheus["Prometheus"] -->|"scrape /metrics<br/>8888/HTTP"| DSP

    %% Internal RHOAI Integrations
    Dashboard["ODH Dashboard"] -->|"UI management"| DSP
    KFNotebooks["Kubeflow Notebooks<br/>kubeflow.org"] -.->|"workbench<br/>integration"| DSP

    %% Admission & Caching
    DSP -->|"admission webhooks<br/>8443/TLS"| Webhooks["Webhook Server<br/>cert-manager TLS"]
    DSP -->|"execution cache<br/>443/TCP"| CacheServer["Cache Server"]

    %% Supporting Components
    PersAgent["Persistence Agent"] -->|"sync state"| DSP
    SchedWF["Scheduled Workflow<br/>Controller"] -->|"trigger runs"| DSP
    MLUI["ml-pipeline-ui<br/>Node.js"] -->|"REST/8888"| DSP

    %% Build Dependencies
    DSP -.->|"FIPS crypto"| FIPS["Go FIPS 140<br/>GOFIPS140=v1.0.0"]
    DSP -.->|"base image"| UBI["ubi9/ubi-minimal-pqc<br/>PQC-enabled"]

