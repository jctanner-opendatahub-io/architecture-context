graph TD
    subgraph "Service Account (In-Cluster)"
        SA["kube-auth-proxy Pod<br/>ServiceAccount<br/>(auto-mounted token)"]
    end

    subgraph "Authentication Mechanisms"
        direction TB
        TokenReview["TokenReview API<br/>authentication.k8s.io/v1"]
        OAuthFlow["OAuth2/OIDC Flow<br/>Authorization Code"]
        BasicAuth["htpasswd Basic Auth"]
        JWTPassthrough["JWT Bearer Passthrough"]
    end

    subgraph "Kubernetes API Operations"
        TR["authentication.k8s.io<br/>TokenReview"]
    end

    subgraph "Token Validation Pipeline"
        Singleflight["Singleflight Dedup<br/>(concurrent request coalescing)"]
        Cache["TTL Cache<br/>(default: 10s)"]
        ReviewCall["doTokenReview<br/>(timeout: 30s)"]
    end

    subgraph "Session Management"
        CookieSession["Encrypted Cookie<br/>(default)"]
        RedisSession["Redis/Valkey Session<br/>(optional, TLS)"]
    end

    subgraph "Upstream Authorization Headers"
        XForwardedUser["X-Forwarded-User"]
        XForwardedEmail["X-Forwarded-Email"]
        XForwardedGroups["X-Forwarded-Groups"]
    end

    %% Flows
    SA -->|"In-cluster credentials"| TokenReview
    TokenReview -->|"POST /apis/authentication.k8s.io/v1/tokenreviews"| TR
    TR -->|"create"| ReviewCall

    SA -->|"Initiates"| OAuthFlow
    SA -->|"Validates"| BasicAuth
    SA -->|"Validates"| JWTPassthrough

    ReviewCall --> Singleflight
    Singleflight --> Cache
    Cache -->|"Cache miss"| TR

    TokenReview -->|"Authenticated identity"| CookieSession
    OAuthFlow -->|"Session token"| CookieSession
    OAuthFlow -->|"Session token"| RedisSession

    CookieSession --> XForwardedUser
    CookieSession --> XForwardedEmail
    CookieSession --> XForwardedGroups
    RedisSession --> XForwardedUser
    RedisSession --> XForwardedEmail
    RedisSession --> XForwardedGroups

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style TR fill:#f5a623,stroke:#333
    style TokenReview fill:#7ed321,stroke:#333
    style OAuthFlow fill:#7ed321,stroke:#333
    style BasicAuth fill:#7ed321,stroke:#333
    style JWTPassthrough fill:#7ed321,stroke:#333
    style Singleflight fill:#dae8fc,stroke:#6c8ebf
    style Cache fill:#dae8fc,stroke:#6c8ebf
    style ReviewCall fill:#dae8fc,stroke:#6c8ebf
    style CookieSession fill:#f5a623,stroke:#333
    style RedisSession fill:#f5a623,stroke:#333
    style XForwardedUser fill:#d5e8d4,stroke:#82b366
    style XForwardedEmail fill:#d5e8d4,stroke:#82b366
    style XForwardedGroups fill:#d5e8d4,stroke:#82b366
