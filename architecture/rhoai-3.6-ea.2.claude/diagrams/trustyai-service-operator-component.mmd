graph TB
    subgraph Operator["TrustyAI Service Operator"]
        direction TB
        Manager["Manager Process<br/>/manager"]

        subgraph Controllers["Controllers"]
            direction LR
            TASCtrl["TrustyAIService<br/>Reconciler"]
            EvalHubCtrl["EvalHub<br/>Reconciler"]
            GorchCtrl["GuardrailsOrchestrator<br/>Reconciler"]
            LMEvalCtrl["LMEvalJob<br/>Reconciler"]
            NemoCtrl["NemoGuardrails<br/>Reconciler"]
            TrustyAIModCtrl["TrustyAI Module<br/>Reconciler"]
            ProfileWatcher["ProfileWatcher<br/>(APIServer TLS)"]
        end

        subgraph Support["Support Components"]
            direction LR
            Webhook["Conversion Webhook<br/>:9443 /convert"]
            Metrics["Metrics Server<br/>(conditional auth)"]
            Tracing["OTLP Tracing<br/>(gRPC/HTTP)"]
            DSCConfig["DSC Config Reader<br/>trustyai-dsc-config"]
        end

        Manager --> Controllers
        Manager --> Support
    end

    subgraph CRDs["Custom Resources"]
        direction LR
        TrustyAISvc["TrustyAIService CR<br/>trustyai.opendatahub.io/v1"]
        EvalHubCR["EvalHub CR<br/>trustyai.opendatahub.io/v1"]
        GorchCR["GuardrailsOrchestrator CR<br/>trustyai.opendatahub.io/v1alpha1"]
        LMEvalCR["LMEvalJob CR<br/>trustyai.opendatahub.io/v1alpha1"]
        NemoCR["NemoGuardrails CR<br/>trustyai.opendatahub.io/v1alpha1"]
        TrustyAICR["TrustyAI CR<br/>components.platform/v1alpha1"]
    end

    subgraph Created["Created Resources"]
        direction LR
        TASDeployment["TrustyAI Deployment<br/>+ kube-rbac-proxy sidecar"]
        TLSService["ClusterIP Service<br/>443→8443 TLS"]
        Route["OpenShift Route<br/>HTTPS"]
        VirtualSvc["Istio VirtualService"]
        EvalPods["Evaluation Pods<br/>+ PVC Storage"]
        ServiceMonitor["ServiceMonitor<br/>(Prometheus)"]
    end

    User["User / Platform"] -->|creates| CRDs

    TrustyAISvc -->|watched by| TASCtrl
    EvalHubCR -->|watched by| EvalHubCtrl
    GorchCR -->|watched by| GorchCtrl
    LMEvalCR -->|watched by| LMEvalCtrl
    NemoCR -->|watched by| NemoCtrl
    TrustyAICR -->|watched by| TrustyAIModCtrl

    TASCtrl -->|creates| TASDeployment
    TASCtrl -->|creates| TLSService
    TASCtrl -->|creates| Route
    TASCtrl -->|creates| VirtualSvc
    EvalHubCtrl -->|creates| EvalPods
    EvalHubCtrl -->|creates| ServiceMonitor
    LMEvalCtrl -->|creates| EvalPods

    GorchCtrl -->|watches| InferenceService["KServe<br/>InferenceService"]
    ProfileWatcher -->|reads| APIServer["OpenShift<br/>APIServer Config"]
    DSCConfig -->|reads| ConfigMap["trustyai-dsc-config<br/>ConfigMap"]

    Tracing -->|exports to| OTelCollector["OpenTelemetry<br/>Collector"]
    ServiceMonitor -->|scraped by| Prometheus["Prometheus"]

    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style TASCtrl fill:#4a90e2,stroke:#333,color:#fff
    style EvalHubCtrl fill:#4a90e2,stroke:#333,color:#fff
    style GorchCtrl fill:#4a90e2,stroke:#333,color:#fff
    style LMEvalCtrl fill:#4a90e2,stroke:#333,color:#fff
    style NemoCtrl fill:#4a90e2,stroke:#333,color:#fff
    style TrustyAIModCtrl fill:#4a90e2,stroke:#333,color:#fff
    style ProfileWatcher fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#7ed321,stroke:#333,color:#fff
    style Metrics fill:#7ed321,stroke:#333,color:#fff
    style Tracing fill:#7ed321,stroke:#333,color:#fff
    style DSCConfig fill:#7ed321,stroke:#333,color:#fff
    style TrustyAISvc fill:#f5a623,stroke:#333
    style EvalHubCR fill:#f5a623,stroke:#333
    style GorchCR fill:#f5a623,stroke:#333
    style LMEvalCR fill:#f5a623,stroke:#333
    style NemoCR fill:#f5a623,stroke:#333
    style TrustyAICR fill:#f5a623,stroke:#333
    style InferenceService fill:#e8e8e8,stroke:#333
    style APIServer fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#e8e8e8,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
