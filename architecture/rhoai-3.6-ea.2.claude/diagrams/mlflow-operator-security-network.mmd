graph TB
    subgraph OperatorPod["OPERATOR POD (mlflow-operator-controller-manager)<br/>SA: mlflow-operator-controller-manager<br/>FIPS: strictfipsruntime + ubi9-pqc"]
        direction TB

        subgraph Endpoints["Listening Endpoints"]
            Health[":8081/healthz<br/>HTTP, No Auth"]
            Ready[":8081/readyz<br/>HTTP, No Auth"]
            Metrics[":8443/metrics<br/>HTTPS, TLS<br/>TokenReview + SAR"]
        end

        subgraph InternalControllers["Controllers"]
            MLflowCtrl["MLflowReconciler"]
            MLflowOpCtrl["MLflowOperatorReconciler"]
            NSRBACCtrl["NamespaceRBACReconciler"]
        end
    end

    subgraph K8sAPIServer["KUBERNETES API SERVER"]
        KAPI["kube-apiserver<br/>:6443/TCP<br/>HTTPS/WSS, TLS 1.2+"]
    end

    subgraph WatchedCRDs["WATCHED CRDs"]
        MLflowCR["MLflow CR<br/>mlflow.opendatahub.io/v1"]
        MLflowOpCR["MLflowOperator CR<br/>components.platform.opendatahub.io/v1α1"]
        MLflowConfigCR["MLflowConfig CR<br/>mlflow.kubeflow.org/v1"]
        AuthCR["Auth CR<br/>services.platform.opendatahub.io/v1α1"]
    end

    subgraph OwnedResources["OWNED RESOURCES (Helm-rendered)"]
        Deploys["Deployments"]
        Svcs["Services"]
        SAs["ServiceAccounts"]
        PVCs["PVCs"]
        NetPols["NetworkPolicies"]
        CronJobs["CronJobs/Jobs"]
    end

    subgraph ConditionalAPIs["CONDITIONAL INTEGRATIONS (Discovery-Gated)"]
        HTTPRoute["HTTPRoute<br/>gateway.networking.k8s.io/v1<br/>HTTPS, TLS 1.2+"]
        ConsoleLink["ConsoleLink<br/>console.openshift.io/v1<br/>HTTPS, TLS 1.2+"]
        SvcMonitor["ServiceMonitor<br/>monitoring.coreos.com/v1<br/>HTTPS, TLS 1.2+"]
    end

    subgraph WorkspaceNS["WORKSPACE NAMESPACES"]
        ViewRB["mlflow-view<br/>RoleBinding"]
        EditRB["mlflow-edit<br/>RoleBinding"]
    end

    MetricsSvc["ClusterIP Service<br/>:8443/TCP → :8443<br/>Metrics"]

    %% Flows
    MLflowCtrl -->|"HTTPS/WSS :6443<br/>TLS 1.2+<br/>SA token"| KAPI
    MLflowOpCtrl -->|"HTTPS/WSS :6443<br/>TLS 1.2+<br/>SA token"| KAPI
    NSRBACCtrl -->|"HTTPS/WSS :6443<br/>TLS 1.2+<br/>SA token"| KAPI

    KAPI -->|watch events| WatchedCRDs
    MLflowCtrl -->|creates/updates| OwnedResources
    MLflowCtrl -->|creates if CRD present| ConditionalAPIs
    NSRBACCtrl -->|propagates RBAC| WorkspaceNS

    MetricsSvc -->|"TCP :8443<br/>TLS"| Metrics

    %% Styling
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8sapi fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef crd fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef owned fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef conditional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef rbac fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef endpoint fill:#d5e8d4,stroke:#82b366

    class MLflowCtrl,MLflowOpCtrl,NSRBACCtrl operator
    class KAPI k8sapi
    class MLflowCR,MLflowOpCR,MLflowConfigCR,AuthCR crd
    class Deploys,Svcs,SAs,PVCs,NetPols,CronJobs owned
    class HTTPRoute,ConsoleLink,SvcMonitor conditional
    class ViewRB,EditRB rbac
    class Health,Ready,Metrics endpoint
