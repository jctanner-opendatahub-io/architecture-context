graph TB
    subgraph "llm-d-inference-payload-processor"
        direction TB
        subgraph "Core Server"
            ExtProcServer["ExtProc gRPC Server<br/>port 9004"]
            HealthServer["Health gRPC Server<br/>port 9005"]
            MetricsServer["Metrics HTTP Server<br/>port 9090"]
        end

        subgraph "Plugin Pipeline"
            direction LR
            PreProcessors["Pre-Processors<br/>body-field-to-header<br/>base-model-extractor<br/>model-group-filter"]
            ProfilePicker["Profile Picker<br/>scoring-based selection<br/>session affinity<br/>cost guard"]
            PostProcessors["Post-Processors<br/>response header injection<br/>metadata extraction"]
        end

        subgraph "Controller Runtime"
            Manager["controller-runtime Manager"]
            ConfigMapReconciler["ConfigMap Reconciler<br/>base-model resolution"]
        end

        Manager -->|coordinates| ExtProcServer
        Manager -->|coordinates| HealthServer
        Manager -->|coordinates| MetricsServer
        ConfigMapReconciler -->|updates| PreProcessors
    end

    %% CRD
    PayloadProcessorConfigCR["PayloadProcessorConfig CR<br/>llm-d.ai/v1alpha1"]
    PayloadProcessorConfigCR -->|configures| ExtProcServer

    %% External interactions
    EnvoyProxy["Envoy Proxy<br/>envoyproxy/envoy:distroless-v1.33.2"] -->|gRPC ExtProc callout| ExtProcServer
    ExtProcServer -->|pre-process| PreProcessors
    PreProcessors -->|select| ProfilePicker
    ProfilePicker -->|post-process| PostProcessors
    PostProcessors -->|response| ExtProcServer

    %% Dependencies
    ConfigMapReconciler -->|watches| K8sAPI["Kubernetes API<br/>port 6443"]
    ConfigMapReconciler -->|reads| ConfigMaps["ConfigMaps<br/>model mappings"]

    %% Model servers
    EnvoyProxy -->|forwards to| VLLMDeepseek["vllm-deepseek-r1<br/>port 8000"]
    EnvoyProxy -->|forwards to| VLLMLlama["vllm-llama3-8b-instruct<br/>port 8000"]

    %% Library dependency
    LLMDRouter["llm-d-router<br/>v0.10.0<br/>(Go library)"] -.->|shared plugin types| ExtProcServer

    %% Clients
    Client["External Client"] -->|inference request| EnvoyProxy

    %% Monitoring
    Prometheus["Prometheus"] -->|scrapes| MetricsServer

    %% Styling
    style ExtProcServer fill:#4a90e2,stroke:#333,color:#fff
    style HealthServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style PreProcessors fill:#50c878,stroke:#333,color:#fff
    style ProfilePicker fill:#50c878,stroke:#333,color:#fff
    style PostProcessors fill:#50c878,stroke:#333,color:#fff
    style Manager fill:#4a90e2,stroke:#333,color:#fff
    style ConfigMapReconciler fill:#4a90e2,stroke:#333,color:#fff
    style PayloadProcessorConfigCR fill:#f5a623,stroke:#333,color:#fff
    style EnvoyProxy fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ConfigMaps fill:#f5a623,stroke:#333
    style VLLMDeepseek fill:#e8e8e8,stroke:#333
    style VLLMLlama fill:#e8e8e8,stroke:#333
    style LLMDRouter fill:#7ed321,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style Prometheus fill:#e8e8e8,stroke:#333
