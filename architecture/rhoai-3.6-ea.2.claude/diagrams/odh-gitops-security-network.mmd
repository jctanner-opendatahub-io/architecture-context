graph TB
    subgraph Admin["CLUSTER ADMIN (Trusted)"]
        ClusterAdmin["Cluster Administrator<br/><i>kubeconfig / cluster-admin</i>"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>x509 / Bearer / OIDC"]
    end

    subgraph SecurityZone["SECURITY COMPONENTS"]
        direction TB
        subgraph NS_CertManager["Namespace: cert-manager"]
            CertManager["cert-manager<br/><i>TLS certificate lifecycle</i>"]
        end
        subgraph NS_Kuadrant["Namespace: kuadrant-system"]
            Kuadrant["Kuadrant CR<br/><i>API gateway control plane</i>"]
            Authorino["Authorino<br/><i>Cluster-wide authz</i><br/>Listener: TLS ✓<br/>OIDC: TLS ✗"]
        end
    end

    subgraph NetworkZone["NETWORK COMPONENTS (XKS only)"]
        direction LR
        Sail["Sail Operator<br/>(Istio)<br/><i>Service mesh / mTLS</i>"]
        GatewayAPI["Gateway API CRDs<br/><i>Ingress routing</i>"]
    end

    subgraph SchedulingZone["SCHEDULING COMPONENTS"]
        direction LR
        Kueue["Kueue Operator<br/><i>Job scheduling</i>"]
        JobSet["JobSet Operator<br/><i>Multi-pod jobs</i>"]
        LWS["LeaderWorkerSet<br/><i>Distributed workloads</i>"]
    end

    subgraph ObservabilityZone["OBSERVABILITY COMPONENTS"]
        direction LR
        OTel["OpenTelemetry<br/><i>Tracing</i>"]
        Tempo["Tempo<br/><i>Trace storage</i>"]
        ClusterObs["Cluster Observability<br/><i>Monitoring</i>"]
        CMA["Custom Metrics<br/>Autoscaler"]
    end

    subgraph GPUZone["GPU COMPONENTS (Optional)"]
        direction LR
        NFD["Node Feature Discovery"]
        NVIDIA["NVIDIA GPU Operator"]
    end

    %% Flows
    ClusterAdmin -->|"helm install / kustomize apply<br/>TLS to API server"| APIServer
    APIServer -->|"Subscription CRs (OLM)<br/>or Helm releases"| SecurityZone
    APIServer -->|"Subscription CRs (OLM)<br/>or Helm releases"| SchedulingZone
    APIServer -->|"Subscription CRs (OLM)"| ObservabilityZone
    APIServer -.->|"Helm sub-charts<br/>(XKS only)"| NetworkZone
    APIServer -.->|"Subscription CRs<br/>(Optional)"| GPUZone

    CertManager -->|"Issues<br/>authorino-server-cert"| Authorino
    Kuadrant -->|"Manages"| Authorino

    %% Styling
    classDef admin fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef security fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef network fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef scheduling fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef gpu fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class ClusterAdmin admin
    class APIServer controlplane
    class CertManager,Kuadrant,Authorino security
    class Sail,GatewayAPI network
    class Kueue,JobSet,LWS scheduling
    class OTel,Tempo,ClusterObs,CMA observability
    class NFD,NVIDIA gpu
