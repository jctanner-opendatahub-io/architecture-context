graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["kserve-controller-manager"]
        SA_LLMISVC["$(llmisvc-serviceAccountName)"]
        SA_LocalModel["kserve-localmodel-<br/>controller-manager"]
        SA_LocalModelNode["kserve-localmodelnode-<br/>agent"]
        SA_Module["kserve-module-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["kserve-manager-<br/>rolebinding"]
        CRB_Proxy["kserve-proxy-<br/>rolebinding"]
        CRB_LLMISVC["llmisvc-manager-<br/>rolebinding"]
        CRB_LocalModel["kserve-localmodel-<br/>manager-rolebinding"]
        CRB_LocalModelNode["kserve-localmodelnode-<br/>agent-rolebinding"]
        CRB_Module["kserve-module-<br/>manager-rolebinding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["kserve-manager-role"]
        CR_Proxy["kserve-proxy-role"]
        CR_LLMISVC["kserve-llmisvc-<br/>manager-role"]
        CR_LocalModel["kserve-localmodel-<br/>manager-role"]
        CR_LocalModelNode["kserve-localmodelnode-<br/>agent-role"]
        CR_Module["kserve-module-<br/>manager-role"]
    end

    subgraph ManagerResources["kserve-manager-role Resources"]
        MR_ISvc["serving.kserve.io<br/>InferenceService<br/>InferenceGraph<br/>TrainedModel<br/>ClusterServingRuntime<br/>ServingRuntime"]
        MR_K8s["core: Services, Events<br/>Deployments, ConfigMaps<br/>ServiceAccounts, Secrets"]
        MR_Ingress["HTTPRoutes<br/>VirtualServices<br/>Ingresses<br/>OpenShift Routes"]
        MR_Scale["HPAs<br/>KEDA ScaledObjects<br/>OTel Collectors"]
        MR_Knative["knative Services"]
    end

    subgraph LLMISVCResources["kserve-llmisvc-manager-role Resources"]
        LR_LLMISVC["serving.kserve.io<br/>LLMInferenceService<br/>LLMInferenceServiceConfig"]
        LR_Gateway["Gateway API<br/>Gateways, GatewayClasses<br/>HTTPRoutes"]
        LR_Inference["inference.networking.k8s.io<br/>InferenceModels<br/>InferencePools"]
        LR_Scale["HPAs, KEDA<br/>LeaderWorkerSets"]
        LR_Monitor["PodMonitors<br/>ServiceMonitors"]
        LR_Auth["TokenReviews<br/>SubjectAccessReviews"]
    end

    subgraph LocalModelResources["kserve-localmodel-manager-role Resources"]
        LMR_Cache["LocalModelCaches<br/>LocalModelNamespaceCaches<br/>LocalModelNodes"]
        LMR_Storage["PersistentVolumes<br/>PersistentVolumeClaims"]
        LMR_Nodes["Nodes<br/>(get, list, watch)"]
    end

    subgraph ModuleResources["kserve-module-manager-role Resources"]
        ModR_Platform["components.platform<br/>Kserves (CR)"]
        ModR_CRDs["CustomResourceDefinitions<br/>(install/update)"]
        ModR_Webhooks["MutatingWebhookConfigs<br/>ValidatingWebhookConfigs"]
        ModR_CertMgr["cert-manager<br/>Certificates, Issuers"]
        ModR_RBAC["ClusterRoles, Roles<br/>RoleBindings<br/>(escalate, bind)"]
        ModR_Security["SecurityContextConstraints<br/>NetworkPolicies"]
        ModR_Runtime["ClusterServingRuntimes<br/>ClusterStorageContainers<br/>NIM Accounts"]
    end

    subgraph ProxyResources["kserve-proxy-role Resources"]
        PR_Auth["TokenReviews<br/>SubjectAccessReviews<br/>(create only)"]
    end

    %% SA → Binding → Role
    SA_Manager -->|bound via| CRB_Manager
    SA_Manager -->|bound via| CRB_Proxy
    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy

    SA_LLMISVC -->|bound via| CRB_LLMISVC
    CRB_LLMISVC -->|grants| CR_LLMISVC

    SA_LocalModel -->|bound via| CRB_LocalModel
    CRB_LocalModel -->|grants| CR_LocalModel

    SA_LocalModelNode -->|bound via| CRB_LocalModelNode
    CRB_LocalModelNode -->|grants| CR_LocalModelNode

    SA_Module -->|bound via| CRB_Module
    CRB_Module -->|grants| CR_Module

    %% Role → Resources
    CR_Manager -->|"full CRUD + watch"| MR_ISvc
    CR_Manager -->|"full CRUD + watch"| MR_K8s
    CR_Manager -->|"full CRUD + watch"| MR_Ingress
    CR_Manager -->|"full CRUD + watch"| MR_Scale
    CR_Manager -->|"full CRUD + watch"| MR_Knative

    CR_LLMISVC -->|"full CRUD + watch"| LR_LLMISVC
    CR_LLMISVC -->|"full CRUD + watch"| LR_Gateway
    CR_LLMISVC -->|"full CRUD + watch"| LR_Inference
    CR_LLMISVC -->|"full CRUD + watch"| LR_Scale
    CR_LLMISVC -->|"full CRUD + watch"| LR_Monitor
    CR_LLMISVC -->|"create"| LR_Auth

    CR_LocalModel -->|"full CRUD + watch"| LMR_Cache
    CR_LocalModel -->|"full CRUD + watch"| LMR_Storage
    CR_LocalModel -->|"read"| LMR_Nodes

    CR_Module -->|"full CRUD + watch"| ModR_Platform
    CR_Module -->|"full CRUD + watch"| ModR_CRDs
    CR_Module -->|"full CRUD + watch"| ModR_Webhooks
    CR_Module -->|"full CRUD + watch"| ModR_CertMgr
    CR_Module -->|"CRUD + escalate + bind"| ModR_RBAC
    CR_Module -->|"full CRUD + watch"| ModR_Security
    CR_Module -->|"full CRUD + watch"| ModR_Runtime

    CR_Proxy -->|"create"| PR_Auth

    %% Styling
    style SA_Manager fill:#4a90e2,color:#fff
    style SA_LLMISVC fill:#4a90e2,color:#fff
    style SA_LocalModel fill:#4a90e2,color:#fff
    style SA_LocalModelNode fill:#4a90e2,color:#fff
    style SA_Module fill:#4a90e2,color:#fff

    style CR_Manager fill:#f5a623,color:#fff
    style CR_Proxy fill:#f5a623,color:#fff
    style CR_LLMISVC fill:#f5a623,color:#fff
    style CR_LocalModel fill:#f5a623,color:#fff
    style CR_LocalModelNode fill:#f5a623,color:#fff
    style CR_Module fill:#e74c3c,color:#fff

    style MR_ISvc fill:#7ed321,color:#fff
    style MR_K8s fill:#7ed321,color:#fff
    style MR_Ingress fill:#7ed321,color:#fff
    style MR_Scale fill:#7ed321,color:#fff
    style MR_Knative fill:#7ed321,color:#fff

    style LR_LLMISVC fill:#7ed321,color:#fff
    style LR_Gateway fill:#7ed321,color:#fff
    style LR_Inference fill:#7ed321,color:#fff
    style LR_Scale fill:#7ed321,color:#fff
    style LR_Monitor fill:#7ed321,color:#fff
    style LR_Auth fill:#e74c3c,color:#fff

    style LMR_Cache fill:#7ed321,color:#fff
    style LMR_Storage fill:#7ed321,color:#fff
    style LMR_Nodes fill:#7ed321,color:#fff

    style ModR_Platform fill:#7ed321,color:#fff
    style ModR_CRDs fill:#7ed321,color:#fff
    style ModR_Webhooks fill:#7ed321,color:#fff
    style ModR_CertMgr fill:#7ed321,color:#fff
    style ModR_RBAC fill:#e74c3c,color:#fff
    style ModR_Security fill:#e74c3c,color:#fff
    style ModR_Runtime fill:#7ed321,color:#fff

    style PR_Auth fill:#e74c3c,color:#fff
