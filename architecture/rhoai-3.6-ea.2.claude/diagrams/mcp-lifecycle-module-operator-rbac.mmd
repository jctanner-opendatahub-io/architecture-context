    style SA_Module fill:#4a90e2,stroke:#333,color:#fff
    style SA_Operand fill:#7ed321,stroke:#333,color:#fff
    style CR_Module fill:#f5a623,stroke:#333,color:#fff
    style CR_Operand fill:#f5a623,stroke:#333,color:#fff
    style CR_Metrics fill:#f5a623,stroke:#333,color:#fff
    style R_Leader fill:#f5a623,stroke:#333,color:#fff
