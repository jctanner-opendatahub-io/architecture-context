graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        K8sAPI["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount RBAC"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB
        Manager["TrustyAI Operator Manager<br/>SA: trustyai-operator-module-controller-manager<br/>Image: UBI9 PQC (FIPS)"]
        Webhook["Conversion Webhook<br/>9443/TCP HTTPS<br/>TLS (cert from Secret)<br/>K8s Admission Auth"]
        HealthOp["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
        MetricsSrv["Metrics Server<br/>HTTPS (conditional)<br/>K8s Token Delegation"]
    end

    subgraph UserNS["USER NAMESPACE ({namespace})"]
        direction TB

        subgraph TrustyAIPod["TrustyAI Service Pod"]
            TrustyAI["trustyai-service<br/>8443/TCP HTTPS"]
            RBACProxy["kube-rbac-proxy<br/>sidecar"]
        end

        ClusterSvc["ClusterIP Service<br/>443/TCP → 8443/TCP<br/>Internal"]
        OShiftRoute["OpenShift Route<br/>HTTPS TLS<br/>External"]
        IstioVS["Istio VirtualService<br/>HTTP<br/>External"]
        EvalPod["Evaluation Pods<br/>PVC Storage<br/>Kueue Scheduled"]
        HealthUser["Health Probes<br/>8080/TCP HTTP<br/>No Auth"]
    end

    subgraph PlatformSvc["PLATFORM SERVICES (Internal)"]
        direction TB
        APIServerCfg["OpenShift APIServer<br/>TLS Profile Config"]
        ODHOperator["OpenDataHub Operator<br/>trustyai-dsc-config CM"]
        KServe["KServe InferenceService<br/>Model Serving State"]
        PromOperator["Prometheus Operator<br/>ServiceMonitor CRDs"]
        Kueue["Kueue<br/>Workload Scheduling"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        OTel["OpenTelemetry Collector<br/>OTLP gRPC/HTTP<br/>Runtime Configured"]
        Prometheus["Prometheus<br/>Scrapes ServiceMonitors<br/>Token Delegation Auth"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>Bearer Token"| K8sAPI
    K8sAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| Manager
    K8sAPI -->|"HTTPS/9443<br/>TLS<br/>Admission mTLS"| Webhook

    Manager -->|"creates resources"| TrustyAIPod
    Manager -->|"creates"| ClusterSvc
    Manager -->|"creates"| OShiftRoute
    Manager -->|"creates"| IstioVS
    Manager -->|"creates"| EvalPod

    TrustyAI --- RBACProxy
    ClusterSvc -->|"443→8443<br/>TLS"| TrustyAI
    OShiftRoute -->|"HTTPS/TLS"| ClusterSvc
    IstioVS -->|"HTTP"| ClusterSvc

    Manager -->|"read TLS profile<br/>10s timeout"| APIServerCfg
    Manager -->|"read ConfigMap<br/>eval policies"| ODHOperator
    Manager -->|"watch<br/>InferenceService"| KServe
    Manager -->|"CRUD<br/>ServiceMonitor"| PromOperator
    Manager -->|"watch<br/>Workload"| Kueue

    Manager -->|"OTLP gRPC/HTTP<br/>traces + metrics"| OTel
    Prometheus -->|"scrape<br/>Token Delegation"| MetricsSrv

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8scontrol fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operatorns fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef userns fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platformsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef externalsvc fill:#ffe6cc,stroke:#d79b00,stroke-width:2px

    class User external
    class K8sAPI k8scontrol
    class Manager,Webhook,HealthOp,MetricsSrv operatorns
    class TrustyAI,RBACProxy,ClusterSvc,OShiftRoute,IstioVS,EvalPod,HealthUser userns
    class APIServerCfg,ODHOperator,KServe,PromOperator,Kueue platformsvc
    class OTel,Prometheus externalsvc
