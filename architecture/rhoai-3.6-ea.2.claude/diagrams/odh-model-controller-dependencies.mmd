graph LR
    ODHModelCtrl["odh-model-controller<br/>Operator"]

    %% Platform CRD Dependencies (Watched)
    ODHModelCtrl -->|"watches CRDs"| KServe["KServe<br/>InferenceService, ServingRuntime,<br/>InferenceGraph, LLMInferenceService"]
    ODHModelCtrl -->|"watches CRDs"| DSC["DataScienceCluster /<br/>DSCInitialization CRs"]
    ODHModelCtrl -->|"watches CRDs"| OSAPIServer["OpenShift APIServer CR<br/>(TLS Profile)"]

    %% External Dependencies (Creates/Manages resources)
    ODHModelCtrl -->|"creates EnvoyFilters"| Istio["Istio<br/>Service Mesh"]
    ODHModelCtrl -->|"creates Gateway, HTTPRoute"| GatewayAPI["Gateway API<br/>v1.5.1"]
    ODHModelCtrl -->|"creates AuthPolicies"| Kuadrant["Kuadrant<br/>v1.4.2"]
    ODHModelCtrl -->|"creates TriggerAuth"| KEDA["KEDA<br/>v2.18.3"]
    ODHModelCtrl -->|"creates ServiceMonitor,<br/>PodMonitor"| PromOperator["Prometheus Operator<br/>v0.89.0"]

    %% Certificate Provider
    ODHModelCtrl -.->|"cert provisioning"| ServiceCA["OpenShift service-ca<br/>(TLS certificates)"]

    %% Observability
    ODHModelCtrl -.->|"OTLP/gRPC traces"| OTel["OpenTelemetry<br/>Collector"]

    %% Core Kubernetes
    ODHModelCtrl -->|"CRUD resources"| K8sAPI["Kubernetes API<br/>v0.35.3"]

    %% NIM Integration
    ODHModelCtrl -->|"manages NIM Account CRs"| NIM["NVIDIA NIM<br/>Account Integration"]

    %% Internal ODH components that integrate with this operator
    Dashboard["ODH Dashboard"] -.->|"UI management"| ODHModelCtrl
    KServeCtrl["KServe Controller"] -.->|"co-manages<br/>InferenceServices"| ODHModelCtrl

    %% Runtime Framework
    ODHModelCtrl -->|"built on"| CtrlRuntime["controller-runtime<br/>v0.23.3"]
    ODHModelCtrl -->|"built with"| Go["Go 1.25.8<br/>FIPS: strictfipsruntime"]

    %% Styling
    style ODHModelCtrl fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    style KServe fill:#7ed321,stroke:#333,color:#fff
    style DSC fill:#7ed321,stroke:#333,color:#fff
    style Dashboard fill:#7ed321,stroke:#333,color:#fff
    style KServeCtrl fill:#7ed321,stroke:#333,color:#fff

    style Istio fill:#999,stroke:#333,color:#fff
    style GatewayAPI fill:#999,stroke:#333,color:#fff
    style Kuadrant fill:#999,stroke:#333,color:#fff
    style KEDA fill:#999,stroke:#333,color:#fff
    style PromOperator fill:#999,stroke:#333,color:#fff
    style ServiceCA fill:#999,stroke:#333,color:#fff
    style OTel fill:#999,stroke:#333,color:#fff
    style OSAPIServer fill:#999,stroke:#333,color:#fff
