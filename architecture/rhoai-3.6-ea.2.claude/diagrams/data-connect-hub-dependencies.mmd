graph LR
    DCH["Data Connect Hub<br/>Operator"]

    %% Runtime Frameworks
    DCH -->|"operator framework"| CR["controller-runtime<br/>v0.24.1"]
    DCH -->|"REST framework"| Actix["actix-web<br/>(Rust)"]
    DCH -->|"data transport"| Arrow["Apache Arrow<br/>+ Arrow Flight"]

    %% Kubernetes Dependencies
    DCH -->|"K8s client"| K8sClient["k8s.io/client-go<br/>v0.36.0"]
    DCH -->|"K8s API types"| K8sAPI["k8s.io/api<br/>v0.36.0"]
    DCH -->|"manifest rendering"| Kustomize["sigs.k8s.io/kustomize<br/>v0.21.1"]
    DCH -->|"routing"| GatewayAPI["sigs.k8s.io/gateway-api<br/>v1.3.0"]

    %% Security / TLS
    DCH -->|"TLS (Rust)"| Rustls["rustls 0.23<br/>+ aws_lc_rs"]
    DCH -->|"HTTP client"| Reqwest["reqwest<br/>(rustls-tls)"]
    DCH -->|"gRPC"| Tonic["tonic + prost"]
    DCH -->|"auth proxy"| KRBP["kube-rbac-proxy"]

    %% Internal Platform Dependencies
    DCH -->|"routing domain"| OSIngress["OpenShift<br/>Ingress Config"]
    DCH -->|"ingress config"| OSIngressCtrl["OpenShift<br/>IngressController"]
    DCH -->|"route management"| GW["Gateway API<br/>Gateway + HTTPRoute"]

    %% Backend Connectors
    DCH -->|"PostgreSQL"| SQLx["sqlx"]
    DCH -->|"Elasticsearch"| ESConn["elasticsearch<br/>connector"]
    DCH -->|"Milvus"| MilvusSDK["milvus-sdk-rust"]
    DCH -->|"Neo4j"| Neo4rs["neo4rs"]
    DCH -->|"S3/Object"| OpenDAL["opendal"]
    DCH -->|"caching"| Moka["moka"]

    %% Observability
    DCH -->|"metrics"| Prom["metrics-exporter<br/>-prometheus"]
    DCH -->|"tracing"| Tracing["tracing +<br/>tracing-subscriber"]

    %% Async Runtime
    DCH -->|"async runtime"| Tokio["tokio"]

    %% Styling
    style DCH fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style CR fill:#999,stroke:#333
    style Actix fill:#999,stroke:#333
    style Arrow fill:#999,stroke:#333
    style K8sClient fill:#999,stroke:#333
    style K8sAPI fill:#999,stroke:#333
    style Kustomize fill:#999,stroke:#333
    style GatewayAPI fill:#999,stroke:#333
    style Rustls fill:#e8744f,stroke:#333,color:#fff
    style Reqwest fill:#e8744f,stroke:#333,color:#fff
    style Tonic fill:#999,stroke:#333
    style KRBP fill:#e8744f,stroke:#333,color:#fff
    style OSIngress fill:#7ed321,stroke:#333
    style OSIngressCtrl fill:#7ed321,stroke:#333
    style GW fill:#7ed321,stroke:#333
    style SQLx fill:#f5a623,stroke:#333
    style ESConn fill:#f5a623,stroke:#333
    style MilvusSDK fill:#f5a623,stroke:#333
    style Neo4rs fill:#f5a623,stroke:#333
    style OpenDAL fill:#f5a623,stroke:#333
    style Moka fill:#f5a623,stroke:#333
    style Prom fill:#bbb,stroke:#333
    style Tracing fill:#bbb,stroke:#333
    style Tokio fill:#999,stroke:#333
