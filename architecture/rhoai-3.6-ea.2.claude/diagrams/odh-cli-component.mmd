graph TB
    subgraph "odh-cli (rhai-cli)"
        direction TB
        RootCmd[Root Command<br/>cmd/main.go]

        subgraph "Subcommands"
            Status[status]
            Diagnose[diagnose]
            Logs[logs]
            Events[events]
            Lint[lint]
            Deps[deps]
            Api[api]
            Get[get]
            Migrate[migrate]
            MCP[mcp serve]
        end

        subgraph "Unified Client Layer"
            direction LR
            ReaderIF["Reader Interface<br/>(read-only ops)"]
            WriterIF["Writer Interface<br/>(write ops)"]
            ClientIF["Client Interface<br/>(combined)"]
        end

        subgraph "Kubernetes Clients"
            direction LR
            DynClient[Dynamic Client]
            DiscClient[Discovery Client]
            ApiExtClient[API Extensions Client]
            OLMClient[OLM Client]
            TypedClient[Typed Core/Auth Client]
        end

        RootCmd --> Status
        RootCmd --> Diagnose
        RootCmd --> Logs
        RootCmd --> Events
        RootCmd --> Lint
        RootCmd --> Deps
        RootCmd --> Api
        RootCmd --> Get
        RootCmd --> Migrate
        RootCmd --> MCP

        Status --> ReaderIF
        Diagnose --> ReaderIF
        Lint --> ReaderIF
        Get --> ReaderIF
        Migrate --> WriterIF
        Migrate --> ReaderIF

        ReaderIF --> ClientIF
        WriterIF --> ClientIF
        ClientIF --> DynClient
        ClientIF --> DiscClient
        ClientIF --> ApiExtClient
        ClientIF --> OLMClient
        ClientIF --> TypedClient
    end

    ConfigFlags["ConfigFlags<br/>(kubeconfig, context,<br/>token, server)"]
    ConfigFlags -->|shared auth| RootCmd

    subgraph "Imported Libraries"
        ClusterHealth["opendatahub-operator<br/>clusterhealth"]
        FailureClassifier["opendatahub-operator<br/>failureclassifier"]
        MCPTools["opendatahub-operator<br/>mcptools"]
    end

    Diagnose -->|condition assessment| ClusterHealth
    Diagnose -->|error categorization| FailureClassifier
    MCP -->|tool definitions| MCPTools

    K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    OLM_Ext["OLM<br/>Subscriptions & CSVs"]
    TrustYAI["TrustYAI Service<br/>443/TCP HTTPS"]

    DynClient -->|REST| K8sAPI
    DiscClient -->|REST| K8sAPI
    TypedClient -->|REST| K8sAPI
    OLMClient -->|REST| OLM_Ext
    Migrate -->|HTTPS backup/restore| TrustYAI

    style RootCmd fill:#4a90e2,stroke:#333,color:#fff
    style ReaderIF fill:#7ed321,stroke:#333
    style WriterIF fill:#f5a623,stroke:#333
    style ClientIF fill:#4a90e2,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OLM_Ext fill:#e8e8e8,stroke:#333
    style TrustYAI fill:#e8e8e8,stroke:#333
    style ConfigFlags fill:#d5e8d4,stroke:#82b366
    style ClusterHealth fill:#7ed321,stroke:#333
    style FailureClassifier fill:#7ed321,stroke:#333
    style MCPTools fill:#7ed321,stroke:#333
