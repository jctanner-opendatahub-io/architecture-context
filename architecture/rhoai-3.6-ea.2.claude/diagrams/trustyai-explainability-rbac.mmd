graph TD
    subgraph "Service Account"
        SA["trustyai-serviceaccount<br/>(Namespace: {user-namespace})"]
    end

    subgraph "ClusterRole Binding"
        CRB["trustyai-clusterrolebinding<br/>(Cluster-scoped)"]
    end

    subgraph "ClusterRole"
        CR["trustyai-role"]
    end

    subgraph "API Resources"
        ConfigMaps["core (v1)<br/>configmaps"]
    end

    subgraph "Permitted Verbs"
        Create["create"]
        Delete["delete"]
        Get["get"]
        List["list"]
        Patch["patch"]
        Update["update"]
        Watch["watch"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"manages"| ConfigMaps

    ConfigMaps --> Create
    ConfigMaps --> Delete
    ConfigMaps --> Get
    ConfigMaps --> List
    ConfigMaps --> Patch
    ConfigMaps --> Update
    ConfigMaps --> Watch

    subgraph "Usage Context"
        direction TB
        InitUsage["Init Container uses SA to create<br/>model-serving-config ConfigMap<br/>that registers TrustyAI as<br/>KServe payload processor"]
    end

    CR -.->|"used by"| InitUsage

    subgraph "Application-Level Auth"
        direction TB
        NoAuth["NO APPLICATION-LEVEL AUTH<br/>No @RolesAllowed annotations<br/>No @Authenticated annotations<br/>No security context injection<br/>Access control: Platform-delegated<br/>(Route / NetworkPolicy / ServiceMesh)"]
    end

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#b8d4e3,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Create fill:#e8e8e8,stroke:#333
    style Delete fill:#e8e8e8,stroke:#333
    style Get fill:#e8e8e8,stroke:#333
    style List fill:#e8e8e8,stroke:#333
    style Patch fill:#e8e8e8,stroke:#333
    style Update fill:#e8e8e8,stroke:#333
    style Watch fill:#e8e8e8,stroke:#333
    style InitUsage fill:#fff2cc,stroke:#d6b656
    style NoAuth fill:#ffcccc,stroke:#cc0000,stroke-width:2px
