graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Platform User / Admin"]
    end

    subgraph ControlPlane["KUBERNETES CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE<br/>(mcp-lifecycle-operator-system)"]
        direction TB
        Controller["mcp-lifecycle-operator-controller-manager<br/>SA: mcp-lifecycle-operator-controller-manager<br/>FIPS: strictfipsruntime + CGO_ENABLED=1<br/>HTTP/2: Disabled (CVE mitigation)<br/>Base: ubi9/ubi-minimal-pqc"]

        subgraph Ports["Exposed Ports"]
            HealthPort["Health/Readiness Probes<br/>:8081/TCP HTTP<br/>No Auth (by design)"]
            MetricsPort["Metrics Endpoint<br/>:8443/TCP HTTPS<br/>Self-signed TLS<br/>TokenReview + SAR Auth"]
        end
    end

    subgraph ManagedResources["MANAGED RESOURCES (User Namespaces)"]
        direction TB
        MCPDeployment["MCP Server Deployment<br/>(owned, TLS env propagated)"]
        MCPService["MCP Server Service<br/>(owned)"]
        MCPNetPol["MCP Server NetworkPolicy<br/>(owned)"]
    end

    subgraph WatchedResources["WATCHED RESOURCES"]
        MCPServerCR["MCPServer CR<br/>mcp.x-k8s.io/v1alpha1<br/>Namespaced"]
        ConfigMaps["ConfigMaps<br/>(field-indexed watch)"]
        Secrets["Secrets<br/>(field-indexed watch)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus / Monitoring<br/>Scrapes metrics"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>User cert / Bearer"| K8sAPI

    %% API Server to Controller
    K8sAPI -->|"Watch events<br/>HTTPS/WSS<br/>TLS 1.2+<br/>SA token"| Controller

    %% Controller to API Server
    Controller -->|"CRUD operations<br/>HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    %% Watch sources
    MCPServerCR -.->|"Watch (For)"| Controller
    ConfigMaps -.->|"Watch (indexed)"| Controller
    Secrets -.->|"Watch (indexed)"| Controller

    %% Managed resource creation
    Controller -->|"Create/Update<br/>(ownership)"| MCPDeployment
    Controller -->|"Create/Update<br/>(ownership)"| MCPService
    Controller -->|"Create/Update<br/>(ownership)"| MCPNetPol

    %% Health probes
    Kubelet["Kubelet"] -->|"HTTP/8081<br/>No encryption<br/>No auth"| HealthPort

    %% Metrics
    Prometheus -->|"HTTPS/8443<br/>Self-signed TLS<br/>TokenReview + SAR"| MetricsPort

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px,color:#333
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px,color:#333
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#333
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px,color:#333
    classDef watched fill:#f8cecc,stroke:#b85450,stroke-width:2px,color:#333
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px,color:#333

    class User external
    class K8sAPI controlplane
    class Controller,HealthPort,MetricsPort operator
    class MCPDeployment,MCPService,MCPNetPol managed
    class MCPServerCR,ConfigMaps,Secrets watched
    class Prometheus,Kubelet monitoring
