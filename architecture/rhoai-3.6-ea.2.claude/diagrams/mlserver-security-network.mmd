graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph KServePod["KSERVE INFERENCESERVICE POD"]
        direction TB

        subgraph AuthBoundary["AUTHENTICATION BOUNDARY"]
            KRBP["kube-rbac-proxy Sidecar<br/>AuthN: OpenShift OAuth / SA Token<br/>AuthZ: RBAC Policy"]
        end

        subgraph Application["APPLICATION (No App-Level Auth)"]
            direction TB

            RESTServer["REST Server (FastAPI/uvicorn)<br/>8080/TCP | HTTP/1.1 | Plaintext<br/>Middleware: CORS, GZip, Prometheus<br/>V2 Inference Protocol endpoints"]

            GRPCServer["gRPC Server (grpc.aio)<br/>8081/TCP | HTTP/2 (gRPC) | Plaintext<br/>Interceptors: Logging, Prometheus<br/>add_insecure_port (no TLS)"]

            MetricsServer["Metrics Server<br/>8082/TCP | HTTP/1.1 | Plaintext<br/>No Auth | GET /metrics"]

            DataPlane["DataPlane Handler"]
        end

        subgraph RuntimeSecurity["RUNTIME SECURITY BOUNDARY"]
            TrustedList["trusted-runtimes.json<br/>/etc/mlserver/trusted-runtimes.json<br/>CPU: LightGBM, ONNX, sklearn, XGBoost<br/>CUDA: ONNX only"]
            Runtimes["Model Runtimes<br/>Framework-specific backends"]
        end

        RESTServer --> DataPlane
        GRPCServer --> DataPlane
        DataPlane --> TrustedList
        TrustedList -->|"allowlist filter"| Runtimes
    end

    subgraph LocalStorage["LOCAL STORAGE"]
        Models["/mnt/models<br/>MLSERVER_MODELS_DIR<br/>Provisioned by KServe"]
    end

    subgraph ObservabilityServices["OBSERVABILITY (Cluster-Internal)"]
        Prometheus["Prometheus<br/>Metrics scrape"]
        OTelCollector["OpenTelemetry Collector<br/>OTLP gRPC"]
    end

    %% External flows
    Client -->|"REST: HTTP/8080 or gRPC: HTTP2/8081<br/>TLS terminated by platform<br/>Auth: Bearer/SA Token"| KRBP
    KRBP -->|"Authenticated<br/>pod-internal localhost"| RESTServer
    KRBP -->|"Authenticated<br/>pod-internal localhost"| GRPCServer

    %% Internal flows
    Runtimes -->|"Local I/O<br/>Model artifacts"| Models

    %% Observability flows
    Prometheus -->|"HTTP/8082<br/>No Auth<br/>Plaintext"| MetricsServer
    Application -.->|"OTLP gRPC<br/>(when configured)"| OTelCollector

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef authboundary fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef application fill:#cce5ff,stroke:#0066cc,stroke-width:2px
    classDef runtimesec fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef observability fill:#e8e8e8,stroke:#666,stroke-width:1px

    class Client external
    class KRBP authboundary
    class RESTServer,GRPCServer,MetricsServer,DataPlane application
    class TrustedList,Runtimes runtimesec
    class Models storage
    class Prometheus,OTelCollector observability
