graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Gateway API)"]
        GW["Gateway API Gateway<br/>+ HTTPRoute<br/>HTTPS → Internal"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Trusted)"]
        direction TB

        subgraph NS_DCH["Namespace: {dataconnectservice-namespace}"]
            direction TB
            subgraph RestPod["REST Service Pod"]
                KRBPRest["kube-rbac-proxy<br/>(REST sidecar)<br/>HTTPS, TLS 1.2+<br/>TokenReview Auth"]
                RESTSvc["REST Service (actix-web)<br/>HTTP (localhost)<br/>X-Tenant-ID middleware"]
            end

            subgraph FlightPod["Flight Service Pod"]
                KRBPFlight["kube-rbac-proxy<br/>(Flight sidecar)<br/>HTTPS, TLS 1.2+<br/>TokenReview Auth"]
                FlightSvc["Flight Service<br/>(Arrow Flight)<br/>gRPC"]
            end

            NP["NetworkPolicy<br/>(operator-managed)"]
        end

        subgraph NS_Controller["Namespace: dc-controller-system"]
            Controller["dc-controller-manager<br/>SA: dc-controller-manager<br/>Leader Election: Lease"]
            MetricsSvc["Metrics Service<br/>8443/TCP<br/>TLS (self-signed)<br/>TokenReview + SAR Auth"]
        end
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP<br/>HTTPS, TLS 1.2+"]
        OSIngress["OpenShift Ingress Config<br/>config.openshift.io/v1"]
        OSIngressCtrl["IngressController<br/>operator.openshift.io/v1"]
    end

    subgraph BackendServices["BACKEND DATA SERVICES"]
        PG["PostgreSQL"]
        ES["Elasticsearch"]
        Milvus["Milvus"]
        Neo4j["Neo4j"]
        S3Store["S3 Storage"]
    end

    %% External flows
    Client -->|"HTTPS<br/>TLS 1.2+<br/>Bearer Token"| GW
    GW -->|"HTTPS<br/>TLS 1.2+<br/>Routed via HTTPRoute"| KRBPRest
    GW -->|"gRPC<br/>TLS 1.2+"| KRBPFlight

    %% Auth proxy to service
    KRBPRest -->|"HTTP (localhost)<br/>No encryption<br/>X-Tenant-ID + Auth passthrough"| RESTSvc
    KRBPFlight -->|"gRPC (localhost)<br/>No encryption"| FlightSvc

    %% kube-rbac-proxy to K8s API for TokenReview
    KRBPRest -.->|"TokenReview<br/>HTTPS/6443"| K8sAPI
    KRBPFlight -.->|"TokenReview<br/>HTTPS/6443"| K8sAPI

    %% Controller flows
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: dc-controller-manager"| K8sAPI
    Controller -->|"Read<br/>HTTPS/6443"| OSIngress
    Controller -->|"Read<br/>HTTPS/6443"| OSIngressCtrl
    Controller -->|"HTTP sync<br/>Internal"| RESTSvc

    %% Backend flows
    RESTSvc -->|"Backend-specific<br/>protocol & auth"| PG
    RESTSvc -->|"Backend-specific"| ES
    RESTSvc -->|"Backend-specific"| Milvus
    RESTSvc -->|"Backend-specific"| Neo4j
    RESTSvc -->|"Backend-specific"| S3Store

    %% Metrics
    MetricsSvc -.->|"TokenReview + SAR<br/>HTTPS/6443"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef authproxy fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef service fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef controller fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef backend fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef netpol fill:#e6e6e6,stroke:#666,stroke-dasharray:5

    class Client external
    class GW ingress
    class KRBPRest,KRBPFlight authproxy
    class RESTSvc,FlightSvc,MetricsSvc service
    class Controller controller
    class K8sAPI,OSIngress,OSIngressCtrl platform
    class PG,ES,Milvus,Neo4j,S3Store backend
    class NP netpol
