graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Clients["Users / API Clients /<br/>External Model Providers"]
    end

    subgraph Ingress["INGRESS (openshift-ingress namespace)"]
        direction TB

        subgraph DSG["data-science-gateway<br/>GatewayClass: data-science-gateway-class<br/>Owner: rhods-operator"]
            DSG_NB["Notebook HTTPRoutes<br/>443/TCP → 8080/TCP<br/>ext_authz + kube-rbac-proxy"]
            DSG_IS["InferenceService HTTPRoutes<br/>443/TCP → model port<br/>ext_authz + AuthPolicy"]
            DSG_WS["Workspace HTTPRoutes<br/>443/TCP → workbench port<br/>ext_authz + request-header"]
        end

        subgraph MAAS_GW["maas-default-gateway<br/>GatewayClass: openshift-default<br/>Owner: ai-gateway-operator"]
            MAAS_ROUTE["maas-api-route<br/>443/TCP → 8443/TCP<br/>Kuadrant AuthPolicy<br/>(API key sk-oai-* +<br/>OpenShift token)"]
        end

        subgraph AuthServices["Gateway Auth Services"]
            KAP["kube-auth-proxy<br/>Port 8443/TCP<br/>OAuth2/OIDC validation"]
            Praxis["praxis-extproc<br/>Dual-stage ExtProc<br/>ipp-pre (fail-open)<br/>ipp (fail-closed)"]
        end

        subgraph LegacyRoutes["Legacy OpenShift Routes"]
            ObsRoutes["odh-observability<br/>3 Routes (TLS passthrough)<br/>kube-rbac-proxy backend"]
            MRRoutes["model-registry<br/>HTTPRoute + Route per instance"]
            DWRoutes["distributed-workloads<br/>4 MinIO Routes (TLS)"]
        end

        subgraph GRPCIngress["gRPC Ingress"]
            OSRoute["OpenShell GRPCRoute<br/>OIDC/Bearer + Ed25519 JWT"]
        end
    end

    subgraph ServiceMesh["INTERNAL SERVICE MESH"]
        direction TB

        subgraph NS_ODH["Namespace: opendatahub"]
            RHODS["rhods-operator<br/>SA: controller-manager<br/>DataScienceCluster reconciler"]
            Dashboard["odh-dashboard<br/>SA: odh-dashboard<br/>11 Go BFF sidecars"]
            ODHMC["odh-model-controller<br/>SA: odh-model-controller<br/>HTTPRoute + AuthPolicy"]
            KF["kubeflow<br/>SA: notebook-controller<br/>Notebook CR + webhook"]
            MAAS_C["maas-controller<br/>SA: maas-controller<br/>Tenant + subscription mgmt"]
            DSPO["data-science-pipelines-operator<br/>SA: dspo<br/>DSPA reconciliation"]
            ModOps["Module Operators x9<br/>feast, mlflow, trainer,<br/>workbenches, spark, ai-gw,<br/>trustyai, ogx, mcp-lifecycle"]
            ODH_OBS["odh-observability<br/>SA: odh-observability"]
        end

        subgraph NS_KServe["Namespace: kserve"]
            KServe_Mgr["kserve manager<br/>SA: kserve-controller-manager<br/>InferenceService (13 CRDs)"]
            KServe_LLMISVC["kserve llmisvc<br/>LLMInferenceService"]
            KServe_LM["kserve localmodel<br/>LocalModelCache"]
        end

        subgraph NS_MRO["Namespace: model-registry-operator-system"]
            MR_OP["model-registry-operator<br/>SA: model-registry-operator"]
        end

        subgraph NS_MON["Namespace: redhat-ods-monitoring"]
            Prom["Prometheus<br/>ServiceMonitor discovery"]
            Thanos["Thanos Querier"]
            OTel["OpenTelemetry Collector<br/>OTLP traces"]
            KRBP_Mon["kube-rbac-proxy<br/>Metrics proxies"]
        end

        subgraph NS_User["User Namespaces (per-project)"]
            NB["Notebook Servers<br/>kube-rbac-proxy sidecar<br/>NetworkPolicy isolation"]
            IS["InferenceServices<br/>vLLM, MLServer, OpenVINO"]
            PR["Pipeline Runs<br/>Argo Workflows<br/>DSP API (8888), MariaDB, MinIO"]
            TJ["Training Jobs<br/>TrainJob → JobSet"]
            FS["Feature Stores (Feast)"]
            LLMD["llm-d vLLM backends<br/>Disaggregated inference<br/>RDMA port 5600"]
        end
    end

    subgraph EgressZone["EGRESS (External Services)"]
        ExtModels["External Model Providers<br/>OpenAI-compatible APIs<br/>TLS, API key"]
        Registry["Container Registry<br/>registry.redhat.io, quay.io<br/>TLS, Pull secrets"]
        S3["Object Storage (S3)<br/>Model + pipeline artifacts<br/>TLS, AWS IAM"]
        K8sAPI["Kubernetes API Server<br/>HTTPS/443<br/>SA tokens (TokenReview)"]
    end

    %% External to Ingress
    Clients -->|"HTTPS/443"| DSG_NB
    Clients -->|"HTTPS/443"| DSG_IS
    Clients -->|"HTTPS/443"| DSG_WS
    Clients -->|"HTTPS/443<br/>API key or token"| MAAS_ROUTE

    %% Gateway auth flows
    DSG_NB -->|"ext_authz"| KAP
    DSG_IS -->|"ext_authz"| KAP
    DSG_WS -->|"ext_authz"| KAP
    MAAS_ROUTE -->|"pre-auth ExtProc"| Praxis
    MAAS_ROUTE -->|"post-auth ExtProc"| Praxis

    %% Ingress to Service Mesh
    DSG_NB -->|"HTTPRoute"| NB
    DSG_IS -->|"HTTPRoute"| IS
    DSG_WS -->|"HTTPRoute"| NB
    MAAS_ROUTE -->|"HTTPRoute"| MAAS_C

    %% Internal controller flows
    RHODS -->|"DataScienceCluster<br/>reconcile"| KServe_Mgr
    RHODS -->|"deploys"| ODHMC
    RHODS -->|"deploys"| KF
    RHODS -->|"deploys"| Dashboard
    RHODS -->|"deploys"| DSPO
    RHODS -->|"creates Gateway"| DSG

    ODHMC -->|"HTTPRoute + AuthPolicy"| DSG
    KF -->|"HTTPRoute + ReferenceGrant"| DSG
    MAAS_C -->|"HTTPRoute"| MAAS_GW

    KServe_Mgr -->|"creates pods"| IS
    DSPO -->|"deploys pipeline stack"| PR
    KF -->|"creates StatefulSet"| NB

    %% Observability flows
    Prom -->|"ServiceMonitor scrape"| RHODS
    Prom -->|"ServiceMonitor scrape"| KServe_Mgr
    Prom -->|"ServiceMonitor scrape"| Dashboard
    OTel -->|"OTLP/gRPC"| MAAS_C
    OTel -->|"OTLP/gRPC"| ODHMC

    %% Egress flows
    MAAS_C -->|"proxy inference<br/>TLS, API key"| ExtModels
    KServe_Mgr -->|"pull images<br/>TLS"| Registry
    IS -->|"pull models<br/>S3 creds"| S3
    PR -->|"pipeline artifacts<br/>S3 creds"| S3
    RHODS -->|"reconcile<br/>SA token"| K8sAPI
    KServe_Mgr -->|"reconcile<br/>SA token"| K8sAPI
    Dashboard -->|"BFF proxy<br/>SA token"| K8sAPI

    %% LLM-D internal path
    LLMD -.->|"RDMA KV-cache<br/>port 5600"| LLMD

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef servicemesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef egress fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef user fill:#ffeaa7,stroke:#fdcb6e,stroke-width:2px

    class Clients external
    class DSG_NB,DSG_IS,DSG_WS,MAAS_ROUTE,ObsRoutes,MRRoutes,DWRoutes,OSRoute ingress
    class KAP,Praxis auth
    class RHODS,Dashboard,ODHMC,KF,MAAS_C,DSPO,ModOps,ODH_OBS,KServe_Mgr,KServe_LLMISVC,KServe_LM,MR_OP servicemesh
    class Prom,Thanos,OTel,KRBP_Mon monitoring
    class ExtModels,Registry,S3,K8sAPI egress
    class NB,IS,PR,TJ,FS,LLMD user
