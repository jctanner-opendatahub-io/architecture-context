graph LR
    BatchGateway["batch-gateway<br/>(3-process architecture)"]

    %% Runtime Infrastructure Dependencies
    BatchGateway -->|"relational state<br/>job metadata"| PostgreSQL["PostgreSQL<br/>(pgx v5.10)"]
    BatchGateway -->|"job coordination<br/>messaging exchange"| Redis["Redis/Valkey<br/>(go-redis v9.22)"]
    BatchGateway -->|"file storage<br/>input/output"| S3["S3-compatible Storage<br/>(aws-sdk-go-v2)"]

    %% Internal RHOAI Dependencies
    BatchGateway -->|"inference requests<br/>auth passthrough"| LLMdGateway["llm-d Inference<br/>Gateway"]
    BatchGateway -->|"job queue producer"| LLMdAsync["llm-d-async<br/>v0.9.0"]

    %% Observability Dependencies
    BatchGateway -->|"OTLP/gRPC traces"| OTel["OpenTelemetry<br/>Collector"]
    BatchGateway -->|"metrics export"| Prometheus["Prometheus<br/>(client_golang v1.24)"]

    %% Build/Runtime Dependencies
    BatchGateway -->|"TLS, crypto"| GoStdlib["Go 1.26 stdlib<br/>crypto/tls"]
    BatchGateway -->|"FIPS crypto"| OpenSSL["OpenSSL<br/>(via UBI9 + strictfipsruntime)"]

    %% Platform Integration
    PlatformGW["llm-d-inference-gateway<br/>(Gateway API)"] -->|"HTTPRoute<br/>auth enforcement"| BatchGateway

    %% OTel Instrumentation Libraries
    BatchGateway -.->|"DB tracing"| OtelPgx["otelpgx v0.11"]
    BatchGateway -.->|"Redis tracing"| RedisOtel["redisotel v9.22"]
    BatchGateway -.->|"HTTP tracing"| OtelHTTP["otelhttp v0.71"]

