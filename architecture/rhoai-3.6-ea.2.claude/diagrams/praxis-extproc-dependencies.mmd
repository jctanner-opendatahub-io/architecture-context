graph LR
    PraxisExtproc["praxis-extproc<br/>(Envoy ExtProc Server)"]

    %% Internal Platform Dependencies
    subgraph InternalDeps["Internal Platform Dependencies"]
        EnvoyGW["Istio/Envoy Gateway<br/>(maas-default-gateway)"]
        Kuadrant["Kuadrant<br/>(WasmPlugin Auth)"]
        K8sAPI["Kubernetes API Server"]
    end

    PraxisExtproc -->|"gRPC ext_proc<br/>9004/TCP, TLS SIMPLE<br/>bidirectional stream"| EnvoyGW
    PraxisExtproc -.->|"filter chain ordering<br/>EnvoyFilter priority 10"| Kuadrant
    PraxisExtproc -->|"REST API<br/>443/TCP, HTTPS<br/>SA Token RBAC"| K8sAPI

    %% Kubernetes Resources Read
    subgraph K8sResources["Kubernetes Resources (Read)"]
        ConfigMaps["ConfigMaps<br/>(get/list/watch)"]
        Secrets["Secrets<br/>(get)"]
        ExternalProviders["ExternalProviders<br/>(inference.opendatahub.io)<br/>(get/list/watch)"]
        ExternalModels["ExternalModels<br/>(inference.opendatahub.io)<br/>(get/list/watch)"]
    end

    K8sAPI --- ConfigMaps
    K8sAPI --- Secrets
    K8sAPI --- ExternalProviders
    K8sAPI --- ExternalModels

    %% Core Rust Dependencies
    subgraph CoreDeps["Core Rust Dependencies"]
        Tonic["tonic 0.14.6<br/>(gRPC framework)"]
        Tokio["tokio 1.52.2<br/>(async runtime)"]
        Hyper["hyper 1.9.0<br/>(HTTP server)"]
        OpenSSL["openssl 0.10.81<br/>(TLS/crypto)"]
        Prost["prost 0.14.3<br/>(protobuf)"]
        Serde["serde 1.0.228<br/>(serialization)"]
    end

    PraxisExtproc -->|runtime| Tonic
    PraxisExtproc -->|runtime| Tokio
    PraxisExtproc -->|metrics server| Hyper
    PraxisExtproc -->|TLS| OpenSSL
    PraxisExtproc -->|protobuf| Prost
    PraxisExtproc -->|config| Serde

    %% Praxis Framework Dependencies
    subgraph PraxisDeps["Praxis Framework"]
        PraxisCore["praxis-core<br/>(github.com/praxis-proxy/praxis)"]
        PraxisFilter["praxis-filter<br/>(github.com/praxis-proxy/praxis)"]
        PraxisAIFilters["praxis-ai-filters<br/>(git@e9fb5211eb97)"]
        PraxisAIAPIs["praxis-ai-apis<br/>(git@e9fb5211eb97)"]
        PraxisProto["praxis-proto"]
    end

    PraxisExtproc -->|filter framework| PraxisCore
    PraxisExtproc -->|filter pipeline| PraxisFilter
    PraxisExtproc -->|AI filters| PraxisAIFilters
    PraxisExtproc -->|API types| PraxisAIAPIs
    PraxisExtproc -->|protobuf defs| PraxisProto

    %% Monitoring
    subgraph Monitoring["Monitoring"]
        Prometheus["Prometheus"]
    end

    Prometheus -->|"HTTP scrape<br/>GET /metrics<br/>9090/TCP"| PraxisExtproc

    %% Styling
    style PraxisExtproc fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style EnvoyGW fill:#7ed321,stroke:#333,color:#fff
    style Kuadrant fill:#7ed321,stroke:#333,color:#fff
    style K8sAPI fill:#f5a623,stroke:#333,color:#fff
    style Tonic fill:#999,stroke:#333,color:#fff
    style Tokio fill:#999,stroke:#333,color:#fff
    style Hyper fill:#999,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333,color:#fff
    style Prost fill:#999,stroke:#333,color:#fff
    style Serde fill:#999,stroke:#333,color:#fff
    style PraxisCore fill:#6c5ce7,stroke:#333,color:#fff
    style PraxisFilter fill:#6c5ce7,stroke:#333,color:#fff
    style PraxisAIFilters fill:#6c5ce7,stroke:#333,color:#fff
    style PraxisAIAPIs fill:#6c5ce7,stroke:#333,color:#fff
    style PraxisProto fill:#6c5ce7,stroke:#333,color:#fff
    style Prometheus fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#dfe6e9,stroke:#333
    style Secrets fill:#dfe6e9,stroke:#333
    style ExternalProviders fill:#dfe6e9,stroke:#333
    style ExternalModels fill:#dfe6e9,stroke:#333
