graph TB
    subgraph DCH["Data Connect Hub"]
        direction TB

        subgraph Operator["Go Operator Tier (dc-controller)"]
            DCSController["DataConnectService<br/>Controller"]
            IDCController["InitDataConnection<br/>Controller"]
            IDCTController["InitDataConnectionType<br/>Controller"]
            CMController["ConfigMap<br/>Controller"]
            SecretController["Secret<br/>Controller"]
            DCSController -->|"renders Kustomize<br/>manifests"| Deployments
            IDCTController -->|"HTTP sync"| RESTService
            CMController -->|"HTTP sync"| RESTService
            SecretController -->|"HTTP migration"| RESTService
        end

        subgraph Services["Rust Services Tier"]
            direction TB
            RESTService["REST Service<br/>(actix-web)<br/>/api/{version}/data/*"]
            FlightService["Flight Service<br/>(Arrow Flight Protocol)"]
            KRBPRest["kube-rbac-proxy<br/>(REST sidecar)"]
            KRBPFlight["kube-rbac-proxy<br/>(Flight sidecar)"]
            KRBPRest -->|"localhost"| RESTService
            KRBPFlight -->|"localhost"| FlightService
        end

        subgraph Connectors["Backend Connectors"]
            PG["PostgreSQL<br/>Connector"]
            ES["Elasticsearch<br/>Connector"]
            Milvus["Milvus<br/>Connector"]
            Neo4j["Neo4j<br/>Connector"]
            S3["S3<br/>Connector"]
            SQLite["SQLite<br/>Connector"]
            URI["URI<br/>Connector"]
        end

        RESTService -->|"pluggable"| PG
        RESTService -->|"pluggable"| ES
        RESTService -->|"pluggable"| Milvus
        RESTService -->|"pluggable"| Neo4j
        RESTService -->|"pluggable"| S3
        RESTService -->|"pluggable"| SQLite
        RESTService -->|"pluggable"| URI
    end

    User["Platform User"] -->|"creates"| DCSCR["DataConnectService CR"]
    User -->|"creates"| IDCCR["InitDataConnection CR"]
    User -->|"creates"| IDCTCR["InitDataConnectionType CR"]
    DCSCR -->|"watched by"| DCSController
    IDCCR -->|"watched by"| IDCController
    IDCTCR -->|"watched by"| IDCTController

    Client["External Client"] -->|"HTTPS + Bearer Token"| KRBPRest
    Client -->|"Arrow Flight"| KRBPFlight

    DCSController -->|"reads routing domain"| IngressConfig["OpenShift Ingress<br/>Config"]
    DCSController -->|"creates"| HTTPRoute["Gateway API<br/>HTTPRoute"]
    DCSController -->|"creates"| Deployments["Service Deployments<br/>+ ConfigMaps + NetworkPolicies"]
    DCSController -->|"CRUD"| K8sAPI["Kubernetes API"]

    style DCSController fill:#4a90e2,color:#fff
    style IDCController fill:#4a90e2,color:#fff
    style IDCTController fill:#4a90e2,color:#fff
    style CMController fill:#4a90e2,color:#fff
    style SecretController fill:#4a90e2,color:#fff
    style RESTService fill:#e8744f,color:#fff
    style FlightService fill:#e8744f,color:#fff
    style KRBPRest fill:#9b59b6,color:#fff
    style KRBPFlight fill:#9b59b6,color:#fff
    style DCSCR fill:#f5a623
    style IDCCR fill:#f5a623
    style IDCTCR fill:#f5a623
    style IngressConfig fill:#e8e8e8
    style HTTPRoute fill:#e8e8e8
    style K8sAPI fill:#e8e8e8
    style PG fill:#7ed321,color:#fff
    style ES fill:#7ed321,color:#fff
    style Milvus fill:#7ed321,color:#fff
    style Neo4j fill:#7ed321,color:#fff
    style S3 fill:#7ed321,color:#fff
    style SQLite fill:#7ed321,color:#fff
    style URI fill:#7ed321,color:#fff
