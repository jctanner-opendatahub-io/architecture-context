graph LR
    MLServer["MLServer<br/>V2 Inference Server"]

    %% Core Framework Dependencies
    MLServer -->|"REST framework"| FastAPI["FastAPI >=0.134.0,<0.137.0"]
    MLServer -->|"ASGI server"| Uvicorn["uvicorn"]
    MLServer -->|"ASGI framework"| Starlette["Starlette >=1.3.1"]
    MLServer -->|"gRPC transport"| gRPC["grpcio >=1.67.1"]
    MLServer -->|"serialization"| Protobuf["protobuf >=5.27.2,<7.0.0"]
    MLServer -->|"data models"| Pydantic["pydantic ^2.7.1"]

    %% Observability Dependencies
    MLServer -->|"tracing SDK"| OTelSDK["opentelemetry-sdk ^1.22.0"]
    MLServer -->|"trace export"| OTelExporter["opentelemetry-exporter-otlp-proto-grpc ^1.22.0"]
    MLServer -->|"REST tracing"| OTelFastAPI["opentelemetry-instrumentation-fastapi >=0.43b0"]
    MLServer -->|"gRPC tracing"| OTelGRPC["opentelemetry-instrumentation-grpc >=0.43b0"]
    MLServer -->|"gRPC metrics"| PyGRPCProm["py-grpc-prometheus"]

    %% ML Framework Runtime Dependencies
    MLServer -->|"sklearn runtime"| ScikitLearn["scikit-learn"]
    MLServer -->|"xgboost runtime"| XGBoost["xgboost"]
    MLServer -->|"lightgbm runtime"| LightGBM["lightgbm"]
    MLServer -->|"onnx runtime"| ONNX["onnxruntime >=1.20.0,<1.24.0"]
    MLServer -->|"onnx GPU runtime"| ONNXGPU["onnxruntime-gpu >=1.20.0,<1.24.0"]
    MLServer -->|"mlflow runtime"| MLflow["mlflow >=2.19.0"]
    MLServer -->|"huggingface runtime"| Optimum["optimum >=1.4,<2.0"]
    MLServer -->|"catboost runtime"| CatBoost["catboost"]
    MLServer -->|"mllib runtime"| PySpark["pyspark"]
    MLServer -->|"alibi detect"| AlibiDetect["alibi-detect"]
    MLServer -->|"alibi explain"| Alibi["alibi"]

    %% Numeric/Data Dependencies
    MLServer -->|"numeric compute"| NumPy["numpy"]
    MLServer -->|"data processing"| Pandas["pandas"]
    MLServer -->|"deep learning"| Torch["torch"]
    MLServer -->|"deep learning"| TensorFlow["tensorflow"]

    %% Platform Integration
    MLServer -.->|"auth sidecar"| KRBP["kube-rbac-proxy"]
    MLServer -.->|"pod lifecycle"| KServe["KServe"]

    %% Runtime
    MLServer -->|"language runtime"| Python["Python >=3.10,<3.13"]

