graph TB
    subgraph TrainingOperator["Training Operator"]
        direction TB
        Controller["Training Operator Controller<br/>/manager entrypoint"]
        WebhookServer["Webhook Server<br/>Port 9443/TCP<br/>TLS (cluster-aligned)"]
        HealthProbe["Health/Readiness Probes<br/>Port 8081/TCP"]
        MetricsServer["Metrics Server<br/>Port 8080/TCP"]

        subgraph Reconcilers["Framework Reconcilers"]
            PyTorchRec["PyTorchJob<br/>Reconciler"]
            TFRec["TFJob<br/>Reconciler"]
            MPIRec["MPIJob<br/>Reconciler"]
            JAXRec["JAXJob<br/>Reconciler"]
            XGBoostRec["XGBoostJob<br/>Reconciler"]
            PaddleRec["PaddleJob<br/>Reconciler"]
        end

        Controller --> PyTorchRec
        Controller --> TFRec
        Controller --> MPIRec
        Controller --> JAXRec
        Controller --> XGBoostRec
        Controller --> PaddleRec
        Controller --> WebhookServer
        Controller --> HealthProbe
        Controller --> MetricsServer
    end

    %% CRDs
    User["Data Scientist / User"] -->|"kubectl apply"| CRDs

    subgraph CRDs["Training Job CRDs (kubeflow.org/v1)"]
        PyTorchJob["PyTorchJob"]
        TFJob["TFJob"]
        MPIJob["MPIJob"]
        JAXJob["JAXJob"]
        XGBoostJob["XGBoostJob"]
        PaddleJob["PaddleJob"]
    end

    CRDs -->|"CREATE/UPDATE<br/>intercepted by"| WebhookServer
    PyTorchJob -->|"watched by"| PyTorchRec
    TFJob -->|"watched by"| TFRec
    MPIJob -->|"watched by"| MPIRec
    JAXJob -->|"watched by"| JAXRec
    XGBoostJob -->|"watched by"| XGBoostRec
    PaddleJob -->|"watched by"| PaddleRec

    %% Created Resources
    subgraph CreatedResources["Created Resources"]
        WorkerPods["Worker Pods"]
        WorkerSvcs["Worker Services"]
        NetPolicies["NetworkPolicies"]
        HPA["HorizontalPodAutoscaler<br/>(PyTorch elastic only)"]
        MPIResources["ConfigMaps, SA,<br/>Roles, RoleBindings<br/>(MPI only)"]
    end

    PyTorchRec -->|"creates"| WorkerPods
    PyTorchRec -->|"creates"| WorkerSvcs
    PyTorchRec -->|"creates"| NetPolicies
    PyTorchRec -->|"manages"| HPA
    MPIRec -->|"creates"| MPIResources
    TFRec -->|"creates"| WorkerPods
    JAXRec -->|"creates"| WorkerPods
    XGBoostRec -->|"creates"| WorkerPods
    PaddleRec -->|"creates"| WorkerPods

    %% External Dependencies
    Controller -->|"reads TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1"]
    Controller -->|"gang scheduling"| Volcano["Volcano<br/>scheduling.volcano.sh"]
    Controller -->|"gang scheduling"| SchedulerPlugins["Scheduler Plugins<br/>scheduling.x-k8s.io"]
    Prometheus["Prometheus"] -->|"scrapes :8080"| MetricsServer

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style WebhookServer fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbe fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style PyTorchRec fill:#5b9bd5,stroke:#333,color:#fff
    style TFRec fill:#5b9bd5,stroke:#333,color:#fff
    style MPIRec fill:#5b9bd5,stroke:#333,color:#fff
    style JAXRec fill:#5b9bd5,stroke:#333,color:#fff
    style XGBoostRec fill:#5b9bd5,stroke:#333,color:#fff
    style PaddleRec fill:#5b9bd5,stroke:#333,color:#fff
    style PyTorchJob fill:#f5a623,stroke:#333
    style TFJob fill:#f5a623,stroke:#333
    style MPIJob fill:#f5a623,stroke:#333
    style JAXJob fill:#f5a623,stroke:#333
    style XGBoostJob fill:#f5a623,stroke:#333
    style PaddleJob fill:#f5a623,stroke:#333
    style OpenShiftAPI fill:#e8e8e8,stroke:#333
    style Volcano fill:#e8e8e8,stroke:#333
    style SchedulerPlugins fill:#e8e8e8,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style WorkerPods fill:#d5e8d4,stroke:#333
    style WorkerSvcs fill:#d5e8d4,stroke:#333
    style NetPolicies fill:#d5e8d4,stroke:#333
    style HPA fill:#d5e8d4,stroke:#333
    style MPIResources fill:#d5e8d4,stroke:#333
