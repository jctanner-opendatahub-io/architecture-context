graph LR
    Trainer["Trainer Operator<br/>kubeflow-trainer-controller-manager"]

    %% Internal Platform Dependencies
    Trainer -->|"creates/reconciles JobSets"| JobSet["JobSet Controller<br/>jobset.x-k8s.io v0.12.0"]
    Trainer -->|"creates PodGroups<br/>(gang scheduling)"| SchedPlugins["Kubernetes Scheduler Plugins<br/>scheduler-plugins v0.35.4"]
    Trainer -->|"creates PodGroups<br/>(gang scheduling)"| Volcano["Volcano Scheduler<br/>volcano.sh/apis v1.13.1"]

    %% Platform Integration
    Trainer -->|"reads TLSSecurityProfile"| OpenShiftAPI["OpenShift APIServer<br/>config.openshift.io/v1"]
    CertController["OPA cert-controller<br/>v0.16.0"] -->|"rotates webhook certs"| Trainer

    %% Runtime Dependencies
    Trainer -->|"controller framework"| ControllerRuntime["controller-runtime<br/>v0.24.1"]
    Trainer -->|"resource operations"| K8sAPI["Kubernetes API<br/>k8s.io v0.36.2"]

    %% Resources Created
    Trainer -->|"creates per-TrainJob"| NetworkPolicies["NetworkPolicies<br/>networking.k8s.io/v1"]
    Trainer -->|"watches"| ConfigMaps["ConfigMaps<br/>(Flux/MPI plugins)"]
    Trainer -->|"watches"| Secrets["Secrets<br/>(Flux/MPI plugins)"]

    %% Python Dependencies
    subgraph PythonInit["Python Initializers"]
        DatasetInit["Dataset Initializer"]
        ModelInit["Model Initializer"]
    end
    DatasetInit -->|"model downloads"| HuggingFace["huggingface-hub<br/>>=0.27.0"]
    DatasetInit -->|"storage access"| OpenDAL["opendal<br/>>=0.46.0"]
    ModelInit -->|"model downloads"| HuggingFace
    Trainer -.->|"init containers"| PythonInit

