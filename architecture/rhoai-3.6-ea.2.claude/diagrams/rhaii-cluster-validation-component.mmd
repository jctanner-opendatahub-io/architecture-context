graph TB
    subgraph "Operator Workstation"
        CLI["rhaii-validator CLI<br/>(kubectl plugin)"]
        subgraph "Controller Logic"
            AllCmd["all subcommand"]
            GPUCmd["gpu subcommand"]
            RDMACmd["rdma subcommand"]
            PingCmd["ping-mesh subcommand"]
            BWCmd["bandwidth subcommand"]
            TCPCmd["tcp subcommand"]
        end
        CLI --> AllCmd
        CLI --> GPUCmd
        CLI --> RDMACmd
        CLI --> PingCmd
        CLI --> BWCmd
        CLI --> TCPCmd
    end

    subgraph "Kubernetes Cluster"
        subgraph "rhaii-validation namespace"
            SA["ServiceAccount<br/>rhaii-validator"]
            Jobs["Probe Jobs<br/>(ephemeral)"]
            ConfigMaps["ConfigMaps<br/>(results)"]
        end

        subgraph "GPU Nodes"
            Agent["rhaii-validator agent<br/>(run mode)"]
            GPU["GPU Devices<br/>/sys/class"]
            RDMA["RDMA/IB Devices<br/>/sys/class/infiniband"]
        end

        RBAC["ClusterRole + Binding<br/>(privileged SCC)"]
    end

    KubeAPI["Kubernetes API<br/>6443/TCP"]

    %% Controller → Cluster flows
    CLI -->|"kubeconfig auth<br/>TLS 1.2+"| KubeAPI
    KubeAPI -->|creates| SA
    KubeAPI -->|creates| RBAC
    KubeAPI -->|deploys| Jobs
    Jobs -->|runs on GPU nodes| Agent
    Agent -->|"host device access<br/>(privileged SCC)"| GPU
    Agent -->|"host device access<br/>(privileged SCC)"| RDMA
    Agent -->|"stdout + ConfigMaps"| ConfigMaps
    CLI -->|"collects results via<br/>log API + ConfigMaps"| KubeAPI

    %% RBAC binding
    RBAC -.->|"SCC: privileged<br/>(no K8s API perms)"| SA
    SA -.->|bound to| Jobs

    style CLI fill:#4a90e2,stroke:#333,stroke-width:3px,color:#fff
    style Agent fill:#4a90e2,stroke:#333,color:#fff
    style KubeAPI fill:#f5a623,stroke:#333,color:#fff
    style Jobs fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style SA fill:#7ed321,stroke:#333
    style RBAC fill:#f5a623,stroke:#333
    style GPU fill:#e8e8e8,stroke:#333
    style RDMA fill:#e8e8e8,stroke:#333
