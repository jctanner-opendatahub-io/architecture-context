graph LR
    KubeRay["KubeRay Operator<br/>(controller-runtime 0.22.4)"]

    %% Platform Dependencies
    KubeRay -->|"mTLS certs<br/>Issuer + Certificate CRDs"| CertManager["cert-manager<br/>v1.18.2+"]
    KubeRay -->|"HTTPRoute CRUD<br/>ReferenceGrant"| GatewayAPI["Gateway API<br/>v1.4.1+"]
    KubeRay -->|"metrics scrape<br/>:8080/TCP"| Prometheus["Prometheus"]
    KubeRay -->|"TLS profile read<br/>APIServer config"| OpenShiftConfig["OpenShift<br/>Cluster Config"]

    %% Kubernetes API
    KubeRay -->|"resource CRUD<br/>:6443 HTTPS"| K8sAPI["Kubernetes API<br/>v0.35.0"]

    %% Runtime Dependencies
    KubeRay -->|"authn sidecar<br/>:8443 OAuth/OIDC"| KubeRBACProxy["kube-rbac-proxy<br/>(sidecar injection)"]
    KubeRay -->|"pod isolation<br/>NetworkPolicy"| NetworkPolicy["NetworkPolicy<br/>(networking.k8s.io)"]

    %% Build/Runtime
    KubeRay -->|"operator framework"| ControllerRuntime["controller-runtime<br/>0.22.4"]
    KubeRay -->|"Go runtime"| Go["Go 1.25<br/>FIPS: strictfipsruntime"]

    %% Optional integrations
    KubeRay -.->|"routes (legacy)"| OpenShiftRoutes["OpenShift Routes"]
    KubeRay -.->|"batch scheduling"| Volcano["Volcano Scheduler<br/>v1.13.0"]
    KubeRay -.->|"ingress (legacy)"| Ingress["Kubernetes Ingress"]

    %% Managed Resources (what KubeRay creates)
    subgraph ManagedCRDs["Managed CRDs (ray.io)"]
        RayCluster["RayCluster"]
        RayJob["RayJob"]
        RayService["RayService"]
        RayCronJob["RayCronJob"]
    end

    KubeRay -->|"reconciles"| ManagedCRDs

    %% Styling
    style KubeRay fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style CertManager fill:#7ed321,stroke:#333,color:#000
    style GatewayAPI fill:#7ed321,stroke:#333,color:#000
    style Prometheus fill:#7ed321,stroke:#333,color:#000
    style OpenShiftConfig fill:#7ed321,stroke:#333,color:#000
    style K8sAPI fill:#f5a623,stroke:#333,color:#000
    style KubeRBACProxy fill:#e74c3c,stroke:#333,color:#fff
    style NetworkPolicy fill:#999,stroke:#333,color:#fff
    style ControllerRuntime fill:#999,stroke:#333,color:#fff
    style Go fill:#999,stroke:#333,color:#fff
    style OpenShiftRoutes fill:#ddd,stroke:#999,stroke-dasharray:5 5,color:#666
    style Volcano fill:#ddd,stroke:#999,stroke-dasharray:5 5,color:#666
    style Ingress fill:#ddd,stroke:#999,stroke-dasharray:5 5,color:#666
    style RayCluster fill:#f5a623,stroke:#333,color:#000
    style RayJob fill:#f5a623,stroke:#333,color:#000
    style RayService fill:#f5a623,stroke:#333,color:#000
    style RayCronJob fill:#f5a623,stroke:#333,color:#000
