graph TD
    subgraph "vllm-orchestrator-gateway RBAC"
        direction TB

        Note["No RBAC Defined"]

        subgraph "Authentication"
            AuthModel["Auth Model: Passthrough<br/>Gateway performs NO auth enforcement"]
            ClientAuth["Client sends optional<br/>Authorization: Bearer token"]
            ForwardAuth["Gateway forwards Authorization<br/>and X-Forwarded-* headers"]
            OrchestratorAuth["TrustyAI Orchestrator<br/>enforces auth policy"]

            ClientAuth --> ForwardAuth
            ForwardAuth --> OrchestratorAuth
        end

        subgraph "TLS Configuration"
            InboundTLS["Inbound: Plaintext HTTP<br/>Port 8090/TCP<br/>No TLS termination"]
            OutboundTLS["Outbound: Optional mTLS<br/>When certs mounted at:<br/>/etc/tls/private/tls.crt<br/>/etc/tls/private/tls.key<br/>/etc/tls/ca/service-ca.crt"]
        end

        subgraph "Notes"
            NoClusterRole["No ClusterRoles defined"]
            NoRoleBinding["No RoleBindings defined"]
            NoSecrets["No Kubernetes Secrets defined"]
            NoSA["No ServiceAccount specified"]
        end
    end

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style AuthModel fill:#d4edda,stroke:#28a745
    style InboundTLS fill:#f8d7da,stroke:#dc3545
    style OutboundTLS fill:#d4edda,stroke:#28a745
    style NoClusterRole fill:#e8e8e8,stroke:#999
    style NoRoleBinding fill:#e8e8e8,stroke:#999
    style NoSecrets fill:#e8e8e8,stroke:#999
    style NoSA fill:#e8e8e8,stroke:#999
