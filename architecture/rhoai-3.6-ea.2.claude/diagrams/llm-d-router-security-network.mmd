graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph ProxyLayer["PROXY LAYER"]
        Envoy["Envoy Proxy<br/>TLS Termination<br/>ExtProc Filter"]
    end

    subgraph EPPService["EPP SERVICE (Optional TLS)"]
        direction TB

        ExtProc["ExternalProcessor gRPC<br/>Port 9002/TCP HTTP/2<br/>Optional TLS (--secure-serving)<br/>Auth: None (transport only)"]
        HealthSvc["Health gRPC<br/>HTTP/2 / Optional TLS<br/>Auth: None"]
        Metrics["Metrics Endpoint<br/>HTTP /metrics<br/>Optional mTLS<br/>--metrics-endpoint-auth"]

        subgraph FIPSBuild["FIPS Compliance"]
            FIPS["GOEXPERIMENT=strictfipsruntime<br/>CGO_ENABLED=1<br/>UBI9 PQC Base Image<br/>System OpenSSL"]
        end
    end

    subgraph Companions["COMPANION BINARIES"]
        Coordinator["Coordinator<br/>/healthz, /readyz, /metrics<br/>HTTP/1.1"]
        Sidecar["pd-sidecar<br/>HTTP Proxy + DNS<br/>NIXL KV-cache transfers<br/>FIPS compliant"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount Auth"]
    end

    subgraph ExternalSvc["EXTERNAL SERVICES"]
        OTel["OpenTelemetry Collector<br/>4317/TCP OTLP/gRPC<br/>or 4318/TCP OTLP/HTTP"]
    end

    subgraph CRDs["CUSTOM RESOURCES"]
        EPC["EndpointPickerConfig<br/>llm-d.ai/v1alpha1"]
        IMR["InferenceModelRewrite<br/>llm-d.ai/v1alpha2"]
        IO["InferenceObjective<br/>llm-d.ai/v1alpha2"]
    end

    %% Flows
    Client -->|"HTTP/HTTPS<br/>Configured by Envoy"| Envoy
    Envoy -->|"gRPC ExtProc/9002<br/>HTTP/2<br/>Optional TLS<br/>No App Auth"| ExtProc
    ExtProc -->|"Routing metadata<br/>(selected backend)"| Envoy

    EPPService -->|"HTTPS/WSS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI
    EPPService -.->|"OTLP traces<br/>gRPC or HTTP"| OTel

    K8sAPI -.->|"Watch events"| CRDs

    Sidecar -->|"DNS/HTTP proxy<br/>NIXL KV-cache"| Envoy

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef epp fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef companion fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalsvc fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef crd fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef fips fill:#e6f3ff,stroke:#4a90e2,stroke-width:1px,stroke-dasharray: 5 5

    class Client external
    class Envoy proxy
    class ExtProc,HealthSvc,Metrics epp
    class Coordinator,Sidecar companion
    class K8sAPI cluster
    class OTel externalsvc
    class EPC,IMR,IO crd
    class FIPS fips
