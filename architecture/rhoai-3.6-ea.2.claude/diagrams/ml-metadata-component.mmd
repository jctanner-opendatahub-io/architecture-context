graph TB
    subgraph "ML Metadata Component"
        direction TB
        Server["metadata_store_server<br/>(C++ Binary / Bazel)"]
        gRPCAPI["MetadataStoreService<br/>gRPC API<br/>8080/TCP HTTP/2"]
        ProtoConfig["MetadataStoreServerConfig<br/>(Protobuf Config)"]
        SSLConfig["SSLConfig<br/>(Optional mTLS)"]

        Server -->|exposes| gRPCAPI
        Server -->|configured by| ProtoConfig
        ProtoConfig -->|optional| SSLConfig
    end

    subgraph "Container Runtime"
        direction TB
        Container["UBI9 Container<br/>ubi9/ubi-minimal-pqc<br/>UID: 65534 (non-root)"]
        Entrypoint["ENTRYPOINT<br/>metadata_store_server"]
        Container -->|runs| Entrypoint
        Entrypoint -->|launches| Server
    end

    subgraph "Client SDKs"
        PythonSDK["ml_metadata<br/>Python Client Library"]
    end

    PipelineClient["Pipeline Client<br/>(e.g., Data Science Pipelines)"] -->|gRPC requests| gRPCAPI
    PythonSDK -->|gRPC calls| gRPCAPI

    subgraph "Database Backends"
        MySQL["MySQL / MariaDB<br/>3306/TCP"]
        PostgreSQL["PostgreSQL<br/>5432/TCP"]
        SQLite["SQLite<br/>(embedded)"]
    end

    Server -->|metadata CRUD| MySQL
    Server -->|metadata CRUD| PostgreSQL
    Server -->|metadata CRUD| SQLite

    style Server fill:#4a90e2,stroke:#333,color:#fff
    style gRPCAPI fill:#4a90e2,stroke:#333,color:#fff
    style ProtoConfig fill:#b8d4f0,stroke:#333
    style SSLConfig fill:#b8d4f0,stroke:#333
    style Container fill:#d5e8d4,stroke:#82b366
    style Entrypoint fill:#d5e8d4,stroke:#82b366
    style PythonSDK fill:#7ed321,stroke:#333,color:#fff
    style PipelineClient fill:#f5a623,stroke:#333,color:#fff
    style MySQL fill:#e8e8e8,stroke:#333
    style PostgreSQL fill:#e8e8e8,stroke:#333
    style SQLite fill:#e8e8e8,stroke:#333
