graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client<br/>Data Scientist"]
    end

    subgraph TLSTermination["OPTIONAL TLS TERMINATION (mTLS Sidecar)"]
        Nginx["nginx Reverse Proxy<br/>TLS 1.2 / AES256+EECDH<br/>ssl_verify_client on<br/>Mutual TLS"]
    end

    subgraph InferenceServer["INFERENCE SERVER (OVMS)"]
        direction TB

        subgraph GRPCServer["gRPC Server (port 9000/8001)"]
            TFSPred["TFS PredictionService"]
            TFSModelSvc["TFS ModelService"]
            KFSInfer["KFS GRPCInferenceService"]
        end

        subgraph RESTServer["REST Server (port 8080/8888)"]
            V1["TFS v1 Endpoints<br/>/v1/models/*<br/>Auth: None"]
            V2["KServe v2 Endpoints<br/>/v2/*<br/>Auth: None"]
            V3["OpenAI v3 Endpoints<br/>/v3/*<br/>Auth: API key (optional)"]
            MetricsEP["/metrics<br/>Auth: None"]
        end

        ModelMgr["Model Manager<br/>OpenVINO Runtime"]
    end

    subgraph Storage["MODEL STORAGE"]
        Models["/mnt/models<br/>PVC or S3-backed<br/>File I/O"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>HTTP scrape<br/>No auth"]
    end

    subgraph Platform["PLATFORM INTEGRATION"]
        KServe["KServe Controller<br/>Kubernetes API"]
    end

    %% External → mTLS sidecar path
    Client -->|"HTTPS + client cert<br/>TLS 1.2 / AES256+EECDH<br/>Mutual TLS"| Nginx
    Nginx -->|"HTTP (loopback)<br/>grpc_pass / proxy_pass<br/>No encryption"| GRPCServer
    Nginx -->|"HTTP (loopback)<br/>proxy_pass<br/>No encryption"| RESTServer

    %% Direct path (no sidecar)
    Client -.->|"HTTP (direct)<br/>configurable ports<br/>No encryption"| GRPCServer
    Client -.->|"HTTP (direct)<br/>configurable ports<br/>v3: API key optional"| RESTServer

    %% Internal flows
    GRPCServer --> ModelMgr
    RESTServer --> ModelMgr
    ModelMgr -->|"File I/O<br/>model_path / config_path"| Models

    %% Monitoring
    Prometheus -->|"HTTP scrape<br/>No encryption<br/>No auth"| MetricsEP

    %% Platform
    KServe -->|"Kubernetes API<br/>ServingRuntime CR"| InferenceServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef tls fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef server fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class Client external
    class Nginx tls
    class TFSPred,TFSModelSvc,KFSInfer,V1,V2,V3,MetricsEP,ModelMgr server
    class Models storage
    class Prometheus monitoring
    class KServe platform
