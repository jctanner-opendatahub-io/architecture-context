graph TD
    subgraph "Service Account"
        SA["controller-controller-manager<br/>(Namespace: kubeflow)"]
    end

    subgraph "ClusterRole Bindings"
        CRB1["controller-model-registry-manager-rolebinding"]
        CRB2["controller-metrics-auth-rolebinding"]
    end

    subgraph "Role Binding"
        RB1["controller-leader-election-rolebinding<br/>(Namespace: kubeflow)"]
    end

    subgraph "ClusterRoles"
        CR1["controller-model-registry-manager-role"]
        CR2["controller-metrics-auth-role"]
    end

    subgraph "Roles"
        R1["controller-leader-election-role<br/>(Namespace: kubeflow)"]
    end

    subgraph "API Resources - Model Registry Manager"
        CoreServices["(core)<br/>services"]
        InferenceServices["serving.kserve.io<br/>inferenceservices"]
        ISFinalizers["serving.kserve.io<br/>inferenceservices/finalizers"]
    end

    subgraph "API Resources - Metrics Auth"
        TokenReviews["authentication.k8s.io<br/>tokenreviews"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews"]
    end

    subgraph "API Resources - Leader Election"
        ConfigMaps["(core)<br/>configmaps"]
        Leases["coordination.k8s.io<br/>leases"]
        Events["(core)<br/>events"]
    end

    %% Bindings
    SA -->|"bound via"| CRB1
    SA -->|"bound via"| CRB2
    SA -->|"bound via"| RB1

    CRB1 -->|"grants"| CR1
    CRB2 -->|"grants"| CR2
    RB1 -->|"grants"| R1

    %% Permissions - Manager Role
    CR1 -->|"get, list, watch"| CoreServices
    CR1 -->|"get, list, patch,<br/>update, watch"| InferenceServices
    CR1 -->|"create, delete, get,<br/>list, patch, update, watch"| ISFinalizers

    %% Permissions - Metrics Auth
    CR2 -->|"create"| TokenReviews
    CR2 -->|"create"| SAR

    %% Permissions - Leader Election
    R1 -->|"create, delete, get,<br/>list, patch, update, watch"| ConfigMaps
    R1 -->|"create, delete, get,<br/>list, patch, update, watch"| Leases
    R1 -->|"create, patch"| Events

    %% Styling
    style SA fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    style CRB1 fill:#b8d4e3,stroke:#333
    style CRB2 fill:#b8d4e3,stroke:#333
    style RB1 fill:#b8d4e3,stroke:#333
    style CR1 fill:#f5a623,stroke:#333,stroke-width:2px
    style CR2 fill:#f5a623,stroke:#333,stroke-width:2px
    style R1 fill:#f5a623,stroke:#333,stroke-width:2px
    style CoreServices fill:#7ed321,stroke:#333
    style InferenceServices fill:#7ed321,stroke:#333
    style ISFinalizers fill:#7ed321,stroke:#333
    style TokenReviews fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style Leases fill:#7ed321,stroke:#333
    style Events fill:#7ed321,stroke:#333
