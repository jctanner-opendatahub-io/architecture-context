graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["kserve-controller-manager"]
        SA_LLMISVC["$(llmisvc-serviceAccountName)"]
        SA_LocalModel["kserve-localmodel-controller-manager"]
        SA_LocalModelNode["kserve-localmodelnode-agent"]
    end

    subgraph ClusterRoleBindings["Cluster/Role Bindings"]
        CRB_Manager["kserve-manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Proxy["kserve-proxy-rolebinding<br/>(ClusterRoleBinding)"]
        RB_LLMISVC["llmisvc-manager-rolebinding<br/>(RoleBinding, ns: kserve)"]
        CRB_LocalModel["kserve-localmodel-manager-rolebinding<br/>(ClusterRoleBinding)"]
        RB_LocalModelNode["kserve-localmodelnode-agent-rolebinding<br/>(RoleBinding, ns: kserve)"]
        RB_LeaderManager["kserve-leader-election-rolebinding<br/>(RoleBinding, ns: kserve)"]
        RB_LeaderLLM["llmisvc-leader-election-rolebinding<br/>(RoleBinding, ns: kserve)"]
    end

    subgraph ClusterRoles["Cluster/Namespace Roles"]
        CR_Manager["kserve-manager-role<br/>(ClusterRole)"]
        CR_Proxy["kserve-proxy-role<br/>(ClusterRole)"]
        CR_LLMISVC["kserve-llmisvc-manager-role<br/>(ClusterRole)"]
        CR_LocalModel["kserve-localmodel-manager-role<br/>(ClusterRole)"]
        CR_LocalModelNode["kserve-localmodelnode-agent-role<br/>(ClusterRole)"]
        R_Leader["kserve-leader-election-role<br/>(Role)"]
        R_LeaderLLM["llmisvc-leader-election-role<br/>(Role)"]
    end

    subgraph ManagerResources["kserve-manager-role Resources"]
        MR_KServe["serving.kserve.io<br/>inferenceservices, inferencegraphs,<br/>clusterservingruntimes, servingruntimes,<br/>trainedmodels, clusterstoragecontainers<br/>+ finalizers + status<br/>CRUD + watch"]
        MR_Knative["serving.knative.dev<br/>services + finalizers + status<br/>CRUD + watch"]
        MR_Istio["networking.istio.io<br/>virtualservices + finalizers + status<br/>CRUD + watch"]
        MR_Gateway["gateway.networking.k8s.io<br/>httproutes<br/>CRUD + watch"]
        MR_Apps["apps<br/>deployments<br/>CRUD + watch"]
        MR_Core["core<br/>events, services (CRUD)<br/>configmaps (create,get,update)<br/>namespaces, pods (read)<br/>secrets, serviceaccounts (get)"]
        MR_Autoscaling["autoscaling<br/>horizontalpodautoscalers<br/>CRUD + watch"]
        MR_Networking["networking.k8s.io<br/>ingresses<br/>CRUD + watch"]
        MR_KEDA["keda.sh<br/>scaledobjects + finalizers + status<br/>CRUD + watch"]
        MR_Webhooks["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigurations<br/>CRUD + watch"]
        MR_OTel["opentelemetry.io<br/>opentelemetrycollectors<br/>+ finalizers + status<br/>CRUD + watch"]
        MR_LocalModel["serving.kserve.io<br/>localmodelcaches,<br/>localmodelnamespacecaches<br/>get, list, watch"]
    end

    subgraph LLMISVCResources["kserve-llmisvc-manager-role Resources"]
        LR_KServe["serving.kserve.io<br/>llminferenceservices,<br/>llminferenceserviceconfigs<br/>+ finalizers + status<br/>CRUD"]
        LR_Gateway["gateway.networking.k8s.io<br/>gatewayclasses, gateways,<br/>httproutes<br/>CRUD"]
        LR_Inference["inference.networking.k8s.io<br/>+ x-k8s.io<br/>inferencemodels, inferencepools,<br/>inferenceobjectives<br/>CRUD"]
        LR_LWS["leaderworkerset.x-k8s.io<br/>leaderworkersets<br/>CRUD"]
        LR_KEDA["keda.sh<br/>scaledobjects<br/>CRUD"]
        LR_Variant["llmd.ai<br/>variantautoscalings<br/>CRUD"]
        LR_RBAC["rbac.authorization.k8s.io<br/>clusterrolebindings,<br/>roles, rolebindings<br/>CRUD"]
        LR_Core["core<br/>secrets, services, serviceaccounts (CRUD)<br/>configmaps, pods (read)<br/>events (create,patch,update)"]
    end

    subgraph LocalModelResources["kserve-localmodel-manager-role Resources"]
        LMR_KServe["serving.kserve.io<br/>localmodelcaches,<br/>localmodelnamespacecaches,<br/>localmodelnodes<br/>+ status<br/>CRUD"]
        LMR_PV["core<br/>persistentvolumes,<br/>persistentvolumeclaims<br/>create,get,list,patch,update,watch"]
        LMR_Nodes["core<br/>nodes + status<br/>get, list, watch"]
    end

    subgraph LocalModelNodeResources["kserve-localmodelnode-agent-role Resources"]
        LMNR_KServe["serving.kserve.io<br/>localmodelnodes + status<br/>CRUD"]
        LMNR_Batch["batch<br/>jobs + status<br/>CRUD"]
        LMNR_Core["core<br/>nodes, secrets,<br/>serviceaccounts<br/>get, list, watch"]
        LMNR_Storage["serving.kserve.io<br/>clusterstoragecontainers,<br/>localmodelnodegroups<br/>get, list, watch"]
    end

    subgraph ProxyResources["kserve-proxy-role Resources"]
        PR_Auth["authentication.k8s.io<br/>tokenreviews (create)<br/>authorization.k8s.io<br/>subjectaccessreviews (create)"]
    end

    %% SA → Binding → Role
    SA_Manager -->|bound via| CRB_Manager
    SA_Manager -->|bound via| CRB_Proxy
    SA_Manager -->|bound via| RB_LeaderManager
    CRB_Manager -->|grants| CR_Manager
    CRB_Proxy -->|grants| CR_Proxy
    RB_LeaderManager -->|grants| R_Leader

    SA_LLMISVC -->|bound via| RB_LLMISVC
    SA_LLMISVC -->|bound via| RB_LeaderLLM
    RB_LLMISVC -->|grants| CR_LLMISVC
    RB_LeaderLLM -->|grants| R_LeaderLLM

    SA_LocalModel -->|bound via| CRB_LocalModel
    CRB_LocalModel -->|grants| CR_LocalModel

    SA_LocalModelNode -->|bound via| RB_LocalModelNode
    RB_LocalModelNode -->|grants| CR_LocalModelNode

    %% Role → Resources
    CR_Manager -->|accesses| MR_KServe
    CR_Manager -->|accesses| MR_Knative
    CR_Manager -->|accesses| MR_Istio
    CR_Manager -->|accesses| MR_Gateway
    CR_Manager -->|accesses| MR_Apps
    CR_Manager -->|accesses| MR_Core
    CR_Manager -->|accesses| MR_Autoscaling
    CR_Manager -->|accesses| MR_Networking
    CR_Manager -->|accesses| MR_KEDA
    CR_Manager -->|accesses| MR_Webhooks
    CR_Manager -->|accesses| MR_OTel
    CR_Manager -->|accesses| MR_LocalModel

    CR_Proxy -->|accesses| PR_Auth

    CR_LLMISVC -->|accesses| LR_KServe
    CR_LLMISVC -->|accesses| LR_Gateway
    CR_LLMISVC -->|accesses| LR_Inference
    CR_LLMISVC -->|accesses| LR_LWS
    CR_LLMISVC -->|accesses| LR_KEDA
    CR_LLMISVC -->|accesses| LR_Variant
    CR_LLMISVC -->|accesses| LR_RBAC
    CR_LLMISVC -->|accesses| LR_Core

    CR_LocalModel -->|accesses| LMR_KServe
    CR_LocalModel -->|accesses| LMR_PV
    CR_LocalModel -->|accesses| LMR_Nodes

    CR_LocalModelNode -->|accesses| LMNR_KServe
    CR_LocalModelNode -->|accesses| LMNR_Batch
    CR_LocalModelNode -->|accesses| LMNR_Core
    CR_LocalModelNode -->|accesses| LMNR_Storage

