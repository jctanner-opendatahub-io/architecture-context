graph TB
    subgraph Operator["llm-d-batch-gateway-operator"]
        direction TB
        Manager["/manager<br/>Go controller-runtime"]

        subgraph Controllers["Controllers"]
            Reconciler["LLMBatchGateway<br/>Reconciler"]
            MetricsCtrl["Metrics<br/>Controller"]
            SecretSync["Secret<br/>Synchronizer"]
        end

        subgraph TLSHandling["TLS Profile Management"]
            TLSProfile["TLS Profile<br/>Reader"]
            ProfileWatcher["Security Profile<br/>Watcher"]
        end

        subgraph HelmCharts["Embedded Helm Charts"]
            BatchGW["batch-gateway<br/>Chart"]
            AsyncProc["async-processor<br/>Chart"]
        end

        Manager --> Reconciler
        Manager --> MetricsCtrl
        Manager --> SecretSync
        Manager --> TLSProfile
        TLSProfile --> ProfileWatcher
        Reconciler --> BatchGW
        Reconciler --> AsyncProc
    end

    %% CRD
    User[User / Platform Operator] -->|creates| BGCR["LLMBatchGateway CR<br/>(batch.llm-d.ai/v1alpha1)"]
    BGCR -->|watched by| Reconciler

    %% Managed Resources
    Reconciler -->|creates/manages| Deploy["Deployments<br/>(apiserver, processor,<br/>gc, async)"]
    Reconciler -->|creates/manages| Svc["Services"]
    Reconciler -->|creates/manages| SA["ServiceAccounts"]
    Reconciler -->|creates/manages| CM["ConfigMaps"]
    Reconciler -->|creates/manages| HTTPRoute["HTTPRoutes<br/>(Gateway API)"]
    Reconciler -->|creates/manages| Cert["Certificates<br/>(cert-manager)"]
    Reconciler -->|creates/manages| RefGrant["ReferenceGrants"]
    SecretSync -->|syncs| Secrets["Secrets<br/>(cross-namespace)"]

    %% Metrics
    MetricsCtrl -->|creates| MetricsSvc["Metrics Service<br/>:8443/HTTPS"]
    MetricsCtrl -->|creates| SM["ServiceMonitor"]
    MetricsCtrl -->|creates| PR["PrometheusRule"]

    %% External Dependencies
    TLSProfile -->|reads| OSAPIServer["OpenShift APIServer<br/>TLS Profile"]
    ProfileWatcher -->|triggers| GracefulRestart["Graceful Restart<br/>(on TLS change)"]

    %% Styling
    style Manager fill:#4a90e2,color:#fff
    style Reconciler fill:#4a90e2,color:#fff
    style MetricsCtrl fill:#4a90e2,color:#fff
    style SecretSync fill:#4a90e2,color:#fff
    style TLSProfile fill:#4a90e2,color:#fff
    style ProfileWatcher fill:#4a90e2,color:#fff
    style BatchGW fill:#6c5ce7,color:#fff
    style AsyncProc fill:#6c5ce7,color:#fff
    style BGCR fill:#f5a623,color:#000
    style Deploy fill:#7ed321,color:#000
    style Svc fill:#7ed321,color:#000
    style SA fill:#7ed321,color:#000
    style CM fill:#7ed321,color:#000
    style HTTPRoute fill:#7ed321,color:#000
    style Cert fill:#7ed321,color:#000
    style RefGrant fill:#7ed321,color:#000
    style Secrets fill:#7ed321,color:#000
    style MetricsSvc fill:#7ed321,color:#000
    style SM fill:#7ed321,color:#000
    style PR fill:#7ed321,color:#000
    style OSAPIServer fill:#e8e8e8,color:#000
