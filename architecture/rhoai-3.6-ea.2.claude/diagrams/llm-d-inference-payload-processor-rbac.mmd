graph TD
    subgraph "Service Account"
        SA["payload-processor<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "Role Bindings"
        RB["payload-processor-auth-reviewer-binding<br/>Namespace: ${NAMESPACE}"]
    end

    subgraph "ClusterRole"
        CR["payload-processor-auth-reviewer"]
    end

    subgraph "API Resources"
        ConfigMaps["(core)<br/>ConfigMaps"]
    end

    subgraph "Allowed Verbs"
        Get["get"]
        List["list"]
        Watch["watch"]
    end

    subgraph "Authentication & Authorization"
        direction TB
        ExtProcAuth["ExtProc gRPC (9004)<br/>Auth: None<br/>TLS: Self-signed (configurable)"]
        HealthAuth["Health gRPC (9005)<br/>Auth: None<br/>TLS: None (plaintext)"]
        MetricsAuth["Metrics HTTP (9090)<br/>Auth: K8s TokenReview<br/>+ SubjectAccessReview"]
    end

    SA -->|"bound via"| RB
    RB -->|"references"| CR
    CR -->|"grants access to"| ConfigMaps
    ConfigMaps --> Get
    ConfigMaps --> List
    ConfigMaps --> Watch

    %% Security context
    subgraph "Security Context"
        RunAs["Runs as: UID 65532 (nonroot)"]
        Image["Base: distroless/static:nonroot"]
        Build["Build: CGO_ENABLED=0 (upstream)"]
    end

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style RB fill:#f5a623,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style ConfigMaps fill:#7ed321,stroke:#333,color:#fff
    style Get fill:#d5e8d4,stroke:#82b366
    style List fill:#d5e8d4,stroke:#82b366
    style Watch fill:#d5e8d4,stroke:#82b366
    style ExtProcAuth fill:#ffe6cc,stroke:#d79b00
    style HealthAuth fill:#ffe6cc,stroke:#d79b00
    style MetricsAuth fill:#d5e8d4,stroke:#82b366
    style RunAs fill:#e1d5e7,stroke:#9673a6
    style Image fill:#e1d5e7,stroke:#9673a6
    style Build fill:#e1d5e7,stroke:#9673a6
