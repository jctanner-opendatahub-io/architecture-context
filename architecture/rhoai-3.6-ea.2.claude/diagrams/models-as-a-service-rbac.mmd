graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_API["maas-api<br/>Namespace: opendatahub"]
    end

    subgraph RoleBindings["ClusterRole Bindings (Namespace: opendatahub)"]
        CRB_API["maas-api<br/>(ClusterRoleBinding)"]
        CRB_SUPP["maas-api-supplemental<br/>(ClusterRoleBinding)"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_API["maas-api<br/>(ClusterRole)"]
        CR_SUPP["maas-api-supplemental<br/>(ClusterRole)"]
    end

    %% Bindings
    SA_API -->|bound via| CRB_API
    SA_API -->|bound via| CRB_SUPP
    CRB_API -->|grants| CR_API
    CRB_SUPP -->|grants| CR_SUPP

    %% maas-api ClusterRole Resources
    subgraph CR_API_Resources["maas-api ClusterRole Permissions"]
        direction LR
        Secrets_API["core/secrets<br/>Verbs: get"]
        NS_SA_SVC["core/namespaces,<br/>serviceaccounts, services<br/>Verbs: get, list, watch"]
        TokenReview["authentication.k8s.io<br/>tokenreviews<br/>Verbs: create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>Verbs: create"]
        MaaSResources["maas.opendatahub.io<br/>maasauthpolicies,<br/>maasmodelrefs,<br/>maassubscriptions<br/>Verbs: get, list, watch"]
        Gateways["gateway.networking.k8s.io<br/>gateways<br/>Verbs: get"]
        APIServers["config.openshift.io<br/>apiservers<br/>Verbs: get, list, watch"]
    end

    %% maas-api-supplemental ClusterRole Resources
    subgraph CR_SUPP_Resources["maas-api-supplemental ClusterRole Permissions"]
        direction LR
        Secrets_SUPP["core/secrets<br/>Verbs: get"]
        SAR_SUPP["authorization.k8s.io<br/>subjectaccessreviews<br/>Verbs: create"]
        MaaSResources_SUPP["maas.opendatahub.io<br/>maasmodelrefs,<br/>maassubscriptions<br/>Verbs: get, list, watch"]
        APIServers_SUPP["config.openshift.io<br/>apiservers<br/>Verbs: get, list, watch"]
        Gateways_SUPP["gateway.networking.k8s.io<br/>gateways<br/>Verbs: get"]
    end

    CR_API -->|"get"| Secrets_API
    CR_API -->|"get, list, watch"| NS_SA_SVC
    CR_API -->|"create"| TokenReview
    CR_API -->|"create"| SAR
    CR_API -->|"get, list, watch"| MaaSResources
    CR_API -->|"get"| Gateways
    CR_API -->|"get, list, watch"| APIServers

    CR_SUPP -->|"get"| Secrets_SUPP
    CR_SUPP -->|"create"| SAR_SUPP
    CR_SUPP -->|"get, list, watch"| MaaSResources_SUPP
    CR_SUPP -->|"get, list, watch"| APIServers_SUPP
    CR_SUPP -->|"get"| Gateways_SUPP

    %% Admission Webhooks
    subgraph Webhooks["Validating Admission Webhooks"]
        WH_Tenant["vaitenant.kb.io<br/>AITenant<br/>CREATE, UPDATE"]
        WH_AuthPolicy["vmaasauthpolicy.kb.io<br/>MaaSAuthPolicy<br/>CREATE"]
        WH_ModelRef["vmaasmodelref.kb.io<br/>MaaSModelRef<br/>CREATE, UPDATE"]
        WH_Subscription["vmaassubscription.kb.io<br/>MaaSSubscription<br/>CREATE"]
    end

    %% Secret Access
    subgraph SecretAccess["Secret Access (resourceNames restricted)"]
        DBSecret["maas-db-config<br/>(Opaque)<br/>PostgreSQL credentials"]
    end

    Secrets_API -->|"resourceNames: maas-db-config"| DBSecret
    Secrets_SUPP -->|"resourceNames: maas-db-config"| DBSecret

    %% Styling
    style SA_API fill:#4a90e2,stroke:#333,color:#fff
    style CR_API fill:#f5a623,stroke:#333
    style CR_SUPP fill:#f5a623,stroke:#333
    style CRB_API fill:#dae8fc,stroke:#6c8ebf
    style CRB_SUPP fill:#dae8fc,stroke:#6c8ebf
    style Secrets_API fill:#7ed321,stroke:#333
    style NS_SA_SVC fill:#7ed321,stroke:#333
    style TokenReview fill:#7ed321,stroke:#333
    style SAR fill:#7ed321,stroke:#333
    style MaaSResources fill:#7ed321,stroke:#333
    style Gateways fill:#7ed321,stroke:#333
    style APIServers fill:#7ed321,stroke:#333
    style Secrets_SUPP fill:#7ed321,stroke:#333
    style SAR_SUPP fill:#7ed321,stroke:#333
    style MaaSResources_SUPP fill:#7ed321,stroke:#333
    style APIServers_SUPP fill:#7ed321,stroke:#333
    style Gateways_SUPP fill:#7ed321,stroke:#333
    style DBSecret fill:#fff2cc,stroke:#d6b656
    style WH_Tenant fill:#e1d5e7,stroke:#9673a6
    style WH_AuthPolicy fill:#e1d5e7,stroke:#9673a6
    style WH_ModelRef fill:#e1d5e7,stroke:#9673a6
    style WH_Subscription fill:#e1d5e7,stroke:#9673a6
