graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS (Platform TLS Termination)"]
        Route["OpenShift Route / Istio Gateway<br/>443/TCP &rarr; 8321/TCP<br/>TLS termination at ingress"]
    end

    subgraph AppTier["APPLICATION TIER (No app-level TLS)"]
        direction TB

        subgraph OGXServer["OGX Distribution Server"]
            direction LR
            AuthMiddleware["OAuth2 JWT Validator<br/>(when AUTH_ISSUER set)<br/>JWKS-based verification"]
            APIHandler["API Handler<br/>/v1/chat/completions<br/>/v1/responses<br/>/v1/messages<br/>/v1/models<br/>/v1/health"]
            MetricsEndpoint["/metrics<br/>(Prometheus)"]
        end
    end

    subgraph RequiredBackends["REQUIRED BACKEND SERVICES"]
        vLLM["vLLM Inference Backend<br/>Configurable URL<br/>TLS verify configurable"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>KV + SQL state store"]
    end

    subgraph OptionalBackends["OPTIONAL BACKEND SERVICES"]
        Milvus["Milvus Vector DB<br/>Configurable endpoint<br/>mTLS configurable"]
        PGVector["PGVector<br/>5432/TCP<br/>PostgreSQL extension"]
        Qdrant["Qdrant Vector DB<br/>6333/TCP HTTP<br/>6334/TCP gRPC"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        IdP["OAuth2 Identity Provider<br/>443/TCP HTTPS<br/>JWKS endpoint"]
        OTEL["OpenTelemetry Collector<br/>OTLP HTTP/gRPC<br/>(optional)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>(via ServiceMonitor)"]
    end

    subgraph Operator["LIFECYCLE MANAGEMENT"]
        OGXOperator["ogx-operator<br/>Manages OGX deployments"]
    end

    %% Flows
    Client -->|"HTTPS/443<br/>TLS (platform-managed)<br/>OAuth2 Bearer Token"| Route
    Route -->|"HTTP/8321<br/>Plaintext (--insecure)<br/>Auth header passthrough"| APIHandler
    APIHandler -->|"HTTP/HTTPS<br/>TLS verify configurable<br/>Service-to-service"| vLLM
    APIHandler -->|"PostgreSQL/5432<br/>Configurable encryption<br/>POSTGRES_PASSWORD (_FILE)"| PostgreSQL
    APIHandler -->|"HTTP/gRPC<br/>mTLS configurable<br/>MILVUS_TOKEN (_FILE)"| Milvus
    APIHandler -->|"PostgreSQL/5432<br/>Configurable"| PGVector
    APIHandler -->|"HTTP/6333 gRPC/6334<br/>HTTPS configurable"| Qdrant
    AuthMiddleware -->|"HTTPS/443<br/>TLS (AUTH_TLS_CAFILE)<br/>JWKS fetch"| IdP
    APIHandler -->|"OTLP<br/>When OTEL_SERVICE_NAME set"| OTEL
    Prometheus -->|"HTTP/metrics<br/>Scrape"| MetricsEndpoint
    OGXOperator -.->|"Lifecycle management"| OGXServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef required fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef optional fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class AuthMiddleware,APIHandler,MetricsEndpoint app
    class vLLM,PostgreSQL required
    class Milvus,PGVector,Qdrant optional
    class IdP,OTEL externalservice
    class Prometheus monitoring
    class OGXOperator monitoring
