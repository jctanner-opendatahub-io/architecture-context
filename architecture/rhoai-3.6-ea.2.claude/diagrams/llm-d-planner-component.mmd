graph TB
    subgraph External["External Access"]
        User[Platform Operator / Browser]
    end

    subgraph Routes["OpenShift Routes (TLS Termination)"]
        PlannerRoute["planner Route<br/>HTTPS"]
        BackendRoute["planner-backend Route<br/>HTTPS"]
    end

    subgraph Planner["llm-d-planner (Namespace: planner)"]
        subgraph UIDeployment["UI Deployment"]
            StreamlitUI["Streamlit UI<br/>Port: 8501<br/>quay.io/llm-d-planner/<br/>llm-d-planner-ui:latest"]
        end

        subgraph BackendDeployment["Backend Deployment"]
            FastAPI["FastAPI Backend<br/>Port: 8000<br/>quay.io/llm-d-planner/<br/>llm-d-planner-backend:latest"]
            GPUDetector["GPU Detector<br/>(TTL cache: 300s)"]
            LLMFactory["LLM Provider Factory<br/>(Ollama / OpenAI / Vertex AI)"]
            BenchmarkDB["Benchmark Database<br/>(Local SQLite)"]
            FastAPI --> GPUDetector
            FastAPI --> LLMFactory
            FastAPI --> BenchmarkDB
        end

        subgraph OllamaDeployment["Ollama Deployment"]
            Ollama["Ollama LLM<br/>Port: 11434<br/>ollama/ollama:latest"]
        end
    end

    subgraph ExternalServices["External Services"]
        K8sAPI["Kubernetes API<br/>Port: 6443"]
        OpenAIAPI["OpenAI API<br/>HTTPS"]
        VertexAI["Vertex AI (Claude)<br/>Port: 443"]
        HuggingFace["HuggingFace Hub<br/>HTTPS"]
    end

    User -->|HTTPS| PlannerRoute
    User -->|HTTPS| BackendRoute
    PlannerRoute -->|HTTP/8501| StreamlitUI
    BackendRoute -->|HTTP/8000| FastAPI
    StreamlitUI -->|HTTP/8000| FastAPI

    LLMFactory -->|HTTP/11434<br/>No encryption| Ollama
    LLMFactory -->|HTTPS<br/>API Key| OpenAIAPI
    LLMFactory -->|HTTPS<br/>GCP credentials| VertexAI

    GPUDetector -->|HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount| K8sAPI
    FastAPI -->|HTTPS<br/>Token| HuggingFace

    style FastAPI fill:#4a90e2,stroke:#333,color:#fff
    style StreamlitUI fill:#4a90e2,stroke:#333,color:#fff
    style Ollama fill:#4a90e2,stroke:#333,color:#fff
    style GPUDetector fill:#7ed321,stroke:#333
    style LLMFactory fill:#7ed321,stroke:#333
    style BenchmarkDB fill:#7ed321,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OpenAIAPI fill:#e8e8e8,stroke:#333
    style VertexAI fill:#e8e8e8,stroke:#333
    style HuggingFace fill:#e8e8e8,stroke:#333
    style PlannerRoute fill:#f5a623,stroke:#333
    style BackendRoute fill:#f5a623,stroke:#333
