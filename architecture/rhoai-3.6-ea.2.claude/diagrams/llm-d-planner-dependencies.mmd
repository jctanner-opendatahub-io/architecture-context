    LLMDPlanner -->|"ML tokenizers"| Transformers["transformers >=5.14.1"]
    LLMDPlanner -->|"data processing"| Pandas["pandas >=3.0.5"]

    %% LLM SDK Dependencies
    LLMDPlanner -->|"OpenAI SDK"| OpenAISDK["openai >=3.1.0"]
    LLMDPlanner -->|"Anthropic SDK"| AnthropicSDK["anthropic >=0.122.0"]
    LLMDPlanner -->|"Ollama SDK"| OllamaSDK["ollama >=0.6.2"]

    %% UI Dependencies
    StreamlitUI["Streamlit UI"] -->|"API calls<br/>HTTP/8000"| LLMDPlanner
    StreamlitUI -->|"UI framework"| Streamlit["streamlit >=1.61.1"]

