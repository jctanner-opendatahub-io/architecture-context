graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Client / Data Scientist SDK"]
    end

    subgraph AppBoundary["APPLICATION BOUNDARY (Port 5000)"]
        direction TB

        subgraph AuthZone["Authentication Layer"]
            K8sAuthPlugin["kubernetes-auth Plugin<br/>(mlflow-kubernetes-plugins==1.5.0)<br/>SA Bearer Token Validation<br/>Token Cache: 60s TTL"]
        end

        subgraph ServerZone["Server Runtime"]
            direction LR
            Gunicorn["gunicorn<br/>WSGI"]
            Uvicorn["uvicorn<br/>ASGI"]
        end

        subgraph APIZone["API Surface (48 endpoints)"]
            direction TB
            TrackingAPI["Tracking & Registry API<br/>/ajax-api/3.0/mlflow/*"]
            AssistantAPI["Assistant API<br/>/ajax-api/3.0/mlflow/assistant/*"]
            JobsAPI["Jobs API<br/>/ajax-api/3.0/jobs/*"]
            GatewayAPI["AI Gateway<br/>/gateway/proxy/* /v1/*"]
            ModelMgmt["Model Management<br/>/{name}/versions/* /{name}/endpoints/*"]
        end
    end

    subgraph K8sCluster["KUBERNETES CLUSTER (Internal)"]
        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS<br/>SA Token Auth"]
        SAToken["/var/run/secrets/<br/>serviceaccount/token"]
    end

    subgraph ExternalAI["EXTERNAL AI PROVIDERS (Egress)"]
        OpenAI["api.openai.com<br/>443/TCP HTTPS<br/>Bearer: $OPENAI_API_KEY"]
        Bedrock["AWS Bedrock<br/>443/TCP HTTPS<br/>AWS SigV4"]
        OtherAI["Cohere / Anthropic / Mistral<br/>Groq / DeepSeek / xAI<br/>OpenRouter / Ollama<br/>443/TCP HTTPS Bearer Token"]
    end

    subgraph ExternalStorage["EXTERNAL STORAGE (Egress)"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>AWS IAM (boto3)"]
        GCS["Google Cloud Storage<br/>443/TCP HTTPS<br/>GCP Credentials"]
        Azure["Azure Blob Storage<br/>443/TCP HTTPS<br/>SAS Token"]
    end

    %% Inbound Flows
    Client -->|"HTTP(S)/5000<br/>Bearer Token (K8s SA)<br/>+ X-MLFLOW-WORKSPACE"| K8sAuthPlugin
    K8sAuthPlugin --> ServerZone
    ServerZone --> APIZone

    %% Token source
    K8sAuthPlugin -.->|"reads token"| SAToken

    %% Outbound - Kubernetes
    JobsAPI -->|"HTTPS/443<br/>SA Token<br/>BatchV1Api.create_namespaced_job()"| K8sAPI

    %% Outbound - AI Providers
    GatewayAPI -->|"HTTPS/443<br/>Bearer Token"| OpenAI
    GatewayAPI -->|"HTTPS/443<br/>AWS SigV4"| Bedrock
    GatewayAPI -->|"HTTPS/443<br/>Bearer Token"| OtherAI

    %% Outbound - Storage
    TrackingAPI -->|"HTTPS/443<br/>AWS IAM"| S3
    TrackingAPI -->|"HTTPS/443<br/>GCP Auth"| GCS
    TrackingAPI -->|"HTTPS/443<br/>SAS Token"| Azure

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef appboundary fill:#e8f0fe,stroke:#4a90e2,stroke-width:2px
    classDef auth fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef api fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef k8s fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class K8sAuthPlugin auth
    class Gunicorn,Uvicorn appboundary
    class TrackingAPI,AssistantAPI,JobsAPI,GatewayAPI,ModelMgmt api
    class K8sAPI,SAToken k8s
    class OpenAI,Bedrock,OtherAI externalservice
    class S3,GCS,Azure storage
