graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Admin["Cluster Admin / kubectl"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>ServiceAccount / kubeconfig"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-operator)"]
        direction TB

        subgraph ManagerPod["opendatahub-operator-controller-manager"]
            direction LR
            Webhook["Webhook Server<br/>9443/TCP TLS<br/>service-ca cert<br/>Admission auth"]
            Metrics["Metrics Server<br/>8443/TCP TLS<br/>service-ca cert<br/>RBAC auth"]
            Health["Health Probes<br/>8081/TCP HTTP<br/>No encryption<br/>Unauthenticated"]
        end

        WebhookSvc["webhook-service<br/>ClusterIP 443→9443"]
        MetricsSvc["metrics-service<br/>ClusterIP 8443→8443"]
    end

    subgraph GatewayResources["GATEWAY MANAGED RESOURCES"]
        direction TB
        GatewayAPI["Gateway API<br/>Resources"]
        KubeAuthProxy["kube-auth-proxy<br/>OIDC Deployments"]
        HTTPRoute["HTTPRoutes"]
        OSRoutes["OpenShift Routes<br/>HTTPS/TLS"]
        EnvoyFilter["Istio EnvoyFilters"]
        DestRule["Istio DestinationRules"]
        NetPolicy["NetworkPolicies"]
    end

    subgraph AuthResources["AUTH MANAGED RESOURCES"]
        direction TB
        ClusterRoles["ClusterRoles<br/>(admin/allowed groups)"]
        RoleBindings["RoleBindings"]
        WatchedNS["Watched Namespaces:<br/>models-as-a-service<br/>kuadrant-system"]
    end

    subgraph WatchedExternal["WATCHED EXTERNAL RESOURCES"]
        direction TB
        OSAPIServer["OpenShift APIServer<br/>TLS Security Profile"]
        IstioMesh["Istio Service Mesh<br/>EnvoyFilter, DestinationRule CRDs"]
        PromOperator["prometheus-operator<br/>PodMonitor, PrometheusRule CRDs"]
        GatewayAPICRDs["Gateway API<br/>Gateway, HTTPRoute CRDs"]
    end

    %% Flows
    Admin -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig auth"| APIServer

    APIServer -->|"HTTPS/9443<br/>TLS (service-ca)<br/>Admission webhook"| Webhook
    APIServer -->|"HTTPS/8443<br/>TLS (service-ca)<br/>RBAC auth"| Metrics
    APIServer -->|"HTTP/8081<br/>Plaintext<br/>No auth"| Health

    ManagerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| APIServer

    ManagerPod -->|"creates"| GatewayAPI
    ManagerPod -->|"creates"| KubeAuthProxy
    ManagerPod -->|"creates"| HTTPRoute
    ManagerPod -->|"creates"| OSRoutes
    ManagerPod -->|"creates"| EnvoyFilter
    ManagerPod -->|"creates"| DestRule
    ManagerPod -->|"creates"| NetPolicy

    ManagerPod -->|"creates"| ClusterRoles
    ManagerPod -->|"creates"| RoleBindings
    ManagerPod -->|"watches"| WatchedNS

    ManagerPod -.->|"reads config"| OSAPIServer
    ManagerPod -.->|"dynamic guard"| IstioMesh
    ManagerPod -.->|"owns resources"| PromOperator
    ManagerPod -.->|"watches"| GatewayAPICRDs

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef watched fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef service fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Admin external
    class APIServer controlplane
    class Webhook,Metrics,Health,ManagerPod operator
    class WebhookSvc,MetricsSvc service
    class GatewayAPI,KubeAuthProxy,HTTPRoute,OSRoutes,EnvoyFilter,DestRule,NetPolicy managed
    class ClusterRoles,RoleBindings,WatchedNS managed
    class OSAPIServer,IstioMesh,PromOperator,GatewayAPICRDs watched
