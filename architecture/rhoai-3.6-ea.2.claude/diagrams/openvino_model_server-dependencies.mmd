graph LR
    OVMS["OpenVINO Model Server<br/>(OVMS)"]

    %% Internal RHOAI Dependencies
    OVMS -->|"ServingRuntime CR<br/>runtime-provider"| KServe["KServe<br/>serving.kserve.io"]

    %% External Dependencies (Go client libraries)
    OVMS -.->|"gRPC transport<br/>v1.79.3"| GRPC["google.golang.org/grpc"]
    OVMS -.->|"protobuf<br/>v1.36.10"| Protobuf["google.golang.org/protobuf"]
    OVMS -.->|"protobuf (legacy)<br/>v1.5.4"| ProtoLegacy["github.com/golang/protobuf"]

    %% Runtime Dependencies
    OVMS -->|"model artifacts<br/>File I/O"| ModelStorage["Model Storage<br/>/mnt/models<br/>(PVC / S3)"]
    OVMS -->|"base image"| UBI9["UBI 9<br/>Red Hat"]
    OVMS -->|"crypto library"| OpenSSL["OpenSSL<br/>(system-provided)"]

    %% Integration Points
    Prometheus["Prometheus"] -->|"HTTP scrape<br/>/metrics"| OVMS
    Istio["Istio / Service Mesh"] -->|"traffic routing<br/>platform auth"| OVMS

    %% Optional
    NginxSidecar["nginx mTLS Sidecar<br/>(optional)"] -->|"TLS termination<br/>client cert auth"| OVMS

    %% Upstream lineage
    Upstream["openvinotoolkit/model_server<br/>(upstream)"] -.->|"sync via midstream"| Midstream["opendatahub-io/openvino_model_server<br/>(midstream)"]
    Midstream -.->|"auto_merge"| Downstream["red-hat-data-services/openvino_model_server<br/>(downstream)"]

    style OVMS fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style KServe fill:#7ed321,stroke:#333
    style ModelStorage fill:#f5a623,stroke:#333
    style Prometheus fill:#7ed321,stroke:#333
    style Istio fill:#7ed321,stroke:#333
    style UBI9 fill:#cc0000,stroke:#333,color:#fff
    style OpenSSL fill:#999,stroke:#333
    style GRPC fill:#999,stroke:#333
    style Protobuf fill:#999,stroke:#333
    style ProtoLegacy fill:#999,stroke:#333
    style NginxSidecar fill:#e6550d,stroke:#333,color:#fff
    style Upstream fill:#ddd,stroke:#333
    style Midstream fill:#ddd,stroke:#333
    style Downstream fill:#ddd,stroke:#333
