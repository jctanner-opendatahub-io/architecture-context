graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist<br/>Browser"]
    end

    subgraph Ingress["INGRESS (OpenShift Route)"]
        Route["OpenShift Route<br/>443/TCP<br/>TLS Termination"]
    end

    subgraph AuthLayer["AUTHENTICATION LAYER"]
        OAuthProxy["OAuth Proxy Sidecar<br/>Injected by odh-notebook-controller<br/>OpenShift OAuth validation"]
    end

    subgraph WorkbenchPod["WORKBENCH POD (User Namespace)"]
        direction TB

        subgraph JupyterLabPath["JupyterLab Workbench"]
            JupyterLab["JupyterLab Server<br/>8888/TCP HTTP<br/>Auth: DISABLED<br/>start-notebook.sh"]
        end

        subgraph CodeServerPath["Code-Server Workbench"]
            Nginx["nginx Reverse Proxy<br/>8787/TCP HTTP<br/>NB_PREFIX path routing"]
            CodeServerApp["code-server<br/>9999/TCP HTTP<br/>Auth: DISABLED (--auth none)"]
        end

        Nginx -->|HTTP/9999<br/>localhost| CodeServerApp
    end

    subgraph ExternalServices["EXTERNAL SERVICES (User Workload)"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>TLS<br/>ServiceAccount Token"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS<br/>AWS IAM / Access Keys"]
    end

    %% Flows
    User -->|"HTTPS/443<br/>TLS<br/>OAuth redirect"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>OAuth token"| OAuthProxy
    OAuthProxy -->|"HTTP/8888<br/>No encryption (pod-local)<br/>No auth (delegated)"| JupyterLab
    OAuthProxy -->|"HTTP/8787<br/>No encryption (pod-local)<br/>No auth (delegated)"| Nginx
    JupyterLab -.->|"HTTPS/443<br/>TLS<br/>SA token"| K8sAPI
    JupyterLab -.->|"HTTPS/443<br/>TLS<br/>IAM creds"| S3

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef auth fill:#ff6666,stroke:#cc0000,stroke-width:3px,color:#fff
    classDef workbench fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef danger fill:#ffcccc,stroke:#cc0000,stroke-width:2px

    class User external
    class Route ingress
    class OAuthProxy auth
    class JupyterLab,Nginx,CodeServerApp workbench
    class K8sAPI,S3 externalservice
