graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (Network Isolated)"]
        direction TB

        subgraph EventIngestion["Event Ingestion Zone"]
            vLLM["vLLM Inference Engines<br/>ZMQ Publisher"]
            EventProcessor["KV Cache Manager<br/>Event Processor<br/>ZMQ :5557/TCP"]
        end

        subgraph DataStore["Data Store Zone"]
            Redis["Redis / Valkey<br/>:6379/TCP<br/>redis:// or rediss://"]
        end

        subgraph ScoringZone["Scoring Zone (No Auth)"]
            ScoringAPI["Scoring API<br/>:8080/TCP HTTP<br/>No Authentication"]
            IndexerGRPC["IndexerService<br/>gRPC HTTP/2<br/>No Authentication"]
            Metrics["/metrics<br/>:8080/TCP HTTP<br/>Prometheus"]
        end

        subgraph ControllerZone["Controller Plane"]
            PodReconciler["Pod Reconciler<br/>controller-runtime<br/>SA: configured"]
        end

        subgraph SidecarZone["Optional Sidecar"]
            Tokenizer["External Tokenizer<br/>UDS gRPC<br/>emptyDir volume"]
        end
    end

    subgraph ExternalCallers["INTERNAL CALLERS"]
        Router["llm-d-router"]
        GRPCClient["gRPC Client"]
        Prometheus["Prometheus"]
    end

    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount RBAC"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC"]
    end

    %% Event Ingestion Flow
    vLLM -->|ZMQ pub/sub<br/>5557/TCP<br/>Plaintext TCP<br/>No Auth| EventProcessor
    EventProcessor -->|Redis protocol<br/>6379/TCP<br/>Plaintext or TLS| Redis

    %% Scoring Flow
    Router -->|HTTP POST<br/>8080/TCP<br/>Plaintext HTTP<br/>No Auth| ScoringAPI
    GRPCClient -->|gRPC<br/>HTTP/2<br/>No TLS default<br/>No Auth| IndexerGRPC
    ScoringAPI -->|read index| Redis
    IndexerGRPC -->|read index| Redis

    %% Controller Flow
    PodReconciler -->|HTTPS/WSS<br/>6443/TCP<br/>TLS 1.2+<br/>SA Token| K8sAPI

    %% Observability Flow
    EventProcessor -->|OTLP/gRPC<br/>Runtime configured| OTel
    Prometheus -->|HTTP GET /metrics<br/>8080/TCP<br/>No Auth| Metrics

    %% Sidecar Flow
    ScoringAPI -->|Unix Domain Socket<br/>gRPC<br/>No Encryption| Tokenizer

    %% Styling
    classDef noauth fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef tls fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef plaintext fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef internal fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px

    class ScoringAPI,IndexerGRPC noauth
    class K8sAPI tls
    class vLLM,EventProcessor,Redis plaintext
    class Router,GRPCClient,Prometheus external
    class PodReconciler,Tokenizer,Metrics internal
