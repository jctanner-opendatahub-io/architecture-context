graph LR
    TrustyAI["TrustyAI Service<br/>(Python FastAPI)"]

    %% Internal Platform Dependencies
    TrustyAI -->|"auth proxy<br/>8443→8081/TCP"| KRBP["kube-rbac-proxy"]
    TrustyAI -->|"CloudEvent consumer<br/>8080/TCP"| KServe["KServe<br/>Inference Logger"]
    TrustyAI -->|"v2 payload consumer<br/>8080/TCP"| ModelMesh["ModelMesh<br/>Agent"]

    %% Runtime Framework Dependencies
    TrustyAI -->|"ASGI server"| Hypercorn["Hypercorn >=0.18"]
    TrustyAI -->|"web framework"| FastAPI["FastAPI >=0.116"]
    TrustyAI -->|"data validation"| Pydantic["Pydantic >=2.13"]

    %% ML/Data Dependencies
    TrustyAI -->|"numerical compute"| NumPy["NumPy >=2.0"]
    TrustyAI -->|"data processing"| Pandas["Pandas >=3.0"]
    TrustyAI -->|"ML algorithms"| Scikit["scikit-learn >=1.7"]
    TrustyAI -->|"scientific compute"| SciPy["SciPy >=1.15"]
    TrustyAI -->|"HDF5 storage"| H5py["h5py >=3.13"]
    TrustyAI -->|"data frames"| Polars["Polars >=1.2"]

    %% Infrastructure Dependencies
    TrustyAI -->|"metrics export<br/>GET /q/metrics"| Prometheus["Prometheus<br/>(scrape target)"]
    TrustyAI -->|"optional storage<br/>3306/TCP"| MariaDB["MariaDB<br/>(optional)"]
    TrustyAI -->|"default storage"| PVC["PVC<br/>(HDF5 files)"]

    %% Transport Dependencies
    TrustyAI -->|"protobuf serialization"| Protobuf["protobuf >=7"]
    TrustyAI -->|"metrics client"| PromClient["prometheus-client >=0.22"]
    TrustyAI -->|"DB client"| MariaDBPy["mariadb >=1.1"]

    %% Consumers (reverse dependencies)
    Kubelet["Kubelet"] -->|"health probes<br/>8080/TCP"| TrustyAI

    %% Styling
    style TrustyAI fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Internal platform
    style KRBP fill:#7ed321,stroke:#333
    style KServe fill:#7ed321,stroke:#333
    style ModelMesh fill:#7ed321,stroke:#333

    %% Runtime framework
    style Hypercorn fill:#9b59b6,stroke:#333,color:#fff
    style FastAPI fill:#9b59b6,stroke:#333,color:#fff
    style Pydantic fill:#9b59b6,stroke:#333,color:#fff

    %% ML/Data
    style NumPy fill:#e67e22,stroke:#333,color:#fff
    style Pandas fill:#e67e22,stroke:#333,color:#fff
    style Scikit fill:#e67e22,stroke:#333,color:#fff
    style SciPy fill:#e67e22,stroke:#333,color:#fff
    style H5py fill:#e67e22,stroke:#333,color:#fff
    style Polars fill:#e67e22,stroke:#333,color:#fff

    %% Infrastructure
