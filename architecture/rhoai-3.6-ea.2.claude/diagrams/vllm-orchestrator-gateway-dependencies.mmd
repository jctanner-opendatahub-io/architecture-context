graph LR
    Gateway["vllm-orchestrator-gateway<br/>(Rust Service)"]

    %% Runtime Framework Dependencies
    Gateway -->|"HTTP framework"| Axum["axum 0.7.9"]
    Gateway -->|"async runtime"| Tokio["tokio 1.41.1"]
    Gateway -->|"HTTP middleware"| TowerHTTP["tower-http 0.6.2"]

    %% TLS / Crypto Dependencies
    Gateway -->|"TLS provider"| OpenSSL["openssl 0.10.73"]
    Gateway -->|"TLS abstraction"| NativeTLS["native-tls 0.2.12"]

    %% HTTP Client Dependencies
    Gateway -->|"HTTP client"| Reqwest["reqwest 0.12.12<br/>(native-tls feature)"]
    Reqwest -.->|"uses"| NativeTLS

    %% Serialization Dependencies
    Gateway -->|"JSON serde"| SerdeJSON["serde_json 1.0.133"]
    Gateway -->|"YAML config"| SerdeYML["serde_yml 0.0.12"]
    Gateway -->|"serialization"| Serde["serde 1.0.215"]

    %% Observability
    Gateway -->|"logging"| Tracing["tracing 0.1.41"]
    Gateway -->|"log subscriber"| TracingSub["tracing-subscriber 0.3.19"]

    %% Utility Dependencies
    Gateway -->|"error handling"| Anyhow["anyhow 1.0.94"]
    Gateway -->|"async streams"| Futures["futures 0.3.30"]
    Gateway -->|"pattern matching"| Regex["regex 1.11.1"]

    %% Internal Platform Dependencies
    Gateway ==>|"proxies requests to<br/>HTTP/HTTPS (optional mTLS)<br/>port configurable (default 8085)"| Orchestrator["TrustyAI Orchestrator<br/>(vllm-orchestrator)"]

    %% Styling
    style Gateway fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Orchestrator fill:#7ed321,stroke:#333,stroke-width:2px

    style Axum fill:#999,stroke:#333
    style Tokio fill:#999,stroke:#333
    style TowerHTTP fill:#999,stroke:#333
    style OpenSSL fill:#999,stroke:#333
    style NativeTLS fill:#999,stroke:#333
    style Reqwest fill:#999,stroke:#333
    style SerdeJSON fill:#999,stroke:#333
    style SerdeYML fill:#999,stroke:#333
    style Serde fill:#999,stroke:#333
    style Tracing fill:#999,stroke:#333
    style TracingSub fill:#999,stroke:#333
    style Anyhow fill:#999,stroke:#333
    style Futures fill:#999,stroke:#333
    style Regex fill:#999,stroke:#333
