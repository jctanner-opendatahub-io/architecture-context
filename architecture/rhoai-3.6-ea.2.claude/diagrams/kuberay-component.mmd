graph TB
    subgraph KubeRayOperator["KubeRay Operator (controller-runtime)"]
        direction TB
        RayClusterCtrl["RayCluster Controller"]
        RayJobCtrl["RayJob Controller"]
        RayServiceCtrl["RayService Controller"]
        RayCronJobCtrl["RayCronJob Controller"]
        AuthCtrl["Authentication Controller"]
        NetworkPolicyCtrl["NetworkPolicy Controller"]
        MTLSCtrl["RayClusterMTLS Controller"]
        MetricsSrv["Metrics Server<br/>:8080"]
        HealthProbe["Health/Ready Probes<br/>:8082"]
        WebhookSrv["Webhook Server<br/>HTTPS"]
    end

    %% CRDs watched
    RayClusterCR["RayCluster CR<br/>(ray.io/v1)"]
    RayJobCR["RayJob CR<br/>(ray.io/v1)"]
    RayServiceCR["RayService CR<br/>(ray.io/v1)"]
    RayCronJobCR["RayCronJob CR<br/>(ray.io/v1)"]

    %% Resources created
    RayClusterCR -->|watched by| RayClusterCtrl
    RayClusterCR -->|watched by| AuthCtrl
    RayClusterCR -->|watched by| NetworkPolicyCtrl
    RayClusterCR -->|watched by| MTLSCtrl
    RayJobCR -->|watched by| RayJobCtrl
    RayServiceCR -->|watched by| RayServiceCtrl
    RayCronJobCR -->|watched by| RayCronJobCtrl

    %% Created resources
    RayClusterCtrl -->|creates| Pods["Pods<br/>(Head + Workers)"]
    RayClusterCtrl -->|creates| Services["Services"]
    RayClusterCtrl -->|creates| Secrets["Secrets"]
    RayJobCtrl -->|creates| BatchJobs["batch/v1 Jobs"]
    RayJobCtrl -->|creates| RayClusterCR
    RayServiceCtrl -->|creates| RayClusterCR
    RayCronJobCtrl -->|creates| RayJobCR

    %% Auth controller creates
    AuthCtrl -->|injects| KubeRBACProxy["kube-rbac-proxy<br/>Sidecar :8443"]
    AuthCtrl -->|creates| HTTPRoute["HTTPRoute<br/>(Gateway API)"]
    AuthCtrl -->|creates| ReferenceGrant["ReferenceGrant"]

    %% mTLS controller creates
    MTLSCtrl -->|creates| CertManagerCert["cert-manager<br/>Certificate + Issuer"]

    %% NetworkPolicy controller creates
    NetworkPolicyCtrl -->|creates| NetPol["NetworkPolicy"]

    %% Webhooks
    WebhookSrv -->|mutates| RayClusterCR
    WebhookSrv -->|validates| RayClusterCR
    WebhookSrv -->|validates| RayJobCR
    WebhookSrv -->|validates| RayServiceCR

    %% External dependencies
    RayClusterCtrl -->|calls| K8sAPI["Kubernetes API<br/>:6443 HTTPS"]
    AuthCtrl -->|reads| OpenShiftConfig["OpenShift<br/>APIServer Config"]
    MetricsSrv -.->|scraped by| Prometheus["Prometheus"]

    %% Styling
    style RayClusterCtrl fill:#4a90e2,color:#fff
    style RayJobCtrl fill:#4a90e2,color:#fff
    style RayServiceCtrl fill:#4a90e2,color:#fff
    style RayCronJobCtrl fill:#4a90e2,color:#fff
    style AuthCtrl fill:#4a90e2,color:#fff
    style NetworkPolicyCtrl fill:#4a90e2,color:#fff
    style MTLSCtrl fill:#4a90e2,color:#fff
    style MetricsSrv fill:#4a90e2,color:#fff
    style HealthProbe fill:#4a90e2,color:#fff
    style WebhookSrv fill:#4a90e2,color:#fff
    style RayClusterCR fill:#f5a623,color:#000
    style RayJobCR fill:#f5a623,color:#000
    style RayServiceCR fill:#f5a623,color:#000
    style RayCronJobCR fill:#f5a623,color:#000
    style KubeRBACProxy fill:#e74c3c,color:#fff
    style HTTPRoute fill:#7ed321,color:#000
    style CertManagerCert fill:#7ed321,color:#000
    style K8sAPI fill:#e8e8e8,color:#000
    style Prometheus fill:#e8e8e8,color:#000
    style OpenShiftConfig fill:#e8e8e8,color:#000
