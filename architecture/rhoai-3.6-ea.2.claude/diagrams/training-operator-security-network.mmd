graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / User"]
    end

    subgraph KubeAPI["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC enforced"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (Cluster-scoped RBAC)"]
        direction TB

        subgraph OperatorPod["Training Operator Pod<br/>SA: training-operator<br/>FIPS: strictfipsruntime"]
            Webhook["Webhook Server<br/>9443/TCP HTTPS<br/>TLS (cluster-aligned)<br/>Fail policy"]
            Metrics["Metrics Server<br/>8080/TCP HTTP<br/>Plaintext<br/>No auth"]
            Health["Health Probes<br/>8081/TCP HTTP<br/>/healthz, /readyz<br/>No auth"]
        end
    end

    subgraph WorkloadNS["WORKLOAD NAMESPACES (NetworkPolicy isolated)"]
        Workers["Worker Pods<br/>Per-job NetworkPolicies<br/>Created by reconcilers"]
    end

    subgraph PlatformSvcs["PLATFORM SERVICES"]
        Prometheus["Prometheus<br/>Inbound scrape<br/>HTTP"]
        OpenShiftCfg["OpenShift APIServer<br/>config.openshift.io/v1<br/>TLS profile source"]
        Volcano["Volcano Scheduler<br/>scheduling.volcano.sh<br/>PodGroup CRUD"]
        SchedPlugins["Scheduler Plugins<br/>scheduling.x-k8s.io<br/>PodGroup CRUD"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig auth"| APIServer
    APIServer -->|"HTTPS/443 → 9443<br/>TLS (cluster-aligned)<br/>Admission webhook"| Webhook
    OperatorPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token auth"| APIServer
    OperatorPod -->|"creates via API"| Workers
    Prometheus -->|"HTTP/8080<br/>Plaintext<br/>No auth"| Metrics
    OperatorPod -->|"reads TLS profile<br/>via Kubernetes API"| OpenShiftCfg
    OperatorPod -->|"PodGroup CRUD<br/>via Kubernetes API"| Volcano
    OperatorPod -->|"PodGroup CRUD<br/>via Kubernetes API"| SchedPlugins

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef kubeapi fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class User external
    class APIServer kubeapi
    class Webhook,Metrics,Health operator
    class Workers workload
    class Prometheus,OpenShiftCfg,Volcano,SchedPlugins platform
