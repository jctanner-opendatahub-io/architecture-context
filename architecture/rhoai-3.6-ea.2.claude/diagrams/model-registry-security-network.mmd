graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph Ingress["INGRESS (Istio Service Mesh)"]
        direction TB
        VS_Registry["VirtualService: model-registry<br/>Hosts: *<br/>AuthZ: JWT + Principal + Namespace"]
        VS_Catalog["VirtualService: model-catalog<br/>Hosts: *"]
        VS_UI["VirtualService: model-registry-ui<br/>Hosts: *<br/>AuthZ: Principal Identity"]
    end

    subgraph AppTier["APPLICATION TIER (Namespace: kubeflow)"]
        direction TB

        subgraph RegistryPod["model-registry Pod"]
            Registry["model-registry<br/>8080/TCP HTTP/1.1<br/>FIPS: strictfipsruntime<br/>TLS 1.2+ min"]
        end

        subgraph BFFPod["BFF Pod"]
            BFF["BFF Server<br/>4000/TCP HTTP/HTTPS<br/>Auth: Bearer / SA Token"]
        end

        DB[("PostgreSQL / MySQL<br/>GORM Driver")]
    end

    subgraph ControllerTier["CONTROLLER TIER (Namespace: kubeflow)"]
        direction TB
        ControllerMgr["controller-controller-manager<br/>SA: controller-controller-manager"]
        Metrics["Metrics: 8443/TCP HTTPS<br/>Self-signed TLS<br/>Auth: TokenReview + SAR"]
        Health["Health: 8081/TCP HTTP<br/>No Auth (/healthz, /readyz)"]
    end

    subgraph JobTier["JOB TIER (Ephemeral)"]
        AsyncUpload["async-upload Job<br/>Python, AIPCC CPU base<br/>System OpenSSL<br/>Sigstore signing"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
        S3["S3 Storage<br/>443/TCP HTTPS<br/>TLS 1.2+<br/>AWS IAM"]
        OCI["OCI Registry<br/>HTTPS<br/>Registry Credentials"]
        Sigstore["Sigstore<br/>HTTPS<br/>Model Signing"]
    end

    %% External to Ingress
    Client -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (JWT)"| VS_Registry
    Client -->|"HTTPS/443<br/>TLS 1.2+"| VS_Catalog
    Client -->|"HTTPS/443<br/>TLS 1.2+"| VS_UI

    %% Ingress to App Tier (mTLS within mesh)
    VS_Registry -->|"HTTP<br/>mTLS (Istio sidecar)<br/>Service Identity"| Registry
    VS_Catalog -->|"HTTP<br/>mTLS (Istio sidecar)<br/>Service Identity"| Registry
    VS_UI -->|"HTTP<br/>mTLS (Istio sidecar)<br/>Service Identity"| BFF

    %% App Tier internal
    BFF -->|"REST API<br/>mTLS"| Registry
    Registry -->|"GORM driver"| DB
    BFF -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    BFF -->|"creates batch/v1/Job"| AsyncUpload

    %% Controller flows
    ControllerMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI
    ControllerMgr -->|"REST API"| Registry

    %% Job flows
    AsyncUpload -->|"HTTPS/443<br/>TLS 1.2+<br/>AWS IAM"| S3
    AsyncUpload -->|"HTTPS<br/>ORAS/skopeo"| OCI
    AsyncUpload -->|"HTTPS"| Sigstore
    AsyncUpload -->|"REST API"| Registry

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef apptier fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controller fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef jobtier fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef database fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class VS_Registry,VS_Catalog,VS_UI ingress
    class Registry,BFF apptier
    class ControllerMgr,Metrics,Health controller
    class AsyncUpload jobtier
    class K8sAPI,S3,OCI,Sigstore externalservice
    class DB database
