    %% Proxy role
    CR_Proxy -->|"create"| TokenReviews
    CR_Proxy -->|"create"| SubjectAccessReviews

    %% Metrics auth role
    CR_Metrics -->|"create"| TokenReviews
    CR_Metrics -->|"create"| SubjectAccessReviews

    %% model-serving-api role
    CR_ServingAPI -->|"list"| Gateways
    CR_ServingAPI -->|"get"| Namespaces

    %% Leader election role
    R_Leader -->|"CRUD"| ConfigMaps
    R_Leader -->|"CRUD"| Leases
