graph TD
    subgraph "SDK Authentication Model"
        SDK["Kubeflow SDK<br/>(Python Client Library)"]
    end

    subgraph "Authentication Delegation"
        K8sClientLib["kubernetes Python Client<br/>Handles all auth & TLS"]
    end

    subgraph "Authentication Methods"
        KubeConfig["kube-config<br/>(~/.kube/config)<br/>Development access"]
        SAToken["ServiceAccount Token<br/>(/var/run/secrets/...)<br/>In-cluster access"]
        OIDC["OIDC Token<br/>(OpenShift OAuth)<br/>Platform SSO"]
    end

    subgraph "Kubernetes RBAC (Cluster-side)"
        RBAC["Kubernetes RBAC<br/>Authorization"]
    end

    subgraph "API Resources Accessed by SDK"
        TrainJobs["kubeflow.org/v2alpha1<br/>TrainJob<br/>Verbs: create, get, list, watch, delete"]
        SparkConnect["sparkoperator.k8s.io/v1alpha1<br/>SparkConnect<br/>Verbs: create, get, list, watch, delete"]
        Pods["core/v1<br/>Pods<br/>Verbs: get, list, watch"]
        Services["core/v1<br/>Services<br/>Verbs: get, list"]
        ConfigMaps["core/v1<br/>ConfigMaps<br/>Verbs: get, list"]
    end

    subgraph "Secrets Used"
        HFToken["HF_TOKEN<br/>Type: environment variable<br/>Purpose: HuggingFace model downloads<br/>Provisioned by: runtime environment"]
    end

    %% Flows
    SDK -->|"delegates auth to"| K8sClientLib
    K8sClientLib -->|"dev environment"| KubeConfig
    K8sClientLib -->|"pod environment"| SAToken
    K8sClientLib -->|"OpenShift"| OIDC

    KubeConfig -->|"authenticated request"| RBAC
    SAToken -->|"authenticated request"| RBAC
    OIDC -->|"authenticated request"| RBAC

    RBAC -->|"authorizes access to"| TrainJobs
    RBAC -->|"authorizes access to"| SparkConnect
    RBAC -->|"authorizes access to"| Pods
    RBAC -->|"authorizes access to"| Services
    RBAC -->|"authorizes access to"| ConfigMaps

    SDK -.->|"reads at runtime"| HFToken

    %% Notes
    Note["Note: No ClusterRoles or RoleBindings<br/>are defined by the SDK itself.<br/>RBAC is configured by the platform<br/>or cluster administrator."]

    %% Styling
    style SDK fill:#4a90e2,stroke:#333,color:#fff
    style K8sClientLib fill:#4a90e2,stroke:#333,color:#fff
    style KubeConfig fill:#d5e8d4,stroke:#82b366
    style SAToken fill:#d5e8d4,stroke:#82b366
    style OIDC fill:#d5e8d4,stroke:#82b366
    style RBAC fill:#f5a623,stroke:#333
    style TrainJobs fill:#7ed321,stroke:#333
    style SparkConnect fill:#7ed321,stroke:#333
    style Pods fill:#7ed321,stroke:#333
    style Services fill:#7ed321,stroke:#333
    style ConfigMaps fill:#7ed321,stroke:#333
    style HFToken fill:#e24a4a,stroke:#333,color:#fff
    style Note fill:#fff2cc,stroke:#d6b656
