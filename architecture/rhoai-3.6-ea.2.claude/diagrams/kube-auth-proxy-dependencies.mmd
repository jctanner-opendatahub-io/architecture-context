graph LR
    KAP["kube-auth-proxy<br/>(FIPS-compliant Auth Proxy)"]

    %% Platform Dependencies
    KAP -->|"TokenReview API<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API Server"]
    KAP -->|"OAuth2 Authorization Code<br/>Auto-discovery"| OpenShiftOAuth["OpenShift OAuth Server"]

    %% Runtime Framework
    KAP -->|"HTTP routing"| Mux["gorilla/mux 1.8.1"]
    KAP -->|"middleware chain"| Alice["justinas/alice 1.2.0"]
    KAP -->|"configuration"| Viper["spf13/viper 1.21.0"]
    KAP -->|"metrics"| Prometheus["prometheus/client_golang 1.23.2"]

    %% Authentication Libraries
    KAP -->|"OIDC validation"| OIDC["coreos/go-oidc/v3 3.18.0"]
    KAP -->|"JWT handling"| JWT["golang-jwt/jwt/v5 5.3.0"]
    KAP -->|"OAuth2 flow"| OAuth2Lib["golang.org/x/oauth2 0.36.0"]
    KAP -->|"HMAC auth"| HMACAuth["mbland/hmacauth"]

    %% Session / Storage
    KAP -->|"session storage<br/>TLS + Sentinel/Cluster"| Redis["Redis / Valkey<br/>(go-redis/v9 9.17.0)"]
    KAP -->|"distributed locking"| RedisLock["bsm/redislock 0.9.4"]

    %% Kubernetes Client
    KAP -->|"K8s client"| ClientGo["k8s.io/client-go 0.35.3"]
    KAP -->|"K8s API types"| K8sAPILib["k8s.io/api 0.35.3"]

    %% Crypto
    KAP -->|"TLS config"| Crypto["golang.org/x/crypto 0.51.0"]
    KAP -->|"JOSE/JWK"| JOSE["go-jose/go-jose/v3 3.0.5"]

    %% Build
    KAP -->|"Go 1.26<br/>GOEXPERIMENT=strictfipsruntime<br/>CGO_ENABLED=1"| GoRuntime["Go 1.26 Runtime"]

    %% Upstream integration
    UpstreamMLflow["MLflow / RHOAI Service"] -.->|"proxied via<br/>X-Forwarded-User"| KAP

