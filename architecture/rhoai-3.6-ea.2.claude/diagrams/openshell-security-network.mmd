graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / CLI / SDK"]
    end

    subgraph Ingress["INGRESS (DMZ)"]
        Route["OpenShift Route<br/>443/TCP &rarr; 8080/TCP<br/>TLS Passthrough"]
        GRPCRoute["Envoy Gateway / GRPCRoute<br/>8080/TCP gRPC<br/>TLS"]
    end

    subgraph GatewayNS["GATEWAY NAMESPACE"]
        direction TB

        Gateway["OpenShell Gateway<br/>8080/TCP gRPC (TLS rustls)<br/>8081/TCP Health (HTTP)<br/>9090/TCP Metrics (HTTP)<br/>SA: release-gateway"]

        subgraph AuthChain["Auth Chain (first-match-wins)"]
            Auth1["OIDC Bearer Token<br/>&rarr; Keycloak JWKS"]
            Auth2["Sandbox JWT (Ed25519)<br/>&rarr; SPIFFE Identity"]
            Auth3["Compute Driver Bootstrap<br/>&rarr; IssueSandboxToken only"]
        end

        Gateway --- AuthChain
    end

    subgraph SandboxNS["SANDBOX NAMESPACE(S)<br/>Mode: shared | managed | operator"]
        direction TB

        subgraph SandboxPod["Sandbox Pod"]
            direction TB
            Supervisor["Supervisor Binary<br/>(static, crt-static)<br/>2222/TCP SSH"]

            subgraph Enforcement["Enforcement Layers"]
                L1["Filesystem Policy"]
                L2["Network (nftables + L7 Proxy)"]
                L3["Process Isolation"]
                L4["Inference Routing"]
            end

            AgentProc["AI Agent Process<br/>Credentials injected as env"]

            Supervisor --- Enforcement
            Enforcement --- AgentProc
        end
    end

    subgraph PlatformSvcs["PLATFORM SERVICES"]
        OIDC["OIDC Provider (Keycloak)<br/>443/TCP HTTPS<br/>JWKS Fetch"]
        K8sAPI["Kubernetes API<br/>443/TCP HTTPS<br/>SA Token Auth"]
        CertMgr["cert-manager<br/>Certificate CRDs"]
        Prometheus["Prometheus<br/>9090/TCP HTTP Scrape"]
    end

    subgraph OptionalBackends["OPTIONAL BACKENDS"]
        PostgreSQL["PostgreSQL<br/>5432/TCP<br/>TLS Optional<br/>Connection URI Auth"]
        Vault["Vault / OpenBao<br/>8200/TCP HTTP/HTTPS<br/>Kubernetes Auth"]
        SPIFFE["SPIFFE / SPIRE<br/>Unix Socket gRPC<br/>Workload Identity"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES (Policy-Controlled)"]
        ExtEndpoint["Allowed Endpoints<br/>Per-sandbox YAML Policy<br/>L7 Protocol-Aware<br/>Fail-Closed Default"]
    end

    %% External to Ingress
    User -->|"HTTPS/443<br/>TLS 1.2+<br/>Bearer Token (OIDC JWT)"| Route
    User -->|"gRPC/8080<br/>TLS<br/>Bearer Token"| GRPCRoute

    %% Ingress to Gateway
    Route -->|"gRPC/8080<br/>TLS Passthrough<br/>E2E Encrypted"| Gateway
    GRPCRoute -->|"gRPC/8080<br/>TLS<br/>Forwarded Auth"| Gateway

    %% Gateway to Platform Services
    Gateway -->|"HTTPS/443<br/>TLS 1.2+<br/>JWKS Fetch"| OIDC
    Gateway -->|"HTTPS/443<br/>TLS<br/>SA Token"| K8sAPI
    Gateway -.->|"CRD Lifecycle"| CertMgr
    Prometheus -->|"HTTP/9090<br/>Plaintext<br/>Unauthenticated"| Gateway

    %% Gateway to Optional Backends
    Gateway -->|"TCP/5432<br/>TLS Optional<br/>Connection URI"| PostgreSQL
    Gateway -->|"HTTP(S)/8200<br/>TLS Optional<br/>K8s Auth"| Vault
    Gateway -->|"gRPC/Unix<br/>Workload Identity"| SPIFFE

    %% Gateway to Supervisor
    Gateway -->|"Creates Pod via K8s API<br/>Supervisor sideloaded"| SandboxPod
    Supervisor -->|"gRPC/8080<br/>mTLS (rustls)<br/>Sandbox JWT (Ed25519)<br/>SPIFFE: spiffe://openshell/sandbox/uuid"| Gateway

    %% NetworkPolicy
    Gateway -->|"TCP/2222 SSH<br/>NetworkPolicy restricted"| Supervisor

    %% Sandbox Egress
    AgentProc -->|"All egress intercepted<br/>nftables redirect"| L2
    L2 -->|"HTTPS/443<br/>TLS<br/>SigV4/Bearer/None<br/>Policy-controlled"| ExtEndpoint

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef gateway fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef sandbox fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef optional fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef extservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class Route,GRPCRoute ingress
    class Gateway,Auth1,Auth2,Auth3 gateway
    class Supervisor,AgentProc,L1,L2,L3,L4 sandbox
    class OIDC,K8sAPI,CertMgr,Prometheus platform
    class PostgreSQL,Vault,SPIFFE optional
    class ExtEndpoint extservice
