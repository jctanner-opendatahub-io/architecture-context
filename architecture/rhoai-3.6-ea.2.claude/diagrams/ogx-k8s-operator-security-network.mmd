graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        PlatformOp["Platform Operator<br/>(RHOAI/ODH)"]
        User["User / Data Scientist"]
    end

    subgraph K8sControl["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC Enforced"]
    end

    subgraph OperatorNS["ogx-k8s-operator-system NAMESPACE"]
        direction TB

        subgraph ControllerPod["ogx-k8s-operator-controller-manager"]
            Webhook["Validating Webhook<br/>9443/TCP HTTPS<br/>TLS (platform profile)<br/>Cert: webhook-cert secret"]
            Metrics["Metrics Server<br/>8443/TCP HTTPS<br/>TLS (platform profile)<br/>Auth: TokenReview + SAR"]
            Health["Health Probes<br/>8081/TCP HTTP<br/>No encryption<br/>Unauthenticated"]
        end

        subgraph Services["ClusterIP Services"]
            MetricsSvc["metrics-service<br/>8443/TCP → https"]
            WebhookSvc["webhook-service<br/>443/TCP → 9443"]
        end
    end

    subgraph ManagedNS["USER NAMESPACE (per OGXServer)"]
        InferencePod["OGX Inference Pod<br/>+ NetworkPolicy<br/>+ ServiceAccount"]
        ManagedSvc["Managed Service<br/>(ClusterIP)"]
        ManagedIngress["Ingress<br/>(optional)"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>(via ServiceMonitor)"]
    end

    %% External to API Server
    PlatformOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| APIServer
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| APIServer

    %% API Server to Webhook
    APIServer -->|"HTTPS/9443<br/>TLS (platform)<br/>Admission Review<br/>FailPolicy: Fail"| Webhook

    %% Controller to API Server
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA: ogx-k8s-operator-controller-manager"| APIServer

    %% Services
    MetricsSvc --> Metrics
    WebhookSvc --> Webhook

    %% Monitoring
    Prometheus -->|"HTTPS/8443<br/>TLS (platform)<br/>TokenReview + SAR"| MetricsSvc

    %% Managed resources
    APIServer -.->|"Watch/CRUD"| InferencePod
    APIServer -.->|"Watch/CRUD"| ManagedSvc
    APIServer -.->|"Watch/CRUD"| ManagedIngress

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef k8sapi fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef managed fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class PlatformOp,User external
    class APIServer k8sapi
    class Webhook,Metrics,Health operator
    class MetricsSvc,WebhookSvc service
    class InferencePod,ManagedSvc,ManagedIngress managed
    class Prometheus monitoring
