graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Manager["mcp-lifecycle-operator-<br/>controller-manager"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["mcp-lifecycle-operator-<br/>manager-rolebinding"]
        CRB_Metrics["mcp-lifecycle-operator-<br/>metrics-auth-rolebinding"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["mcp-lifecycle-operator-<br/>leader-election-rolebinding<br/>(ns: mcp-lifecycle-operator-system)"]
    end

    subgraph ManagerRole["ClusterRole: mcp-lifecycle-operator-manager-role"]
        direction LR
        MR_ConfigMaps["core<br/>configmaps, secrets<br/>get, list, watch"]
        MR_Pods["core<br/>pods<br/>get, list"]
        MR_Services["core<br/>services<br/>create, get, list,<br/>update, watch"]
        MR_Events["events.k8s.io<br/>events<br/>create, patch"]
        MR_Deployments["apps<br/>deployments<br/>create, get, list,<br/>update, watch"]
        MR_MCPServers["mcp.x-k8s.io<br/>mcpservers<br/>get, list, patch,<br/>update, watch"]
        MR_Finalizers["mcp.x-k8s.io<br/>mcpservers/finalizers<br/>update"]
        MR_Status["mcp.x-k8s.io<br/>mcpservers/status<br/>get, patch, update"]
        MR_NetPol["networking.k8s.io<br/>networkpolicies<br/>create, get, list,<br/>update, watch"]
    end

    subgraph MetricsRole["ClusterRole: mcp-lifecycle-operator-metrics-auth-role"]
        MAR_TokenReview["authentication.k8s.io<br/>tokenreviews<br/>create"]
        MAR_SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    subgraph LeaderRole["Role: mcp-lifecycle-operator-leader-election-role"]
        LER_ConfigMaps["core<br/>configmaps<br/>full CRUD"]
        LER_Leases["coordination.k8s.io<br/>leases<br/>full CRUD"]
        LER_Events["core<br/>events<br/>create, patch"]
    end

    subgraph AggregatedRoles["Aggregated ClusterRoles (RBAC aggregation)"]
        AdminRole["mcpserver-admin-role<br/>aggregate-to-admin<br/>mcpservers: full CRUD +<br/>deletecollection<br/>mcpservers/status: get"]
        EditorRole["mcpserver-editor-role<br/>aggregate-to-edit<br/>mcpservers: CRUD<br/>mcpservers/status: get"]
        ViewerRole["mcpserver-viewer-role<br/>aggregate-to-view<br/>mcpservers: get, list, watch<br/>mcpservers/status: get"]
    end

    %% Bindings
    SA_Manager -->|"bound via"| CRB_Manager
    SA_Manager -->|"bound via"| CRB_Metrics
    SA_Manager -->|"bound via"| RB_Leader

    CRB_Manager -->|"grants"| ManagerRole
    CRB_Metrics -->|"grants"| MetricsRole
    RB_Leader -->|"grants"| LeaderRole

    %% Aggregation to built-in roles
    AdminRole -.->|"aggregates to"| BuiltInAdmin["Built-in admin ClusterRole"]
    EditorRole -.->|"aggregates to"| BuiltInEdit["Built-in edit ClusterRole"]
    ViewerRole -.->|"aggregates to"| BuiltInView["Built-in view ClusterRole"]

    style SA_Manager fill:#4a90e2,color:#fff
    style CRB_Manager fill:#e8e8e8,color:#333
    style CRB_Metrics fill:#e8e8e8,color:#333
    style RB_Leader fill:#e8e8e8,color:#333
    style MR_ConfigMaps fill:#7ed321,color:#fff
    style MR_Pods fill:#7ed321,color:#fff
    style MR_Services fill:#7ed321,color:#fff
    style MR_Events fill:#7ed321,color:#fff
    style MR_Deployments fill:#7ed321,color:#fff
    style MR_MCPServers fill:#7ed321,color:#fff
    style MR_Finalizers fill:#7ed321,color:#fff
    style MR_Status fill:#7ed321,color:#fff
    style MR_NetPol fill:#7ed321,color:#fff
    style MAR_TokenReview fill:#f5a623,color:#fff
    style MAR_SAR fill:#f5a623,color:#fff
    style LER_ConfigMaps fill:#b8d4f0,color:#333
    style LER_Leases fill:#b8d4f0,color:#333
    style LER_Events fill:#b8d4f0,color:#333
    style AdminRole fill:#d4a0a0,color:#333
    style EditorRole fill:#d4b8a0,color:#333
    style ViewerRole fill:#d4d4a0,color:#333
    style BuiltInAdmin fill:#ccc,color:#333
    style BuiltInEdit fill:#ccc,color:#333
    style BuiltInView fill:#ccc,color:#333
