graph TB
    subgraph InitPhase["INIT CONTAINER PHASE (Pod-Internal)"]
        InitContainer["Init Container<br/>init_managed_pipelines<br/>Image: ubi9/python-312 (pinned)<br/>No network access"]
        SharedVolume["/config/managed-pipelines<br/>Shared Volume (emptyDir)"]
        InitContainer -->|"Volume mount<br/>read/write<br/>Pipeline YAMLs"| SharedVolume
    end

    subgraph KFPRuntime["KFP RUNTIME (Task Pods)"]
        direction TB

        KFPServer["KFP API Server<br/>Consumes managed pipeline YAMLs"]

        subgraph TaskPods["Task Pods (KFP-Orchestrated)"]
            TabularLoader["Tabular Data Loader<br/>SA: pipeline runner"]
            ParseChunk["Parse & Chunk<br/>SA: pipeline runner"]
            SDGComp["SDG Component<br/>SA: pipeline runner"]
            AutoRAGComp["AutoRAG Component<br/>SA: pipeline runner"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-Compatible Storage<br/>443/TCP HTTPS<br/>TLS (system default)<br/>Auth: AWS credentials (env)"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS<br/>Auth: In-cluster SA token"]
        RayCluster["Ray Cluster<br/>(via CodeFlare SDK)"]
        SDGHub["SDG Hub<br/>HTTPS<br/>Auth: env-configured"]
        HFHub["HuggingFace Hub<br/>HTTPS<br/>Auth: HF_TOKEN (optional)"]
    end

    %% Init phase flows
    SharedVolume -->|"Pipeline YAMLs<br/>consumed at startup"| KFPServer

    %% KFP orchestration
    KFPServer -->|"orchestrates"| TabularLoader
    KFPServer -->|"orchestrates"| ParseChunk
    KFPServer -->|"orchestrates"| SDGComp
    KFPServer -->|"orchestrates"| AutoRAGComp

    %% Task pod egress flows
    TabularLoader -->|"HTTPS/443<br/>TLS<br/>AWS_ACCESS_KEY_ID +<br/>AWS_SECRET_ACCESS_KEY"| S3
    ParseChunk -->|"HTTPS/443<br/>TLS<br/>AWS credentials"| S3
    ParseChunk -->|"HTTPS/6443<br/>TLS<br/>In-cluster SA token"| K8sAPI
    K8sAPI -->|"RayJob submission"| RayCluster
    SDGComp -->|"SDK calls<br/>HTTPS"| SDGHub
    AutoRAGComp -->|"SDK calls"| AutoRAGComp

    %% Styling
    classDef initphase fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef kfp fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef taskpod fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef volume fill:#f5a623,stroke:#333,stroke-width:2px

    class InitContainer initphase
    class SharedVolume volume
    class KFPServer kfp
    class TabularLoader,ParseChunk,SDGComp,AutoRAGComp taskpod
    class S3,K8sAPI,RayCluster,SDGHub,HFHub external
