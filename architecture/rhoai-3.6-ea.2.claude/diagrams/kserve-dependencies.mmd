graph LR
    KServe["KServe Operator<br/>(Multi-controller)"]

    %% External Platform Dependencies
    KServe -->|"HTTPRoute CRUD<br/>ingress routing"| GatewayAPI["Gateway API<br/>(sigs.k8s.io/gateway-api v1.5.1)"]
    KServe -->|"VirtualService CRUD<br/>traffic mgmt"| Istio["Istio<br/>(istio.io/client-go v1.27.1)"]
    KServe -->|"Knative Services<br/>serverless serving"| Knative["Knative Serving<br/>(v0.48.1)"]
    KServe -->|"certificates<br/>webhook TLS"| CertManager["cert-manager"]
    KServe -->|"ScaledObjects<br/>event-driven scaling"| KEDA["KEDA<br/>(v2.18.0)"]
    KServe -->|"LeaderWorkerSets<br/>multi-node inference"| LWS["LeaderWorkerSet<br/>(sigs.k8s.io/lws v0.8.0)"]
    KServe -->|"InferencePools<br/>inference routing"| GAIE["Gateway API<br/>Inference Extension<br/>(v1.5.0)"]
    KServe -->|"OpenTelemetry<br/>Collectors"| OTel["OpenTelemetry<br/>Operator (v0.113.0)"]

    %% Internal RHOAI Dependencies
    KServe -->|"platform detection<br/>manifest rendering"| ODHPlatform["odh-platform-utilities<br/>(v0.3.0)"]
    KServe -->|"metrics auth proxy<br/>8443→8080"| KRBACProxy["kube-rbac-proxy<br/>(v0.18.0)"]

    %% Monitoring
    KServe -->|"ServiceMonitors<br/>PodMonitors"| PromOperator["prometheus-operator<br/>(v0.89.0)"]
    Prometheus["Prometheus"] -->|"scrape /metrics<br/>8443/TCP"| KServe

    %% Kubernetes API
    KServe -->|"resource operations<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API<br/>(k8s.io v0.35.3)"]

    %% OpenShift
    KServe -->|"Routes, SCCs<br/>APIServer config"| OpenShift["OpenShift API"]
    KServe -.->|"cluster TLS<br/>profile read"| OpenShiftTLS["OpenShift APIServer<br/>TLS Config"]

    %% Storage backends
    KServe -->|"model storage<br/>HTTPS/443"| S3["S3-compatible<br/>Storage<br/>(aws-sdk-go-v2)"]
    KServe -->|"model storage<br/>HTTPS/443"| Azure["Azure Blob<br/>Storage<br/>(azure-sdk-for-go)"]
    KServe -->|"model storage<br/>HTTPS/443"| GCS["Google Cloud<br/>Storage<br/>(cloud.google.com/go)"]

    %% Python runtime dependencies
    KServe -->|"model serving<br/>V2 protocol"| FastAPI["FastAPI/uvicorn<br/>(Python SDK)"]
    KServe -->|"gRPC inference"| gRPC["gRPC<br/>(grpcio v1.73+)"]
    KServe -->|"ML frameworks"| MLFrameworks["HuggingFace / vLLM<br/>scikit-learn / XGBoost<br/>LightGBM / OVMS"]

    %% Integration points (other components depending on KServe)
    Dashboard["ODH Dashboard"] -.->|"route status<br/>UI management"| KServe
    NIM["NIM Accounts<br/>(nim.opendatahub.io)"] -.->|"NVIDIA NIM<br/>configuration"| KServe

