graph TB
    subgraph "odh-gitops Repository"
        direction TB

        subgraph HelmCharts["Helm Charts"]
            direction LR
            OpenShiftChart["rhai-on-openshift-chart<br/><i>OLM-based operator installation</i>"]
            XKSChart["rhai-on-xks-chart<br/><i>Direct Helm sub-chart installation</i>"]
        end

        subgraph KustomizeOverlays["Kustomize Overlays"]
            direction LR
            Dependencies["kustomize-dependencies<br/><i>Operator subscription composition</i>"]
            Configurations["kustomize-configurations<br/><i>Post-install operator config</i>"]
        end
    end

    subgraph OpenShiftTarget["OpenShift Cluster"]
        OLM["OLM<br/>(Operator Lifecycle Manager)"]
    end

    subgraph XKSTarget["Non-OpenShift Kubernetes<br/>(AWS EKS / Azure AKS / CoreWeave)"]
        HelmRuntime["Helm Runtime"]
    end

    subgraph SchedulingOps["Scheduling Operators"]
        Kueue["Kueue Operator"]
        JobSet["JobSet Operator"]
        LWS["LeaderWorkerSet"]
    end

    subgraph SecurityOps["Security Operators"]
        CertManager["cert-manager"]
        RHCL["RHCL Operator<br/>(Kuadrant/Authorino)"]
    end

    subgraph ObservabilityOps["Observability Operators"]
        OTel["OpenTelemetry Operator"]
        Tempo["Tempo Operator"]
        ClusterObs["Cluster Observability Operator"]
        CMA["Custom Metrics Autoscaler"]
    end

    subgraph NetworkOps["Network Operators (XKS only)"]
        Sail["Sail Operator (Istio)"]
        GatewayAPI["Gateway API CRDs"]
    end

    subgraph GPUOps["GPU Operators (Optional)"]
        NFD["Node Feature Discovery"]
        NVIDIA["NVIDIA GPU Operator"]
    end

    %% OpenShift flow
    OpenShiftChart -->|"installs via"| OLM
    Dependencies -->|"composes subscriptions for"| OLM
    Configurations -->|"configures operators via"| OLM
    OLM -->|provisions| SchedulingOps
    OLM -->|provisions| SecurityOps
    OLM -->|provisions| ObservabilityOps
    OLM -.->|provisions| GPUOps

    %% XKS flow
    XKSChart -->|"installs via"| HelmRuntime
    HelmRuntime -->|provisions| SchedulingOps
    HelmRuntime -->|provisions| SecurityOps
    HelmRuntime -->|provisions| NetworkOps

    %% Styling
    style OpenShiftChart fill:#4a90e2,stroke:#333,color:#fff
    style XKSChart fill:#4a90e2,stroke:#333,color:#fff
    style Dependencies fill:#7ed321,stroke:#333,color:#fff
    style Configurations fill:#7ed321,stroke:#333,color:#fff
    style OLM fill:#e74c3c,stroke:#333,color:#fff
    style HelmRuntime fill:#f5a623,stroke:#333,color:#fff
    style Kueue fill:#d5e8d4,stroke:#82b366
    style JobSet fill:#d5e8d4,stroke:#82b366
    style LWS fill:#d5e8d4,stroke:#82b366
    style CertManager fill:#dae8fc,stroke:#6c8ebf
    style RHCL fill:#dae8fc,stroke:#6c8ebf
    style OTel fill:#fff2cc,stroke:#d6b656
    style Tempo fill:#fff2cc,stroke:#d6b656
    style ClusterObs fill:#fff2cc,stroke:#d6b656
    style CMA fill:#fff2cc,stroke:#d6b656
    style Sail fill:#e1d5e7,stroke:#9673a6
    style GatewayAPI fill:#e1d5e7,stroke:#9673a6
    style NFD fill:#f8cecc,stroke:#b85450
    style NVIDIA fill:#f8cecc,stroke:#b85450
