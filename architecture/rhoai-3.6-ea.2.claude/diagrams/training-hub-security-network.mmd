graph TB
    subgraph LibraryBoundary["LIBRARY BOUNDARY (No inbound network exposure)"]
        direction TB

        subgraph TrainingHub["Training Hub Python Package"]
            direction TB
            Registry["AlgorithmRegistry"]

            subgraph WeightTraining["Weight-Training Backends (local compute)"]
                SFT["SFT Backend<br/>InstructLab Training<br/>torchrun subprocess"]
                OSFT["OSFT Backend<br/>Mini-Trainer"]
                LoRA["LoRA Backend<br/>Unsloth"]
            end

            subgraph RLTraining["RL Backends (local + co-process)"]
                GRPO["GRPO Backend<br/>ART/OpenPipe<br/>co-located vLLM"]
                VeRL["VeRL Backend<br/>Distributed GRPO"]
            end

            subgraph PromptOpt["Prompt Optimization Backends (outbound network)"]
                GEPAStd["GEPA Standalone<br/>gepa library"]
                GEPAMlf["GEPA MLflow<br/>gepa + MLflow integration"]
            end

            Registry --> SFT
            Registry --> OSFT
            Registry --> LoRA
            Registry --> GRPO
            Registry --> VeRL
            Registry --> GEPAStd
            Registry --> GEPAMlf
        end
    end

    subgraph CoProcess["CO-LOCATED PROCESS (same GPU)"]
        vLLM["vLLM AsyncLLM Engine<br/>+ EngineCore subprocess<br/>GPU time-sharing<br/>No network (in-process)"]
    end

    subgraph OutboundServices["OUTBOUND SERVICES (client-initiated)"]
        OpenAI["OpenAI-compatible API<br/>Protocol: HTTP/HTTPS<br/>Auth: OPENAI_API_KEY (Bearer)<br/>Client: LiteLLM"]
        MLflow["MLflow Tracking Server<br/>Protocol: HTTP/HTTPS (REST)<br/>Auth: Server-configured<br/>Purpose: Tracking + Prompt Registry"]
    end

    subgraph Secrets["SECRETS"]
        Key["OPENAI_API_KEY<br/>Type: Environment Variable<br/>Scope: Process memory only<br/>Set/restored at runtime"]
    end

    %% Flows
    GRPO -->|In-process<br/>No network<br/>No auth| vLLM
    GEPAStd -->|HTTP/HTTPS<br/>Bearer Token| OpenAI
    GEPAMlf -->|HTTP/HTTPS<br/>Bearer Token| OpenAI
    GEPAMlf -->|HTTP/HTTPS REST<br/>Server auth| MLflow

    Key -.->|used by| GEPAStd
    Key -.->|used by| GEPAMlf

    %% Styling
    classDef library fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef coprocess fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef outbound fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef secret fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Registry,SFT,OSFT,LoRA,GRPO,VeRL,GEPAStd,GEPAMlf library
    class vLLM coprocess
    class OpenAI,MLflow outbound
    class Key secret
