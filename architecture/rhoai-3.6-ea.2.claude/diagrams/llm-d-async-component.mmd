graph TB
    subgraph "llm-d-async Component"
        direction TB
        Runner["Runner<br/>(pkg/server/runner.go)"]
        Options["Options / Config<br/>(pkg/server/options.go)"]
        HealthServer["Health Server<br/>:8081"]
        MetricsServer["Metrics Server<br/>:9090"]
        MergePolicy["Merge Policy<br/>(random-robin)"]
        WorkerPool["Worker Pool<br/>(configurable concurrency)"]
        FlowGate["Flow-Control Gate<br/>(Prometheus-backed)"]
        HTTPClient["HTTP Client<br/>(OTel-instrumented)"]
        TransformPlugin["Body Transform Plugin"]
    end

    subgraph "Transport Layer"
        direction LR
        TransportInterface["pipeline.Flow Interface"]
        RedisPubSub["Redis Pub/Sub<br/>Transport"]
        RedisSortedSet["Redis Sorted Set<br/>Transport"]
        GCPPubSub["GCP Pub/Sub<br/>Transport"]
    end

    subgraph "External Systems"
        Redis["Redis<br/>:6379/TCP"]
        GCP["Google Cloud Pub/Sub<br/>:443/gRPC TLS"]
        InferenceGW["Inference Gateway<br/>(Model Server)<br/>HTTP/HTTPS"]
        PrometheusExt["Prometheus<br/>:9090/HTTP"]
        K8sAPI["Kubernetes API<br/>:6443/HTTPS"]
        OTelCollector["OTel Collector<br/>gRPC"]
    end

    %% Internal flows
    Options -->|configures| Runner
    Runner -->|creates| TransportInterface
    TransportInterface --> RedisPubSub
    TransportInterface --> RedisSortedSet
    TransportInterface --> GCPPubSub
    Runner -->|distributes via| MergePolicy
    MergePolicy -->|feeds| WorkerPool
    WorkerPool -->|checked by| FlowGate
    WorkerPool -->|dispatches via| HTTPClient
    HTTPClient -->|optional transform| TransformPlugin
    Runner -->|starts| HealthServer
    Runner -->|starts| MetricsServer

    %% External connections
    RedisPubSub -->|subscribes| Redis
    RedisSortedSet -->|polls| Redis
    GCPPubSub -->|subscribes| GCP
    HTTPClient -->|POST inference<br/>optional mTLS| InferenceGW
    FlowGate -->|queries metrics| PrometheusExt
    MetricsServer -->|auth delegates to| K8sAPI
    Runner -->|exports traces| OTelCollector

    %% Styling
    style Runner fill:#4a90e2,stroke:#333,color:#fff
    style HealthServer fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style MergePolicy fill:#4a90e2,stroke:#333,color:#fff
    style WorkerPool fill:#4a90e2,stroke:#333,color:#fff
    style FlowGate fill:#4a90e2,stroke:#333,color:#fff
    style HTTPClient fill:#4a90e2,stroke:#333,color:#fff
    style TransformPlugin fill:#4a90e2,stroke:#333,color:#fff
    style Options fill:#4a90e2,stroke:#333,color:#fff
    style TransportInterface fill:#f5a623,stroke:#333,color:#fff
    style RedisPubSub fill:#f5a623,stroke:#333,color:#fff
    style RedisSortedSet fill:#f5a623,stroke:#333,color:#fff
    style GCPPubSub fill:#f5a623,stroke:#333,color:#fff
    style Redis fill:#e8e8e8,stroke:#333
    style GCP fill:#e8e8e8,stroke:#333
    style InferenceGW fill:#7ed321,stroke:#333,color:#fff
    style PrometheusExt fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style OTelCollector fill:#e8e8e8,stroke:#333
