graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager<br/>(operator namespace)"]
        SA_Argo["argo<br/>(DSPA namespace)"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["manager-rolebinding"]
        CRB_ArgoMgr["manager-argo-rolebinding"]
        CRB_ArgoDS["ds-pipeline-argo-binding"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding"]
        RB_Argo["argo-binding"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["manager-role"]
        CR_ArgoMgr["manager-argo-role"]
        CR_Argo["argo-cluster-role"]
        CR_AggAdmin["aggregate-dspa-admin-edit"]
        CR_AggView["aggregate-dspa-admin-view"]
        CR_ArgoAdmin["argo-aggregate-to-admin"]
        CR_ArgoEdit["argo-aggregate-to-edit"]
        CR_ArgoView["argo-aggregate-to-view"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Leader["leader-election-role"]
        R_Argo["argo-role"]
    end

    %% SA to Binding connections
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_ArgoMgr
    SA_CM -->|bound via| RB_Leader
    SA_Argo -->|bound via| CRB_ArgoDS
    SA_Argo -->|bound via| RB_Argo

    %% Binding to Role connections
    CRB_Manager -->|grants| CR_Manager
    CRB_ArgoMgr -->|grants| CR_ArgoMgr
    CRB_ArgoDS -->|grants| CR_Argo
    RB_Leader -->|grants| R_Leader
    RB_Argo -->|grants| R_Argo

    subgraph ManagerResources["manager-role Resources"]
        direction LR
        DSPA_Res["datasciencepipelinesapplications.opendatahub.io<br/>DSPA, DSPA/api, DSPA/finalizers, DSPA/status"]
        Pipeline_Res["pipelines.kubeflow.org<br/>pipelines, pipelineversions"]
        Argo_Res["argoproj.io<br/>workflows, workflowtaskresults,<br/>workflowartifactgctasks"]
        Core_Res["core<br/>pods, secrets, configmaps,<br/>services, serviceaccounts, PVs, PVCs"]
        Apps_Res["apps<br/>deployments, replicasets"]
        RBAC_Res["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterroles, clusterrolebindings"]
        Route_Res["route.openshift.io<br/>routes"]
        Net_Res["networking.k8s.io<br/>networkpolicies, ingresses"]
        Monitor_Res["monitoring.coreos.com<br/>servicemonitors"]
        Serving_Res["serving.kserve.io<br/>inferenceservices"]
        Kubeflow_Res["kubeflow.org<br/>* (all resources)"]
        Webhook_Res["admissionregistration.k8s.io<br/>validatingwebhookconfigurations,<br/>mutatingwebhookconfigurations"]
    end

    subgraph ArgoResources["argo-cluster-role Resources"]
        direction LR
        Argo_WF["argoproj.io<br/>workflows, cronworkflows,<br/>workflowtemplates, workflowtasksets"]
        Argo_Pods["core<br/>pods, pods/exec"]
        Argo_Secrets["core<br/>secrets (resourceNames restricted)"]
    end

    CR_Manager -->|"full lifecycle"| ManagerResources
    CR_Argo -->|"workflow mgmt"| ArgoResources

    %% Aggregated roles (user-facing)
    subgraph AggregatedAccess["User-Facing Aggregated Access"]
        DSPA_AdminEdit["admin/edit: full CRUD<br/>on DSPA + Pipeline resources"]
        DSPA_View["view: read-only<br/>on DSPA + Pipeline resources"]
        Argo_AdminAccess["admin: full CRUD<br/>on Argo CRDs"]
        Argo_ViewAccess["view: read-only<br/>on Argo CRDs"]
    end

    CR_AggAdmin -->|provides| DSPA_AdminEdit
    CR_AggView -->|provides| DSPA_View
    CR_ArgoAdmin -->|provides| Argo_AdminAccess
    CR_ArgoView -->|provides| Argo_ViewAccess

    style SA_CM fill:#4a90e2,stroke:#333,color:#fff
    style SA_Argo fill:#4a90e2,stroke:#333,color:#fff
    style CR_Manager fill:#f5a623,stroke:#333
    style CR_ArgoMgr fill:#f5a623,stroke:#333
    style CR_Argo fill:#f5a623,stroke:#333
    style CR_AggAdmin fill:#f5a623,stroke:#333
    style CR_AggView fill:#f5a623,stroke:#333
    style CR_ArgoAdmin fill:#f5a623,stroke:#333
    style CR_ArgoEdit fill:#f5a623,stroke:#333
    style CR_ArgoView fill:#f5a623,stroke:#333
    style R_Leader fill:#e8a623,stroke:#333
    style R_Argo fill:#e8a623,stroke:#333
    style DSPA_Res fill:#7ed321,stroke:#333
    style Pipeline_Res fill:#7ed321,stroke:#333
    style Argo_Res fill:#7ed321,stroke:#333
    style Core_Res fill:#7ed321,stroke:#333
    style Apps_Res fill:#7ed321,stroke:#333
    style RBAC_Res fill:#7ed321,stroke:#333
    style Route_Res fill:#7ed321,stroke:#333
    style Net_Res fill:#7ed321,stroke:#333
    style Monitor_Res fill:#7ed321,stroke:#333
    style Serving_Res fill:#7ed321,stroke:#333
    style Kubeflow_Res fill:#7ed321,stroke:#333
    style Webhook_Res fill:#7ed321,stroke:#333
