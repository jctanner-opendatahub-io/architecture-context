graph TB
    subgraph Operator["Data Science Pipelines Operator"]
        direction TB
        Controller["DSPAReconciler<br/>(controller-runtime)"]
        Webhook["Webhook Server<br/>:9443/TCP TLS"]
        Metrics["Metrics Server<br/>:8080/TCP TLS"]
        Health["Health Probes<br/>:8081/TCP"]
        TLSWatcher["SecurityProfileWatcher<br/>(TLS profile reload)"]

        Controller -->|validates PipelineVersion| Webhook
        TLSWatcher -->|triggers restart on change| Controller
    end

    User[Data Scientist] -->|creates/updates| DSPACR["DataSciencePipelinesApplication CR"]
    DSPACR -->|watched by| Controller

    subgraph PerDSPA["Per-DSPA Service Stack"]
        direction TB
        APIServer["DS Pipeline API Server<br/>:8888 HTTP / :8887 gRPC"]
        OAuthProxy["OAuth Proxy<br/>:8443 HTTPS"]
        ArgoWFC["Argo Workflow Controller<br/>metrics :9090"]
        MariaDB["MariaDB<br/>:3306 TCP<br/>(optional)"]
        MinIO["MinIO<br/>:9000 HTTP<br/>(optional)"]

        OAuthProxy -->|proxies| APIServer
        APIServer -->|submits workflows| ArgoWFC
        APIServer -->|stores metadata| MariaDB
        APIServer -->|stores artifacts| MinIO
    end

    Controller -->|renders templates via manifestival| PerDSPA

    Controller -->|watches| MLflow["MLflow CR<br/>(direct API read)"]
    Controller -->|watches| KServe["KServe InferenceService"]
    Controller -->|manages| ServiceMonitor["ServiceMonitor<br/>(prometheus-operator)"]
    Controller -->|manages| NetworkPolicy["NetworkPolicy"]
    Controller -->|manages| Routes["OpenShift Routes"]

    Controller -->|reads TLS profile| APIServer_OS["OpenShift APIServer<br/>(config.openshift.io)"]

    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style Webhook fill:#4a90e2,stroke:#333,color:#fff
    style Metrics fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#4a90e2,stroke:#333,color:#fff
    style TLSWatcher fill:#4a90e2,stroke:#333,color:#fff
    style DSPACR fill:#f5a623,stroke:#333,color:#000
    style APIServer fill:#7ed321,stroke:#333,color:#000
    style OAuthProxy fill:#7ed321,stroke:#333,color:#000
    style ArgoWFC fill:#7ed321,stroke:#333,color:#000
    style MariaDB fill:#9b59b6,stroke:#333,color:#fff
    style MinIO fill:#9b59b6,stroke:#333,color:#fff
    style MLflow fill:#e8e8e8,stroke:#333
    style KServe fill:#e8e8e8,stroke:#333
    style ServiceMonitor fill:#e8e8e8,stroke:#333
    style NetworkPolicy fill:#e8e8e8,stroke:#333
    style Routes fill:#e8e8e8,stroke:#333
    style APIServer_OS fill:#e8e8e8,stroke:#333
