graph TB
    subgraph ClusterInternal["CLUSTER INTERNAL (In-cluster ServiceAccount Auth)"]
        direction TB

        subgraph NS_System["Namespace: system"]
            ModuleOp["mcp-lifecycle-module-operator-<br/>controller-manager<br/>Image: /manager<br/>SA: mcp-lifecycle-module-operator-controller-manager<br/>Build: GOEXPERIMENT=strictfipsruntime<br/>Base: ubi9/ubi-minimal-pqc"]
            HealthProbe["Health Probes<br/>:8081/TCP HTTP<br/>Unauthenticated"]
        end

        subgraph NS_Operand["Namespace: mcp-lifecycle-operator-system"]
            OperandCtrl["mcp-lifecycle-operator-<br/>controller-manager<br/>Image: odh-mcp-lifecycle-operator<br/>SA: mcp-lifecycle-operator-controller-manager<br/>TLS: Cluster-derived profile"]
            MetricsSvc["Metrics Service<br/>:8443/TCP ClusterIP<br/>Auth: RBAC-gated<br/>(TokenReview/SubjectAccessReview)"]
        end

        subgraph K8sControl["Control Plane"]
            K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token auth"]
        end

        subgraph PlatformResources["Platform Resources"]
            PlatformCM["Platform ConfigMap<br/>Distribution detection"]
            APIServer["OpenShift APIServer<br/>config.openshift.io<br/>TLS profile source<br/>(read-only)"]
            PrometheusOp["Prometheus Operator<br/>monitoring.coreos.com<br/>ServiceMonitor mgmt<br/>HTTPS/TLS 1.2+"]
        end
    end

    subgraph CRDs["Custom Resources"]
        MCPLifecycleOpCR["MCPLifecycleOperator CR<br/>(Cluster-scoped, Singleton)<br/>components.platform.opendatahub.io/v1alpha1"]
        MCPServerCR["MCPServer CR<br/>(Namespaced)<br/>mcp.x-k8s.io/v1alpha1"]
    end

    %% Module Operator flows
    ModuleOp -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ModuleOp -->|"watches"| MCPLifecycleOpCR
    ModuleOp -->|"reads"| PlatformCM
    ModuleOp -->|"reads TLS profile"| APIServer
    ModuleOp -->|"SSA deploys"| OperandCtrl

    %% Operand flows
    OperandCtrl -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    OperandCtrl -->|"reconciles"| MCPServerCR

    %% Managed resource watches
    K8sAPI -->|"watch events<br/>label: part-of=<br/>mcp-lifecycle-operator"| ModuleOp

    %% Styling
    classDef moduleOp fill:#4a90e2,stroke:#333,stroke-width:2px,color:#fff
    classDef operand fill:#7ed321,stroke:#333,stroke-width:2px,color:#fff
    classDef controlplane fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cr fill:#f5a623,stroke:#333,stroke-width:2px,color:#fff
    classDef probe fill:#ddd,stroke:#999,stroke-width:1px
    classDef metrics fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class ModuleOp moduleOp
    class OperandCtrl operand
    class K8sAPI controlplane
    class PlatformCM,APIServer,PrometheusOp platform
    class MCPLifecycleOpCR,MCPServerCR cr
    class HealthProbe probe
    class MetricsSvc metrics
