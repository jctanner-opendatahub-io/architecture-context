graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["DSP API Server / CLI / UI"]
    end

    subgraph APIGateway["API GATEWAY (argo-server)"]
        ArgoServer["argo-server<br/>ClusterIP: 2746/TCP<br/>gRPC + HTTP multiplexed<br/>TLS (Go FIPS 140-3)"]
        Gatekeeper["Gatekeeper Interceptor<br/>├ Client: Bearer/Basic → K8s impersonation<br/>├ Server: argo-server SA<br/>└ SSO: OIDC + RBAC delegation"]
        ArgoServer --> Gatekeeper
    end

    subgraph ControlPlane["CONTROL PLANE"]
        Controller["workflow-controller<br/>healthz: 6060/TCP (no auth)<br/>Watches: Workflow, CronWorkflow,<br/>WorkflowTemplate, ClusterWorkflowTemplate"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS/WSS<br/>TLS 1.2+<br/>ServiceAccount tokens"]
    end

    subgraph DataPlane["DATA PLANE (per workflow)"]
        StepPod["Step Pod + argoexec sidecar<br/>Namespace: user-namespace<br/>Created by: workflow-controller<br/>Reports: WorkflowTaskResult CR"]
    end

    %% Flows
    Client -->|"gRPC+HTTP/2746<br/>TLS (FIPS 140-3)<br/>Bearer / Basic / OIDC"| ArgoServer
    Gatekeeper -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token / Impersonation"| K8sAPI
    Controller -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    Controller -->|"Creates Pods<br/>Injects argoexec"| StepPod
    StepPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef gateway fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef dataplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef k8s fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Client external
    class ArgoServer,Gatekeeper gateway
    class Controller controlplane
    class StepPod dataplane
    class K8sAPI k8s
