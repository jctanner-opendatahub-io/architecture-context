graph TB
    subgraph TrainerOperator["Trainer Operator"]
        direction TB
        Controller["Trainer Controller<br/>(controller-runtime)"]
        MetricsServer["Metrics Server<br/>:8443/TCP HTTPS"]
        HealthProbes["Health Probes<br/>:8081/TCP HTTP"]
        TLSWatcher["TLS Profile Watcher"]
        ManifestRenderer["Manifest Renderer<br/>(odh-platform-utilities)"]
        GarbageCollector["Garbage Collector"]

        Controller -->|renders manifests| ManifestRenderer
        Controller -->|tracks readiness| GarbageCollector
        TLSWatcher -->|reloads TLS config| MetricsServer
    end

    %% Platform CR
    PlatformOp[Platform Operator] -->|creates| TrainerCR["Trainer CR<br/>(components.platform.opendatahub.io/v1alpha1)"]
    TrainerCR -->|watched by| Controller

    %% Deployed Resources
    Controller -->|deploys via SSA| KubeflowTrainer["Kubeflow Trainer v2<br/>Controller Deployment"]
    Controller -->|creates| TrainJobCRD["TrainJob CRD"]
    Controller -->|creates| ClusterTrainingRuntimeCRD["ClusterTrainingRuntime CRD"]
    Controller -->|creates| TrainingRuntimeCRD["TrainingRuntime CRD"]
    Controller -->|creates| Webhooks["Webhook Configurations"]
    Controller -->|creates| RBAC["RBAC Roles & Bindings"]
    Controller -->|creates| NetworkPolicies["NetworkPolicies"]
    Controller -->|creates| ImageStreams["OpenShift ImageStreams"]

    %% Dependencies
    Controller -->|checks availability| JobSetOperator["JobSet Operator"]
    Controller -->|reads version| ConfigMap["odh-trainer-config<br/>ConfigMap"]
    Controller -->|API operations| K8sAPI["Kubernetes API<br/>:6443"]

    %% Monitoring
    MetricsServer -->|scraped by| Prometheus["Prometheus<br/>(via ServiceMonitor)"]

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style MetricsServer fill:#4a90e2,stroke:#333,color:#fff
    style HealthProbes fill:#4a90e2,stroke:#333,color:#fff
    style TLSWatcher fill:#4a90e2,stroke:#333,color:#fff
    style ManifestRenderer fill:#4a90e2,stroke:#333,color:#fff
    style GarbageCollector fill:#4a90e2,stroke:#333,color:#fff
    style TrainerCR fill:#f5a623,stroke:#333
    style TrainJobCRD fill:#f5a623,stroke:#333
    style ClusterTrainingRuntimeCRD fill:#f5a623,stroke:#333
    style TrainingRuntimeCRD fill:#f5a623,stroke:#333
    style KubeflowTrainer fill:#7ed321,stroke:#333
    style Webhooks fill:#7ed321,stroke:#333
    style RBAC fill:#7ed321,stroke:#333
    style NetworkPolicies fill:#7ed321,stroke:#333
    style ImageStreams fill:#7ed321,stroke:#333
    style JobSetOperator fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#e8e8e8,stroke:#333
    style ConfigMap fill:#e8e8e8,stroke:#333
    style Prometheus fill:#e8e8e8,stroke:#333
    style PlatformOp fill:#e8e8e8,stroke:#333
