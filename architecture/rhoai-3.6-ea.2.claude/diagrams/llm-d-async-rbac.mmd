graph TD
    subgraph "Service Account"
        SA["Pod ServiceAccount<br/>(namespace-scoped)"]
    end

    subgraph "Authentication Endpoints"
        HealthEndpoint["/healthz, /readyz<br/>Port 8081<br/>No authentication"]
        MetricsEndpoint["/metrics<br/>Port 9090<br/>Bearer token auth"]
    end

    subgraph "Auth Delegation"
        CRAuth["controller-runtime<br/>WithAuthenticationAndAuthorization"]
        K8sAPI["Kubernetes API Server<br/>:6443/HTTPS<br/>Token Review"]
    end

    subgraph "Outbound Auth"
        MTLSAuth["mTLS Client Auth<br/>(--tls-cert, --tls-key)"]
        RedisAuth["Redis URL Credentials<br/>(embedded in connection URL)"]
        GCPAuth["GCP IAM / ADC<br/>(Application Default Credentials)"]
    end

    subgraph "Outbound Targets"
        ModelServer["Inference Gateway<br/>(Model Server)"]
        Redis["Redis Server"]
        GCPPubSub["GCP Pub/Sub"]
    end

    %% RBAC Note
    subgraph "RBAC Status"
        Note["No ClusterRoles or<br/>RoleBindings defined<br/>in component manifests.<br/>Uses controller-runtime<br/>default SA permissions."]
    end

    %% Auth flows
    SA -->|"provides token"| CRAuth
    CRAuth -->|"validates bearer token"| K8sAPI
    K8sAPI -->|"auth result"| MetricsEndpoint

    SA -->|"mounts cert files"| MTLSAuth
    MTLSAuth -->|"TLS 1.2+ client cert"| ModelServer

    SA -->|"configures URL"| RedisAuth
    RedisAuth -->|"TCP/6379"| Redis

    SA -->|"workload identity"| GCPAuth
    GCPAuth -->|"gRPC/443 TLS"| GCPPubSub

    %% Styling
    style SA fill:#4a90e2,stroke:#333,color:#fff
    style HealthEndpoint fill:#e1d5e7,stroke:#9673a6
    style MetricsEndpoint fill:#fff2cc,stroke:#d6b656
    style CRAuth fill:#f5a623,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style MTLSAuth fill:#d5e8d4,stroke:#82b366
    style RedisAuth fill:#d5e8d4,stroke:#82b366
    style GCPAuth fill:#d5e8d4,stroke:#82b366
    style ModelServer fill:#e8e8e8,stroke:#333
    style Redis fill:#e8e8e8,stroke:#333
    style GCPPubSub fill:#e8e8e8,stroke:#333
    style Note fill:#f9f9f9,stroke:#ccc,stroke-dasharray: 5 5
