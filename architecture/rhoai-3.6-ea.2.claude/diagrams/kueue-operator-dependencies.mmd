graph LR
    KueueOp["Kueue Operator<br/>(Two-Tier)"]

    %% Platform Dependencies (Required)
    KueueOp -->|"webhook TLS certs<br/>Certificate + Issuer CRs"| CertManager["cert-manager"]
    KueueOp -->|"metrics collection<br/>ServiceMonitor CRs"| PromOperator["prometheus-operator"]
    KueueOp -->|"resource mgmt<br/>6443/HTTPS"| K8sAPI["Kubernetes API"]
    KueueOp -->|"capacity scheduling<br/>node list"| Nodes["Kubernetes Nodes"]

    %% Workload Framework Integrations (CRD watch/patch)
    KueueOp -->|"queue batch jobs<br/>watch/patch"| BatchV1["batch/v1<br/>Jobs"]
    KueueOp -->|"queue training jobs<br/>watch/patch"| Kubeflow["Kubeflow Training<br/>MPI, PyTorch, TF,<br/>XGBoost, Paddle"]
    KueueOp -->|"queue ray workloads<br/>watch/patch"| Ray["Ray Operator<br/>RayClusters, RayJobs"]
    KueueOp -->|"queue jobsets<br/>watch/patch"| JobSet["JobSet Controller<br/>jobset.x-k8s.io"]
    KueueOp -->|"queue LWS<br/>watch"| LWS["LeaderWorkerSet<br/>Controller"]
    KueueOp -->|"queue appwrappers<br/>watch/patch"| CodeFlare["CodeFlare<br/>AppWrappers"]

    %% Core workload interception
    KueueOp -->|"queue pods/deploys<br/>webhooks"| CoreK8s["Core Kubernetes<br/>Pods, Deployments,<br/>StatefulSets"]

    %% Build/Runtime Dependencies
    KueueOp -.->|"operator framework"| LibraryGo["openshift/library-go"]
    KueueOp -.->|"controller framework"| CtrlRuntime["controller-runtime<br/>0.20.4"]
    KueueOp -.->|"upstream kueue"| KueueUpstream["sigs.k8s.io/kueue<br/>0.10.2"]

    %% Provisioning API
    KueueOp -->|"cluster autoscaler<br/>ProvisioningRequest CRs"| AutoscalingAPI["autoscaling.x-k8s.io<br/>ProvisioningRequests"]

