graph TB
    subgraph ModuleLayer["Spark Operator Module (Platform Layer)"]
        ModuleController["spark-operator-module<br/>controller-manager<br/>(Go controller-runtime)"]
        SparkOperatorCR["SparkOperator CR<br/>(Cluster-scoped, singleton)"]
    end

    subgraph OperatorLayer["Spark Operator (Workload Layer)"]
        Controller["spark-operator-controller<br/>(Deployment)"]
        Webhook["spark-operator-webhook<br/>(Deployment)"]

        subgraph Controllers["Reconcilers"]
            SparkAppCtrl["SparkApplication<br/>Controller"]
            SchedCtrl["ScheduledSparkApplication<br/>Controller"]
            ConnectCtrl["SparkConnect<br/>Controller"]
        end

        subgraph Webhooks["Admission Webhooks (failurePolicy: Fail)"]
            MutPod["Mutating: pods"]
            MutApp["Mutating: SparkApplication"]
            MutSched["Mutating: ScheduledSparkApp"]
            MutConnect["Mutating: SparkConnect"]
            ValApp["Validating: SparkApplication"]
            ValSched["Validating: ScheduledSparkApp"]
            ValConnect["Validating: SparkConnect"]
            ConvWH["Conversion: ScheduledSparkApp"]
        end
    end

    subgraph CRDs["Custom Resource Definitions"]
        SparkApp["SparkApplication<br/>sparkoperator.k8s.io/v1beta2"]
        SchedSparkApp["ScheduledSparkApplication<br/>sparkoperator.k8s.io/v1beta2"]
        SparkConnect["SparkConnect<br/>sparkoperator.k8s.io/v1alpha1"]
    end

    subgraph WorkloadResources["Managed Workload Resources"]
        DriverPod["Driver Pod"]
        ExecutorPod["Executor Pod(s)"]
        Svc["Service"]
        CM["ConfigMap<br/>(Monitoring)"]
        PDB["PodDisruptionBudget"]
        Ingress["Ingress"]
    end

    %% ODH Operator interaction
    ODHOperator["ODH Operator"] -->|creates| SparkOperatorCR
    SparkOperatorCR -->|watched by| ModuleController
    ModuleController -->|deploys & manages| Controller
    ModuleController -->|deploys & manages| Webhook
    ModuleController -->|creates| CRDDef["CRDs, RBAC,<br/>NetworkPolicies,<br/>cert-manager Certs"]

    %% User interaction
    User["Data Engineer / User"] -->|creates| SparkApp
    User -->|creates| SchedSparkApp
    User -->|creates| SparkConnect

    %% Webhook flow
    SparkApp -->|admission| MutApp
    SparkApp -->|admission| ValApp
    SchedSparkApp -->|admission| MutSched
    SchedSparkApp -->|admission| ValSched
    SparkConnect -->|admission| MutConnect
    SparkConnect -->|admission| ValConnect

    %% Controller reconciliation
    Controller --- Controllers
    Webhook --- Webhooks
    SparkAppCtrl -->|reconciles| SparkApp
    SchedCtrl -->|reconciles| SchedSparkApp
    ConnectCtrl -->|reconciles| SparkConnect

    %% Workload creation
    SparkAppCtrl -->|creates| DriverPod
    SparkAppCtrl -->|creates| ExecutorPod
    SparkAppCtrl -->|creates| Svc
    SparkAppCtrl -->|creates| CM
    SparkAppCtrl -->|creates| PDB
    SparkAppCtrl -->|creates| Ingress

    %% Dependencies
    CertManager["cert-manager"] -->|provisions certs| Webhook
    Prometheus["Prometheus<br/>(PodMonitor)"] -.->|scrapes| Controller

    %% Styles
    style ModuleController fill:#4a90e2,color:#fff
    style Controller fill:#4a90e2,color:#fff
    style Webhook fill:#4a90e2,color:#fff
    style SparkApp fill:#f5a623
    style SchedSparkApp fill:#f5a623
    style SparkConnect fill:#f5a623
    style SparkOperatorCR fill:#f5a623
    style ODHOperator fill:#7ed321,color:#fff
    style CertManager fill:#999,color:#fff
    style Prometheus fill:#999,color:#fff
    style DriverPod fill:#d5e8d4
    style ExecutorPod fill:#d5e8d4
    style Svc fill:#d5e8d4
    style CM fill:#d5e8d4
    style PDB fill:#d5e8d4
    style Ingress fill:#d5e8d4
