graph TB
    subgraph "kube-rbac-proxy Sidecar"
        direction TB
        CLI["Cobra CLI<br/>cmd/kube-rbac-proxy"]
        TLS["TLS Termination<br/>crypto/tls<br/>FIPS-compliant (strictfipsruntime)"]
        AuthN["Authentication Handler<br/>WithAuthentication"]
        AuthZ["Authorization Handler<br/>WithAuthorization"]
        Proxy["Reverse Proxy<br/>httputil.ReverseProxy"]
        HealthCheck["/healthz Endpoint<br/>(No Auth)"]

        CLI --> TLS
        TLS --> AuthN
        AuthN --> AuthZ
        AuthZ --> Proxy
        CLI --> HealthCheck
    end

    subgraph "Authentication Modes"
        OIDC["OIDC Token Validation"]
        TokenReview["Kubernetes TokenReview<br/>(Delegated)"]
    end

    subgraph "Authorization Chain (Union)"
        MetricsAuth["Hardcoded Metrics Authorizer<br/>(OpenShift monitoring identities)"]
        StaticAuth["Static Policy Authorizer<br/>(File-based rules)"]
        SARAuth["SubjectAccessReview Authorizer<br/>(Kubernetes API delegation)"]
    end

    AuthN -->|"mode: OIDC"| OIDC
    AuthN -->|"mode: delegated"| TokenReview
    AuthZ --> MetricsAuth
    AuthZ --> StaticAuth
    AuthZ --> SARAuth

    Client["External Client"] -->|"HTTPS/8443<br/>TLS"| TLS
    Proxy -->|"HTTP/8080<br/>localhost"| Upstream["Upstream Application<br/>(e.g. Prometheus Exporter)"]
    TokenReview -->|"HTTPS/6443"| K8sAPI["Kubernetes API Server"]
    SARAuth -->|"HTTPS/6443"| K8sAPI

    style CLI fill:#4a90e2,color:#fff
    style TLS fill:#4a90e2,color:#fff
    style AuthN fill:#4a90e2,color:#fff
    style AuthZ fill:#4a90e2,color:#fff
    style Proxy fill:#4a90e2,color:#fff
    style HealthCheck fill:#4a90e2,color:#fff
    style OIDC fill:#f5a623,color:#fff
    style TokenReview fill:#f5a623,color:#fff
    style MetricsAuth fill:#7ed321,color:#fff
    style StaticAuth fill:#7ed321,color:#fff
    style SARAuth fill:#7ed321,color:#fff
    style Client fill:#e8e8e8,stroke:#333
    style Upstream fill:#e8e8e8,stroke:#333
    style K8sAPI fill:#999,color:#fff
