graph TB
    subgraph ControlPlane["CLUSTER CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph OperatorNS["NAMESPACE: openshift-kueue-operator"]
        direction TB

        subgraph Tier1["Tier 1: Operator (HA)"]
            Operator["openshift-kueue-operator<br/>2 replicas | system-cluster-critical<br/>SA: openshift-kueue-operator<br/>readOnlyRootFilesystem: true<br/>drop ALL capabilities"]
        end

        subgraph Tier2["Tier 2: Controller Manager"]
            Controller["kueue-controller-manager<br/>1 replica<br/>SA: kueue-controller-manager<br/>FIPS: strictfipsruntime + UBI 9 OpenSSL"]

            WebhookSvc["kueue-webhook-service<br/>ClusterIP 443→9443/TCP<br/>TLS (cert-manager)<br/>34 webhooks (Fail policy)"]

            VisibilitySvc["kueue-visibility-server<br/>ClusterIP 443→8082/TCP<br/>extension-apiserver auth"]

            MetricsSvc["kueue-controller-manager-metrics-service<br/>ClusterIP 8443/TCP<br/>TokenReview + SAR auth"]

            HealthProbe["Health Probes<br/>8081/TCP HTTP<br/>/healthz /readyz"]
        end
    end

    subgraph PlatformDeps["PLATFORM DEPENDENCIES"]
        CertManager["cert-manager<br/>Certificate + Issuer CRs<br/>Provisions webhook TLS"]
        PromOperator["prometheus-operator<br/>ServiceMonitor CRs<br/>Scrapes metrics"]
    end

    subgraph WorkloadFrameworks["INTERCEPTED WORKLOAD FRAMEWORKS (7)"]
        BatchJobs["batch/v1 Jobs"]
        KubeflowJobs["kubeflow.org<br/>MPI, PyTorch, TF,<br/>XGBoost, Paddle"]
        RayWorkloads["ray.io<br/>RayClusters, RayJobs"]
        JobSets["jobset.x-k8s.io<br/>JobSets"]
        LWS["leaderworkerset.x-k8s.io<br/>LeaderWorkerSets"]
        AppWrappers["workload.codeflare.dev<br/>AppWrappers"]
        CoreWorkloads["core/apps<br/>Pods, Deployments,<br/>StatefulSets"]
    end

    subgraph ClusterResources["CLUSTER RESOURCES"]
        Nodes["Kubernetes Nodes<br/>Capacity data"]
    end

    %% Flows
    Operator -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    Controller -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI

    K8sAPI -->|"HTTPS/443→9443<br/>TLS (cert-manager)<br/>Admission request"| WebhookSvc

    WebhookSvc -.->|"mutate/validate"| BatchJobs
    WebhookSvc -.->|"mutate/validate"| KubeflowJobs
    WebhookSvc -.->|"mutate/validate"| RayWorkloads
    WebhookSvc -.->|"mutate/validate"| JobSets
    WebhookSvc -.->|"mutate/validate"| LWS
    WebhookSvc -.->|"mutate/validate"| AppWrappers
    WebhookSvc -.->|"mutate/validate"| CoreWorkloads

    Operator -->|"CRD CRUD"| CertManager
    PromOperator -->|"Scrape 8443/TLS<br/>TokenReview auth"| MetricsSvc

    Controller -->|"list nodes<br/>RBAC"| Nodes

    Operator -->|"reconciles<br/>creates/manages"| Controller

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef service fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef workload fill:#f8cecc,stroke:#b85450,stroke-width:1px
    classDef cluster fill:#e1d5e7,stroke:#9673a6,stroke-width:1px

    class K8sAPI controlplane
    class Operator,Controller operator
    class WebhookSvc,VisibilitySvc,MetricsSvc,HealthProbe service
    class CertManager,PromOperator platform
    class BatchJobs,KubeflowJobs,RayWorkloads,JobSets,LWS,AppWrappers,CoreWorkloads workload
    class Nodes cluster
