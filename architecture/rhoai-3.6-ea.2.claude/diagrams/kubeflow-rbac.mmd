    style SA_CTRLMGR fill:#4a90e2,color:#fff
    style CR_NB fill:#f5a623,color:#fff
    style CR_MGR fill:#f5a623,color:#fff
    style R_LE fill:#f5a623,color:#fff
    style CR_Edit fill:#bd10e0,color:#fff
    style CR_View fill:#bd10e0,color:#fff
