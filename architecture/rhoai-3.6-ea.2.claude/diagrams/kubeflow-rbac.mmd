graph TD
    subgraph "Service Accounts"
        SA_NB["notebook-controller-<br/>service-account"]
        SA_MGR["manager"]
        SA_CTRLMGR["controller-manager"]
    end

    subgraph "ClusterRole Bindings"
        CRB_NB["notebook-controller-<br/>role-binding<br/>(Cluster-scoped)"]
        CRB_MGR["manager-rolebinding<br/>(Cluster-scoped)"]
        RB_LE["leader-election-<br/>rolebinding<br/>(Namespace-scoped)"]
    end

    subgraph "Roles"
        CR_NB["notebook-controller-role<br/>(ClusterRole)"]
        CR_MGR["manager-role<br/>(ClusterRole)"]
        R_LE["leader-election-role<br/>(Role)"]
    end

    subgraph "Notebook Controller Resources"
        NB_Events["core/events<br/>create, get, list,<br/>patch, watch"]
        NB_Pods["core/pods<br/>delete, get,<br/>list, watch"]
        NB_Services["core/services<br/>*"]
        NB_STS["apps/statefulsets<br/>*"]
        NB_Notebooks["kubeflow.org/notebooks<br/>notebooks/finalizers<br/>notebooks/status<br/>*"]
        NB_VS["networking.istio.io/<br/>virtualservices<br/>*"]
    end

    subgraph "ODH Controller Resources"
        MGR_Core["core/configmaps, secrets,<br/>serviceaccounts, services<br/>create, get, list, patch,<br/>update, watch"]
        MGR_Auth["authentication.k8s.io/<br/>tokenreviews<br/>authorization.k8s.io/<br/>subjectaccessreviews<br/>create"]
        MGR_OCP["config.openshift.io/<br/>apiservers, proxies<br/>get, list, watch"]
        MGR_DSPA["datasciencepipelinesapplications<br/>.opendatahub.io/<br/>datasciencepipelinesapplications<br/>get, list, watch"]
        MGR_GW["gateway.networking.k8s.io/<br/>gateways<br/>get, list, watch"]
        MGR_Route["gateway.networking.k8s.io/<br/>httproutes, referencegrants<br/>full CRUD"]
        MGR_NetPol["networking.k8s.io/<br/>networkpolicies<br/>create, get, list, patch,<br/>update, watch"]
        MGR_RBAC["rbac.authorization.k8s.io/<br/>clusterrolebindings,<br/>rolebindings, roles<br/>full CRUD"]
        MGR_OAuth["oauth.openshift.io/<br/>oauthclients<br/>delete, get, list, patch,<br/>update, watch"]
    end

    subgraph "Leader Election Resources"
        LE_CM["core/configmaps<br/>full CRUD"]
        LE_Leases["coordination.k8s.io/<br/>leases<br/>full CRUD"]
        LE_Events["core/events<br/>create, patch"]
    end

    subgraph "Aggregated Roles (User-facing)"
        CR_Edit["notebooks-edit<br/>kubeflow-notebooks-edit<br/>(ClusterRole)"]
        CR_View["notebooks-view<br/>kubeflow-notebooks-view<br/>(ClusterRole)"]
        Edit_Res["kubeflow.org/notebooks<br/>notebooks/status<br/>full CRUD"]
        View_Res["kubeflow.org/notebooks<br/>notebooks/status<br/>get, list, watch"]
    end

    %% Bindings
    SA_NB -->|bound via| CRB_NB
    SA_MGR -->|bound via| CRB_MGR
    SA_CTRLMGR -->|bound via| RB_LE

    CRB_NB -->|grants| CR_NB
    CRB_MGR -->|grants| CR_MGR
    RB_LE -->|grants| R_LE

    %% Notebook Controller permissions
    CR_NB --> NB_Events
    CR_NB --> NB_Pods
    CR_NB --> NB_Services
    CR_NB --> NB_STS
    CR_NB --> NB_Notebooks
    CR_NB --> NB_VS

    %% ODH Controller permissions
    CR_MGR --> MGR_Core
    CR_MGR --> MGR_Auth
    CR_MGR --> MGR_OCP
    CR_MGR --> MGR_DSPA
    CR_MGR --> MGR_GW
    CR_MGR --> MGR_Route
    CR_MGR --> MGR_NetPol
    CR_MGR --> MGR_RBAC
    CR_MGR --> MGR_OAuth

    %% Leader election
    R_LE --> LE_CM
    R_LE --> LE_Leases
    R_LE --> LE_Events

    %% Aggregated roles
    CR_Edit --> Edit_Res
    CR_View --> View_Res

