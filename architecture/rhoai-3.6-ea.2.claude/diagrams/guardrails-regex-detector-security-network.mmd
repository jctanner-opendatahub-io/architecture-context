graph TB
    subgraph Platform["PLATFORM / SERVICE MESH (Trust boundary)"]
        direction TB

        subgraph Caller["Upstream Caller"]
            Orchestrator["Guardrails Orchestrator<br/>Upstream guardrails component"]
        end

        subgraph App["APPLICATION: guardrails-regex-detector"]
            direction TB
            subgraph Container["UBI9-minimal Container"]
                Binary["regex-detector binary<br/>Rust / Tokio async runtime<br/>No TLS (plain TCP listener)<br/>No crypto libraries"]
                Endpoint1["POST /api/v1/text/contents<br/>Auth: None (platform-delegated)<br/>Processing: stateless, in-memory"]
                Endpoint2["GET /health<br/>Auth: None<br/>Response: 'healthy'"]
                Binary --- Endpoint1
                Binary --- Endpoint2
            end
        end
    end

    subgraph Probes["KUBERNETES"]
        K8s["Kubelet Probes"]
    end

    %% Flows
    Orchestrator -->|"HTTP/8080 (plain TCP)<br/>No app-level TLS<br/>No app-level auth<br/>mTLS if mesh-injected"| Binary
    K8s -->|"HTTP/8080<br/>GET /health<br/>No auth"| Endpoint2

    %% No egress
    note["No egress connections<br/>No secrets consumed<br/>No persistent storage<br/>No RBAC required"]

    %% Styling
    classDef platform fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef app fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef caller fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef k8s fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef noteStyle fill:#fff,stroke:#ccc,stroke-dasharray:5 5

    class Orchestrator caller
    class Binary,Endpoint1,Endpoint2 app
    class K8s k8s
    class note noteStyle
