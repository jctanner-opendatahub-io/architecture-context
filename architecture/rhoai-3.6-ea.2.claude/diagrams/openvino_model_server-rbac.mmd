graph TD
    subgraph "Authentication Model"
        direction TB

        subgraph V1V2["v1/v2 Endpoints (Inference)"]
            V1Endpoints["/v1/models/* (TFS v1)<br/>/v2/* (KServe v2)"]
            PlatformAuth["Platform-delegated Auth<br/>Enforcement: KServe / Istio"]
            V1Endpoints -->|"auth delegated to"| PlatformAuth
        end

        subgraph V3["v3 Endpoints (Generative / OpenAI)"]
            V3Endpoints["/v3/* (OpenAI-compatible)"]
            APIKeyAuth["API Key Auth (optional)<br/>--api_key_file or API_KEY env<br/>Bearer token"]
            V3Endpoints -->|"optional auth via"| APIKeyAuth
        end

        subgraph MTLSSidecar["mTLS Sidecar (Optional Deployment)"]
            NginxProxy["nginx Reverse Proxy"]
            TLSConfig["TLS 1.2<br/>AES256+EECDH<br/>ssl_verify_client on"]
            ClientCert["Client Certificate<br/>Verified against CA"]
            NginxProxy -->|"enforces"| TLSConfig
            TLSConfig -->|"requires"| ClientCert
        end
    end

    subgraph "KServe Integration (Platform RBAC)"
        direction TB

        subgraph ServingRuntimeCRs["Serving Runtime CRs"]
            CSR["kserve-openvino<br/>ClusterServingRuntime<br/>Scope: Cluster"]
            NSR["kserve-ovms-2026-2<br/>ServingRuntime<br/>Scope: Namespaced"]
        end

        KServeController["KServe Controller<br/>Manages InferenceService lifecycle"]
        KServeController -->|"reads"| CSR
        KServeController -->|"reads"| NSR
        KServeController -->|"creates pods with"| OVMSContainer["OVMS Container<br/>/ovms/bin/ovms"]
    end

    subgraph "Notes"
        Note1["No ClusterRoles or RoleBindings<br/>defined in the component itself"]
        Note2["RBAC managed by KServe<br/>and RHOAI platform"]
        Note3["No Kubernetes Secrets<br/>defined in the component"]
    end

    style V1Endpoints fill:#9ecae1,stroke:#333
    style V3Endpoints fill:#9ecae1,stroke:#333
    style PlatformAuth fill:#7ed321,stroke:#333
    style APIKeyAuth fill:#f5a623,stroke:#333
    style NginxProxy fill:#e6550d,stroke:#333,color:#fff
    style TLSConfig fill:#e6550d,stroke:#333,color:#fff
    style ClientCert fill:#e6550d,stroke:#333,color:#fff
    style CSR fill:#f5a623,stroke:#333
    style NSR fill:#f5a623,stroke:#333
    style KServeController fill:#7ed321,stroke:#333
    style OVMSContainer fill:#4a90e2,stroke:#333,color:#fff
    style Note1 fill:#f9f9f9,stroke:#ccc
    style Note2 fill:#f9f9f9,stroke:#ccc
    style Note3 fill:#f9f9f9,stroke:#ccc
