graph TB
    subgraph K8sControl["KUBERNETES CONTROL PLANE (Trusted)"]
        Operator["LMES Operator<br/>(trustyai-service-operator)<br/>Creates K8s Jobs<br/>Injects env vars & volumes"]
    end

    subgraph JobPod["JOB POD (Batch Workload - No Inbound Ports)"]
        direction TB
        HarnessJob["lm-evaluation-harness<br/>Image: odh-ta-lmes-job-rhel9<br/>User: non-root (UID 65532)<br/>No Services / No Ingress"]
    end

    subgraph ExternalAPIs["EXTERNAL SERVICES (Outbound Only)"]
        direction TB

        subgraph ModelAPIs["Model Inference APIs"]
            OpenAI["OpenAI / vLLM API<br/>HTTPS<br/>Auth: OPENAI_API_KEY"]
            Anthropic["Anthropic API<br/>HTTPS<br/>Auth: ANTHROPIC_API_KEY"]
            WatsonX["IBM WatsonX API<br/>HTTPS<br/>Auth: WATSONX_API_KEY"]
        end

        HFHub["HuggingFace Hub<br/>datasets-server.huggingface.co<br/>443/TCP HTTPS TLS<br/>Auth: HF_TOKEN"]

        S3["S3-Compatible Storage<br/>(AWS S3 / IBM COS)<br/>HTTPS TLS<br/>Auth: AWS credentials"]
    end

    subgraph LocalStorage["LOCAL STORAGE"]
        OutputPath["Output Path<br/>(PVC / Local Volume)<br/>Filesystem<br/>No encryption"]
    end

    %% Flows
    Operator -->|"K8s Job API<br/>RBAC auth<br/>Injects secrets as env vars"| HarnessJob

    HarnessJob -->|"HTTPS<br/>TLS<br/>OPENAI_API_KEY"| OpenAI
    HarnessJob -->|"HTTPS<br/>TLS<br/>ANTHROPIC_API_KEY"| Anthropic
    HarnessJob -->|"HTTPS<br/>TLS<br/>WATSONX_API_KEY"| WatsonX
    HarnessJob -->|"HTTPS/443<br/>TLS<br/>HF_TOKEN"| HFHub
    HarnessJob -->|"HTTPS<br/>TLS<br/>AWS IAM credentials"| S3
    HarnessJob -->|"Filesystem<br/>No network"| OutputPath

    %% Styling
    classDef controlplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef jobpod fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef external fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef storage fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Operator controlplane
    class HarnessJob jobpod
    class OpenAI,Anthropic,WatsonX,HFHub,S3 external
    class OutputPath storage
