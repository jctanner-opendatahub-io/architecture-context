graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_CM["controller-manager"]
        SA_Prom["kube-prometheus-stack-prometheus"]
        SA_EPP["epp-metrics-reader"]
    end

    subgraph ClusterRoleBindings["Cluster Role Bindings"]
        CRB_Manager["manager-rolebinding<br/>(Cluster-scoped)"]
        CRB_Metrics["metrics-auth-rolebinding<br/>(Cluster-scoped)"]
        CRB_Reader["metrics-reader-rolebinding<br/>(NS: monitoring)"]
        CRB_EPP["epp-metrics-reader-role-binding<br/>(Cluster-scoped)"]
    end

    subgraph RoleBindings["Role Bindings"]
        RB_Leader["leader-election-rolebinding"]
    end

    subgraph ClusterRoles["Cluster Roles"]
        CR_Manager["manager-role"]
        CR_MetricsAuth["metrics-auth-role"]
        CR_MetricsReader["metrics-reader"]
        CR_EPP["epp-metrics-reader-role"]
    end

    subgraph Roles["Roles"]
        R_Leader["leader-election-role"]
    end

    subgraph CoreResources["Core API Resources"]
        ConfigMaps["core<br/>configmaps<br/>get, list, watch"]
        ConfigMapsStatus["core<br/>configmaps/status<br/>get"]
        Namespaces["core<br/>namespaces<br/>get, list, watch"]
        Nodes["core<br/>nodes, nodes/status<br/>get, list, watch"]
        Pods["core<br/>pods<br/>get, list, watch"]
        ResourceQuotas["core<br/>resourcequotas<br/>get, list, watch"]
        Services["core<br/>services<br/>get, list, watch"]
        Events["core<br/>events<br/>create, patch"]
    end

    subgraph AppsResources["Apps API Resources"]
        Deployments["apps<br/>deployments<br/>get, list, patch, update, watch"]
        DeploymentsScale["apps<br/>deployments/scale<br/>get, update"]
        ReplicaSets["apps<br/>replicasets, statefulsets<br/>get, list, watch"]
    end

    subgraph AutoscalingResources["Autoscaling Resources"]
        HPAs["autoscaling<br/>horizontalpodautoscalers<br/>get, list, patch, update, watch"]
    end

    subgraph InferenceResources["Inference API Resources"]
        InferencePools["inference.networking.k8s.io<br/>inference.networking.x-k8s.io<br/>inferencepools<br/>get, list, watch"]
    end

    subgraph KEDAResources["KEDA Resources"]
        ScaledObjects["keda.sh<br/>scaledobjects<br/>get, list, patch, update, watch"]
    end

    subgraph LWSResources["LeaderWorkerSet Resources"]
        LWS["leaderworkerset.x-k8s.io<br/>leaderworkersets<br/>get, list, patch, update, watch"]
        LWSScale["leaderworkerset.x-k8s.io<br/>leaderworkersets/scale<br/>get, update"]
    end

    subgraph MonitoringResources["Monitoring Resources"]
        ServiceMonitors["monitoring.coreos.com<br/>servicemonitors<br/>get, list, watch"]
    end

    subgraph AuthResources["Auth Resources"]
        TokenReviews["authentication.k8s.io<br/>tokenreviews<br/>create"]
        SAR["authorization.k8s.io<br/>subjectaccessreviews<br/>create"]
    end

    subgraph LeaderElectionResources["Leader Election Resources"]
        Leases["coordination.k8s.io<br/>leases<br/>create, delete, get, list,<br/>patch, update, watch"]
        LEEvents["core<br/>events<br/>create, patch"]
    end

    %% controller-manager bindings
    SA_CM -->|bound via| CRB_Manager
    SA_CM -->|bound via| CRB_Metrics
    SA_CM -->|bound via| RB_Leader

    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_MetricsAuth
    RB_Leader -->|grants| R_Leader

    %% prometheus bindings
    SA_Prom -->|bound via| CRB_Reader
    CRB_Reader -->|grants| CR_MetricsReader

    %% epp bindings
    SA_EPP -->|bound via| CRB_EPP
    CRB_EPP -->|grants| CR_EPP

    %% manager-role permissions
    CR_Manager -->|access| ConfigMaps
    CR_Manager -->|access| ConfigMapsStatus
    CR_Manager -->|access| Namespaces
    CR_Manager -->|access| Nodes
    CR_Manager -->|access| Pods
    CR_Manager -->|access| ResourceQuotas
    CR_Manager -->|access| Services
    CR_Manager -->|access| Events
    CR_Manager -->|access| Deployments
    CR_Manager -->|access| DeploymentsScale
    CR_Manager -->|access| ReplicaSets
    CR_Manager -->|access| HPAs
    CR_Manager -->|access| InferencePools
    CR_Manager -->|access| ScaledObjects
    CR_Manager -->|access| LWS
    CR_Manager -->|access| LWSScale
    CR_Manager -->|access| ServiceMonitors

    %% metrics-auth-role permissions
    CR_MetricsAuth -->|access| TokenReviews
    CR_MetricsAuth -->|access| SAR

    %% leader-election-role permissions
    R_Leader -->|access| Leases
    R_Leader -->|access| LEEvents

    %% Styling
    style SA_CM fill:#4a90e2,color:#fff
    style SA_Prom fill:#4a90e2,color:#fff
    style SA_EPP fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623
    style CR_MetricsAuth fill:#f5a623
    style CR_MetricsReader fill:#f5a623
    style CR_EPP fill:#f5a623
    style R_Leader fill:#f5a623
    style ConfigMaps fill:#7ed321
    style ConfigMapsStatus fill:#7ed321
    style Namespaces fill:#7ed321
    style Nodes fill:#7ed321
    style Pods fill:#7ed321
    style ResourceQuotas fill:#7ed321
    style Services fill:#7ed321
    style Events fill:#7ed321
    style Deployments fill:#7ed321
    style DeploymentsScale fill:#7ed321
    style ReplicaSets fill:#7ed321
    style HPAs fill:#7ed321
    style InferencePools fill:#7ed321
    style ScaledObjects fill:#7ed321
    style LWS fill:#7ed321
    style LWSScale fill:#7ed321
    style ServiceMonitors fill:#7ed321
