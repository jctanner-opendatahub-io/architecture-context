graph LR
    KVCache["llm-d-kv-cache<br/>KV Cache Manager"]

    %% Runtime Infrastructure Dependencies
    KVCache -->|"cache block index<br/>6379/TCP"| Redis["Redis / Valkey"]
    KVCache -->|"cache events<br/>ZMQ 5557/TCP"| ZMQ["ZeroMQ<br/>(go-zeromq/zmq4)"]
    KVCache -->|"pod lifecycle<br/>6443/HTTPS"| K8sAPI["Kubernetes API<br/>k8s.io/client-go 0.33"]

    %% Framework Dependencies
    KVCache -->|"operator framework"| ControllerRuntime["controller-runtime<br/>0.21.0"]
    KVCache -->|"gRPC transport"| GRPC["google.golang.org/grpc<br/>1.81"]
    KVCache -->|"serialization"| Protobuf["google.golang.org/protobuf<br/>1.36"]

    %% Caching Dependencies
    KVCache -->|"in-memory cache"| Ristretto["Ristretto<br/>v2.4.0"]
    KVCache -->|"LRU cache"| LRU["hashicorp/golang-lru<br/>v2.0.7"]

    %% Serialization
    KVCache -->|"binary encoding"| CBOR["fxamacker/cbor<br/>v2.9.2"]
    KVCache -->|"message pack"| MsgPack["vmihailenco/msgpack<br/>v5.4.1"]

    %% Observability Dependencies
    KVCache -->|"distributed tracing<br/>OTLP/gRPC"| OTel["OpenTelemetry<br/>SDK 1.44"]
    KVCache -->|"metrics"| PromClient["prometheus/client_golang<br/>1.23"]
    KVCache -->|"structured logging"| Zap["uber.org/zap<br/>1.28"]

    %% Integration Points (incoming)
    Router["llm-d-router"] -->|"POST /score_*<br/>8080/TCP"| KVCache
    vLLM["vLLM Engines"] -->|"ZMQ pub/sub<br/>5557/TCP"| KVCache
    Prometheus["Prometheus"] -->|"GET /metrics<br/>8080/TCP"| KVCache

    %% Build Dependency
    KVCache -.->|"build toolchain"| Go["Go 1.25"]

