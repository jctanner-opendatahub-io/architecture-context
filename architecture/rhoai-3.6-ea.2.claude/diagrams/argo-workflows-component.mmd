graph TB
    subgraph ArgoWorkflows["Argo Workflows"]
        direction TB

        subgraph ControlPlane["Control Plane"]
            Controller["workflow-controller<br/>Go Operator<br/>Port 6060 (healthz)"]
            ArgoServer["argo-server<br/>gRPC + HTTP Gateway<br/>Port 2746"]
            Gatekeeper["Gatekeeper Interceptor<br/>Bearer / Basic / SSO (OIDC)"]
        end

        subgraph DataPlane["Data Plane (per workflow)"]
            StepPod["Step Pod"]
            ArgoExec["argoexec sidecar<br/>Artifact collection &<br/>container lifecycle"]
            StepPod --- ArgoExec
        end
    end

    %% CRDs
    subgraph CRDs["CRDs (argoproj.io/v1alpha1)"]
        WorkflowCR["Workflow<br/>(Namespaced)"]
        CronWorkflowCR["CronWorkflow<br/>(Namespaced)"]
        WorkflowTemplateCR["WorkflowTemplate<br/>(Namespaced)"]
        ClusterWFT["ClusterWorkflowTemplate<br/>(Cluster)"]
        WorkflowTaskSetCR["WorkflowTaskSet<br/>(Namespaced)"]
        WorkflowTaskResultCR["WorkflowTaskResult<br/>(Namespaced)"]
        WorkflowArtifactGCCR["WorkflowArtifactGCTask<br/>(Namespaced)"]
        WorkflowEventBindingCR["WorkflowEventBinding<br/>(Namespaced)"]
    end

    %% gRPC Services
    subgraph gRPCServices["gRPC Services (port 2746)"]
        WorkflowSvc["WorkflowService"]
        CronWFSvc["CronWorkflowService"]
        WFTemplateSvc["WorkflowTemplateService"]
        ClusterWFTSvc["ClusterWorkflowTemplateService"]
        ArchivedWFSvc["ArchivedWorkflowService"]
        EventSvc["EventService"]
        EventSourceSvc["EventSourceService"]
        SensorSvc["SensorService"]
        InfoSvc["InfoService"]
    end

    %% External
    Client["Client<br/>(DSP API Server / CLI / UI)"]
    K8sAPI["Kubernetes API<br/>6443/HTTPS"]

    %% Flows
    Client -->|"2746/TCP<br/>Bearer/Basic/OIDC"| ArgoServer
    ArgoServer --> Gatekeeper
    Gatekeeper --> gRPCServices

    Controller -->|watches| WorkflowCR
    Controller -->|watches| CronWorkflowCR
    Controller -->|watches| WorkflowTemplateCR
    Controller -->|watches| ClusterWFT
    Controller -->|creates| StepPod
    Controller -->|manages| WorkflowTaskSetCR
    Controller -->|manages| WorkflowArtifactGCCR

    ArgoExec -->|reports| WorkflowTaskResultCR

    Controller -->|"HTTPS/WSS<br/>ServiceAccount"| K8sAPI
    ArgoServer -->|"HTTPS/WSS<br/>ServiceAccount/Impersonation"| K8sAPI
    ArgoExec -->|"HTTPS<br/>ServiceAccount"| K8sAPI

    %% Styling
    style Controller fill:#4a90e2,stroke:#333,color:#fff
    style ArgoServer fill:#4a90e2,stroke:#333,color:#fff
    style Gatekeeper fill:#e74c3c,stroke:#333,color:#fff
    style ArgoExec fill:#9b59b6,stroke:#333,color:#fff
    style StepPod fill:#9b59b6,stroke:#333,color:#fff
    style K8sAPI fill:#e8e8e8,stroke:#333
    style Client fill:#f5a623,stroke:#333

    style WorkflowCR fill:#7ed321,stroke:#333
    style CronWorkflowCR fill:#7ed321,stroke:#333
    style WorkflowTemplateCR fill:#7ed321,stroke:#333
    style ClusterWFT fill:#7ed321,stroke:#333
    style WorkflowTaskSetCR fill:#7ed321,stroke:#333
    style WorkflowTaskResultCR fill:#7ed321,stroke:#333
    style WorkflowArtifactGCCR fill:#7ed321,stroke:#333
    style WorkflowEventBindingCR fill:#7ed321,stroke:#333
