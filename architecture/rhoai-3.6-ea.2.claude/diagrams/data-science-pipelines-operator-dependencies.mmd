graph LR
    DSPO["Data Science Pipelines<br/>Operator"]

    %% Runtime Framework
    DSPO -->|"operator framework"| ControllerRuntime["controller-runtime 0.23.3"]
    DSPO -->|"manifest rendering"| Manifestival["manifestival 0.7.2"]

    %% Infrastructure Dependencies
    DSPO -->|"resource mgmt<br/>6443/TCP HTTPS"| K8sAPI["Kubernetes API"]
    DSPO -->|"TLS profile"| OpenShiftAPI["OpenShift APIServer<br/>(config.openshift.io)"]

    %% Internal RHOAI Dependencies
    DSPO -->|"CRD Watch<br/>(direct API read)"| MLflow["MLflow<br/>(mlflow.opendatahub.io)"]
    DSPO -->|"CRD Watch"| KServe["KServe InferenceService<br/>(serving.kserve.io)"]
    DSPO -->|"CRD CRUD"| KubeflowNB["Kubeflow Notebooks<br/>(kubeflow.org)"]
    DSPO -->|"ServiceMonitor CRUD"| PromOperator["prometheus-operator<br/>(monitoring.coreos.com)"]
    DSPO -.->|"Go library"| MLflowAPI["mlflow-operator/api"]

    %% Per-DSPA Stack Components (deployed by operator)
    DSPO -->|"deploys"| ArgoWFC["Argo Workflow Controller"]
    DSPO -->|"deploys"| MariaDB["MariaDB<br/>:3306"]
    DSPO -->|"deploys"| MinIO["MinIO<br/>:9000"]

    %% Managed CRD Ecosystems
    DSPO -->|"manages Argo CRDs"| ArgoCRDs["Argo Workflow CRDs<br/>(argoproj.io)"]
    DSPO -->|"manages Pipeline CRDs"| PipelineCRDs["Pipeline/PipelineVersion<br/>(pipelines.kubeflow.org)"]

    %% External integrations visible via RBAC
    DSPO -.->|"RBAC for"| Ray["Ray<br/>(ray.io)"]
    DSPO -.->|"RBAC for"| Codeflare["CodeFlare AppWrappers<br/>(workload.codeflare.dev)"]
    DSPO -.->|"RBAC for"| Seldon["Seldon Deployments<br/>(machinelearning.seldon.io)"]

    %% Observability
    DSPO -->|"logging"| Zap["go.uber.org/zap"]
    DSPO -->|"metrics"| Prometheus["prometheus/client_golang"]

