graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Data Scientist / kubectl"]
    end

    subgraph K8sControl["KUBERNETES API SERVER"]
        APIServer["kube-apiserver<br/>6443/TCP<br/>TLS 1.2+<br/>RBAC + SA tokens"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (opendatahub)"]
        direction TB

        subgraph ControllerPod["kubeflow-trainer-controller-manager"]
            direction TB
            Webhook["Webhook Server<br/>443/TCP TLS<br/>OpenShift TLSProfile<br/>Cert: kubeflow-trainer-webhook-cert"]
            Metrics["Metrics Server<br/>8443/TCP TLS<br/>OpenShift TLSProfile"]
            StatusSrv["Status Server<br/>10443/TCP"]
            Health["Health/Readiness<br/>8081/TCP HTTP<br/>Unauthenticated"]
        end

        CertController["OPA cert-controller<br/>Certificate rotation"]
    end

    subgraph OpenShiftConfig["OPENSHIFT PLATFORM"]
        TLSProfile["APIServer Resource<br/>config.openshift.io/v1<br/>TLSSecurityProfile"]
    end

    subgraph WorkloadNS["TRAINING WORKLOAD NAMESPACE"]
        direction TB
        JobSet["JobSet CR"]
        TrainingPods["Training Pods<br/>(distributed workers)"]
        NetPolicy["NetworkPolicy<br/>Per-TrainJob isolation<br/>Ingress: jobset-name label"]
        InitContainers["Init Containers<br/>Dataset + Model<br/>(Python)"]
    end

    subgraph GangScheduling["GANG SCHEDULING (Optional)"]
        CoSchedPG["PodGroup<br/>scheduling.x-k8s.io<br/>CoScheduling"]
        VolcanoPG["PodGroup<br/>scheduling.volcano.sh<br/>Volcano"]
    end

    %% Flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| APIServer
    APIServer -->|"HTTPS/443<br/>TLS (TLSProfile)<br/>Admission webhook"| Webhook
    ControllerPod -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token (in-cluster)"| APIServer
    ControllerPod -->|"reads"| TLSProfile
    CertController -->|"rotates cert"| Webhook
    ControllerPod -->|"creates/reconciles"| JobSet
    ControllerPod -->|"creates"| NetPolicy
    JobSet -->|"creates"| TrainingPods
    InitContainers -.->|"runs before"| TrainingPods
    ControllerPod -.->|"creates (if CoScheduling)"| CoSchedPG
    ControllerPod -.->|"creates (if Volcano)"| VolcanoPG

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef apiserver fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef workload fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef scheduling fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class APIServer apiserver
    class Webhook,Metrics,StatusSrv,Health,CertController operator
    class JobSet,TrainingPods,NetPolicy,InitContainers workload
    class TLSProfile platform
    class CoSchedPG,VolcanoPG scheduling
