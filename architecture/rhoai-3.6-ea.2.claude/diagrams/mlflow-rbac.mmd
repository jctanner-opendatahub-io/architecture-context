graph TD
    subgraph "Authentication Model"
        direction TB

        subgraph ClientAuth["Client-Side Authentication"]
            ClientSDK["MLflow Client SDK"]
            AuthProvider["KubernetesRequestAuthProvider"]
            SATokenFile["/var/run/secrets/<br/>kubernetes.io/serviceaccount/token"]
            KubeConfig["~/.kube/config<br/>(fallback)"]

            ClientSDK -->|"uses"| AuthProvider
            AuthProvider -->|"reads token<br/>(60s TTL cache)"| SATokenFile
            AuthProvider -.->|"fallback"| KubeConfig
        end

        subgraph ServerAuth["Server-Side Authentication"]
            K8sAuthPlugin["kubernetes-auth Plugin<br/>(mlflow-kubernetes-plugins==1.5.0)"]
            AppFramework["mlflow.app Plugin Framework<br/>(_find_app() entry point)"]

            AppFramework -->|"loads at startup"| K8sAuthPlugin
        end

        subgraph RequestFlow["Request Authentication Flow"]
            IncomingRequest["Incoming HTTP Request"]
            BearerHeader["Authorization: Bearer &lt;token&gt;"]
            WorkspaceHeader["X-MLFLOW-WORKSPACE: &lt;namespace&gt;"]
            TokenValidation["Token Validation<br/>(K8s API)"]
            NamespaceIsolation["Namespace-Based<br/>Workspace Isolation"]
            APIHandler["API Handler<br/>(48 endpoints)"]

            IncomingRequest --> BearerHeader
            IncomingRequest --> WorkspaceHeader
            BearerHeader --> K8sAuthPlugin
            WorkspaceHeader --> K8sAuthPlugin
            K8sAuthPlugin --> TokenValidation
            K8sAuthPlugin --> NamespaceIsolation
            TokenValidation -->|"valid"| APIHandler
        end
    end

    subgraph "Secrets Management (19 Environment Variables)"
        direction TB

        subgraph AIProviderKeys["AI Provider API Keys"]
            OPENAI["OPENAI_API_KEY"]
            ANTHROPIC["ANTHROPIC_API_KEY"]
            COHERE["COHERE_API_KEY"]
            MISTRAL["MISTRAL_API_KEY"]
            TOGETHERAI["TOGETHERAI_API_KEY"]
            GROQ["GROQ_API_KEY"]
            DEEPSEEK["DEEPSEEK_API_KEY"]
            XAI["XAI_API_KEY"]
            OPENROUTER["OPENROUTER_API_KEY"]
            OLLAMA["OLLAMA_API_KEY"]
        end

        subgraph AWSKeys["AWS Credentials"]
            AWSSECRET["AWS_SECRET_ACCESS_KEY"]
            AWSSESSION["AWS_SESSION_TOKEN"]
            AWSBEDROCK["AWS_BEARER_TOKEN_BEDROCK"]
        end

        subgraph DatabricksKeys["Databricks Credentials"]
            DBTOKEN["DATABRICKS_TOKEN"]
            DBPASS["DATABRICKS_PASSWORD"]
            DBREFRESH["DATABRICKS_REFRESH_TOKEN"]
            DBCLIENT["DATABRICKS_CLIENT_SECRET"]
        end

        subgraph OtherKeys["Other Credentials"]
            AZURESTORAGE["AZURE_STORAGE_SAS_TOKEN"]
            JUPYTERHUB["JUPYTERHUB_API_TOKEN"]
        end
    end

    subgraph "FIPS Compliance"
        BaseImage["Base Image:<br/>ubi9/ubi-minimal-pqc"]
        CryptoLib["cryptography >=43.0.0<br/>(OpenSSL backend)"]
        SystemSSL["System OpenSSL<br/>(FIPS mode if configured)"]

        BaseImage --> SystemSSL
        CryptoLib --> SystemSSL
    end

    %% Styling
    style K8sAuthPlugin fill:#f5a623,stroke:#333,stroke-width:2px
    style AuthProvider fill:#f5a623,stroke:#333
    style TokenValidation fill:#d5e8d4,stroke:#82b366
    style NamespaceIsolation fill:#d5e8d4,stroke:#82b366
