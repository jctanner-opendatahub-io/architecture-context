graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph Ingress["INGRESS"]
        Route["OpenShift Route / HTTPRoute<br/>443/TCP → 8443/TCP<br/>TLS re-encrypt"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (model-registry-operator-system)"]
        direction TB
        ControllerMgr["controller-manager<br/>SA: model-registry-operator-controller-manager<br/>FIPS: strictfipsruntime<br/>Image: ubi9/ubi-minimal-pqc"]
        WebhookSvr["Webhook Server<br/>9443/TCP HTTPS TLS<br/>Auth: Kubernetes Admission"]
        Metrics["Metrics (kube-rbac-proxy)<br/>8443/TCP HTTPS<br/>Auth: TokenReview"]
        HealthProbes["Health Probes<br/>8081/TCP HTTP<br/>Auth: None"]
    end

    subgraph RegistryNS["REGISTRY NAMESPACE ({user-namespace})"]
        direction TB

        subgraph RegistryPod["Registry Pod"]
            KubeProxy["kube-rbac-proxy<br/>8443/TCP HTTPS TLS<br/>Auth: TokenReview + SAR<br/>Cert: {name}-kube-rbac-proxy"]
            RESTContainer["REST Container<br/>8080/TCP HTTP<br/>Auth: Proxy-authenticated"]
        end

        PostgresReg["{registry-name}-postgres<br/>5432/TCP PostgreSQL<br/>Auth: DB credentials<br/>Service: ClusterIP"]

        NetPol["NetworkPolicy<br/>(per-registry scoped)"]
    end

    subgraph CatalogNS["CATALOG NAMESPACE"]
        direction TB

        subgraph CatalogPod["Catalog Pod"]
            CatalogProxy["kube-rbac-proxy<br/>8443/TCP HTTPS TLS<br/>Cert: model-catalog-kube-rbac-proxy"]
            CatalogApp["catalog<br/>8080/TCP HTTP"]
        end

        PostgresCat["model-catalog-postgres<br/>5432/TCP PostgreSQL<br/>Service: ClusterIP"]
    end

    subgraph PlatformAPIs["PLATFORM INTEGRATIONS"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount Token"]
        PlatformAuth["ODH Platform Auth<br/>services.platform.opendatahub.io<br/>Watch (read-only)"]
        ComponentMgr["ODH Component Manager<br/>components.platform.opendatahub.io<br/>Watch (read-only)"]
        GatewayAPI["Gateway API<br/>data-science-gateway<br/>HTTPRoute CRUD"]
    end

    %% External flows
    Client -->|"HTTPS/443<br/>TLS<br/>Bearer Token"| Route
    Route -->|"HTTPS/8443<br/>TLS<br/>Passthrough"| KubeProxy

    %% Proxy authentication chain
    KubeProxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>TokenReview"| K8sAPI
    KubeProxy -->|"HTTPS/6443<br/>TLS 1.2+<br/>SubjectAccessReview"| K8sAPI
    KubeProxy -->|"HTTP/8080<br/>None<br/>Proxy-auth headers"| RESTContainer

    %% Registry data flow
    RESTContainer -->|"PostgreSQL/5432<br/>DB Credentials"| PostgresReg

    %% Catalog data flow
    CatalogProxy -->|"HTTP/8080<br/>Proxy-auth"| CatalogApp
    CatalogApp -->|"PostgreSQL/5432<br/>DB Credentials"| PostgresCat

    %% Operator → K8s API
    ControllerMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount Token"| K8sAPI

    %% Operator → Platform
    ControllerMgr -.->|"Watch"| PlatformAuth
    ControllerMgr -.->|"Watch"| ComponentMgr
    ControllerMgr -->|"HTTPRoute CRUD"| GatewayAPI

    %% Webhook
    K8sAPI -->|"HTTPS/9443<br/>TLS<br/>Admission"| WebhookSvr

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef registry fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef catalog fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef platform fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef security fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Route ingress
    class ControllerMgr,WebhookSvr,Metrics,HealthProbes operator
    class KubeProxy,RESTContainer,PostgresReg,NetPol registry
    class CatalogProxy,CatalogApp,PostgresCat catalog
    class K8sAPI,PlatformAuth,ComponentMgr,GatewayAPI platform
