    %% Runtime Libraries
    Feast -.->|"REST framework"| FastAPI["FastAPI +<br/>Starlette + Uvicorn"]
    Feast -.->|"gRPC transport"| gRPC["gRPC<br/>(grpcio / google.golang.org/grpc)"]
    Feast -.->|"auth tokens"| PyJWT["PyJWT<br/>OIDC validation"]
    Feast -.->|"observability"| OTel["OpenTelemetry<br/>tracing"]
    Feast -.->|"metrics"| PromClient["Prometheus Client<br/>(Go + Python)"]

    %% Integration Consumers
    Dashboard["ODH Dashboard"] -.->|"manages via UI"| Feast
    Pipelines["Data Science Pipelines"] -.->|"feature retrieval"| Feast

