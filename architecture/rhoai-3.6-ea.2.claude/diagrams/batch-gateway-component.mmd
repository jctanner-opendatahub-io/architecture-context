graph TB
    subgraph "batch-gateway"
        subgraph "API Server"
            APIServer["batch-gateway-apiserver<br/>Go HTTP Service<br/>Port 8000 (optional TLS)"]
            APIMux["API Mux<br/>/v1/batches, /v1/files"]
            ObsMux["Observability Mux<br/>Port 8081 (plain HTTP)<br/>/health, /metrics"]
            Middleware["Middleware Chain<br/>Recovery → RequestMiddleware<br/>(Tenant, OTel, Metrics)<br/>→ SecurityHeaders"]
            APIServer --> APIMux
            APIServer --> ObsMux
            APIMux --> Middleware
        end

        subgraph "Processor"
            Processor["batch-gateway-processor<br/>Go Background Worker"]
            ProcessorObs["Observability<br/>Port 8081<br/>/ready, /health, /metrics"]
            Processor --> ProcessorObs
        end

        subgraph "Garbage Collector"
            GC["batch-gateway-gc<br/>Go Background Worker"]
            GCObs["Observability<br/>Port 8081<br/>/health, /metrics"]
            GC --> GCObs
        end

        subgraph "Shared Libraries"
            DBLib["Database Access<br/>(PostgreSQL)"]
            FileLib["File Storage<br/>(PVC / S3)"]
            RedisLib["Redis/Valkey<br/>Messaging"]
            TLSLib["TLS Config<br/>(internal/tls)"]
        end

        APIServer -->|uses| DBLib
        APIServer -->|uses| FileLib
        APIServer -->|uses| RedisLib
        APIServer -->|uses| TLSLib
        Processor -->|uses| DBLib
        Processor -->|uses| FileLib
        Processor -->|uses| RedisLib
        GC -->|uses| DBLib
        GC -->|uses| FileLib
    end

    Client[External Client] -->|"POST /v1/batches<br/>Authorization header"| APIMux
    Client -->|"POST /v1/files<br/>Upload (max 200MB)"| APIMux

    Processor -->|"HTTP/HTTPS<br/>Auth passthrough"| LLMd["llm-d Inference Gateway"]
    Processor -->|"llm-d-async producer"| RedisLib

    DBLib -->|TCP| PostgreSQL["PostgreSQL"]
    RedisLib -->|TCP| Redis["Redis/Valkey"]
    FileLib -->|HTTP/HTTPS| S3["S3-compatible Storage"]

    APIServer -->|"OTLP/gRPC"| OTel["OpenTelemetry Collector"]
    Processor -->|"OTLP/gRPC"| OTel
    GC -->|"OTLP/gRPC"| OTel

    style APIServer fill:#4a90e2,stroke:#333,color:#fff
    style Processor fill:#4a90e2,stroke:#333,color:#fff
    style GC fill:#4a90e2,stroke:#333,color:#fff
    style APIMux fill:#5b9bd5,stroke:#333,color:#fff
    style ObsMux fill:#5b9bd5,stroke:#333,color:#fff
    style Middleware fill:#5b9bd5,stroke:#333,color:#fff
    style Client fill:#f9f9f9,stroke:#999
    style PostgreSQL fill:#f5a623,stroke:#333
    style Redis fill:#f5a623,stroke:#333
    style S3 fill:#f5a623,stroke:#333
    style LLMd fill:#7ed321,stroke:#333
    style OTel fill:#999,stroke:#333,color:#fff
