graph TD
    subgraph "ML Metadata RBAC"
        direction TB
        Note["No Kubernetes RBAC resources defined<br/>by this component"]
    end

    subgraph "Authentication Model"
        direction TB
        gRPCEndpoint["MetadataStoreService<br/>gRPC API (8080/TCP)"]
        AuthModel["Auth: Platform-Delegated<br/>No application-level AuthN/AuthZ"]
        OptionalMTLS["Optional mTLS<br/>via SSLConfig"]
    end

    subgraph "SSLConfig Options"
        direction TB
        ServerKey["server_key<br/>(Server private key)"]
        ServerCert["server_cert<br/>(Server certificate)"]
        CustomCA["custom_ca<br/>(Custom CA certificate)"]
        ClientVerify["client_verify<br/>(Enable client cert verification)"]
    end

    subgraph "Database Auth"
        direction TB
        DBCreds["Database Credentials<br/>(via MetadataStoreServerConfig)"]
        MySQLSSL["MySQL SSLOptions<br/>key, cert, ca, capath,<br/>cipher, verify_server_cert"]
        PgSSL["PostgreSQL SSLOptions<br/>sslmode, sslcert,<br/>sslkey, sslrootcert"]
    end

    gRPCEndpoint -->|"optional"| OptionalMTLS
    gRPCEndpoint -->|"enforced by"| AuthModel
    OptionalMTLS -->|"configures"| ServerKey
    OptionalMTLS -->|"configures"| ServerCert
    OptionalMTLS -->|"configures"| CustomCA
    OptionalMTLS -->|"configures"| ClientVerify

    gRPCEndpoint -->|"backend auth"| DBCreds
    DBCreds -->|"MySQL"| MySQLSSL
    DBCreds -->|"PostgreSQL"| PgSSL

    style Note fill:#fff3cd,stroke:#ffc107,stroke-width:2px
    style gRPCEndpoint fill:#4a90e2,stroke:#333,color:#fff
    style AuthModel fill:#f8d7da,stroke:#dc3545
    style OptionalMTLS fill:#d5e8d4,stroke:#82b366
    style ServerKey fill:#e8e8e8,stroke:#333
    style ServerCert fill:#e8e8e8,stroke:#333
    style CustomCA fill:#e8e8e8,stroke:#333
    style ClientVerify fill:#e8e8e8,stroke:#333
    style DBCreds fill:#f5a623,stroke:#333,color:#fff
    style MySQLSSL fill:#fff2cc,stroke:#d6b656
    style PgSSL fill:#fff2cc,stroke:#d6b656
