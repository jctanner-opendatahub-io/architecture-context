    style HealthProbe fill:#e27a4a,stroke:#333,color:#fff
    style KueueCR fill:#f5a623,stroke:#333
    style ClusterQueue fill:#7ed321,stroke:#333
    style LocalQueue fill:#7ed321,stroke:#333
    style Workload fill:#7ed321,stroke:#333
    style ResourceFlavor fill:#7ed321,stroke:#333
    style Cohort fill:#7ed321,stroke:#333
    style Topology fill:#7ed321,stroke:#333
    style AdmissionCheck fill:#7ed321,stroke:#333
    style MultiKueueCluster fill:#7ed321,stroke:#333
    style WorkloadPriorityClass fill:#7ed321,stroke:#333
    style CertManager fill:#e8e8e8,stroke:#333
