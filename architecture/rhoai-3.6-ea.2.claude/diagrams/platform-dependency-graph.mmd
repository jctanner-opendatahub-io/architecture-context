graph TB
    subgraph PlatformOperator["Platform Operator"]
        rhods["rhods-operator<br/>Platform Orchestrator<br/>(DataScienceCluster)"]
    end

    subgraph ModuleOperators["Module Operators (components.platform.opendatahub.io)"]
        feast_mod["feast-module-operator"]
        mlflow_op["mlflow-operator"]
        trainer_op["trainer-operator"]
        workbenches_op["workbenches-operator"]
        spark_op["spark-operator"]
        aigw_op["ai-gateway-operator"]
        trustyai_op["trustyai-service-operator"]
        ogx_op["ogx-k8s-operator"]
        mcp_mod["mcp-lifecycle-module-operator"]
    end

    subgraph CoreControllers["Core Controllers"]
        kserve["kserve<br/>13 CRDs, 30 webhooks<br/>(InferenceService, LLMInferenceService,<br/>ServingRuntime, LocalModelCache)"]
        odh_mc["odh-model-controller<br/>HTTPRoute, AuthPolicy,<br/>EnvoyFilter creation"]
        kubeflow["kubeflow<br/>notebook-controller<br/>(Notebook CR lifecycle)"]
        dashboard["odh-dashboard<br/>11 Go BFF sidecars<br/>(user-facing UI)"]
        maas["models-as-a-service<br/>MaaS API + tenant mgmt<br/>(MaaSSubscription, AITenant)"]
        dspo["data-science-pipelines-operator<br/>(DSPA CR reconciliation)"]
        mr_op["model-registry-operator<br/>(model-catalog + registry)"]
    end

    subgraph InferenceEngines["Inference & Serving"]
        llmd["llm-d<br/>Disaggregated inference<br/>(vLLM + RDMA KV-cache)"]
        llmd_router["llm-d-router (EPP)<br/>ExtProc scheduling<br/>(InferencePool)"]
        llmd_kv["llm-d-kv-cache<br/>KV-cache transfer"]
        vllm["vllm-cpu"]
        mlserver["MLServer"]
        guardrails_orch["fms-guardrails-orchestrator"]
        nemo["NeMo-Guardrails"]
        guardrails_regex["guardrails-regex-detector"]
        batch_gw["batch-gateway"]
    end

    subgraph GatewayInfra["Gateway Infrastructure (openshift-ingress)"]
        dsg["data-science-gateway<br/>(Istio/Envoy)"]
        maas_gw["maas-default-gateway<br/>(Istio/Envoy)"]
        kube_auth["kube-auth-proxy<br/>OAuth2/OIDC auth"]
        praxis["praxis-extproc<br/>Dual-stage ExtProc"]
        aigw_ctrl["ai-gateway-controller<br/>ExtProc dataplane mgmt"]
    end

    subgraph Workloads["User Workloads"]
        notebooks["Notebook Servers<br/>(JupyterLab)"]
        pipelines["Pipeline Runs<br/>(Argo Workflows)"]
        training["Training Jobs<br/>(TrainJob, PyTorchJob)"]
        featurestore["Feature Stores<br/>(Feast)"]
    end

    subgraph Observability["Observability (redhat-ods-monitoring)"]
        odh_obs["odh-observability<br/>Prometheus + OTel"]
    end

    subgraph NewCapabilities["New Capabilities (3.6-ea.2)"]
        openshell["OpenShell<br/>Sandboxed AI agent"]
        workbenches_ctrl["workbenches<br/>Workspace management"]
        trainer_ctrl["trainer<br/>Kubeflow Trainer v2"]
        data_connect["data-connect-hub"]
        eval_hub["eval-hub"]
        mcp_life["mcp-lifecycle-operator"]
    end

    %% rhods-operator → module operators (lifecycle orchestration)
    rhods -->|enables/disables| feast_mod
    rhods -->|enables/disables| mlflow_op
    rhods -->|enables/disables| trainer_op
    rhods -->|enables/disables| workbenches_op
    rhods -->|enables/disables| spark_op
    rhods -->|enables/disables| aigw_op
    rhods -->|enables/disables| trustyai_op
    rhods -->|enables/disables| ogx_op
    rhods -->|enables/disables| mcp_mod

    %% rhods-operator → core controllers
    rhods -->|deploys| kserve
    rhods -->|deploys| odh_mc
    rhods -->|deploys| kubeflow
    rhods -->|deploys| dashboard
    rhods -->|deploys| dspo
    rhods -->|deploys| mr_op
    rhods -->|deploys| maas

    %% rhods-operator → gateway infrastructure
    rhods -->|creates Gateway + EnvoyFilter| dsg

    %% Core controller dependencies (from dependency graph)
    kserve -->|runtime integration| odh_mc
    odh_mc -->|HTTPRoute + AuthPolicy| dsg
    kubeflow -->|HTTPRoute + ReferenceGrant| dsg
    maas -->|HTTPRoute| maas_gw
    dspo -->|runtime integration| kserve
    dspo -->|runtime integration| mlflow_op
    dspo -->|runtime library| kubeflow

    %% Gateway authentication flows
    dsg -->|ext_authz subrequest| kube_auth
    maas_gw -->|dual-stage ExtProc| praxis
    aigw_op -->|deploys| aigw_ctrl
    aigw_ctrl -->|installs ExtProc manifests| praxis

    %% MaaS dependencies
    maas -->|inference routing| kserve

    %% Feast dependencies
    feast_mod -->|runtime integration| kubeflow
    feast_mod -->|runtime integration| kuberay
    feast_mod -->|runtime integration| mlflow_op

    %% LLM-D inference path
    llmd_router -->|ExtProc routing| llmd
    llmd -->|RDMA KV-cache| llmd_kv

    %% Workload relationships
    kubeflow -->|manages| notebooks
    dspo -->|orchestrates| pipelines
    trainer_ctrl -->|manages| training

    %% Observability
    odh_obs -->|monitors| kserve
    odh_obs -->|monitors| dashboard

