graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph ProxyLayer["PROXY LAYER (Envoy)"]
        Envoy["Envoy Proxy<br/>envoyproxy/envoy:distroless-v1.33.2<br/>NodePort 8081/TCP"]
    end

    subgraph ProcessingLayer["PROCESSING LAYER (payload-processor)"]
        direction TB

        subgraph NS_IPP["Namespace: ${NAMESPACE}"]
            ExtProc["ExtProc gRPC Server<br/>9004/TCP<br/>Self-signed TLS (RSA-4096)<br/>No app-level auth"]
            Health["Health gRPC Server<br/>9005/TCP<br/>Plaintext<br/>No auth"]
            Metrics["Metrics HTTP Server<br/>9090/TCP<br/>K8s TokenReview auth"]
        end

        SecurityCtx["Security Context:<br/>User: 65532 (nonroot)<br/>SA: payload-processor<br/>Image: distroless/static:nonroot"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>TLS 1.2+<br/>ServiceAccount auth"]
    end

    subgraph ModelServing["MODEL SERVING LAYER"]
        DeepSeek["vllm-deepseek-r1<br/>ClusterIP 8000/TCP"]
        Llama["vllm-llama3-8b-instruct<br/>ClusterIP 8000/TCP"]
    end

    subgraph Monitoring["MONITORING"]
        Prometheus["Prometheus<br/>Scraper"]
    end

    %% Flows
    Client -->|"HTTP/8081<br/>Inference request"| Envoy
    Envoy -->|"gRPC/9004<br/>Self-signed TLS (RSA-4096)<br/>No app auth"| ExtProc
    Envoy -->|"HTTP/8000<br/>Forward to model"| DeepSeek
    Envoy -->|"HTTP/8000<br/>Forward to model"| Llama
    ExtProc -->|"HTTPS+WSS/6443<br/>TLS 1.2+<br/>ServiceAccount token"| K8sAPI
    Prometheus -->|"HTTP/9090<br/>K8s TokenReview"| Metrics

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef proxy fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef processing fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef modelserving fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef monitoring fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class Envoy proxy
    class ExtProc,Health,Metrics,SecurityCtx processing
    class K8sAPI platform
    class DeepSeek,Llama modelserving
    class Prometheus monitoring
