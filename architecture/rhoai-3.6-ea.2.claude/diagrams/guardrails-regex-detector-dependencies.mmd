graph LR
    GRD[guardrails-regex-detector<br/>Rust Service]

    %% Runtime Framework Dependencies
    GRD -->|"HTTP framework"| Axum[axum 0.7.9]
    GRD -->|"async runtime"| Tokio[tokio 1.41.1]
    GRD -->|"HTTP middleware"| TowerHTTP[tower-http 0.6.2]

    %% Core Logic Dependencies
    GRD -->|"pattern matching"| Regex[regex 1.11.1]
    GRD -->|"JSON serialization"| Serde[serde 1.0.215]
    GRD -->|"JSON parsing"| SerdeJSON[serde_json 1.0.133]

    %% Observability Dependencies
    GRD -->|"structured logging"| Tracing[tracing 0.1.41]
    GRD -->|"log subscriber"| TracingSub[tracing-subscriber 0.3.19]

    %% Platform Dependencies (runtime, not code)
    GRD -.->|"called by"| Orchestrator[Guardrails Orchestrator]
    GRD -.->|"probed by"| K8s[Kubernetes Probes]
    GRD -.->|"TLS/auth provided by"| Mesh[Service Mesh / Gateway]

    %% Container Base
    GRD -.->|"base image"| UBI9[UBI9-minimal]

    style GRD fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff
    style Axum fill:#7ed321,stroke:#333
    style Tokio fill:#7ed321,stroke:#333
    style TowerHTTP fill:#7ed321,stroke:#333
    style Regex fill:#7ed321,stroke:#333
    style Serde fill:#7ed321,stroke:#333
    style SerdeJSON fill:#7ed321,stroke:#333
    style Tracing fill:#7ed321,stroke:#333
    style TracingSub fill:#7ed321,stroke:#333
    style Orchestrator fill:#f5a623,stroke:#333
    style K8s fill:#e8e8e8,stroke:#333
    style Mesh fill:#e8e8e8,stroke:#333
    style UBI9 fill:#999,stroke:#333,color:#fff
