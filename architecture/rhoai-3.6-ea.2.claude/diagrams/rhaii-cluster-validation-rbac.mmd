graph TD
    subgraph "Operator Authentication"
        Kubeconfig["kubeconfig<br/>(user-provided credentials)"]
    end

    subgraph "Controller Permissions (via kubeconfig)"
        ControllerPerms["Administrator Privileges<br/>(full cluster access)"]
    end

    subgraph "Resources Created by Controller"
        NS["Namespace<br/>rhaii-validation"]
        SA_Create["ServiceAccount<br/>rhaii-validator"]
        CR_Create["ClusterRole<br/>rhaii-validator"]
        CRB_Create["ClusterRoleBinding<br/>rhaii-validator"]
        Jobs_Create["Jobs<br/>batch/v1"]
        CM_Create["ConfigMaps<br/>v1"]
    end

    Kubeconfig -->|"authenticates"| ControllerPerms
    ControllerPerms -->|"CREATE/DELETE"| NS
    ControllerPerms -->|"CREATE"| SA_Create
    ControllerPerms -->|"CREATE"| CR_Create
    ControllerPerms -->|"CREATE"| CRB_Create
    ControllerPerms -->|"CREATE/GET/LIST/WATCH/DELETE"| Jobs_Create
    ControllerPerms -->|"CREATE/GET/LIST"| CM_Create

    subgraph "Agent Permissions (Split-Privilege Design)"
        SA["ServiceAccount<br/>rhaii-validator"]
        CRB["ClusterRoleBinding<br/>rhaii-validator"]
        CR["ClusterRole<br/>rhaii-validator"]
    end

    subgraph "ClusterRole Rules"
        EmptyRules["API Groups: (none)<br/>Resources: (none)<br/>Verbs: (none)<br/>--- EMPTY RULES ---"]
    end

    subgraph "SCC Binding"
        SCC["system:openshift:scc:privileged"]
    end

    subgraph "Effective Agent Access"
        HostAccess["/sys/class/infiniband/*<br/>/sys/bus/pci/devices/*<br/>/sys/class/drm/*<br/>nvidia-smi"]
        NoAPIAccess["Kubernetes API: NO ACCESS<br/>(empty ClusterRole rules)"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"defines"| EmptyRules
    CRB -->|"SCC subject"| SCC
    SCC -->|"grants host device access"| HostAccess
    EmptyRules -->|"no K8s permissions"| NoAPIAccess

    style Kubeconfig fill:#4a90e2,stroke:#333,color:#fff
    style ControllerPerms fill:#4a90e2,stroke:#333,color:#fff
    style SA fill:#f5a623,stroke:#333,color:#fff
    style CR fill:#f5a623,stroke:#333,color:#fff
    style CRB fill:#f5a623,stroke:#333,color:#fff
    style EmptyRules fill:#f8cecc,stroke:#b85450
    style SCC fill:#ffe6cc,stroke:#d79b00
    style HostAccess fill:#d5e8d4,stroke:#82b366
    style NoAPIAccess fill:#f8cecc,stroke:#b85450
