graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["User / kubectl"]
    end

    subgraph K8sControl["KUBERNETES CONTROL PLANE"]
        APIServer["kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>RBAC AuthZ"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (redhat-ods-applications)"]
        direction TB

        subgraph ControllerDeploy["odh-model-controller Deployment"]
            direction TB
            Manager["Manager Process<br/>SA: odh-model-controller"]

            WebhookSrv["Webhook Server<br/>9443/TCP TLS<br/>Cert: service-ca<br/>failurePolicy: Fail"]

            MetricsCtrl["Metrics Endpoint<br/>8443/TCP HTTPS<br/>Cert: service-ca<br/>Auth: TokenReview+SSAR"]

            HealthCtrl["Health Probes<br/>8081/TCP HTTP<br/>No Auth"]
        end

        subgraph ServingAPIDeploy["model-serving-api Deployment"]
            direction TB
            ServingAPI["API Server<br/>SA: model-serving-api"]

            GatewaysEP["/api/v1/gateways<br/>8443/TCP TLS<br/>Auth: Bearer → SSAR"]

            SamplesEP["/api/v1/samples/llm-d<br/>8443/TCP TLS<br/>Auth: None"]

            MetricsAPI["Metrics<br/>8080/TCP TLS<br/>Auth: None"]
        end
    end

    subgraph PlatformSvc["PLATFORM SERVICES (Trusted)"]
        direction TB
        OTel["OpenTelemetry Collector<br/>OTLP/gRPC TLS"]
        Prometheus["Prometheus<br/>Scrapes ServiceMonitors"]
        ServiceCA["OpenShift service-ca<br/>Certificate Provisioning"]
    end

    subgraph ManagedCRDs["MANAGED RESOURCES (User Namespaces)"]
        direction TB
        ISVCRes["InferenceService<br/>+ Route, Service, NetworkPolicy<br/>ServiceMonitor, RBAC"]
        GWRes["Gateway + HTTPRoute<br/>EnvoyFilter, AuthPolicy"]
        NIMRes["NIM Account<br/>+ ConfigMap, Secret, Template"]
    end

    %% External flows
    User -->|"HTTPS/6443<br/>TLS 1.2+<br/>kubeconfig"| APIServer

    %% API Server to operator
    APIServer -->|"HTTPS/9443<br/>TLS (service-ca)<br/>Admission Review"| WebhookSrv
    APIServer -.->|"HTTPS/6443<br/>Watch streams (WSS)<br/>SA token"| Manager

    %% Controller to API Server
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| APIServer
    ServingAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token + forwarded Bearer"| APIServer

    %% API to managed resources
    Manager -->|"Creates/Updates"| ISVCRes
    Manager -->|"Creates/Updates"| GWRes
    Manager -->|"Creates/Updates"| NIMRes

    %% Observability
    Manager -.->|"OTLP/gRPC<br/>TLS"| OTel
    ServingAPI -.->|"OTLP/gRPC<br/>TLS"| OTel
    Prometheus -.->|"Scrape :8443<br/>TokenReview Auth"| MetricsCtrl
    Prometheus -.->|"Scrape :8080<br/>TLS only"| MetricsAPI

    %% Certificate provisioning
    ServiceCA -.->|"Provisions certs"| WebhookSrv
    ServiceCA -.->|"Provisions certs"| MetricsCtrl
    ServiceCA -.->|"Provisions certs"| ServingAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef controlplane fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef platform fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef managed fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef webhook fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class APIServer controlplane
    class Manager,ServingAPI,MetricsCtrl,HealthCtrl,GatewaysEP,SamplesEP,MetricsAPI operator
    class WebhookSrv webhook
    class OTel,Prometheus,ServiceCA platform
    class ISVCRes,GWRes,NIMRes managed
