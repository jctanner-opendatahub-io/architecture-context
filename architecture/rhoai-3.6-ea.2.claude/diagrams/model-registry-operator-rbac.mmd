graph TD
    subgraph ServiceAccounts["Service Accounts"]
        SA_Operator["model-registry-operator-<br/>controller-manager"]
        SA_Registry["{registry-name}<br/>(per-registry)"]
        SA_Catalog["model-catalog"]
    end

    subgraph ClusterRoleBindings["ClusterRole Bindings"]
        CRB_Manager["model-registry-operator-<br/>manager-rolebinding"]
        CRB_Metrics["model-registry-operator-<br/>metrics-auth-rolebinding"]
        CRB_AuthDeleg_Reg["{registry-name}-<br/>auth-delegator"]
        CRB_AuthDeleg_Cat["model-catalog-<br/>auth-delegator"]
    end

    subgraph ClusterRoles["ClusterRoles"]
        CR_Manager["model-registry-operator-manager-role<br/><i>Primary operator role</i>"]
        CR_Metrics["model-registry-operator-metrics-auth-role"]
        CR_AuthDeleg["system:auth-delegator"]
        CR_Admin["modelregistry-admin-role"]
        CR_Editor["modelregistry-editor-role"]
        CR_Viewer["modelregistry-viewer-role"]
    end

    subgraph RoleBindings["Role Bindings (Namespace-scoped)"]
        RB_Leader["leader-election-rolebinding<br/><i>operator namespace</i>"]
        RB_Users["{registry-name}-users<br/><i>registry namespace</i>"]
        RB_CatAdmin["model-catalog-admin-binding<br/><i>catalog namespace</i>"]
        RB_CatAuth["model-catalog-authenticated<br/><i>catalog namespace</i>"]
    end

    subgraph Roles["Roles (Namespace-scoped)"]
        R_Leader["leader-election-role<br/>configmaps, leases, events"]
        R_RegUser["registry-user-{registry-name}<br/>endpoints, services: get"]
        R_CatAdmin["model-catalog-admin<br/>configmaps, secrets: get,list,<br/>patch,update,watch"]
        R_CatRole["model-catalog<br/>endpoints, services: get"]
    end

    subgraph Groups["User Groups"]
        G_RegUsers["Group/{registry-name}-users"]
        G_Template["Group/{template-value}"]
        G_Authenticated["Group/system:authenticated"]
    end

    subgraph ManagerResources["Manager Role API Resources"]
        direction LR
        Res_MR["modelregistry.opendatahub.io<br/>modelregistries<br/>modelregistries/finalizers<br/>modelregistries/status<br/><i>full CRUD</i>"]
        Res_Core["core<br/>configmaps, secrets,<br/>services, serviceaccounts,<br/>persistentvolumeclaims<br/><i>full CRUD</i>"]
        Res_Apps["apps<br/>deployments<br/><i>full CRUD</i>"]
        Res_Gateway["gateway.networking.k8s.io<br/>httproutes, referencegrants<br/><i>CRUD</i>"]
        Res_Route["route.openshift.io<br/>routes, routes/custom-host<br/><i>full CRUD</i>"]
        Res_RBAC["rbac.authorization.k8s.io<br/>roles, rolebindings,<br/>clusterrolebindings<br/><i>full CRUD</i>"]
        Res_NetPol["networking.k8s.io<br/>networkpolicies<br/><i>full CRUD</i>"]
        Res_Auth["authentication.k8s.io<br/>tokenreviews: create<br/>authorization.k8s.io<br/>subjectaccessreviews: create"]
        Res_Platform["services.platform.opendatahub.io<br/>auths: get,list,watch<br/>components.platform.opendatahub.io<br/>modelregistries: get,list,watch"]
        Res_Groups["user.openshift.io<br/>groups<br/><i>CRUD + list,watch</i>"]
        Res_Migration["migration.k8s.io<br/>storageversionmigrations<br/><i>full CRUD</i>"]
    end

    %% Operator SA bindings
    SA_Operator -->|bound via| CRB_Manager
    SA_Operator -->|bound via| CRB_Metrics
    SA_Operator -->|bound via| RB_Leader
    CRB_Manager -->|grants| CR_Manager
    CRB_Metrics -->|grants| CR_Metrics

    %% Manager role → resources
    CR_Manager -->|manages| Res_MR
    CR_Manager -->|manages| Res_Core
    CR_Manager -->|manages| Res_Apps
    CR_Manager -->|manages| Res_Gateway
    CR_Manager -->|manages| Res_Route
    CR_Manager -->|manages| Res_RBAC
    CR_Manager -->|manages| Res_NetPol
    CR_Manager -->|manages| Res_Auth
    CR_Manager -->|manages| Res_Platform
    CR_Manager -->|manages| Res_Groups
    CR_Manager -->|manages| Res_Migration

    %% Leader election
    RB_Leader -->|grants| R_Leader

    %% Registry SA bindings
    SA_Registry -->|bound via| CRB_AuthDeleg_Reg
    CRB_AuthDeleg_Reg -->|grants| CR_AuthDeleg

    %% Per-registry user access
    G_RegUsers -->|bound via| RB_Users
    RB_Users -->|grants| R_RegUser

    %% Catalog SA bindings
    SA_Catalog -->|bound via| CRB_AuthDeleg_Cat
    CRB_AuthDeleg_Cat -->|grants| CR_AuthDeleg

    %% Catalog user access
    G_Template -->|bound via| RB_CatAdmin
    RB_CatAdmin -->|grants| R_CatAdmin
    G_Authenticated -->|bound via| RB_CatAuth
    RB_CatAuth -->|grants| R_CatRole

    %% User-facing roles (not bound to operator SA)
    CR_Admin -.->|"grants *"| Res_MR
    CR_Editor -.->|"grants CRUD"| Res_MR
    CR_Viewer -.->|"grants read"| Res_MR

    %% Styling
    style SA_Operator fill:#4a90e2,color:#fff
    style SA_Registry fill:#4a90e2,color:#fff
    style SA_Catalog fill:#4a90e2,color:#fff
    style CR_Manager fill:#f5a623,color:#fff
    style CR_Metrics fill:#f5a623,color:#fff
    style CR_AuthDeleg fill:#f5a623,color:#fff
    style CR_Admin fill:#f5a623,color:#fff
    style CR_Editor fill:#f5a623,color:#fff
    style CR_Viewer fill:#f5a623,color:#fff
    style R_Leader fill:#e8724a,color:#fff
    style R_RegUser fill:#e8724a,color:#fff
    style R_CatAdmin fill:#e8724a,color:#fff
    style R_CatRole fill:#e8724a,color:#fff
    style Res_MR fill:#7ed321,color:#fff
    style Res_Core fill:#7ed321,color:#fff
    style Res_Apps fill:#7ed321,color:#fff
    style Res_Gateway fill:#7ed321,color:#fff
    style Res_Route fill:#7ed321,color:#fff
    style Res_RBAC fill:#7ed321,color:#fff
    style Res_NetPol fill:#7ed321,color:#fff
    style Res_Auth fill:#7ed321,color:#fff
    style Res_Platform fill:#7ed321,color:#fff
    style Res_Groups fill:#7ed321,color:#fff
    style Res_Migration fill:#7ed321,color:#fff
    style G_RegUsers fill:#9b59b6,color:#fff
    style G_Template fill:#9b59b6,color:#fff
    style G_Authenticated fill:#9b59b6,color:#fff
