graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        User["Platform Operator / Browser"]
    end

    subgraph Ingress["INGRESS (OpenShift Routes - TLS Termination)"]
        UIRoute["planner Route<br/>HTTPS → HTTP/8501<br/>TLS edge termination<br/>Auth: None"]
        BackendRoute["planner-backend Route<br/>HTTPS → HTTP/8000<br/>TLS edge termination<br/>Auth: None"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL (Namespace: planner)"]
        direction TB

        subgraph UITier["UI Tier"]
            StreamlitUI["Streamlit UI<br/>Service: ui (ClusterIP)<br/>Port: 8501/TCP<br/>Image: llm-d-planner-ui<br/>Health: /_stcore/health"]
        end

        subgraph BackendTier["Backend Tier"]
            FastAPI["FastAPI Backend<br/>Service: backend (ClusterIP)<br/>Port: 8000/TCP<br/>SA: planner-backend<br/>Image: llm-d-planner-backend<br/>CORS: allow_origins=[*]<br/>39 endpoints under /api/v1/<br/>Health: /health"]
        end

        subgraph LLMTier["LLM Tier"]
            Ollama["Ollama LLM<br/>Service: ollama (ClusterIP)<br/>Port: 11434/TCP<br/>Image: ollama/ollama<br/>Health: /api/tags"]
        end
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        K8sAPI["Kubernetes API<br/>kube-apiserver<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>Auth: SA Token"]
        OpenAI["OpenAI API<br/>api.openai.com<br/>HTTPS<br/>Auth: OPENAI_API_KEY"]
        VertexAI["Vertex AI (Claude)<br/>443/TCP HTTPS<br/>Auth: GCP Credentials"]
        HFHub["HuggingFace Hub<br/>huggingface.co<br/>HTTPS<br/>Auth: HF_TOKEN"]
        ServiceCA["OpenShift Service CA<br/>CA bundle injection"]
    end

    %% External to Ingress
    User -->|"HTTPS<br/>TLS (edge)<br/>Auth: None"| UIRoute
    User -->|"HTTPS<br/>TLS (edge)<br/>Auth: None"| BackendRoute

    %% Ingress to Internal
    UIRoute -->|"HTTP/8501<br/>No encryption<br/>Auth: None"| StreamlitUI
    BackendRoute -->|"HTTP/8000<br/>No encryption<br/>Auth: None"| FastAPI

    %% Internal flows
    StreamlitUI -->|"HTTP/8000<br/>No encryption<br/>Auth: None"| FastAPI
    FastAPI -->|"HTTP/11434<br/>No encryption<br/>Auth: None"| Ollama

    %% Backend to External Services
    FastAPI -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token<br/>nodes: list only"| K8sAPI
    FastAPI -->|"HTTPS<br/>TLS<br/>OPENAI_API_KEY"| OpenAI
    FastAPI -->|"HTTPS/443<br/>TLS<br/>GCP Credentials"| VertexAI
    FastAPI -->|"HTTPS<br/>TLS<br/>HF_TOKEN"| HFHub

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef internal fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef externalservice fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef warning fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class User external
    class UIRoute,BackendRoute ingress
    class StreamlitUI,FastAPI,Ollama internal
    class K8sAPI,OpenAI,VertexAI,HFHub,ServiceCA externalservice
