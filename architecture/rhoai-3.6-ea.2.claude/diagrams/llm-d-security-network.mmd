graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client"]
    end

    subgraph RoutingLayer["ROUTING LAYER"]
        Envoy["Envoy Sidecar Proxy<br/>8081/TCP HTTP<br/>No built-in TLS<br/>Auth: Platform-delegated"]
        EPP["Endpoint Picker Plugin<br/>9002/TCP gRPC ext_proc<br/>No encryption (localhost)<br/>No auth (localhost)"]
    end

    subgraph ModelServing["MODEL SERVING LAYER (No built-in auth)"]
        direction TB

        subgraph DecodePod["Decode Deployment"]
            Decode["vllm API Server<br/>8000/TCP HTTP<br/>No encryption<br/>No auth<br/>Endpoints: /v1/completions,<br/>/v1/chat/completions"]
        end

        subgraph PrefillPod["Prefill Deployment (disaggregated)"]
            Prefill["vllm API Server<br/>8000/TCP HTTP<br/>No encryption<br/>No auth"]
            NixlPort["nixl RDMA Port<br/>5600/TCP<br/>No encryption<br/>BYPASSES MESH"]
        end

        Sidecar["Routing Sidecar<br/>--kv-connector=nixlv2<br/>--secure-proxy=false"]
    end

    subgraph IstioMesh["OPTIONAL: ISTIO MESH (ModelExpress)"]
        PeerAuth["PeerAuthentication<br/>Mode: STRICT<br/>mTLS enforced"]
        AuthzPolicy["AuthorizationPolicy<br/>Port 8001 gRPC<br/>Restrict to decode SA only"]
    end

    subgraph Observability["OBSERVABILITY"]
        OTel["OpenTelemetry Collector<br/>4317/TCP gRPC OTLP<br/>No encryption"]
        Jaeger["Jaeger<br/>jaeger-collector:4317"]
        Prometheus["Prometheus<br/>PodMonitor scraping"]
    end

    %% Request Flow
    Client -->|"HTTP/8081<br/>No TLS (platform-delegated)"| Envoy
    Envoy -->|"gRPC ext_proc/9002<br/>No encryption (localhost)"| EPP
    Envoy -->|"HTTP/8000<br/>ORIGINAL_DST<br/>No encryption"| Decode
    Envoy -->|"HTTP/8000<br/>ORIGINAL_DST<br/>No encryption"| Prefill

    %% KV-Cache Transfer (bypasses mesh)
    Prefill -->|"RDMA/5600<br/>No encryption<br/>BYPASSES MESH"| NixlPort
    NixlPort -->|"KV-cache transfer"| Sidecar
    Sidecar -->|"intercepts 8000<br/>--secure-proxy=false"| Decode

    %% Observability
    Decode -->|"OTLP/4317<br/>gRPC"| OTel
    Prefill -->|"OTLP/4317<br/>gRPC"| OTel
    EPP -->|"OTLP/4317<br/>gRPC"| OTel
    OTel -->|"gRPC/4317"| Jaeger
    Prometheus -.->|"scrape"| Decode
    Prometheus -.->|"scrape"| Prefill

    %% Optional mesh
    PeerAuth -.->|"enforces mTLS"| Prefill
    AuthzPolicy -.->|"restricts port 8001"| Decode

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef routing fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef serving fill:#ffe6cc,stroke:#d79b00,stroke-width:2px
    classDef mesh fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef observability fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef danger fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class Envoy,EPP routing
    class Decode,Prefill,Sidecar serving
    class NixlPort danger
    class PeerAuth,AuthzPolicy mesh
    class OTel,Jaeger,Prometheus observability
