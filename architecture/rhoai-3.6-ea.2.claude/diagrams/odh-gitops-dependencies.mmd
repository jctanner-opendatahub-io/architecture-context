graph LR
    ODHGitOps["odh-gitops<br/><i>GitOps Configuration</i>"]

    %% Scheduling Dependencies (Required)
    ODHGitOps -->|"OLM / Helm"| Kueue["Kueue Operator<br/><i>Job scheduling & quota</i>"]
    ODHGitOps -->|"OLM / Helm"| JobSet["JobSet Operator<br/><i>Multi-pod orchestration</i>"]
    ODHGitOps -->|"OLM / Helm"| LWS["LeaderWorkerSet<br/><i>Distributed workloads</i>"]

    %% Security Dependencies (Required)
    ODHGitOps -->|"OLM / Helm"| CertManager["cert-manager<br/><i>TLS certificate lifecycle</i>"]
    ODHGitOps -->|"OLM / Helm"| RHCL["RHCL Operator<br/>(Kuadrant/Authorino)<br/><i>API gateway & authz</i>"]

    %% Observability Dependencies (Required)
    ODHGitOps -->|"OLM Subscription"| ClusterObs["Cluster Observability<br/>Operator<br/><i>Monitoring & metrics</i>"]
    ODHGitOps -->|"OLM Subscription"| OTel["OpenTelemetry Operator<br/><i>Distributed tracing</i>"]
    ODHGitOps -->|"OLM Subscription"| Tempo["Tempo Operator<br/><i>Trace storage backend</i>"]
    ODHGitOps -->|"OLM Subscription"| CMA["Custom Metrics<br/>Autoscaler<br/><i>HPA custom metrics</i>"]

    %% XKS-only Dependencies
    ODHGitOps -.->|"Helm (XKS only)"| Sail["Sail Operator<br/>(Istio)<br/><i>Service mesh</i>"]
    ODHGitOps -.->|"Helm (XKS only)"| GatewayAPI["Gateway API CRDs<br/><i>Ingress resources</i>"]

    %% Optional Dependencies
    ODHGitOps -.->|"OLM (Optional)"| NFD["Node Feature Discovery<br/><i>GPU/accelerator detection</i>"]
    ODHGitOps -.->|"OLM (Optional)"| NVIDIA["NVIDIA GPU Operator<br/><i>GPU device plugin & drivers</i>"]

    %% Upstream source
    Upstream["opendatahub-io/odh-gitops<br/><i>Upstream source</i>"] -->|"auto-merge sync"| ODHGitOps

    %% Styling
    style ODHGitOps fill:#4a90e2,stroke:#333,stroke-width:4px,color:#fff

    %% Required scheduling
    style Kueue fill:#d5e8d4,stroke:#82b366
    style JobSet fill:#d5e8d4,stroke:#82b366
    style LWS fill:#d5e8d4,stroke:#82b366

    %% Required security
    style CertManager fill:#dae8fc,stroke:#6c8ebf
    style RHCL fill:#dae8fc,stroke:#6c8ebf

    %% Required observability
    style ClusterObs fill:#fff2cc,stroke:#d6b656
    style OTel fill:#fff2cc,stroke:#d6b656
    style Tempo fill:#fff2cc,stroke:#d6b656
    style CMA fill:#fff2cc,stroke:#d6b656

    %% XKS-only
    style Sail fill:#e1d5e7,stroke:#9673a6
    style GatewayAPI fill:#e1d5e7,stroke:#9673a6

    %% Optional
    style NFD fill:#f8cecc,stroke:#b85450
    style NVIDIA fill:#f8cecc,stroke:#b85450

    %% Upstream
    style Upstream fill:#999,stroke:#333,color:#fff
