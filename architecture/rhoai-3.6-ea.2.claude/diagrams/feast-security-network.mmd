graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / Data Scientist"]
    end

    subgraph DataPlane["FEATURE SERVING (Data Plane)"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            PythonServer["Python Feature Server<br/>FastAPI :6566/TCP<br/>Auth: Configurable<br/>(K8s RBAC / OIDC / noAuth)"]
            GoServer["Go Feature Server<br/>HTTP + gRPC<br/>Auth: NONE<br/>(no interceptors)"]
            RegistryServer["Registry Server<br/>gRPC + REST :6566/TCP<br/>48 RPCs"]
        end
    end

    subgraph ControlPlane["OPERATOR CONTROL PLANE"]
        direction TB

        subgraph NS_Operator["Namespace: feast-operator-system"]
            Operator["feast-operator-controller-manager<br/>SA: feast-operator-controller-manager<br/>Leader election: single replica<br/>FIPS: strictfipsruntime + UBI9-pqc"]
            Metrics["Metrics Endpoint<br/>:8443/TCP TLS<br/>TokenReview + SAR"]
            HealthProbes["Health Probes<br/>:8081/TCP<br/>No auth (by design)"]
        end
    end

    subgraph OnlineStores["ONLINE STORE BACKENDS"]
        PostgreSQL["PostgreSQL<br/>:5432/TCP<br/>DB credentials"]
        Redis["Redis / Valkey<br/>:6379/TCP<br/>AUTH / ACL"]
    end

    subgraph PlatformServices["PLATFORM SERVICES"]
        K8sAPI["Kubernetes API<br/>:6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount token"]
        Prometheus["Prometheus<br/>(via ServiceMonitor)"]
        OpenShiftConfig["OpenShift APIServer Config<br/>TLS profile bootstrap"]
    end

    subgraph ExternalServices["EXTERNAL SERVICES"]
        S3["S3-compatible Storage<br/>:443/TCP HTTPS<br/>AWS IAM credentials"]
        GCS["Google Cloud Storage<br/>:443/TCP HTTPS<br/>GCP credentials"]
    end

    %% Client to Feature Serving
    Client -->|"HTTP/HTTPS :6566<br/>Bearer Token (configurable)<br/>K8s RBAC or OIDC"| PythonServer
    Client -->|"HTTP/gRPC<br/>No auth enforcement"| GoServer

    %% Feature Serving to Online Stores
    PythonServer -->|"TCP :5432<br/>DB credentials"| PostgreSQL
    PythonServer -->|"TCP :6379<br/>Redis AUTH"| Redis
    GoServer -->|"TCP :5432<br/>pgx driver"| PostgreSQL
    GoServer -->|"TCP :6379<br/>go-redis"| Redis

    %% Registry to Backends
    RegistryServer -->|"HTTPS :443<br/>AWS IAM"| S3
    RegistryServer -->|"HTTPS :443<br/>GCP creds"| GCS

    %% Operator to K8s API
    Operator -->|"HTTPS :6443<br/>TLS 1.2+<br/>SA token (in-cluster)"| K8sAPI

    %% Operator TLS bootstrap
    Operator -.->|"Read TLS profile"| OpenShiftConfig

    %% Prometheus scraping
    Prometheus -->|"HTTPS :8443<br/>TLS + TokenReview + SAR"| Metrics
    Prometheus -->|"HTTP /metrics"| GoServer

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef dataplane fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef onlinestore fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef externalservice fill:#f8cecc,stroke:#b85450,stroke-width:2px

    class Client external
    class PythonServer,GoServer,RegistryServer dataplane
    class Operator,Metrics,HealthProbes controlplane
    class PostgreSQL,Redis onlinestore
    class K8sAPI,Prometheus,OpenShiftConfig platform
    class S3,GCS externalservice
