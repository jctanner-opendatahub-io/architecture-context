graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["External Client / User"]
    end

    subgraph Ingress["INGRESS (No TLS)"]
        Route["OpenShift Route: trustyai<br/>HTTP (TLS not configured)<br/>No app-level auth"]
    end

    subgraph ClusterInternal["CLUSTER INTERNAL"]
        direction TB

        subgraph NS_User["Namespace: {user-namespace}"]
            SvcIP["trustyai-service<br/>ClusterIP 80/TCP → 8080/TCP"]

            subgraph Pod["trustyai-service Pod<br/>SA: trustyai-serviceaccount"]
                App["Quarkus 3.8 Native App<br/>Port 8080/TCP HTTP (exposed)<br/>Port 4443/TCP HTTPS (internal, not exposed)"]
                InitContainer["Init Container<br/>register-consumer"]
            end
        end

        subgraph Inbound["INBOUND INTEGRATIONS"]
            KServe["KServe/ModelMesh<br/>Model Servers"]
            Prometheus["Prometheus"]
        end

        K8sAPI["Kubernetes API Server<br/>443/TCP HTTPS"]
    end

    subgraph Storage["STORAGE BACKENDS"]
        PVC["PVC: /inputs<br/>(default, filesystem)"]
        MariaDB["MariaDB/MySQL<br/>(optional, JDBC)<br/>QUARKUS_HIBERNATE_ORM_ACTIVE"]
    end

    subgraph Disabled["OUTBOUND (Disabled in RHOAI)"]
        KServeInference["KServe Inference Services<br/>gRPC (explainer callbacks)<br/>DISABLED in RHOAI profile"]
    end

    %% External flow
    Client -->|"HTTP/80<br/>No TLS<br/>No Auth"| Route
    Route -->|"HTTP/80 → 8080<br/>No encryption"| SvcIP
    SvcIP --> App

    %% Inbound integrations
    KServe -->|"HTTP/8080<br/>POST /consumer/kserve/v2<br/>No Auth"| App
    Prometheus -->|"HTTP/8080<br/>GET /q/metrics<br/>No Auth"| App

    %% Init container
    InitContainer -->|"HTTPS/443<br/>SA Token<br/>ConfigMap CRUD"| K8sAPI

    %% Storage
    App -->|"Filesystem mount<br/>/inputs"| PVC
    App -.->|"JDBC<br/>(if enabled)"| MariaDB

    %% Disabled outbound
    App -.->|"gRPC (DISABLED)<br/>Explainer callbacks"| KServeInference

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef ingress fill:#ffcccc,stroke:#cc0000,stroke-width:2px
    classDef cluster fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef storage fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef disabled fill:#e0e0e0,stroke:#999,stroke-width:1px,stroke-dasharray: 5 5
    classDef warning fill:#ff6666,stroke:#cc0000,stroke-width:2px

    class Client external
    class Route ingress
    class SvcIP,App,InitContainer cluster
    class KServe,Prometheus,K8sAPI cluster
    class PVC,MariaDB storage
    class KServeInference disabled
