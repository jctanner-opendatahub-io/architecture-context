graph TD
    subgraph "Application-Level Security"
        Note["fms-guardrails-orchestrator is an application service,<br/>not a Kubernetes operator.<br/>No ClusterRoles or RoleBindings are defined."]
    end

    subgraph "Authentication Model"
        direction TB
        HeaderPassthrough["Header Passthrough<br/>(Application-level)"]
        TokenRewrite["X-Forwarded-Access-Token<br/>→ Authorization: Bearer"]
        TLSAuth["TLS / mTLS<br/>(Transport-level, optional)"]
        NoAuth["No Auth<br/>(Health endpoints)"]
    end

    subgraph "Endpoint Authorization"
        APIv1["/api/v1/* (POST)"]
        APIv2["/api/v2/* (POST)"]
        Health["/health (GET)"]
        Info["/info (GET)"]
    end

    subgraph "Secrets (Provisioned by Platform Operator)"
        TLSCert["TLS server cert/key<br/>kubernetes.io/tls"]
        ClientCA["TLS client CA cert<br/>Opaque"]
        APITokens["API tokens<br/>Opaque (env var)"]
        DownstreamTLS["Downstream TLS certs<br/>Opaque"]
    end

    HeaderPassthrough -->|"forwards headers"| APIv1
    HeaderPassthrough -->|"forwards headers"| APIv2
    TokenRewrite -->|"rewrites token"| APIv1
    TokenRewrite -->|"rewrites token"| APIv2
    TLSAuth -->|"optional mTLS"| APIv1
    TLSAuth -->|"optional mTLS"| APIv2
    NoAuth -->|"unauthenticated"| Health
    NoAuth -->|"unauthenticated"| Info

    TLSCert -.->|"configures"| TLSAuth
    ClientCA -.->|"configures"| TLSAuth
    APITokens -.->|"configures"| HeaderPassthrough
    DownstreamTLS -.->|"configures"| HeaderPassthrough

    style Note fill:#fff3cd,stroke:#856404,color:#856404
    style HeaderPassthrough fill:#f5a623,stroke:#333
    style TokenRewrite fill:#f5a623,stroke:#333
    style TLSAuth fill:#b85450,stroke:#333,color:#fff
    style NoAuth fill:#82b366,stroke:#333
    style APIv1 fill:#4a90e2,stroke:#333,color:#fff
    style APIv2 fill:#4a90e2,stroke:#333,color:#fff
    style Health fill:#82b366,stroke:#333
    style Info fill:#82b366,stroke:#333
    style TLSCert fill:#e8e8e8,stroke:#333
    style ClientCA fill:#e8e8e8,stroke:#333
    style APITokens fill:#e8e8e8,stroke:#333
    style DownstreamTLS fill:#e8e8e8,stroke:#333
