graph TB
    subgraph ControlPlane["CONTROL PLANE"]
        K8sAPI["Kubernetes API Server<br/>6443/TCP<br/>HTTPS/WSS<br/>TLS 1.2+<br/>SA Token Auth"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE (workbenches-operator-system)"]
        direction TB

        subgraph Manager["workbenches-operator-controller-manager<br/>SA: workbenches-operator-controller-manager<br/>Image: ubi9/ubi-minimal-pqc<br/>FIPS: strictfipsruntime"]
            direction TB

            WebhookPort["Webhook Server<br/>9443/TCP<br/>HTTPS / TLS 1.2+<br/>OpenShift TLS Profile<br/>service-ca cert"]
            HealthPort["Health Probes<br/>8081/TCP<br/>HTTP / Plaintext<br/>Unauthenticated"]
            MetricsPort["Metrics<br/>8443/TCP<br/>HTTPS / TLS<br/>TokenReview + SAR"]
        end

        WebhookSvc["workbenches-operator-webhook-service<br/>ClusterIP<br/>443/TCP → 9443/TCP"]
    end

    subgraph CertProviders["CERTIFICATE PROVIDERS"]
        ServiceCA["OpenShift service-ca<br/>(Primary)"]
        CertMgr["cert-manager<br/>(Fallback)"]
    end

    subgraph PlatformIntegration["PLATFORM INTEGRATION"]
        Orchestrator["Platform Orchestrator"]
        ConfigMap["odh-workbenches-config<br/>ConfigMap<br/>distribution, version"]
        WorkbenchesCR["Workbenches CR<br/>Cluster-scoped<br/>gatewayDomain, mlflowEnabled"]
    end

    subgraph ManagedOperands["MANAGED OPERANDS"]
        NotebookCtrl["Kubeflow Notebook Controller<br/>Deployment"]
        HardwareProfile["HardwareProfile CRs<br/>infrastructure.opendatahub.io"]
        NotebookCRs["Notebook CRs<br/>kubeflow.org"]
    end

    subgraph Monitoring["MONITORING"]
        Kubelet["Kubelet Probes"]
        Prometheus["Prometheus"]
    end

    %% Admission flow
    K8sAPI -->|"HTTPS/443<br/>TLS (service-ca)<br/>Admission Request"| WebhookSvc
    WebhookSvc -->|"TCP/9443"| WebhookPort

    %% Controller to API
    Manager -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA Token"| K8sAPI

    %% Certificate provisioning
    ServiceCA -.->|"Provisions<br/>webhook-cert Secret"| WebhookPort
    CertMgr -.->|"Fallback<br/>Certificate CR"| WebhookPort

    %% Platform coordination
    Orchestrator -->|"Creates/Updates"| WorkbenchesCR
    Orchestrator -->|"Writes"| ConfigMap
    ConfigMap -->|"Watched by<br/>(namespace-scoped)"| Manager
    WorkbenchesCR -->|"Watched by<br/>(generation predicate)"| Manager

    %% Managed operands
    Manager -->|"Server-side Apply<br/>via K8s API"| NotebookCtrl
    WebhookPort -->|"GET<br/>HardwareProfile"| HardwareProfile
    WebhookPort -->|"Mutates<br/>notebooks"| NotebookCRs

    %% Health & Metrics
    Kubelet -->|"HTTP/8081<br/>Plaintext<br/>No Auth"| HealthPort
    Prometheus -->|"HTTPS/8443<br/>TLS<br/>TokenReview+SAR"| MetricsPort

    %% Styling
    classDef controlplane fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef operator fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef certprovider fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef operand fill:#f8cecc,stroke:#b85450,stroke-width:2px
    classDef monitoring fill:#f5f5f5,stroke:#666,stroke-width:1px

    class K8sAPI controlplane
    class Manager,WebhookPort,HealthPort,MetricsPort,WebhookSvc operator
    class ServiceCA,CertMgr certprovider
    class Orchestrator,ConfigMap,WorkbenchesCR platform
    class NotebookCtrl,HardwareProfile,NotebookCRs operand
    class Kubelet,Prometheus monitoring
