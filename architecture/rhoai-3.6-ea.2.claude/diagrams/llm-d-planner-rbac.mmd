graph TD
    subgraph "Service Account"
        SA["planner-backend<br/>Namespace: planner"]
    end

    subgraph "ClusterRole Bindings"
        CRB["planner-gpu-reader<br/>(ClusterRoleBinding)<br/>Namespace: planner"]
    end

    subgraph "ClusterRole Permissions"
        CR["planner-gpu-reader<br/>(ClusterRole)"]
    end

    subgraph "API Resources"
        Nodes["core (v1)<br/>nodes"]
    end

    subgraph "Application-Level Auth"
        direction TB
        NoAuth["General API Surface<br/>/api/v1/*<br/>⚠ No Authentication"]
        HMACAuth["Database Admin API<br/>/db/upload-benchmarks<br/>/db/reset<br/>/db/verify-admin<br/>HMAC Password<br/>(X-Admin-Password header)"]
        CORSPolicy["CORS Policy<br/>allow_origins=[*]<br/>⚠ Fully Permissive"]
    end

    subgraph "Secrets (Credentials)"
        PlannerSecrets["planner-secrets (Opaque)"]
        OpenAIKey["OPENAI_API_KEY"]
        AAKey["AA_API_KEY<br/>(Anthropic)"]
        HFToken["HF_TOKEN<br/>(HuggingFace)"]
        CatalogToken["MODEL_CATALOG_TOKEN"]
        DBPassword["DB_ADMIN_PASSWORD<br/>(Optional HMAC)"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"list"| Nodes

    SA -->|"uses"| PlannerSecrets
    PlannerSecrets --> OpenAIKey
    PlannerSecrets --> AAKey
    PlannerSecrets --> HFToken
    PlannerSecrets --> CatalogToken
    PlannerSecrets --> DBPassword

    DBPassword -->|"enables"| HMACAuth

    style SA fill:#4a90e2,stroke:#333,color:#fff
    style CRB fill:#b8d4f0,stroke:#333
    style CR fill:#f5a623,stroke:#333
    style Nodes fill:#7ed321,stroke:#333
    style NoAuth fill:#f8cecc,stroke:#b85450
    style CORSPolicy fill:#f8cecc,stroke:#b85450
    style HMACAuth fill:#fff2cc,stroke:#d6b656
    style PlannerSecrets fill:#e1d5e7,stroke:#9673a6
    style OpenAIKey fill:#e1d5e7,stroke:#9673a6
    style AAKey fill:#e1d5e7,stroke:#9673a6
    style HFToken fill:#e1d5e7,stroke:#9673a6
    style CatalogToken fill:#e1d5e7,stroke:#9673a6
    style DBPassword fill:#e1d5e7,stroke:#9673a6
