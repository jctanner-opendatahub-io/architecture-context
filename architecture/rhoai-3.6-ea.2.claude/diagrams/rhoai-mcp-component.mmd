graph TB
    subgraph "rhoai-mcp Server"
        direction TB
        Entrypoint["rhoai-mcp Entrypoint<br/>(Python console script)"]
        FastMCP["FastMCP Server"]
        PluginSystem["Pluggy Plugin System"]
        OIDCMiddleware["OIDCAuthMiddleware<br/>(JWT / TokenReview)"]
        WorkflowTokens["Workflow Token Manager<br/>(HMAC-SHA256 signed)"]

        subgraph "Transport Layer"
            Stdio["stdio Transport"]
            SSE["SSE Transport"]
            StreamableHTTP["streamable-http Transport"]
        end

        subgraph "Plugins"
            NotebooksPlugin["Notebooks Plugin<br/>(kubeflow.org)"]
            ModelServingPlugin["Model Serving Plugin<br/>(KServe)"]
            PipelinesPlugin["Pipelines Plugin<br/>(DSP)"]
            TrainingPlugin["Training Plugin<br/>(Kubeflow Training)"]
            ModelRegistryPlugin["Model Registry Plugin"]
        end

        Entrypoint --> FastMCP
        FastMCP --> PluginSystem
        PluginSystem --> NotebooksPlugin
        PluginSystem --> ModelServingPlugin
        PluginSystem --> PipelinesPlugin
        PluginSystem --> TrainingPlugin
        PluginSystem --> ModelRegistryPlugin
        FastMCP --> Stdio
        FastMCP --> SSE
        FastMCP --> StreamableHTTP
        SSE --> OIDCMiddleware
        StreamableHTTP --> OIDCMiddleware
        FastMCP --> WorkflowTokens
    end

    subgraph "External Clients"
        Agent["AI Agent<br/>(e.g., Claude Desktop)"]
    end

    subgraph "Kubernetes API Server"
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS"]
    end

    subgraph "Kubernetes CRDs"
        NotebookCR["Notebook CR<br/>(kubeflow.org)"]
        InferenceServiceCR["InferenceService CR<br/>(serving.kserve.io)"]
        ServingRuntimeCR["ServingRuntime CR<br/>(serving.kserve.io)"]
        TrainJobCR["TrainJob CR<br/>(trainer.kubeflow.org)"]
        TrainingRuntimeCR["TrainingRuntime CR<br/>(trainer.kubeflow.org)"]
        DSPCR["DataSciencePipelinesApplication CR<br/>(opendatahub.io)"]
    end

    subgraph "Platform Services"
        ModelRegistry["Model Registry<br/>8080/TCP HTTP"]
        PlannerBackend["Planner Backend<br/>8000/TCP HTTP"]
    end

    Agent -->|"MCP Protocol<br/>(stdio/SSE/streamable-http)"| FastMCP
    NotebooksPlugin -->|CRUD| NotebookCR
    ModelServingPlugin -->|Watch/CRUD| InferenceServiceCR
    ModelServingPlugin -->|CRUD| ServingRuntimeCR
    PipelinesPlugin -->|CRUD| DSPCR
    TrainingPlugin -->|CRUD| TrainJobCR
    TrainingPlugin -->|Watch| TrainingRuntimeCR
    ModelRegistryPlugin -->|HTTP| ModelRegistry
    FastMCP -->|"API calls"| K8sAPI
    FastMCP -->|HTTP| PlannerBackend

    K8sAPI -.->|manages| NotebookCR
    K8sAPI -.->|manages| InferenceServiceCR
    K8sAPI -.->|manages| ServingRuntimeCR
    K8sAPI -.->|manages| TrainJobCR
    K8sAPI -.->|manages| TrainingRuntimeCR
    K8sAPI -.->|manages| DSPCR

