graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Client["Data Scientist / Client"]
    end

    subgraph DSPAStack["DSPA SERVICE STACK (Per-Namespace)"]
        direction TB

        OAuthProxy["OAuth Proxy<br/>8443/TCP HTTPS<br/>TLS (service-serving cert)<br/>OpenShift OAuth"]
        APIServer["DS Pipeline API Server<br/>8888/TCP HTTP REST<br/>8887/TCP gRPC"]
        MariaDB["MariaDB<br/>3306/TCP<br/>Optional PodToPodTLS"]
        MinIOSvc["MinIO<br/>9000/TCP HTTP<br/>S3 credentials"]
        ArgoWFC["Argo Workflow Controller<br/>metrics: 9090/TCP"]
    end

    subgraph OperatorNS["OPERATOR NAMESPACE"]
        direction TB

        ControllerMgr["controller-manager<br/>SA: controller-manager"]
        WebhookSrv["Webhook Server<br/>9443/TCP TLS<br/>OpenShift TLS profile"]
        MetricsSrv["Metrics Server<br/>8080/TCP TLS<br/>OpenShift TLS profile"]
        HealthSrv["Health Probes<br/>8081/TCP<br/>No auth"]
    end

    subgraph ClusterServices["CLUSTER SERVICES"]
        K8sAPI["Kubernetes API<br/>6443/TCP HTTPS<br/>TLS 1.2+<br/>ServiceAccount RBAC"]
        OSAPIServer["OpenShift APIServer<br/>config.openshift.io<br/>TLS profile source"]
        PromOperator["prometheus-operator<br/>ServiceMonitor CRUD"]
    end

    subgraph PlatformDeps["INTERNAL PLATFORM DEPENDENCIES"]
        MLflow["MLflow CR<br/>mlflow.opendatahub.io<br/>Direct API read"]
        KServe["KServe InferenceService<br/>serving.kserve.io<br/>CRD Watch"]
        KubeflowNB["Kubeflow Notebooks<br/>kubeflow.org<br/>CRD CRUD"]
    end

    %% External flows
    Client -->|"HTTPS/8443<br/>TLS (service-serving cert)<br/>OpenShift OAuth"| OAuthProxy

    %% DSPA internal flows
    OAuthProxy -->|"HTTP/8888<br/>No encryption (internal)"| APIServer
    APIServer -->|"MySQL/3306<br/>Optional PodToPodTLS"| MariaDB
    APIServer -->|"HTTP/9000<br/>S3 credentials"| MinIOSvc
    APIServer -->|"submits workflows"| ArgoWFC

    %% Operator to cluster
    ControllerMgr -->|"HTTPS/6443<br/>TLS 1.2+<br/>SA token"| K8sAPI
    ControllerMgr -->|"reads TLS profile"| OSAPIServer
    ControllerMgr -->|"manages ServiceMonitors"| PromOperator

    %% Operator to platform deps
    ControllerMgr -->|"Direct API read<br/>(bypasses cache)"| MLflow
    ControllerMgr -->|"CRD Watch<br/>HTTPS TLS 1.2+"| KServe
    ControllerMgr -->|"CRD CRUD<br/>HTTPS TLS 1.2+"| KubeflowNB

    %% Webhook
    K8sAPI -->|"POST/9443<br/>TLS (OpenShift profile)"| WebhookSrv

    %% Argo to K8s
    ArgoWFC -->|"HTTPS/6443<br/>Create workflow pods"| K8sAPI

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef dspa fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef operator fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef cluster fill:#fff2cc,stroke:#d6b656,stroke-width:2px
    classDef platform fill:#e1d5e7,stroke:#9673a6,stroke-width:2px

    class Client external
    class OAuthProxy,APIServer,MariaDB,MinIOSvc,ArgoWFC dspa
    class ControllerMgr,WebhookSrv,MetricsSrv,HealthSrv operator
    class K8sAPI,OSAPIServer,PromOperator cluster
    class MLflow,KServe,KubeflowNB platform
