graph TD
    subgraph Note["RBAC Configuration"]
        direction TB
        Info["No ClusterRoles or RoleBindings<br/>are defined in this repository.<br/><br/>RBAC is managed by the deploying operator<br/>(llm-d operator or RHOAI platform operator)."]
    end

    subgraph ExpectedPermissions["Expected Runtime Permissions"]
        direction TB

        subgraph WatchResources["Controller Watch Resources (Expected)"]
            Pods["core/v1<br/>Pods"]
            InferencePool["inference.networking.k8s.io/v1<br/>InferencePool"]
            EPC["llm-d.ai/v1alpha1<br/>EndpointPickerConfig"]
            IMR["llm-d.ai/v1alpha2<br/>InferenceModelRewrite"]
            IO["llm-d.ai/v1alpha2<br/>InferenceObjective"]
        end

        subgraph Verbs["Expected Verbs"]
            ReadVerbs["get, list, watch"]
        end

        Pods --- ReadVerbs
        InferencePool --- ReadVerbs
        EPC --- ReadVerbs
        IMR --- ReadVerbs
        IO --- ReadVerbs
    end

    subgraph Auth["Authentication Endpoints"]
        direction TB
        ExtProcAuth["ExternalProcessor gRPC<br/>Auth: None<br/>(transport TLS only)"]
        HealthAuth["Health gRPC<br/>Auth: None<br/>(transport TLS only)"]
        MetricsAuth["Metrics HTTP<br/>Auth: Optional mTLS<br/>(--metrics-endpoint-auth)"]
        K8sAuth["Kubernetes API<br/>Auth: ServiceAccount<br/>(kubeconfig credential chain)"]
    end

    %% Styles
    style Info fill:#fff3cd,stroke:#856404,stroke-width:2px,color:#856404
    style Pods fill:#7ed321,color:#fff
    style InferencePool fill:#7ed321,color:#fff
    style EPC fill:#7ed321,color:#fff
    style IMR fill:#7ed321,color:#fff
    style IO fill:#7ed321,color:#fff
    style ReadVerbs fill:#4a90e2,color:#fff
    style ExtProcAuth fill:#f8d7da,stroke:#721c24,color:#721c24
    style HealthAuth fill:#f8d7da,stroke:#721c24,color:#721c24
    style MetricsAuth fill:#fff3cd,stroke:#856404,color:#856404
    style K8sAuth fill:#d4edda,stroke:#155724,color:#155724
