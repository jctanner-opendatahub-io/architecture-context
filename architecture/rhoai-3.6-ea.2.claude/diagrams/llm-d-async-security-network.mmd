graph TB
    subgraph External["EXTERNAL (Untrusted)"]
        Producers["Message Queue<br/>Producers"]
        RedisExt["Redis Server<br/>:6379/TCP<br/>Configurable TLS<br/>URL credentials"]
        GCPPubSub["GCP Pub/Sub<br/>pubsub.googleapis.com<br/>:443/gRPC TLS<br/>GCP IAM / ADC"]
    end

    subgraph Workload["WORKLOAD (llm-d-async Pod)<br/>FIPS: strictfipsruntime + CGO"]
        direction TB

        subgraph HealthPort["Port 8081 - Health Server"]
            Healthz["/healthz, /readyz<br/>HTTP/1.1 plaintext<br/>Auth: None (kubelet only)"]
        end

        subgraph MetricsPort["Port 9090 - Metrics Server"]
            Metrics["/metrics<br/>HTTP/1.1 plaintext<br/>Auth: K8s bearer token<br/>(controller-runtime)"]
        end

        subgraph Core["Async Processor Core"]
            Transport["Transport Layer<br/>(pipeline.Flow)"]
            MergePolicy["Merge Policy<br/>(random-robin)"]
            Workers["Worker Pool<br/>(configurable concurrency)"]
            FlowGate["Flow-Control Gate"]
            HTTPClient["HTTP Client<br/>(OTel-instrumented)"]
        end
    end

    subgraph ClusterInternal["CLUSTER-INTERNAL"]
        K8sAPI["Kubernetes API<br/>:6443/HTTPS<br/>TLS 1.2+<br/>ServiceAccount"]
        InferenceGW["Inference Gateway<br/>(Model Server)<br/>Configurable port<br/>Optional mTLS TLS 1.2+"]
        Prometheus["Prometheus<br/>:9090/HTTP"]
        OTelCollector["OTel Collector<br/>:4317/gRPC OTLP"]
        Kubelet["Kubelet"]
        PromScraper["Prometheus Scraper"]
    end

    %% Inbound flows
    Kubelet -->|"HTTP/8081<br/>plaintext<br/>No auth"| Healthz
    PromScraper -->|"HTTP/9090<br/>plaintext<br/>Bearer token"| Metrics

    %% Auth delegation
    Metrics -->|"HTTPS/6443<br/>TLS 1.2+<br/>Token validation"| K8sAPI

    %% Transport flows
    Transport -->|"TCP/6379<br/>Configurable TLS<br/>URL credentials"| RedisExt
    Transport -->|"gRPC/443<br/>TLS<br/>GCP IAM"| GCPPubSub

    %% Inference dispatch
    HTTPClient -->|"HTTP(S)/configurable<br/>Optional mTLS TLS 1.2+<br/>Client certificate"| InferenceGW

    %% Flow control
    FlowGate -->|"HTTP/9090<br/>Metric queries"| Prometheus

    %% Observability
    Workers -->|"gRPC/4317<br/>OTLP traces"| OTelCollector

    %% K8s API for controller-runtime
    Core -->|"HTTPS/6443<br/>TLS 1.2+<br/>ServiceAccount"| K8sAPI

    %% Internal flow
    Transport --> MergePolicy
    MergePolicy --> Workers
    Workers --> FlowGate
    Workers --> HTTPClient

    %% Styling
    classDef external fill:#f9f9f9,stroke:#999,stroke-width:2px
    classDef workload fill:#d5e8d4,stroke:#82b366,stroke-width:2px
    classDef cluster fill:#dae8fc,stroke:#6c8ebf,stroke-width:2px
    classDef health fill:#e1d5e7,stroke:#9673a6,stroke-width:2px
    classDef metrics fill:#fff2cc,stroke:#d6b656,stroke-width:2px

    class Producers,RedisExt,GCPPubSub external
    class Transport,MergePolicy,Workers,FlowGate,HTTPClient workload
    class K8sAPI,InferenceGW,Prometheus,OTelCollector,Kubelet,PromScraper cluster
    class Healthz health
    class Metrics metrics
