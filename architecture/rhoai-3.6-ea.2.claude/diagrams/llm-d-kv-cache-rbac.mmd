graph TD
    subgraph "Pod Reconciler RBAC"
        SA["ServiceAccount<br/>(configured per deployment)"]
        CRB["RoleBinding / ClusterRoleBinding<br/>(defined in kustomize deploy/)"]
        CR["Role / ClusterRole<br/>(defined in kustomize deploy/)"]
    end

    subgraph "Required API Resources"
        Pods["/v1/Pod<br/>core API group"]
    end

    subgraph "Authentication & Authorization"
        direction TB

        HTTP_Auth["HTTP Scoring API<br/>:8080/TCP"]
        GRPC_Auth["gRPC IndexerService"]
        K8s_Auth["Kubernetes API<br/>:6443/TCP"]
    end

    SA -->|"bound via"| CRB
    CRB -->|"grants"| CR
    CR -->|"get, list, watch"| Pods

    %% Auth details
    HTTP_Auth -.-|"NO AUTH<br/>Relies on network isolation"| NoAuth1["No Enforcement Point"]
    GRPC_Auth -.-|"NO AUTH<br/>Relies on network isolation"| NoAuth2["No Enforcement Point"]
    K8s_Auth -->|"ServiceAccount token<br/>kube-apiserver enforced"| RBAC_Enforced["RBAC Enforced"]

    %% Notes
    Note1["Note: kustomize deploy/ defines RBAC<br/>but referenced resource files are<br/>incomplete in analyzed checkout"]

    %% Styling
    style SA fill:#4a90e2,color:#fff
    style CR fill:#f5a623,color:#fff
    style CRB fill:#f5a623,color:#fff
    style Pods fill:#7ed321,color:#fff
    style HTTP_Auth fill:#ffcccc,stroke:#cc0000
    style GRPC_Auth fill:#ffcccc,stroke:#cc0000
    style K8s_Auth fill:#d5e8d4,stroke:#82b366
    style NoAuth1 fill:#ffcccc,stroke:#cc0000
    style NoAuth2 fill:#ffcccc,stroke:#cc0000
    style RBAC_Enforced fill:#d5e8d4,stroke:#82b366
    style Note1 fill:#fff2cc,stroke:#d6b656
