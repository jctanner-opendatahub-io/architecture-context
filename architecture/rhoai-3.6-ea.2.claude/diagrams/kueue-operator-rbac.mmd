graph TD
    subgraph "Service Accounts"
        SA_Operator["SA: openshift-kueue-operator<br/>NS: openshift-kueue-operator"]
        SA_Controller["SA: kueue-controller-manager<br/>NS: kueue-system"]
        SA_Prometheus["SA: prometheus-k8s<br/>NS: system"]
    end

    subgraph "ClusterRole Bindings"
        CRB_Operator["openshift-kueue-operator<br/>(ClusterRoleBinding)"]
        CRB_Manager["kueue-manager-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Metrics["kueue-metrics-auth-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_Proxy["kueue-proxy-rolebinding<br/>(ClusterRoleBinding)"]
        CRB_MetricsReader["kueue-metrics-rolebinding<br/>(ClusterRoleBinding)"]
        RB_Leader["kueue-leader-election-rolebinding<br/>(RoleBinding, NS: kueue-system)"]
        RB_Visibility["kueue-visibility-server-auth-reader<br/>(RoleBinding, NS: kube-system)"]
        RB_Network["openshift-kueue-operator-networking<br/>(RoleBinding, NS: openshift-kueue-operator)"]
    end

    subgraph "Operator ClusterRole"
        CR_Operator["openshift-kueue-operator<br/>(ClusterRole)"]

        subgraph "Operator Resources"
            OP_Kueue["kueue.openshift.io<br/>kueues, kueues/finalizers,<br/>kueues/status<br/>full CRUD"]
            OP_CRDs["apiextensions.k8s.io<br/>customresourcedefinitions<br/>full CRUD"]
            OP_RBAC["rbac.authorization.k8s.io<br/>clusterroles, clusterrolebindings,<br/>roles, rolebindings<br/>bind, escalate, full CRUD"]
            OP_Webhooks["admissionregistration.k8s.io<br/>mutating/validatingwebhookconfigurations<br/>full CRUD"]
            OP_CertMgr["cert-manager.io<br/>certificates, issuers<br/>full CRUD"]
            OP_Deploy["apps: deployments, replicasets<br/>core: configmaps, events, pods,<br/>secrets, serviceaccounts, services<br/>full CRUD"]
            OP_Monitor["monitoring.coreos.com<br/>servicemonitors<br/>CRUD"]
        end
    end

    subgraph "Manager ClusterRole (36+ rules)"
        CR_Manager["kueue-manager-role<br/>(ClusterRole)"]

        subgraph "Kueue CRDs"
            MR_KueueCRDs["kueue.x-k8s.io<br/>admissionchecks, clusterqueues,<br/>cohorts, localqueues, workloads<br/>full CRUD + finalizers + status"]
            MR_KueueRO["kueue.x-k8s.io<br/>multikueueclusters, multikueueconfigs,<br/>provisioningrequestconfigs,<br/>workloadpriorityclasses<br/>get, list, watch"]
            MR_Flavors["kueue.x-k8s.io<br/>resourceflavors, topologies<br/>get, list, update, watch, delete"]
        end

        subgraph "Workload Frameworks"
            MR_Batch["batch<br/>jobs, jobs/finalizers, jobs/status<br/>get, list, patch, update, watch"]
            MR_Kubeflow["kubeflow.org<br/>mpijobs, pytorchjobs, tfjobs,<br/>xgboostjobs, paddlejobs<br/>+ finalizers + status"]
            MR_Ray["ray.io<br/>rayclusters, rayjobs<br/>+ finalizers + status"]
            MR_JobSet["jobset.x-k8s.io<br/>jobsets + finalizers + status"]
            MR_LWS["leaderworkerset.x-k8s.io<br/>leaderworkersets<br/>get, list, watch"]
            MR_AppWrapper["workload.codeflare.dev<br/>appwrappers + finalizers + status"]
        end

        subgraph "Core Resources"
            MR_Core["core<br/>pods: delete, get, list, patch,<br/>update, watch + finalizers + status<br/>nodes, namespaces, limitranges:<br/>get, list, watch<br/>events: create, patch, update, watch<br/>secrets: get, list, update, watch<br/>podtemplates: full CRUD"]
            MR_Apps["apps<br/>deployments, replicasets,<br/>statefulsets<br/>get, list, watch"]
        end
    end

    subgraph "Auth Roles"
        CR_MetricsAuth["kueue-metrics-auth-role<br/>(ClusterRole)"]
        MR_TokenReview["authentication.k8s.io<br/>tokenreviews: create"]
        MR_SAR["authorization.k8s.io<br/>subjectaccessreviews: create"]

        CR_Proxy["kueue-proxy-role<br/>(ClusterRole)"]
    end

    subgraph "Leader Election Role"
        R_Leader["kueue-leader-election-role<br/>(Role, NS: kueue-system)"]
        LE_Resources["configmaps, leases: full CRUD<br/>events: create, patch"]
    end

    %% Bindings
    SA_Operator -->|"bound via"| CRB_Operator
    CRB_Operator -->|"grants"| CR_Operator

    SA_Controller -->|"bound via"| CRB_Manager
    CRB_Manager -->|"grants"| CR_Manager

    SA_Controller -->|"bound via"| CRB_Metrics
    CRB_Metrics -->|"grants"| CR_MetricsAuth

    SA_Controller -->|"bound via"| CRB_Proxy
    CRB_Proxy -->|"grants"| CR_Proxy

    SA_Controller -->|"bound via"| RB_Leader
    RB_Leader -->|"grants"| R_Leader

    SA_Controller -->|"bound via"| RB_Visibility

    SA_Operator -->|"bound via"| RB_Network

    %% Role to Resources
    CR_Operator --- OP_Kueue
    CR_Operator --- OP_CRDs
    CR_Operator --- OP_RBAC
    CR_Operator --- OP_Webhooks
    CR_Operator --- OP_CertMgr
    CR_Operator --- OP_Deploy
    CR_Operator --- OP_Monitor

    CR_Manager --- MR_KueueCRDs
    CR_Manager --- MR_KueueRO
    CR_Manager --- MR_Flavors
    CR_Manager --- MR_Batch
    CR_Manager --- MR_Kubeflow
    CR_Manager --- MR_Ray
    CR_Manager --- MR_JobSet
    CR_Manager --- MR_LWS
    CR_Manager --- MR_AppWrapper
    CR_Manager --- MR_Core
    CR_Manager --- MR_Apps

    CR_MetricsAuth --- MR_TokenReview
    CR_MetricsAuth --- MR_SAR

    R_Leader --- LE_Resources

