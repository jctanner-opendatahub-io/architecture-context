{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/red-hat-data-services/odh-architecture-context/schemas/architecture-table-patch-v1.schema.json",
  "title": "Architecture table patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operations"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s,:;]+:[0-9]+(?:-[0-9]+)?$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "category",
        "key",
        "column",
        "analyzer_value",
        "candidate_value",
        "reason",
        "evidence"
      ],
      "properties": {
        "action": {
          "enum": ["add", "update", "delete"]
        },
        "category": {
          "enum": [
            "architecture_components",
            "authentication",
            "crds",
            "egress",
            "external_dependencies",
            "grpc_services",
            "http_endpoints",
            "ingress",
            "integration_points",
            "internal_dependencies",
            "rbac_cluster_roles",
            "rbac_role_bindings",
            "secrets",
            "services"
          ]
        },
        "key": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "column": {
          "type": "string"
        },
        "analyzer_value": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "candidate_value": {
          "type": ["string", "null"],
          "maxLength": 4000
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["add", "delete"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "column": {
                "const": "*"
              },
              "analyzer_value": {
                "type": "null"
              },
              "candidate_value": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "column": {
                "not": {
                  "const": "*"
                }
              },
              "analyzer_value": {
                "type": "string"
              },
              "candidate_value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {"properties": {"category": {"const": "architecture_components"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 1, "maxItems": 1}, "column": {"enum": ["*", "type", "purpose"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "authentication"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 2, "maxItems": 2}, "column": {"enum": ["*", "auth_mechanism", "enforcement_point", "policy"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "crds"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 3, "maxItems": 3}, "column": {"enum": ["*", "scope", "api_role", "purpose"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "egress"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 1, "maxItems": 1}, "column": {"enum": ["*", "port", "protocol", "encryption", "auth", "purpose"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "external_dependencies"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 1, "maxItems": 1}, "column": {"enum": ["*", "version", "required", "role", "purpose"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "grpc_services"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 1, "maxItems": 1}, "column": {"enum": ["*", "port", "protocol", "transport", "encryption", "auth", "owner", "purpose"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "http_endpoints"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 2, "maxItems": 2}, "column": {"enum": ["*", "upstream_service", "port", "protocol", "transport", "encryption", "auth", "owner", "purpose"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "ingress"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 1, "maxItems": 1}, "column": {"enum": ["*", "type", "hosts", "port", "protocol", "encryption", "tls_mode", "exposure"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "integration_points"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 2, "maxItems": 2}, "column": {"enum": ["*", "port", "protocol", "encryption", "purpose"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "internal_dependencies"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 1, "maxItems": 1}, "column": {"enum": ["*", "interaction_type", "role", "purpose"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "rbac_cluster_roles"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 3, "maxItems": 3}, "column": {"enum": ["*", "verbs"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "rbac_role_bindings"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 2, "maxItems": 2}, "column": {"enum": ["*", "namespace", "service_account"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "secrets"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 1, "maxItems": 1}, "column": {"enum": ["*", "type", "purpose", "provisioned_by", "auto_rotate"]}}}
        },
        {
          "if": {"properties": {"category": {"const": "services"}}, "required": ["category"]},
          "then": {"properties": {"key": {"minItems": 1, "maxItems": 1}, "column": {"enum": ["*", "type", "port", "target_port", "protocol", "encryption", "auth", "exposure"]}}}
        }
      ]
    }
  }
}
